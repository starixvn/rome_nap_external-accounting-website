<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Fanex.ExternalAccount.Resources</RootNamespace>
    <AssemblyName>Fanex.ExternalAccount.Resources</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Update="OTP.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>OTP.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="ProductStatus.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>ProductStatus.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>

