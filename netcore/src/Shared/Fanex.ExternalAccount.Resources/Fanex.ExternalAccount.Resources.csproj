<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Fanex.ExternalAccount.Resources</RootNamespace>
    <AssemblyName>Fanex.ExternalAccount.Resources</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Practices.EnterpriseLibrary.Common" Version="5.0.414.0" />
    <PackageReference Include="Microsoft.Practices.EnterpriseLibrary.Data" Version="5.0.414.0" />
    <PackageReference Include="Microsoft.Practices.ServiceLocation" Version="1.0.0.0" />
    <PackageReference Include="Microsoft.Practices.Unity" Version="2.0.414.0" />
    <PackageReference Include="Microsoft.Practices.Unity.Interception" Version="2.0.414.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="OTP.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>OTP.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="ProductStatus.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>ProductStatus.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>

