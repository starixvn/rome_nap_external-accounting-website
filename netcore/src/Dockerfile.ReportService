# Report Service Dockerfile
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

COPY ["*.sln", "."]
COPY ["ReportService/ReportService.csproj", "ReportService/"]
COPY ["Core/Core.csproj", "Core/"]
COPY ["Core.Shared/Core.Shared.csproj", "Core.Shared/"]
COPY ["Fanex.ExternalAccount.Service/Fanex.ExternalAccount.Service.csproj", "Fanex.ExternalAccount.Service/"]
COPY ["Fanex.ExternalAccount.DataAccess/Fanex.ExternalAccount.DataAccess.csproj", "Fanex.ExternalAccount.DataAccess/"]
COPY ["Fanex.ExternalAccount.Excel/Fanex.ExternalAccount.Excel.csproj", "Fanex.ExternalAccount.Excel/"]

RUN dotnet restore "ReportService/ReportService.csproj"

COPY . .

WORKDIR "/src/ReportService"
RUN dotnet build "ReportService.csproj" -c Release -o /app/build

FROM build AS publish
RUN dotnet publish "ReportService.csproj" -c Release -o /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS final
WORKDIR /app
COPY --from=publish /app/publish .
EXPOSE 80
ENTRYPOINT ["dotnet", "ReportService.dll"]

