@model ExternalAdmin.Main.Models.LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            background: #f5f5f5;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .login-container {
            background: white;
            border-radius: 2px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
            width: 100%;
            max-width: 620px;
            padding: 50px 60px;
        }

        .lock-icon {
            width: 90px;
            height: 90px;
            margin: 0 auto 40px;
            background: #f5f5f5;
            border: 3px solid #e8e8e8;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .lock-icon svg {
            width: 36px;
            height: 36px;
            fill: #d0d0d0;
        }

        .form-group {
            margin-bottom: 0;
            position: relative;
        }

        .form-control {
            width: 100%;
            padding: 16px 50px 16px 16px;
            border: none;
            border-bottom: 1px solid #e0e0e0;
            border-radius: 0;
            font-size: 15px;
            background: #f7f8fc;
            transition: all 0.3s;
        }

        .form-control:focus {
            outline: none;
            border-bottom-color: #3f51b5;
            background: #fff;
        }

        .form-control::placeholder {
            color: transparent;
        }

        .input-icon {
            position: absolute;
            right: 16px;
            top: 50%;
            transform: translateY(-50%);
            width: 22px;
            height: 22px;
            pointer-events: none;
        }

        .input-icon svg {
            width: 100%;
            height: 100%;
            fill: #b0b0b0;
        }

        .btn-login {
            width: 100%;
            padding: 16px;
            background: #6c7a8f;
            color: white;
            border: none;
            border-radius: 2px;
            font-size: 13px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            cursor: pointer;
            transition: background 0.3s;
            margin-top: 30px;
        }

        .btn-login:hover {
            background: #5a6878;
        }

        .validation-error {
            color: #dc3545;
            font-size: 12px;
            margin-top: 5px;
            display: block;
        }

        .validation-summary {
            background: #f8d7da;
            color: #721c24;
            padding: 12px;
            border-radius: 2px;
            margin-bottom: 20px;
            font-size: 13px;
        }

        .validation-summary ul {
            list-style: none;
            margin: 0;
            padding: 0;
        }
    </style>
</head>
<body>
    <div id="root"></div>
    
    <script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    <script src="https://unpkg.com/@@babel/standalone/babel.min.js"></script>
    
    <script type="text/babel">
        const { useState } = React;

        function LoginForm() {
            const [username, setUsername] = useState('');
            const [password, setPassword] = useState('');
            const [errors, setErrors] = useState({});

            const handleSubmit = (e) => {
                e.preventDefault();
                
                const newErrors = {};
                if (!username) newErrors.username = 'Username is required';
                if (!password) newErrors.password = 'Password is required';

                if (Object.keys(newErrors).length > 0) {
                    setErrors(newErrors);
                    return;
                }

                e.target.submit();
            };

            return (
                <div className="login-container">
                    <div className="lock-icon">
                        <svg viewBox="0 0 24 24">
                            <path d="M18,8h-1V6c0-2.76-2.24-5-5-5S7,3.24,7,6v2H6c-1.1,0-2,0.9-2,2v10c0,1.1,0.9,2,2,2h12c1.1,0,2-0.9,2-2V10C20,8.9,19.1,8,18,8z M12,17c-1.1,0-2-0.9-2-2s0.9-2,2-2s2,0.9,2,2S13.1,17,12,17z M15.1,8H8.9V6c0-1.71,1.39-3.1,3.1-3.1s3.1,1.39,3.1,3.1V8z"/>
                        </svg>
                    </div>

                    <form 
                        action="/Account/Login?returnUrl=@ViewData["ReturnUrl"]" 
                        method="post"
                        onSubmit={handleSubmit}
                    >
                        @Html.AntiForgeryToken()
                        
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div className="validation-summary">
                                @Html.ValidationSummary(true)
                            </div>
                        }

                        <div className="form-group">
                            <input
                                type="text"
                                name="Username"
                                className="form-control"
                                value={username}
                                onChange={(e) => {
                                    setUsername(e.target.value);
                                    if (errors.username) setErrors({...errors, username: ''});
                                }}
                                autoComplete="username"
                            />
                            <div className="input-icon">
                                <svg viewBox="0 0 24 24">
                                    <path d="M12,12c2.21,0,4-1.79,4-4s-1.79-4-4-4S8,5.79,8,8S9.79,12,12,12z M12,14c-2.67,0-8,1.34-8,4v2h16v-2C20,15.34,14.67,14,12,14z"/>
                                </svg>
                            </div>
                            {errors.username && <span className="validation-error">{errors.username}</span>}
                        </div>

                        <div className="form-group">
                            <input
                                type="password"
                                name="Password"
                                className="form-control"
                                value={password}
                                onChange={(e) => {
                                    setPassword(e.target.value);
                                    if (errors.password) setErrors({...errors, password: ''});
                                }}
                                autoComplete="current-password"
                            />
                            <div className="input-icon">
                                <svg viewBox="0 0 24 24">
                                    <path d="M18,8h-1V6c0-2.76-2.24-5-5-5S7,3.24,7,6v2H6c-1.1,0-2,0.9-2,2v10c0,1.1,0.9,2,2,2h12c1.1,0,2-0.9,2-2V10C20,8.9,19.1,8,18,8z M12,17c-1.1,0-2-0.9-2-2s0.9-2,2-2s2,0.9,2,2S13.1,17,12,17z M15.1,8H8.9V6c0-1.71,1.39-3.1,3.1-3.1s3.1,1.39,3.1,3.1V8z"/>
                                </svg>
                            </div>
                            {errors.password && <span className="validation-error">{errors.password}</span>}
                        </div>

                        <input type="hidden" name="RememberMe" value="false" />

                        <button type="submit" className="btn-login">LOGIN</button>
                    </form>
                </div>
            );
        }

        ReactDOM.render(<LoginForm />, document.getElementById('root'));
    </script>
</body>
</html>
