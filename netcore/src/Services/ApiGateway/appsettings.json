{
    "AllowedHosts": "*",
    "Logging": {
      "LogLevel": {
        "Microsoft.AspNetCore.Http.Connections": "Information",
        "Default": "Information",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "ReverseProxy": {
      "Clusters": {
        "usercontrol-cluster": {
          "HealthCheck": {
            "Match": {
              "Path": "/health"
            },
            "Interval": "00:00:10",
            "Timeout": "00:00:05"
          },
          "Destinations": {
            "destination1": {
              "Address": "http://user-control-service:80/"
            }
          }
        },
        "auth-cluster": {
          "HealthCheck": {
            "Match": {
              "Path": "/health"
            },
            "Interval": "00:00:10",
            "Timeout": "00:00:05"
          },
          "Destinations": {
            "destination1": {
              "Address": "http://auth-service:80/"
            }
          }
        },
        "statement-cluster": {
          "HealthCheck": {
            "Match": {
              "Path": "/health"
            },
            "Interval": "00:00:10",
            "Timeout": "00:00:05"
          },
          "Destinations": {
            "destination1": {
              "Address": "http://statement-service:80/"
            }
          }
        },
        "customer-cluster": {
          "HealthCheck": {
            "Match": {
              "Path": "/health"
            },
            "Interval": "00:00:10",
            "Timeout": "00:00:05"
          },
          "Destinations": {
            "destination1": {
              "Address": "http://customer-service:80/"
            }
          }
        },
        "report-cluster": {
          "HealthCheck": {
            "Match": {
              "Path": "/health"
            },
            "Interval": "00:00:10",
            "Timeout": "00:00:05"
          },
          "Destinations": {
            "destination1": {
              "Address": "http://report-service:80/"
            }
          }
        },
        "webapp-cluster": {
          "HealthCheck": {
            "Match": {
              "Path": "/health"
            },
            "Interval": "00:00:10",
            "Timeout": "00:00:05"
          },
          "Destinations": {
            "destination1": {
              "Address": "http://webapp:80/"
            }
          }
        }
      },
      "Routes": {
        "customer-controller-route": {
          "Match": {
            "Path": "/Customer/{**catch-all}"
          },
          "ClusterId": "customer-cluster"
        },
        "customer-route": {
          "ClusterId": "customer-cluster",
          "Match": {
            "Path": "/api/customer/{**catch-all}"
          },
          "Transforms": [
            {
              "PathRemovePrefix": "/api/customer",
              "PathPattern": "/api/customer/{**catch-all}"
            }
          ]
        },
        "home-route": {
          "Match": {
            "Path": "/Home/{**catch-all}"
          },
          "ClusterId": "customer-cluster"
        },
        "subgroup-route": {
          "Match": {
            "Path": "/SubGroup/{**catch-all}"
          },
          "ClusterId": "usercontrol-cluster"
        },
        "auth-route": {
          "ClusterId": "auth-cluster",
          "Match": {
            "Path": "/api/auth/{**catch-all}"
          },
          "Transforms": [
            {
              "PathRemovePrefix": "/api/auth",
              "PathPattern": "/api/auth/{**catch-all}"
            }
          ]
        },
        "auth-login-route": {
          "Match": {
            "Path": "/Account/{**catch-all}"
          },
          "ClusterId": "auth-cluster"
        },
        "statement-route": {
          "ClusterId": "statement-cluster",
          "Match": {
            "Path": "/api/statement/{**catch-all}"
          },
          "Transforms": [
            {
              "PathRemovePrefix": "/api/statement",
              "PathPattern": "/api/statement/{**catch-all}"
            }
          ]
        },
        "user-route": {
          "Match": {
            "Path": "/User/{**catch-all}"
          },
          "ClusterId": "usercontrol-cluster"
        },
        "totalbet-route": {
          "Match": {
            "Path": "/TotalBet/{**catch-all}"
          },
          "ClusterId": "report-cluster"
        },
        "group-route": {
          "Match": {
            "Path": "/Group/{**catch-all}"
          },
          "ClusterId": "usercontrol-cluster"
        },
        "menu-route": {
          "Match": {
            "Path": "/Menu/{**catch-all}"
          },
          "ClusterId": "usercontrol-cluster"
        },
        "function-route": {
          "Match": {
            "Path": "/Function/{**catch-all}"
          },
          "ClusterId": "usercontrol-cluster"
        },
        "datRange-route": {
          "Match": {
            "Path": "/DataRange/{**catch-all}"
          },
          "ClusterId": "customer-cluster"
        },
        "winlossDetail-route": {
          "Match": {
            "Path": "/WinlossDetail/{**catch-all}"
          },
          "ClusterId": "report-cluster"
        },
        "usercontrol-route": {
          "ClusterId": "usercontrol-cluster",
          "Match": {
            "Path": "/api/usercontrol/{**catch-all}"
          },
          "Transforms": [
            {
              "PathRemovePrefix": "/api/usercontrol",
              "PathPattern": "/api/usercontrol/{**catch-all}"
            }
          ]
        },
        "dailyWinloss-route": {
          "Match": {
            "Path": "/DailyWinloss/{**catch-all}"
          },
          "ClusterId": "report-cluster"
        },
        "report-route": {
          "ClusterId": "report-cluster",
          "Match": {
            "Path": "/api/report/{**catch-all}"
          },
          "Transforms": [
            {
              "PathRemovePrefix": "/api/report",
              "PathPattern": "/api/report/{**catch-all}"
            }
          ]
        },
        "statement-controller-route": {
          "Match": {
            "Path": "/Statement/{**catch-all}"
          },
          "ClusterId": "statement-cluster"
        },
        "webapp-home-route": {
          "Match": {
            "Path": "/"
          },
          "ClusterId": "webapp-cluster",
          "Order": 999
        },
        "webapp-default-route": {
          "Match": {
            "Path": "/Home/{**catch-all}"
          },
          "ClusterId": "webapp-cluster",
          "Order": 999
        },
        "webapp-static-route": {
          "Match": {
            "Path": "/{**catch-all}",
            "QueryParameters": []
          },
          "ClusterId": "webapp-cluster",
          "Order": 1000
        }
      }
    }
  }