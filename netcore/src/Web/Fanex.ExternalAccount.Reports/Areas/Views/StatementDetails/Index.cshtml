@using Newtonsoft.Json;
@using Fanex.ExternalAccount.Statement.Models.StatementReport;
@using Fanex.ExternalAccount.Statement.Resources;
@using Fanex.ExternalAccount.Reports.Helpers;
@model StatementReportModel
@{
    ViewBag.Title = Labels.Transfer_Details;
    Layout = "";
    var statementReport = JsonConvert.SerializeObject(Model);
    var transferDetailsCriteria = JsonConvert.SerializeObject(ViewBag.TransferDetailsCriteria);
}
<html>
<head>
    <link href="@Url.Content("~/Scripts/Fanex.Grid/Fanex.Pagination.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Scripts/Fanex.Grid/Fanex.Grid.css")" rel="stylesheet" />
    <link rel="stylesheet" href="@Url.Content("~/assets/styles/pages/default/common.css")" />
</head>
<body>
    <div>
        <span id="exporttoexcel" title="Export Excel" class="icon-excel"></span>
    </div>
    <div id="transfer-details-container" class="freegrid"></div>
    <iframe id="frm" width="0" height="0" frameborder="0" style="display: none"></iframe>
    <script type="text/javascript" src="@Url.Content("~/Scripts/_Libs/jQuery/jquery-1.8.2.min.js")"></script>
    @StaticResources.RenderScripts("~/Scripts/_Libs/FanexGrid/FanexGridScripts")
    <script type="text/javascript" src="@Url.Content("~/Scripts/Fanex.Grid/Fanex.Grid.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/Fanex.Grid/Fanex.Pagination.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/Fanex.Grid/moment.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/Fanex.Grid/numeral.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Areas/Statement/Views/StatementDetails/Scripts/StatementDetailsManager.js")"></script>
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
        var statementReport= @Html.Raw(statementReport);
        var transferDetailsCriteria= @Html.Raw(transferDetailsCriteria);
        var statementResources = {
            Date: '@Labels.Date',
            Remark: '@Labels.Remark',
            Amount: '@Labels.Amount',
            Symbol_NoData: '@Labels.Symbol_NoData',
            Total: '@Labels.Total',
            Symbol_ExchangeRate: '@Labels.Symbol_ExchangeRate',
            GrandPrize: '@Labels.GrandPrize'
        };
    </script>
    @Fanex.ExternalAccount.Core.Helpers.GoogleAnalyticHepler.Render()
</body>
</html>
