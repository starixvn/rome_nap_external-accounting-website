@using Fanex.ExternalAccount.Reports.Helpers
@using Fanex.ExternalAccount.Utilities
@model Fanex.ExternalAccount.WhiteLabelWinLossReports.ViewModels.WhiteLabelReportViewModel
@{
    Layout = null;
    var typeReport1 = "settlement-win-loss";
    var typeReport2 = "daily-win-loss";
}
@StaticResources.RenderStyles("~/assets/styles/pages/reports/white-label-report")
<div class="manage-product">
    <div class="page-title">White Label Report</div>
    <div id="tabs" style="border: none">
        <ul class="tabs">
            <li><a href="#tabs-1">@ViewLang.SettlementReport</a></li>
            <li><a href="#tabs-2">@ViewLang.DailyWinLossReport</a></li>
        </ul>
        <div id="tabs-1">
            <div class="search-form search-form-report-by-cur filter-box">
                <div class="form-group">
                    <label class="label-form-control">@ViewLang.From</label>
                    <div class="input-group date group-month-picker">
                        <input id="month-picker-from-date" class="form-control" type="text" readonly />
                    </div>
                </div>
                <div class="form-group">
                    <label class="label-form-control">@ViewLang.To</label>
                    <div class="input-group date group-month-picker">
                        <input id="month-picker-to-date" class="form-control" type="text" readonly />
                    </div>
                </div>
                <div class="form-group">
                    <div class="label-form-control">@ViewLang.WhiteLabel</div>
                    <div class="ddl-white-label">
                        <div id="@typeReport1-ddl-white-label"></div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="label-form-control" for="@typeReport1-username-filter">@ViewLang.Username</label>
                    <div>
                        <input id="@typeReport1-username-filter" type="text" autocomplete="off" maxlength="50" />
                    </div>
                </div>
                <div class="form-group btn-box">
                    <input type="button" value="@ViewLang.Submit" id="@typeReport1-submit-btn" class="btn -submit btnSearch" />
                </div>
                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-top: 10px">
                    <div class="note-text"><span class="icon icon-warning"></span>@ViewLang.WhiteLabelSettlementReportNote</div>
                    <div id="@typeReport1-ddl-columns-container" style="display: none">
                        <div class="columns-container">
                            <span>@ViewLang.Columns</span>
                            <div class="columns-list">
                                <div id="@typeReport1-ddl-columns"></div>
                            </div>
                        </div>
                    </div>
                
                </div>
            </div>
            <div id="@typeReport1-mainGrid" class="settlement-grid" style="display: none">
                <div id="@typeReport1-jqgrid" class="removeRadius freegrid content-grid"></div>
            </div>
            <div id="@typeReport1-msgNoInfo" class="div-noData msgNoInfo" style="display: none">@ViewLang.NoData</div>
        </div>
        <div id="tabs-2">
            <div class="search-form search-form-report-by-cur filter-box">
                <div class="form-group daterangepicker-container">
                    <label class="label-form-control" for="@typeReport2-date-range-picker">@ViewLang.DateRange</label>
                    <div class="input-group date datepicker">
                        <input type="text"
                               class="form-control"
                               id="@typeReport2-date-range-picker"
                               autocomplete="off"
                               readonly
                               data-mindate="@Model.FormatedMinDate"
                               data-maxdate="@Model.FormatedToday"
                               data-fromdate="@Model.FormatedToday"
                               data-todate="@Model.FormatedToday"
                               data-currentdate="@Model.FormatedToday"
                               data-label-today="@ViewLang.Today"
                               data-label-yesterday="@ViewLang.Yesterday"
                               data-label-thisweek="@ViewLang.ThisWeek"
                               data-label-lastweek="@ViewLang.LastWeek"
                               data-label-thismonth="@ViewLang.ThisMonth"
                               data-label-lastmonth="@ViewLang.LastMonth"
                               data-label-sincelastmonth="@ViewLang.SinceLastMonth" />
                        <label class="input-group-addon" for="@typeReport2-date-range-picker">
                            <span class="icon-calendar"></span>
                        </label>
                    </div>
                </div>
                <div class="form-group">
                    <div class="label-form-control">@ViewLang.WhiteLabel</div>
                    <div class="ddl-white-label">
                        <div id="@typeReport2-ddl-white-label"></div>
                    </div>
                </div>
                <div class="form-group">
                    <div class="label">@ViewLang.Username</div>
                    <div>
                        <input id="@typeReport2-username-filter" type="text" autocomplete="off" maxlength="50" />
                    </div>
                </div>
                <div class="form-group btn-box">
                    <input type="button" value="@ViewLang.Submit" id="@typeReport2-submit-btn" class="btn -submit btnSearch" />
                </div>
            </div>
            <div id="@typeReport2-mainGrid" class="settlement-grid daily" style="display: none">
                <div id="@typeReport2-jqgrid" class="removeRadius freegrid content-grid"></div>
            </div>
            <div id="@typeReport2-msgNoInfo" class="div-noData msgNoInfo" style="display: none">@ViewLang.NoData</div>
        </div>
    </div>
</div>
@Html.Hidden("hidden-today", Model.FormatedToday)
@Html.Hidden("inp-whitelabels", Newtonsoft.Json.JsonConvert.SerializeObject(Model.WhiteLabels))
@StaticResources.RenderScripts("~/assets/bundles/white-label-report/index")
