@model CaptchaMvc.Models.DefaultBuildInfoModel
@{
    string id = Guid.NewGuid().ToString("N");
    string functionName = string.Format("______{0}________()", id);
    <script type="text/javascript">
        function @functionName {
            $('#@id').hide();
            $.post("@Model.RefreshUrl", { @Model.TokenParameterName: $('#@Model.TokenElementId').val() }, 
                function () {
                    $('#@id').show();
                });
            return false;
        }
    </script>
}

@if (Model.IsRequired)
{
    @Html.TextBox(Model.InputElementId, null, new Dictionary<string, object>
                        {
                            {"data-val", "true"},
                            {"data-val-required", Model.RequiredMessage},
                            {"id", "recaptcha_response_field"},
                            {"class", "captcha-text form-control"}
                        })

}
else
{
    @Html.TextBox(Model.InputElementId, null, new { @id = "recaptcha_response_field", @class = "captcha-text form-control", @maxlength = 5 })
}

<img alt="" id="@Model.ImageElementId" src="@Model.ImageUrl" class="captcha-img" onclick="return @functionName" />

@Html.Hidden(Model.TokenElementId, Model.TokenValue)

<div class="refreshCont" id="@id" href="#@Model.ImageElementId">
    <span class="refreshCode" onclick="return @functionName"></span>
</div>

