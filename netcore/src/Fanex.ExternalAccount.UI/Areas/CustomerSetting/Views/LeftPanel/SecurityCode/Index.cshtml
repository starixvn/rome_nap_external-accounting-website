@using Fanex.ExternalAccount.Core.Shared
@{
    var canEditForceChange = Role.IsSuper(ViewBag.roleId);
}
@{
    Layout = null;
}

<link rel="stylesheet" href="@Url.Content("~/assets/styles/fonts/AlphaAdmin/style.css?v=1")" />
<link href="@Url.Content("~/Areas/CustomerSetting/Styles/Validators.css")" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/assets/styles/pages/account/security-code.css")" rel="stylesheet" type="text/css" />

<form class="form-add">
    <div id="errMsg" class="successMsg hide"> </div>
    <div id="err-message" class="row errMsg hide"></div>
    <div class="group">
        <div class="pull-left width-140 text-right">
            <label for="securityCode" class="label">Security Code</label>
        </div>
        <div class="pull-left width-250">
            <input id="securityCode" maxlength="6" type="text" class="form-control width-250" />
        </div>
    </div>
    <div class="group">
        <div class="pull-left width-140 text-right">
            <label for="securityCodeConfirm" class="label">Confirm Security Code</label>
        </div>
        <div class="pull-left width-250">
            <input type="text" id="securityCodeConfirm" maxlength="6" class="form-control width-250" />
        </div>
    </div>
    <div class="group">
        <div class="pull-left width-140 text-right">
            <label for="forceChange" class="label">Force change</label>
        </div>
        <div class="pull-left width-250">
            <input id="forceChange" type="checkbox"
                   checked="checked" @(canEditForceChange ? string.Empty : "disabled") class="checkbox" />
        </div>
    </div>
    <div class="group form-action with-label-150">
        <input type="button" class="btn -submit" value="Submit" onclick="Update()" />
        <input type="button" class="btn -normal" value="Reset" onclick="Reset()" />
    </div>
</form>
<div class="warning l" id="reportNote">
    <ul>
        <li>
            Security Code (SC) must be:
            <ul>
                <li> Numeric digits only.</li>
                <li> 6 digits from 0-9.</li>
                <li> At least 2 different digits in the SC.</li>
                <li>
                    Not a forward run AND not a backward run number:
                    <ul>
                        <li>
                            A "Forward Run" number is an integer whose digits are all in consecutive, ascending
                            order, left to right.
                        </li>
                        <li>
                            A "Backward Run" number is an integer whose digits are all in consecutive, descending
                            order, left to right.
                        </li>
                        <li> For example: 123456, 456789, 765432, etc. are not allowed.</li>
                    </ul>
                </li>
            </ul>
        </li>
    </ul>
</div>
@Html.AntiForgeryToken()
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/jquery.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/jquery.blockUI.1.33.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/Validators.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/Fanex.CustomerSetting.Core.js")" type="text/javascript"></script>
<script type="text/javascript">
    var custId = parseInt('@ViewBag.custId');
    var roleId = parseInt('@ViewBag.roleId');
</script>
<script src="@Url.Content("~/Areas/CustomerSetting/Views/LeftPanel/SecurityCode/Scripts/SecurityCode.js")" type="text/javascript"></script>
@Html.Raw(Fanex.Logging.LogManager.RenderJavascriptLogger())