<?xml version="1.0" encoding="utf-8" ?>
<enablestatus>
  <!--<enablestatus xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="Template.xsd">-->
  <products iframeid="leftPanel">
    <product id="bettrade" function="EnableBetTrade" closepopupjs="parent.ClosePopup();">
      <sps>
        <sp key="Acc_3rdProductSelSuperStatus" type="SELECT">
          <params>
            <param name="CustId" mapproperty="CustId" />
            <param name="Username" mapproperty="Username" />
            <param name="RoleId" mapproperty="Level" />
            <param name="ProductId" mapproperty="Product" />
          </params>
          <results>
            <column name="supperstatus" mapproperty="Disabled" reverse="true" />
            <column name="downlinestatus" mapproperty="DisabledDownlines" reverse="true" />
          </results>
        </sp>
        <sp key="Acc_3rdProductUpdSuperStatus" type="UPDATE">
          <params>
            <param name="CustId" mapproperty="CustId" />
            <param name="Username" mapproperty="Username" />
            <param name="RoleId" mapproperty="Level" />
            <param name="ProductId" mapproperty="Product" />

            <param name="IsEnable" mapproperty="Disabled" reverse="true"/>
            <param name="ApplyToMember" mapproperty="DisabledDownlines" reverse="true" />

            <param name="UserId" mapproperty="UserId" />
            <param name="language" mapproperty="Language" />
            <param name="errcode" mapproperty="ErrorCode" />
            <param name="errmsg" mapproperty="ErrorMessage" />
            <param name="ip" mapproperty="Ip" />
          </params>
          <results>
            <column name="errcode" mapproperty="ErrorCode" />
            <column name="errmsg" mapproperty="ErrorMessage" />
          </results>
        </sp>
      </sps>
    </product>
    <product id="superLive" reloadafterupdate="true" function="EnableSuperLive" closepopupjs="parent.ClosePopup();">
      <sps>
        <sp key="Acc_CustomerSelProductStatus" type="SELECT">
          <params>
            <param name="CustId" mapproperty="CustId" />
            <param name="SportName" mapproperty="SportTypeName" default="SuperLive" />
            <param name="RoleId" mapproperty="Level" />
          </params>
          <results>
            <column name="UplineStatus" mapproperty="DisabledUplines" />
            <column name="Status" mapproperty="Disabled" />
            <column name="downlinestatus" mapproperty="DisabledDownlines" />
          </results>
        </sp>
        <sp key="Acc_CustomerUpdDisableSuperLive" type="UPDATE">
          <params>
            <param name="CustId" mapproperty="CustId" />
            <param name="Disable" mapproperty="Disabled"/>
            <param name="EnableDownlines" mapproperty="DisabledDownlines" reverse="true" />

            <param name="UserId" mapproperty="UserId" />
            <param name="SubAccID" mapproperty="SubAccID" />
            <param name="language" mapproperty="Language" />
            <param name="errcode" mapproperty="ErrorCode" />
            <param name="errmsg" mapproperty="ErrorMessage" />
            <param name="ip" mapproperty="Ip" />
          </params>
          <results>
            <column name="errcode" mapproperty="ErrorCode" />
            <column name="errmsg" mapproperty="ErrorMessage" />
          </results>
        </sp>
      </sps>
    </product>

    <product id="macau" function="EnableMacau" closepopupjs="parent.ClosePopup();">
      <sps>
        <sp key="Acc_3rdProductSelSuperStatus" type="SELECT">
          <params>
            <param name="CustId" mapproperty="CustId" />
            <param name="Username" mapproperty="Username" />
            <param name="RoleId" mapproperty="Level" />
            <param name="ProductId" mapproperty="Product" />
          </params>
          <results>
            <column name="supperstatus" mapproperty="Disabled" reverse="true" />
            <column name="downlinestatus" mapproperty="DisabledDownlines" reverse="true" />
          </results>
        </sp>
        <sp key="Acc_3rdProductUpdSuperStatus" type="UPDATE">
          <params>
            <param name="CustId" mapproperty="CustId" />
            <param name="Username" mapproperty="Username" />
            <param name="RoleId" mapproperty="Level" />
            <param name="ProductId" mapproperty="Product" />

            <param name="IsEnable" mapproperty="Disabled" reverse="true"/>
            <param name="ApplyToMember" mapproperty="DisabledDownlines" reverse="true" />

            <param name="UserId" mapproperty="UserId" />
            <param name="language" mapproperty="Language" />
            <param name="errcode" mapproperty="ErrorCode" />
            <param name="errmsg" mapproperty="ErrorMessage" />
            <param name="ip" mapproperty="Ip" />
          </params>
          <results>
            <column name="errcode" mapproperty="ErrorCode" />
            <column name="errmsg" mapproperty="ErrorMessage" />
          </results>
        </sp>
      </sps>
    </product>
    <product id="sportsbook2" function="EnableSportsbook2" newmode="true" closepopupjs="parent.ClosePopup();">
      <sps>
        <sp key="Acc_CustSetting_StatusSettingSelect" type="SELECT">
          <params>
            <param name="CustID" mapproperty="CustId" />
            <param name="ProductID" mapproperty="Product"/>
            <param name="SettingType" mapproperty="SettingType" />
            <param name="RoleID" mapproperty="Level" />
          </params>
          <results>
            <column name="SportType" mapproperty="SportTypeId" />
            <column name="BetType" mapproperty="BetTypeId" />
            <column name="IsSync" mapproperty="Synced" />
            <column name="IsDisabled" mapproperty="Disabled" />
            <column name="IsDisabledUpline" mapproperty="DisabledUplines" />
            <column name="IsDisabledDownline" mapproperty="DisabledDownlines" />
            <column name="IsHidden" mapproperty="Hide" />
          </results>
        </sp>
        <sp key="Acc_CustSetting_DisableStatUpd" type="UPDATE">
          <params>
            <param name="CustId" mapproperty="CustId" />
            <param name="IsDisabled" mapproperty="DisabledXML"/>
            <param name="UserId" mapproperty="UserId" />
            <param name="SubAccID" mapproperty="SubAccID" />
            <param name="language" mapproperty="Language" />
            <param name="errcode" mapproperty="ErrorCode" />
            <param name="errmsg" mapproperty="ErrorMessage" />
            <param name="msgType" mapproperty="MessageType" />
            <param name="ip" mapproperty="Ip" />
          </params>
          <results>
            <column name="errcode" mapproperty="ErrorCode" />
            <column name="errmsg" mapproperty="ErrorMessage" />
          </results>
        </sp>
      </sps>
    </product>
    <product id="allbet" function="EnableAllbet" newmode="true" closepopupjs="parent.ClosePopup();"
             warning="warningAllbetUnsyncedAllDownline">
      <sps>
        <sp key="Acc_CustSetting_StatusSettingSelect" type="SELECT">
          <params>
            <param name="CustID" mapproperty="CustId" />
            <param name="ProductID" mapproperty="Product" default="21"/>
            <param name="SettingType" mapproperty="SettingType" default="4" />
            <param name="RoleID" mapproperty="Level" />
          </params>
          <results>
            <column name="SportType" mapproperty="SportTypeId" />
            <column name="BetType" mapproperty="BetTypeId" />         
            <column name="IsDisabled" mapproperty="Disabled" />
            <column name="IsDisabledUpline" mapproperty="DisabledUplines" />
            <column name="IsDisabledDownline" mapproperty="DisabledDownlines" />
            <column name="IsHidden" mapproperty="Hide" />
          </results>
        </sp>
        <sp key="Acc_CustSetting_DisableStatUpd" type="UPDATE">
          <params>
            <param name="CustId" mapproperty="CustId" />
            <param name="IsDisabled" mapproperty="DisabledXML"/>
            <param name="UserId" mapproperty="UserId" />
            <param name="SubAccID" mapproperty="SubAccID" />
            <param name="language" mapproperty="Language" />
            <param name="errcode" mapproperty="ErrorCode" />
            <param name="errmsg" mapproperty="ErrorMessage" />
            <param name="msgType" mapproperty="MessageType" />
            <param name="ip" mapproperty="Ip" />
          </params>
          <results>
            <column name="errcode" mapproperty="ErrorCode" />
            <column name="errmsg" mapproperty="ErrorMessage" />
          </results>
        </sp>
      </sps>
    </product>
    <product id="voidbridge" function="EnableVoidbridge" newmode="true" reloadafterupdate="true" closepopupjs="parent.ClosePopup();"
               warning="warningVoidBridgeUnsyncedAllDownline">
      <sps>
        <sp key="Acc_CustSetting_StatusSettingSelect" type="SELECT">
          <params>
            <param name="CustID" mapproperty="CustId" />
            <param name="ProductID" mapproperty="Product" default="22"/>
            <param name="SettingType" mapproperty="SettingType" default="4" />
            <param name="RoleID" mapproperty="Level" />
          </params>
          <results>
            <column name="SportType" mapproperty="SportTypeId" />
            <column name="BetType" mapproperty="BetTypeId" />         
            <column name="IsDisabled" mapproperty="Disabled" />
            <column name="IsDisabledUpline" mapproperty="DisabledUplines" />
            <column name="IsDisabledDownline" mapproperty="DisabledDownlines" />
            <column name="IsHidden" mapproperty="Hide" />
          </results>
        </sp>
        <sp key="Acc_CustSetting_DisableStatUpd" type="UPDATE">
          <params>
            <param name="CustId" mapproperty="CustId" />
            <param name="IsDisabled" mapproperty="DisabledXML"/>
            <param name="UserId" mapproperty="UserId" />
            <param name="SubAccID" mapproperty="SubAccID" />
            <param name="language" mapproperty="Language" />
            <param name="errcode" mapproperty="ErrorCode" />
            <param name="errmsg" mapproperty="ErrorMessage" />
            <param name="msgType" mapproperty="MessageType" />
            <param name="ip" mapproperty="Ip" />
          </params>
          <results>
            <column name="errcode" mapproperty="ErrorCode" />
            <column name="errmsg" mapproperty="ErrorMessage" />
          </results>
        </sp>
      </sps>
    </product>
    
  </products>
</enablestatus>