@using Fanex.ExternalAccount.Utilities
@using Fanex.ExternalAccount.DTO.UserControl
@model Function
@{
    var parentList = (IEnumerable<Function>)ViewBag.ParentList;
}
<link href="@Url.Content("~/Scripts/Combobox/Combobox.css")" rel="stylesheet" type="text/css" />

<div class="form-add">
    <div id="errMsg" class="successMsg hide">
    </div>

    <div class="group">
        <div class="pull-left width-100 text-right">
            @Html.HiddenFor(m => m.FuncID)
            @Html.LabelFor(m => m.FuncName, ViewLang.Name, new { @class = "divMargin" })
        </div>
        <div class="pull-left width-250">
            @Html.TextBoxFor(m => m.FuncName, new { @class = "form-control width-250" })
        </div>
    </div>
    <div class="group">
        <div class="pull-left width-100 text-right">
            @Html.LabelFor(m => m.FuncKey, ViewLang.Key, new { @class = "divMargin" })
        </div>
        <div class="pull-left">
            @Html.TextBoxFor(m => m.FuncKey, new { @class = "form-control width-250" })
        </div>
    </div>
    <div class="group">
        <div class="pull-left width-100 text-right">
            @Html.LabelFor(m => m.FuncDesc, ViewLang.Description, new { @class = "label" })
        </div>
        <div class="pull-left">
            @Html.TextAreaFor(m => m.FuncDesc, new { @class = "desc form-control width-250 textarea" })
        </div>
    </div>
    <div class="group">
        <div class="pull-left width-100 text-right">
            @Html.LabelFor(m => m.ParentID, ViewLang.Parent, new { @class = "label" })
        </div>
        <div class="pull-left groupCboMenu">
            <select id="ParentID" name="ParentID" class="form-control">
                <option value="-1">@ViewLang.None</option>
                @foreach (var item in parentList)
                {
                    <option value="@item.FuncID" @(item.FuncID == Model.ParentID ? "selected=selected" : "")>@item.FuncName</option>
                }
            </select>
        </div>
    </div>
    <div class="group">
        <div class="pull-left width-100 text-right">
            @Html.LabelFor(m => m.DisplayOrder, ViewLang.Order, new { @class = "label" })
        </div>
        <div class="pull-left">
            @Html.TextBoxFor(m => m.DisplayOrder, new { @class = "form-control order", @maxlength = "3", @onpaste = "return false;", @onkeypress = "return Fanex.ExtAcc.CheckNumber(event, this)", @onkeyup = "return Fanex.ExtAcc.CheckNumber(event, this)" })
        </div>
    </div>
    <div class="group">
        <div class="pull-left width-100 text-right">
            @Html.Label(ViewLang.AssignTo, new { @class = "label" })
        </div>
        <div class="pull-left">
            <select name="groupsAdd" id="groupsAdd" multiple="multiple" class="hide form-control"></select>
            <input type="hidden" id="newGroups" />
        </div>
    </div>
    <div class="group form-action">
        <input class="buttonPopup btn -submit" type="button" value="Submit" onclick="Fanex.ExtAcc.Function.Add()" />
    </div>
</div>

<script src="@Url.Content("~/Scripts/Combobox/Combobox.js")" type="text/javascript"></script>
<script type="text/javascript">
    $('#ParentID').combobox();
    $(document).ready(function () {
        $(".groupCboMenu input").attr("readonly", "true");
        $(".groupCboMenu input").bind("click", function () {
            $(this).autocomplete("search", '');
        });
    });
</script>