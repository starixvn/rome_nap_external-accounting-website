@using Fanex.ExternalAccount.Utilities
@model Fanex.ExternalAccount.DTO.Customer.Customer
@{
    var displayMember = Model.RoleId.IsMember() ? "block" : "none";
    var displayAgent = Model.RoleId.IsNotMember() ? "block" : "none";
}

<form class="form-add">
    <div id="err-message" class="row errMsg hide"></div>
    <div class="group">
        <div class="pull-left width-120 text-right">
            @Html.HiddenFor(m => m.CustId)@Html.LabelFor(m => m.Password, ViewLang.Newpassword, new { @class = "label" })
        </div>
        <div class="pull-left width-250">
            @Html.PasswordFor(m => m.Password, new { @class = "form-control width-250", @maxlength = "10" })
        </div>
    </div>
    <div class="group">
        <div class="pull-left width-120 text-right">
            <label for="confirmPwd" class="label">@ViewLang.Confirmpassword</label>
        </div>
        <div class="pull-left width-250">
            <input id="confirmPwd" type="password" class="form-control width-250" maxlength="10" />
        </div>
    </div>
    <div class="group form-action with-label-120">
        <input class="btn -submit buttonPopup" type="button" value="Submit" onclick="Fanex.ExtAcc.Customer.ResetPwd(@Model.RoleId)" />
    </div>
</form>
<div class="note text-red">
    <div id="agentTemplate" style="display: @displayAgent;">
        <p>Password must be at least 8 characters without white-space and contain at least 3 of the following:</p>
        <ul>
            <li>Uppercase letter [A-Z]</li>
            <li>Lowercase letter [a-z]</li>
            <li>Numeric [0-9]</li>
            <li>Special character (!,&#64;,#,etc..)</li>
        </ul>
        <p>For example: 59D7!4$h, 493abcDE</p>
        <p>Notes: your password is cAsE sEnSiTiVe</p>
    </div>
    <div id="memberTemplate" style="display: @displayMember;">
        <p>Password must be 6-10 characters without white-space and contain at least 1 uppercase letter, 1 lowercase letter, 1 numeric digit.</p>
        <ul>
            <li>Uppercase letter [A-Z]</li>
            <li>Lowercase letter [a-z]</li>
            <li>Numeric [0-9]</li>
            <li>Special character (!,&#64;,#,etc..)</li>
        </ul>
        <p>For example: 493abcDE, 59D7!4$h</p>
        <p>Notes: your password is cAsE sEnSiTiVe.</p>
    </div>
</div>
@Html.Hidden("SCode", (string)ViewBag.SCode)
@Html.AntiForgeryToken()