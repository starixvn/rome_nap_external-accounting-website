@using Fanex.ExternalAccount.Utilities

<form class="form-add mark-account">
    <div id="errMsg" class="successMsg hide"> </div>

    <div class="group">
        <div class="pull-left width-100 text-left ml-3">
            <label class="label" for="TypeId">@ViewLang.Type<span style="color:red"> *</span></label>
        </div>
        <div class="pull-left">
            <select id="TypeId" name="GroupID" class="form-control width-150">
                <option value="">Please select</option>
                <option value="1">VIP</option>
                <option value="2">Suspicious</option>
                <option value="3">Problem</option>
            </select>
        </div>
    </div>
    <div class="group">
        <div class="pull-left width-100 text-left">
            <label class="label" for="Usernames">@ViewLang.Usernames<span style="color:red"> *</span></label>
        </div>
        <div class="pull-left">
            <textarea id="Usernames" class="form-control width-320 textarea"></textarea>
            <div class="text-left ml10" style="color:cadetblue">Usernames are separated by comma ','</div>
        </div>
    </div>
    <div class="group">
        <div class="pull-left width-100 text-left">
            <label for="Remark" class="label">@ViewLang.Remark</label>
        </div>
        <div class="pull-left">
            <textarea id="Remark" class="width-320 ml10" rows="3" maxlength="2000"></textarea>
        </div>
    </div>
    <div class="group form-action">
        <input class="btn btn-default pull-right" type="button" value="Cancel" onclick="Fanex.ExtAcc.Form.Close(false);" />
        <input class="btn -submit pull-right mr10" type="button" value="Submit" onclick="Fanex.ExtAcc.MarkAccountType.Add()" />
    </div>
</form>
<script>
    Fanex.ExtAcc.MarkAccountType.BindingAddNewEvents();
</script>