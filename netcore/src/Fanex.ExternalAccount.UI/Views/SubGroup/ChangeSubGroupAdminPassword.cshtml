@using Fanex.ExternalAccount.Utilities

<form class="form-add" autocomplete="off">
    <div id="err-message" class="row errMsg hide"></div>
    <div id="success-message" class="row successMsg hide">Update successfully!</div>
    <div class="group">
        <div class="pull-left width-150 text-right">
            @Html.Label(ViewLang.Group, new { @class = "divMargin" })
        </div>
        <div class="pull-left width-250">
            @Html.Label((string)ViewBag.GroupName, new { @class = "form-control width-250" })
        </div>
    </div>
    <div class="group">
        <div class="pull-left width-150 text-right">
            @Html.Label(ViewLang.Admin, new { @class = "divMargin label-required" })
        </div>
        <div class="pull-left">
            @Html.DropDownList("AdminId", (List<SelectListItem>)ViewBag.Admins, new { @class = "form-control width-250" })
        </div>
    </div>
    <div class="group">
        <div class="pull-left width-150 text-right">
            @Html.Label(ViewLang.Newpassword, new { @class = "divMargin label-required" })
        </div>
        <div class="pull-left width-250">
            @Html.Password("newpassword", "", new { @class = "form-control width-250", @autocomplete = "new-password", @maxlength = "30" })
        </div>
    </div>
    <div class="group">
        <div class="pull-left width-150 text-right">
            @Html.Label(ViewLang.Confirmnewpassword, new { @class = "divMargin label-required" })
        </div>
        <div class="pull-left width-250">
            @Html.Password("confirmpassword", "", new { @class = "form-control width-250", @autocomplete = "new-password", @maxlength = "30" })
        </div>
    </div>
    <div class="group form-action">
        <input class="btn -submit" type="button" value="Submit" onclick="Fanex.ExtAcc.SubGroup.ChangeSubGroupAdminPassword()" />
    </div>
    @Html.Hidden("SCode", (string)ViewBag.SCode)
</form>
<script type="text/javascript">
    $('label.label-required').each(function () {
        var label = $(this);
        var text = label.text();
        if (text.length > 0) {
            label.append('<span style="color:red"> *</span>');
        }
    });
</script>