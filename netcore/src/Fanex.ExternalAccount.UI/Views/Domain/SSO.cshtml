@using Fanex.ExternalAccount.Core.Context;
@using Fanex.ExternalAccount.DTO.UserControl;
@{
    Layout = null;

    string[] domains = null;
    var appPath = Request.PathBase;
    var virtualDirectory = appPath.Equals("/", StringComparison.OrdinalIgnoreCase) ? string.Empty : appPath.Value;
    var currentDomain = Request.Headers["Host"] + virtualDirectory;

    string currentLine = currentDomain;
    var currentLineValue = string.Empty;

    var supportSwitchLine = !CurrentSession.Instance.IsInternalAdmin || !CurrentSession.Instance.IsITAdmin; /*!Group.IsOfficeGroup(new CurrentSession().CurrencyGroup);*/

    if (supportSwitchLine)
    {
        var domainsValue = Configuration.GetValue<string>("AppSettings:Domains") ?? Configuration.GetValue<string>("Domains") ?? "";
        domains = domainsValue.Split(new[] { "," }, StringSplitOptions.RemoveEmptyEntries);

        foreach (var domain in domains)
        {
            if (domain.IndexOf(currentDomain) != -1)
            {
                currentLine = domain.Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries).ElementAt(1);
                break;
            }
        }

        var scheme = Request.Headers["X-Forwarded-Proto"];
        currentLineValue = string.Format("{0}://{1}", string.IsNullOrWhiteSpace(scheme) ? "http" : scheme, currentDomain);
    }
}
@if (supportSwitchLine && domains.Length > 0)
{
    <div class="switch-line">
        <span class="switch-line-current-line"></span>
        <select onchange="javascript:switchLine(this)" class="ddl-switchLine">
            <option value="@currentLineValue" class="opt-line-current">
                @currentLine
            </option>
            @for (var i = 0; i < domains.Length; i++)
            {
                var domainName = domains[i].Split(';')[0];
                var aliasName = domains[i].Split(';')[1];

                domainName = domainName.IndexOf(currentDomain, StringComparison.OrdinalIgnoreCase) != -1 ? string.Empty : domainName;

                var formatedDomain = domainName.StartsWith("http") ? domainName :
                    string.IsNullOrWhiteSpace(domainName) ? string.Empty : "http://" + domainName;
                if (!string.IsNullOrWhiteSpace(domainName))
                {
                    <option value="@formatedDomain" class="opt-line-@i">@aliasName</option>
                }
            }
        </select>
    </div>
    
}