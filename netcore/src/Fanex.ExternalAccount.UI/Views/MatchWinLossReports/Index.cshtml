@using Fanex.ExternalAccount.MatchWinLossReports.ViewModels
@model MatchWinLossReportsViewModels
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    @StaticResources.RenderStyles("~/assets/bundles/matchwinlossreports/match-winloss-reports-style")
</head>
<div class="match-win-loss-report-container">
    <div class="page-title">
        Match Win Loss
        <span id="match-win-loss-report-note" class="bet-type-detail-icon"></span>
    </div>
    <div id="tabs-container" style="width: 100%;">
        <ul class="tabs">
            <li class="tab-1 active">
                <a href="#tab-1" data-url="">Summary</a>
            </li>
            <li class="tab-2">
                <a href="#tab-2" data-url="">Details</a>
            </li>
        </ul>
        <div id="tab-frames" style="width: 100%;">
            <div id="tab-1-container" style="width: 100%;">
                @{ Html.RenderPartial("SummaryFilter", Model); }
            </div>
            <div id="tab-2-container" style="width: 100%; display: none;">
                @{ Html.RenderPartial("DetailsFilter", Model); }
            </div>
        </div>
    </div>
</div>
@Html.Hidden("inp-leagues", Newtonsoft.Json.JsonConvert.SerializeObject(Model.Leagues))
@Html.Hidden("inp-events", Newtonsoft.Json.JsonConvert.SerializeObject(Model.Events))
@Html.Hidden("inp-bettypes", Newtonsoft.Json.JsonConvert.SerializeObject(Model.BetTypes))
@Html.Hidden("inp-currencies", Newtonsoft.Json.JsonConvert.SerializeObject(Model.Currencies))
@Html.Hidden("inp-sports", Newtonsoft.Json.JsonConvert.SerializeObject(Model.Sports))
@Html.Hidden("inp-isMY", Model.IsMY)
@Html.Hidden("inp-reportGuide", Model.ReportGuide)
<script>
    $(document).ready(function () {
        $('.tabs li a').on('click', function (e) {
            e.preventDefault();
            var $this = $(this);
            var tabId = $this.attr('href').replace('#', '');
            var url = $this.data('url');

            // Remove active class from all tabs
            $('.tabs li').removeClass("active");

            // Add active class to the clicked tab
            $this.parent().addClass("active");

            // Rest of your code for showing/hiding content
            $('#tab-frames >div').hide().removeClass("active");
            $('#' + tabId + '-container').addClass("active").show();
            $('#' + tabId + '-iframe').attr('src', url).show();
        });

        $("#match-win-loss-report-note").on("click", function ( e ) {
            e.preventDefault();
            const isMY = $("#inp-isMY").val().toLowerCase() === "true";
            const DefaultReportGuide = [
                "Data is up to 3 months.",
                "To view the performance of <b>SABA Ice Hockey, SABA Kabaddi, SABA Cricket,</b> you can select <b>SABA Other Sports.</b>",
                "Parlay tickets can be searched by date and bet types.",
                "Outright tickets can be searched by date, leagues, and bet types."
            ];
            const MYReportGuide = [
                "The figures have been converted to the base currency using the exchange rate of each day by the OANDA Exchange Service.",
                "The currency HKK uses the standard code MYR instead of HKD.",
            ]
            
            const guide = isMY ? [...DefaultReportGuide,...MYReportGuide].join("<br/>") : DefaultReportGuide.join("<br/>");
            Fanex.ExtAcc.Form.Alert("Note", guide, 480, isMY ? 240 : 190, "alertWLD");
        });
    });
    
    function resolveClientUrl(relativeUrl) {
        return '@Url.Content("~/")' + relativeUrl;
    }
</script>
@StaticResources.RenderScripts("~/assets/bundles/matchwinlossreports/match-winloss-reports")