@using GlobalViewLang = Fanex.ExternalAccount.Utilities.ViewLang
@using Fanex.ExternalAccount.HeadlineBonus.Resources
@{
    Layout = null;
}
@model Fanex.ExternalAccount.HeadlineBonus.ViewModels.BonusDetailViewModel
<div class="bonus-detail-container">
    <div class="page-title">
        <div class="wlDetail">@ViewLang.BonusDetail</div>
        <span class="icon-filter active" id="span-iconFilter"></span>
    </div>
    @using (Html.BeginForm("Search", "BonusDetail", FormMethod.Get, new { @class = "search-form filterbox filter-winloss-detail", id = "form-bonusDetail" }))
    {
        <div class="form-group">
            <div class="label">@GlobalViewLang.Member</div>
            <input type="text" maxlength="50" autocomplete="off" name="member" />
        </div>
        <div class="form-group from-to-date">
            <input type="hidden" id="MinDate" value="@(new DateTime(2021, 1, 1))" />
            <input type="hidden" id="MaxDate" value="@DateTime.Today" />
            <div class="label">@GlobalViewLang.Date</div>
            <div id="userGroup" class="user-group pull-left">
                <select id="DateList">
                    <option id="0">Today</option>
                    <option id="1">Yesterday</option>
                    <option id="2">Current Week</option>
                    <option id="3">Last Week</option>
                    <option id="4">Current Month</option>
                    <option id="5">Last Month</option>
                    <option id="6" selected="selected">Since Last Month</option>
                    <option id="7">Date Range</option>
                </select>
            </div>
        </div>
        <div class="form-group from-to-date">
            <div class="label">@ViewLang.CreatedFrom</div>
            <input type="text" readonly="readonly" id="dtpFromDate" name="fromDate" />
        </div>
        <div class="form-group from-to-date">
            <div class="label">@GlobalViewLang.To</div>
            <input type="text" readonly="readonly" id="dtpToDate" name="toDate" />
        </div>
        <div class="form-group">
            <div class="label">@ViewLang.BonusStatus</div>
            <div class="select-box pull-left">
                @Html.DropDownList("statusId", Model.BonusStatus, new { id = "ddl-bonusStatus" })
            </div>
        </div>
        <div class="form-group">
            <div class="label">@ViewLang.MemberFeedback</div>
            <div class="select-box pull-left">
                @Html.DropDownList("isComplained", Model.MemberFeedback, new { id = "ddl-memberFeedback" })
            </div>
        </div>
        <div class="form-group">
            <button type="submit" class="btn -submit btnSearch">@GlobalViewLang.Submit</button>
        </div>
        <div class="form-group view-history-box">@Model.Note</div>
        if (Model.HasHostPermission)
        {
            <div class="form-group view-history-box">
                <button type="button" class="btn -submit btnSearch" id="btn-addNewBonus">@ViewLang.AddNewBonus</button>
            </div>
        }
    }
    @Html.AntiForgeryToken()
    <div class="freegrid-container hide margin-top-10" id="freegrid-container">
        <div class="freegrid" id="jqgrid"></div>
    </div>
    <div id="msgNoinfo">@GlobalViewLang.NoData</div>
</div>
@if (Model.HasHostPermission)
{
    <div class="hide" id="div-popupAddNewBonus">
        <div id="div-msgAddNewBonus" class="hide"></div>
        @using (Html.BeginForm("AddNew", "BonusDetail", FormMethod.Post, new { @class = "form-add", id = "form-addNewBonus", style = "padding-top: 0" }))
        {
            <div class="group">
                <label class="label">@ViewLang.AddNewBonusMemberUsername</label>
                <textarea class="textarea" style="width: 100%" maxlength="4000" id="txt-MemberUsernames" name="usernames"></textarea>
            </div>
            <div class="group">
                <label class="label">@GlobalViewLang.Amount</label>
                <input type="text" class="form-control width-150" autocomplete="off" maxlength="10" id="txt-amount" name="amount" />
            </div>
        }
    </div>
}
@StaticResources.RenderScripts("~/assets/bundles/bonusdetail/index")
@Html.Raw(Fanex.Logging.LogManager.RenderJavascriptLogger())
