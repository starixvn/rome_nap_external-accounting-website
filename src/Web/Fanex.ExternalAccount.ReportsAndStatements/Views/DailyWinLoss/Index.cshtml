@using Fanex.ExternalAccount.ReportsAndStatements.Utilities
@{
    ViewData["Title"] = "Daily WinLoss";
}

<div>
    <div class="page-title">
        <div class="wlDetail">
            Daily Win Loss
        </div>
        <div class="groupBack hide">
            <div class="level-line"></div>
            <div id="tabSuper">
                Super
            </div>
            <div id="tabMaster">
                Master
            </div>
            <div id="tabAgent">
                Agent
            </div>
        </div>
        <span class="icon-filter active"></span>
    </div>
    <div class="search-form filterbox filter-winloss-detail">
        <div class="searchBar">
            <div class="form-group">
                <label class="label">Username</label>
                <input class="" type="text" maxlength="50" autocomplete="off" name="txtUserName" id="txtUserName" />
            </div>
            <div class="form-group">
                <label class="label">Date</label>
                <div class="user-group pull-left">
                    <input id="dtpWinLossDate" type="text" readonly="readonly" />
                    <input id="BalanceUpDay" type="hidden" value="@Fanex.ExternalAccount.ReportsAndStatements.Services.Reports.ReportService.BalanceUpDate.ToString("MM/dd/yyyy")" />
                </div>
            </div>
            <div class="form-group">
                <input type="button" value="Submit" id='Submit' class="btn -submit btnSearch" />
            </div>
            <div class="form-group">
                <span id="exporttoexcel" title="Export Excel" class="icon-excel hide"></span>
            </div>
        </div>
        @if (ViewBag.WillShowMessage != null && ViewBag.WillShowMessage)
        {
            <div class="searchBar">
                <span>The report data do not include tickets of IBCBet Live Casino</span>
            </div>
        }
    </div>
    <div id="mainGrid" class="hide">
        <div id="jqgrid" class="removeRadius freegrid content-grid"></div>
    </div>
    <div id='msgNoinfo'>
        There is no data.
    </div>
    <form id="antiForgeryForm" asp-anti-forgery="true"></form>
</div>

@section Scripts {
    <script src="~/js/daily-winloss.js" asp-append-version="true"></script>
}
