@using Fanex.ExternalAccount.ReportsAndStatements.Utilities
@{
    ViewData["Title"] = "Win Loss Detail";
    Layout = null;
}

<style type="text/css">
    .view-xtra-pt {
        color: #2489ce;
        cursor: pointer;
    }

    #filterBoxWLD .monPickrWrap, #filterBoxWLD .selectedDayWrap {
        z-index: 1 !important;
    }
</style>
<div>
    <div class="page-title">
        <div class="wlDetail">
            Win Loss Detail
        </div>
        <div class="groupBack hide">
            <div id="levelLine" class="level-line"></div>
            <div id="tabSuper">
                Super
            </div>
            <div id="tabMaster">
                Master
            </div>
            <div id="tabAgent">
                Agent
            </div>
            <div id="tabMember">
                Member
            </div>
        </div>
        <span class="icon-filter active"></span>
    </div>
    <div id="filterBoxWLD" class="search-form filterbox filter-winloss-detail">
        <div class="form-group from-to-date">
            <input type="hidden" id="MinDate" value="@DateTime.Now.AddMonths(-3).AddDays((-DateTime.Now.Day) + 1).ToString("MM/dd/yyyy")" />
            <input type="hidden" id="MaxDate" value="@DateTime.Now.ToString("MM/dd/yyyy")" />
            <div class="label">Date</div>
            <div id="userGroup" class="user-group pull-left">
                <select name="DateList" id="DateList">
                    <option id="0" selected="selected">Today</option>
                    <option id="1">Yesterday</option>
                    <option id="2">Current Week</option>
                    <option id="3">Last Week</option>
                    <option id="4">Current Month</option>
                    <option id="5">Last Month</option>
                    <option id="6">Since Last Month</option>
                    <option id="7">Date Range</option>
                </select>
            </div>
        </div>
        <div class="form-group from-to-date">
            <div class="label">From</div>
            <input id="dtpFromDate" type="text" readonly="readonly" />
        </div>
        <div class="form-group from-to-date">
            <div class="label to-width">To</div>
            <input id="dtpToDate" type="text" readonly="readonly" />
        </div>
        <div class="form-group group-month-day" style="display: none">
            <div class="label">Month</div>
            <div class="user-group pull-left dll-month">
                <div id="monPickr1">
                </div>
            </div>
        </div>
        <div class="form-group group-month-day" style="display: none">
            <div class="label">From</div>
            <div class="user-group pull-left">
                <div id="fromDay1">
                </div>
            </div>
        </div>
        <div class="form-group group-month-day" style="display: none">
            <div class="label to-width">To</div>
            <div class="user-group pull-left">
                <div id="toDay1">
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="label">Username</label>
            <input type="text" maxlength="50" autocomplete="off" name="txtUserName" id="txtUserName" />
        </div>
        <div class="form-group">
            <label class="label">Product</label>
            <div id="productGroup" class="user-group pull-left">
                <select name="productList" id="productList">
                    <option value="">All</option>
                </select>
            </div>
        </div>
        <div class="form-group">
            <input type="button" value="Submit" id="Submit" class="btn -submit btnSearch" />
        </div>
        <div class="form-group">
            <span id="exporttoexcel" title="Export Excel" class="icon-excel hide"></span>
        </div>
    </div>
    <div id="mainGrid" class="hide">
        <div id="jqgrid" class="removeRadius freegrid content-grid"></div>
    </div>
    <div id='msgNoinfo'>
        There is no data.
    </div>
    <form id="antiForgeryForm" asp-anti-forgery="true"></form>
</div>

@section Scripts {
    <script src="~/js/win-loss-detail.js" asp-append-version="true"></script>
}
