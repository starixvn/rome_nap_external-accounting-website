<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0"
         xmlns="http://schemas.microsoft.com/developer/msbuild/2003"
         DefaultTargets="MyTargets"
         InitialTargets="MyTargets">
  <UsingTask AssemblyFile="..\tools\WebCompiler\WebCompiler.exe" TaskName="WebCompiler.CompilerBuildTask"/>
  <UsingTask AssemblyFile="..\tools\WebCompiler\WebCompiler.exe" TaskName="WebCompiler.CompilerCleanTask"/>

  <Target Name="MyTargets">
    <WebCompiler.CompilerCleanTask FileName="$(MSBuildProjectDirectory)\..\Fanex.ExternalAccount\compilerconfig.json" />
    <WebCompiler.CompilerBuildTask FileName="$(MSBuildProjectDirectory)\..\Fanex.ExternalAccount\compilerconfig.json" />
  </Target>
  
</Project>
