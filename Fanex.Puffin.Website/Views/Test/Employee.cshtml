 @model Fanex.Puffin.Website.Model.Test.IssueDTO
@{
    Layout = "";
    var count = 0;  
    }

<style type="text/css">

.StampBox
{
display:block;
border: 1px solid;
padding:2px 10px 2px 10px;
margin:10px 0px;
height:100px;
width:250px;
float:right;
display:inline;
}
table tr td
{

    border:1px solid #000;
    padding:4px;
}
table tr:last-child td
{
    border:none;
}
table table
{
    width:100%;

}
table table td.BOXSTamp
{
    width:350px;
    border:1px solid black;
    background-color: #90ee90;
}
</style>
<table cellspacing=0 cellpadding=0 width="900px"@* class="tblcontents"*@>
<tr>
<td colspan="3"  align="center" ><b>Issue Voucher</b></td>
</tr>
<tr>
<td colspan="3"> 
    <table>
        <td>Date:@DateTime.Now.ToShortDateString()</td>
        <td width="400px" align="left">Issue Voucher Number:<b>01</b><br />
        Issued To: Nexcel Solutions
        </td>
    </table>
 </td>
</tr>
        <tr>
        <td><strong>SN</strong></td>
        <td><strong>Description</strong></td>
        <td><strong>Quantity</strong></td>
        </tr>


@foreach (var item in Model.Details)
{
    <tr>
        <td valign="top" width="30px">@{count++;}@count</td>
        <td>
        Commodity:
         @Html.DisplayFor(modelItem => item.ItemName)


        <br />
            Units:
            @Html.DisplayFor(modelitem=>item.UnitName)

            <br />
            Lot:
             @Html.DisplayFor(modelitem=>item.LotNo)

            <br />
            Exp. Date(M/D?Y):
             @Html.DisplayFor(modelitem=>item.EditionNoExpDate)

        </td>

    <td width="100px" valign="top">    

    @Html.DisplayFor(modelitem=>item.Quantity)
    </td>
    </tr>
}
<tr style="border:none;">
    <td colspan="3" style="border:none; padding:10px 0 0 0;">
    <table>
    <tr>
        <td><p>
Received By:
</p><p>
Signature:       <img src="http://www.nasa.gov/images/content/711375main_grail20121205_4x3_946-710.jpg" width="100px" height="100px">
</p><p>
Name: ____________________________
</p><p>
Received Date:_______________________
</p></td>
        <td class="BOXSTamp" valign="bottom" align="center">
        <span style="rgba(0,0,0,0.1);">
        Office Stamp
        </span>
         </td>
    </tr>
    </table>
    </td>
</tr>
</table>