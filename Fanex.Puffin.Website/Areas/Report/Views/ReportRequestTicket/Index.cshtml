@using Fanex.Puffin.Core.Web;
@using Fanex.Puffin.Core.Services.Impl;
@using Fanex.Puffin.Report.Criteria.LicenseeSettlement;
@using Fanex.Puffin.Core.Extensions
@using Fanex.Puffin.Core.Web
@using Resource;
@using Fanex.Puffin.Core.Web;
@{
    ViewBag.Title = AppSession.CurrentWorkingOnMenu != null ? AppSession.CurrentWorkingOnMenu.Name : string.Empty;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {
    <link rel="stylesheet" type="text/css" href="~/Scripts/_Libs/DatePicker/jquery.nexDatePicker.css" />
    <link rel="stylesheet" type="text/css" href="~/Scripts/_Libs/Tooltip/tipsy.css" />
    <link rel="stylesheet" type="text/css" href="~/Areas/Report/Views/ReportRequestTicket/Styles/RequestTicketReport.less" />
}
@section Headline {
    <div class="title">
        <div>
            <span>@Labels.Report / </span><span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}
<div id="filter-bar">
    <div class="filter-form">
        <div class="filter-row">
            <div class="filter-cell">
                @* <div class="lbl-field col_3 align-right">
                    @Labels.Status
                </div>
                <div class="edit-field col_6 align-left">
                    <select id="ddlStatusOfReport" class="alpha">                      
                    </select>
                </div>*@
                <div class="submit width-auto col_12">
                    <input id="btnGenerate" name="btnGenerate" type="submit" value="@Labels.Generate" class="col_4 alpha display-none" />
                    <input id="btnAddNew" name="btnAddNew" type="submit" value="@Labels.Add_New" class="col_4 alpha" />
                    <input id="btnViewLog" name="btnViewLog" type="submit" value="@Labels.View_Log" class="col_4 omega display-none" />
                </div>
            </div>
        </div>
        <div class="filter-row">
            <div class="filter-cell">
                <div id="ErrMsg" class="col_35 display-none width-auto">
                </div>
            </div>
        </div>
    </div>
</div>
<div class="content">
    <div id="parentContainer" class="content-grid">
        @Html.Partial("~/Areas/Report/Views/ReportRequestTicket/RequestTicketReport.cshtml")
        @Html.Partial("~/Areas/Report/Views/ReportRequestTicket/AddNewRequestTicket.cshtml")
        @Html.Partial("~/Areas/Report/Views/ReportRequestTicket/EditRequestTicket.cshtml")
    </div>
</div>
@section scripts
{
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
        var toDay = '@string.Format("{0:MM/dd/yyyy}", DateTime.Now)';
        var minDate = '@string.Format("{0:MM/dd/yyyy}", new DateTime(2006, 01, 01))';
        var maxDate = '@string.Format("{0:MM/dd/yyyy}", DateTime.Now)';
        var requestor = '@AppSession.CurrentUser.Username';
        var hasHostPermission = '@(PermissionService.HasHostPermission(TicketControlFunctionKeys.ReportRequestTicket) ? "true" : "false")';
    </script>
}
@section Foot {
    <script type="text/javascript" src="~/Scripts/_Libs/Tooltip/jquery.tipsy.js"></script>
    <script type="text/javascript" src="~/Scripts/_Libs/FormatLibs/DateTimeFormat/moment.js"></script>
    <script type="text/javascript" src="~/Scripts/_Libs/DatePicker/jquery.nexDatePicker.js"></script>
    <script type="text/javascript" src="~/Scripts/_Libs/Utils/jquery.fixBugsBrowser.js"></script>
    <script type="text/javascript" src="~/Scripts/NapTicketControl.js"></script>
    <script type="text/javascript" src="~/Areas/Report/Views/ReportRequestTicket/Scripts/ReportManger.js"></script>
}
