  <ONEbook.UM ServiceUris="http://msite.starixuat.com/v5/api" EnableCheckUM="false" EnableUnscheduledUM="false" UMFrom="03:00" UMTo="04:00" SiteId="2000" UMPageUrl="~/Shared/Offline">
