<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
        <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
    <section name="ONEbook.UM" type="ONEbook.UM.Configurations.UMClientConfiguration, ONEbook.UM" /><section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data" /></configSections>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="NPOI" publicKeyToken="0df73ec7942b34e1" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-2.0.6.0" newVersion="2.0.6.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
<Fanex.Logging msmqPath="FormatName:DIRECT=tcp:[IP]\private$\entlib" defaultCategory="$CategoryValue" /><ONEbook.UM ServiceUris="http://10.18.200.124:8889/api" EnableCheckUM="false" EnableUnscheduledUM="false" UMFrom="03:00" UMTo="04:00" SiteId="2000" UMPageUrl="~/UserLogin/Common/Offline"> 
    <AllowedIPs AllowAll="true">
      <add Value="10.19.10.54" /> <!--Exact IP-->
      <add From="10.19.10.100" To="10.19.10.200" /> <!--IP Range-->
    </AllowedIPs>
  </ONEbook.UM><Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
        <providers>
            <add name="XmlDbSettingProvider" type="Fanex.Data.Configuration.XmlDbSettingProvider, Fanex.Data" resourcePath="$resourcePath_Value" enableWatching="1" />
        </providers>
    </Fanex.Data.DbSettingProvider></configuration>