<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
        <section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data" />
    <section name="ONEbook.UM.ThirdParty" type="ONEbook.UM.ThirdParty.Configurations.UMClientConfiguration, ONEbook.UM.ThirdParty" /><section name="Fanex.MailDelivery.Client" type="Fanex.MailDelivery.Client.Configurations.MailClientSection, Fanex.MailDelivery.Client" /></configSections>
  <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
        <providers>
            <add name="XmlDbSettingProvider" type="Fanex.Data.Configuration.XmlDbSettingProvider, Fanex.Data" resourcePath="$resourcePath_Value" enableWatching="1" />
        </providers>
    </Fanex.Data.DbSettingProvider>
<ONEbook.UM.ThirdParty ServiceUris="http://10.18.200.124:8887/api" EnableCheckUM="true" EnableUnscheduledUM="false" UMFrom="03:00" UMTo="04:00" UMPageUrl="~/UserLogin/Common/Offline"> 
    <Products>
      <add Id="23" IsUM="false" UMFrom="00:00" UMTo="01:00" /> <!--For manual control on site each product -->
    </Products>
  </ONEbook.UM.ThirdParty><Fanex.MailDelivery.Client environment="local" applicationSendMailId="1" siteId="1" rabbitMQConnectionString="host=10.18.200.209,10.18.200.202;virtualHost=/philliphost;username=rabbitclient" messageBrokerLogCategory="MailCentralized">
        <Functions>
          <!--<add id="1" name="YourFunction" />-->
        </Functions>
        <Schedules>
          <!--<Schedule id="2" name="YourSchedule" job="YourProject.Namespace.Job, YourProject">-->
        </Schedules>
    </Fanex.MailDelivery.Client>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Mvc" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-5.2.6.0" newVersion="5.2.6.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-10.0.0.0" newVersion="10.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.WebPages" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="NPOI" publicKeyToken="0df73ec7942b34e1" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-2.0.6.0" newVersion="2.0.6.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Net.Http" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.1.1.2" newVersion="4.1.1.2" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Threading.Tasks.Extensions" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.1.0.0" newVersion="4.1.0.0" />
