/// <reference path="../_references.js" />
if (typeof Fanex == 'undefined' || typeof Fanex.ExtAcc == 'undefined') {
    alert("Fanex.ExtAcc.js module is required!")
}

Fanex.ExtAcc.Customer = {
    DataFields: null,
    DataSource: null,

    superId: 0,
    masterId: 0,
    agentId: 0,

    Super: 1,
    Master: 2,
    Agent: 3,
    Member: 4,

    CurrentLevel: 1,

    AllowDoubleCommMaster: false,
    AllowDoubleCommAgent: false,
    AllowDoubleComm: false,

    BlockedUI: false,

    URL: '',

    $this: null,

    Init: function () {
        $this = this;

        //Prevent loading group name
        var timeout = setInterval(function () {
            if ($.trim($('#selectedGroupName').html()) != '') {
                $this.Search(true);
                clearInterval(timeout);
            }
        }, 100);

        $('#txtUserName').keypress(function (e) {
            if (typeof e == 'undefined') e = window.event;
            var key = (typeof e.keyCode == 'undefined') ? e.which : e.keyCode;
            if (key == 13) {
                $this.Search(false);

                return true;
            } else {
                return true;
            }
        });

        $('#txtUserName').keyup(function (e) {
            if ($('#txtUserName').val().length > 1) {
                Fanex.ExtAcc.InitSuggestion();
            }
        });
    },

    Search: function (isFirstLoad) {
        if (isFirstLoad) {
            this.GetSuperList();
        }
        else {
            this.SearchList();
        }
    },
    ShowEditInfoSuper: function (custId, title) {
        Fanex.ExtAcc.Customer.UserId = custId;
        Fanex.ExtAcc.Customer.TitleEditInfo = title;

        $.contextMenu({
            selector: '.editInfo',
            items: {
                editInfo: { name: "Edit Info", height: 25, className: "iconEnableEdit", callback: function (key, opt) { Fanex.ExtAcc.Form.Show(resolveClientUrl('Customer/EditInfo/?custId=' + Fanex.ExtAcc.Customer.UserId), Fanex.ExtAcc.Customer.TitleEditInfo, 750, 265, false); } },
                changePassword: { name: "Reset Password", className: "iconEnableEdit" }
            },
            trigger: "left",
            ignoreRightClick: true,
            autoHide: true
        });
    },
    ShowEditInfoMasterAgent: function (custId, title) {
        Fanex.ExtAcc.Customer.UserId = custId;
        Fanex.ExtAcc.Customer.TitleEditInfo = title;

        $.contextMenu({
            selector: '.editInfoMasterAgent',
            items: {
                sportbook: { name: "Sportbook", className: "iconEnableEdit" },
                minPT: { name: "Min PT", className: "iconEnableEdit" },
                betSetting: { name: "Bet Setting", className: "iconEnableEdit" },
                commission: { name: "Commission", className: "iconEnableEdit" },
                separator: "-----",
                racing: { name: "Racing", className: "iconEnableEdit" },
                separator1: "-----",
                casino: { name: "Casino", className: "iconEnableEdit" },
                poker: { name: "Poker", className: "iconEnableEdit" },
                virtualSport: { name: "Virtual Sport", className: "iconEnableEdit" },
                separator2: "-----",
                editInfo: { name: "Edit Info", className: "iconEnableEdit", callback: function (key, opt) { Fanex.ExtAcc.Form.Show(resolveClientUrl('Customer/EditInfo/?custId=' + Fanex.ExtAcc.Customer.UserId), Fanex.ExtAcc.Customer.TitleEditInfo, 750, 265, false); } },
                changePassword: { name: "Reset Password", className: "iconEnableEdit" }
            },
            trigger: "left",
            ignoreRightClick: true,
            autoHide: true
        });
    },
    ShowEditInfoMember: function (custId, title) {
        Fanex.ExtAcc.Customer.UserId = custId;
        Fanex.ExtAcc.Customer.TitleEditInfo = title;

        $.contextMenu({
            selector: '.editInfoMember',
            items: {
                sportbook: { name: "Sportbook", className: "iconEnableEdit" },
                betSetting: { name: "Bet Setting", className: "iconEnableEdit" },
                commission: { name: "Commission", className: "iconEnableEdit" },
                separator: "-----",
                racing: { name: "Racing", className: "iconEnableEdit" },
                separator1: "-----",
                casino: { name: "Casino", className: "iconEnableEdit" },
                poker: { name: "Poker", className: "iconEnableEdit" },
                separator2: "-----",
                editInfo: { name: "Edit Info", className: "iconEnableEdit", callback: function (key, opt) { Fanex.ExtAcc.Form.Show(resolveClientUrl('Customer/EditInfo/?custId=' + Fanex.ExtAcc.Customer.UserId), Fanex.ExtAcc.Customer.TitleEditInfo, 750, 265, false); } },
                changePassword: { name: "Reset Password", className: "iconEnableEdit" }
            },
            trigger: "left",
            ignoreRightClick: true,
            autoHide: true
        });
    },
    EditInfo: function () {
        var firstName = $('#FirstName').val();
        var lastName = $('#LastName').val();
        var homePhone = $('#HomePhone').val();
        var mobilePhone = $('#MobilePhone').val();
        var email = $('#Email').val();
        var fax = $('#Fax').val();

        var editUrl = 'Customer/EditInfoPost/?';
        var params = 'custId=' + $('#CustId').val();

        params += '&firstName=' + firstName;
        params += '&lastName=' + lastName;
        params += '&homePhone=' + homePhone;
        params += '&mobilePhone=' + mobilePhone;
        params += '&email=' + email;
        params += '&fax=' + fax;

        $.ajax({ url: resolveClientUrl(editUrl + params), type: 'POST' })
        .done(function (data) {
            if (!data.IsSuccess) {
                $('#errMsg').css('display', 'block');
                $('#errMsg').html(data.ErrorMessage);
            }
            else {
                
                var timeout = setTimeout(function () {
                    clearTimeout(timeout);

                    if ($this.CurrentLevel == $this.Super) {
                        $this.GetSuperList();
                    }
                    else if ($this.CurrentLevel == $this.Master) {
                        Fanex.ExtAcc.Customer.GetMasterList($this.superId, $this.AllowDoubleComm);
                    }
                    else if ($this.CurrentLevel == $this.Agent) {
                        Fanex.ExtAcc.Customer.GetAgentList($this.masterId, $this.AllowDoubleComm);
                    }
                    else {
                        Fanex.ExtAcc.Customer.GetMemberList($this.agentId, $this.AllowDoubleComm);
                    }
                }, 3000);

                Fanex.ExtAcc.Form.Close(false, 4000);
            }

        })
        .error(function (data) {
            if (typeof console != 'undefined') console.log(data.responseText);
        });
    },
    GetSuperList: function (custId, dataSource) {
        $this.BlockUI();

        $this.CurrentLevel = $this.Super;
        $this.AllowDoubleComm = true;

        var url = resolveClientUrl('Customer/SuperListPost');
        var enabled = false;
        var closed = false;
        var suspended = false;

        if ($('#customerStatus').val() == '-1') {
            enabled = null;
            closed = null;
            suspended = null;
        }
        else if ($('#customerStatus').val() == '1') {
            enabled = true;
            closed = false;
            suspended = false;
        }
        else if ($('#customerStatus').val() == '2') {
            enabled = false;
            closed = true;
            suspended = null;
        }
        else if ($('#customerStatus').val() == '3') {
            enabled = null;
            closed = null;
            suspended = true;
        }
        else {
            enabled = false;
            closed = null;
            suspended = null;
        }

        var data = {
            groupName: $('#selectedGroupName').html().trim() == '' ? 'ACCDDD' : $('#selectedGroupName').html(),
            enabled: enabled,
            closed: closed,
            suspended: suspended,
            username: $('#txtUserName').val()
        };

        $this.DataFields = [
                    { HeaderText: 'No.', Name: 'RowNumber', Width: 30, CellAlign: 'center' },
                    { HeaderText: '', Name: 'Check', Width: 30, CellAlign: 'center',
                        CustomHeaderRender: function (cell) {
                            return '<div class="editMult"></div>';
                        },
                        CustomCellRender: function (cell) {
                            return '<div onclick="Fanex.ExtAcc.Customer.Select(this)" style="margin-left: 0px !important" id="' + cell.Value.custid + '" class="menuInactive"></div>';
                        }
                    },
                    { HeaderText: 'Username', Name: 'username', Width: 120,
                        CustomCellRender: function (cell) {
                            var custId = cell.Value.custid;
                            var func = "javascript:Fanex.ExtAcc.Customer.GetMasterList(" + custId + ", " + cell.Value.DoubleCommLosing + ")";

                            return '<div><a id="usr-' + custId + '" href="' + func + '">' + cell.Value.username + '</a></div>';
                        }
                    },
                    { HeaderText: 'Edit', Name: 'Edit', Width: 30,
                        CustomCellRender: function (cell) {
<<<<<<< HEAD
