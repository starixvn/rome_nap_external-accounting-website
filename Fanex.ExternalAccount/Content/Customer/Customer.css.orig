.enabled
{
	background-image: url(../../Images/Content/icon-customerlist.png);
	background-repeat: no-repeat;
	background-position: -5px -43px;
	width: 16px;
	height: 16px !important;
	border: none;
	cursor: pointer !important;
}
.disabled
{
	background-image: url(../../Images/Content/icon-customerlist.png);
	background-repeat: no-repeat;
	background-position: -36px -43px;
	width: 16px;
	height: 16px !important;
	border: none;
	cursor: pointer !important;
}
.unsynced
{
	background-image: url(../../Images/Content/icon-customerlist.png);
	background-repeat: no-repeat;
	background-position: -20px -43px;
	width: 16px;
	height: 16px !important;
	border: none;
	cursor: pointer !important;
}
.editMult
{
	background-image: url(../../Images/Content/icon-customerlist.png);
	background-repeat: no-repeat;
	background-position: -23px -20px;
	width: 16px;
	height: 16px !important;
	border: none;
	cursor: pointer !important;
}

.editInfo, .editInfoMasterAgent, .editInfoMember
{
	background-image: url(../../Images/Content/icon-customerlist.png);
	background-repeat: no-repeat;
	background-position: -5px -20px;
	width: 16px;
	height: 16px !important;
	border: none;
	margin-left: 8px !important;
	cursor: pointer !important;
}

.allowDblComm
{
	background-image: url(../../Images/Content/on-off.png);
	background-repeat: no-repeat;
	background-position: -12px -11px;
	width: 80px;
	height: 16px !important;
	border: none;
	margin-left: 10px !important;
	cursor: pointer !important;
}

.disallowDblComm
{
	background-image: url(../../Images/Content/on-off.png);
	background-repeat: no-repeat;
	background-position: -100px -11px;
	width: 80px;
	height: 16px !important;
	border: none;
	margin-left: 10px !important;
	cursor: pointer !important;
}

.onDblComm
{
	background-image: url(../../Images/Content/on-off.png);
	background-repeat: no-repeat;
	background-position: -12px -36px;
	width: 60px;
	height: 16px !important;
	border: none;
	margin-left: 22px !important;
	cursor: pointer !important;
}

.offDblComm
{
	background-image: url(../../Images/Content/on-off.png);
	background-repeat: no-repeat;
	background-position: -100px -36px;
	width: 60px;
	height: 16px !important;
	border: none;
	margin-left: 22px !important;
	cursor: pointer !important;
}

#breadcrumbs
{
	font-weight: bold;
	float: left;
	margin-right: 10px;
	margin-top: 5px;
}

.viewNext
{
	float: left;
	background: url("../../Images/arrow-icn.png") no-repeat center transparent !important;
	width: 20px;
}

tr.rowClosed td
{
	background-color: #efefef !important;
}

tr.rowSuspended td
{
	background-color: #f8ded7 !important;
}

tr.rowDisabled td
{
	background-color: #a0a97a !important;
}

.iconEnableEdit
{
	background-image: url(../../Images/Content/enableEdit.jpg);
	background-repeat: no-repeat;
	height: 16px;
	font-size: 12px;
}
.headerTransferCondition
{
	background-color: #D4E3EB;
	font-weight: bold;
	text-align: center;
}

tr.rowTransferCondition
{
	 border: 1px solid #C5C5C5;
	 height: 30px;
}