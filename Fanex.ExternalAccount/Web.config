<configuration>
  <configSections>
    <section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data"/>
    <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging"/>
  </configSections>
  <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
    <providers>
      <add name="XmlDbSettingProvider" type="Fanex.Data.Configuration.XmlDbSettingProvider, Fanex.Data" resourcePath="~/SpNames.xml" enableWatching="1"/>
    </providers>
  </Fanex.Data.DbSettingProvider>
  <Fanex.Logging msmqPath="FormatName:DIRECT=TCP:10.18.200.201\private$\entlib" defaultCategory="ExternalAccount"/>
  <connectionStrings>
    <clear/>
    <add name="login" connectionString="packet size=4096; Data Source=10.18.200.206;Initial Catalog=bodb02;integrated security=false; user id=bodbExtAccNet; password=vYhXhbKA6zC1WQWpIuYv+mkQuVzTh/dP=" providerName="System.Data.SqlClient"/>
    <add name="checkin" connectionString="packet size=4096; Data Source=10.18.200.215;Initial Catalog=bodb_EAS;integrated security=false; user id=bodbExtAccNet; password=vYhXhbKA6zC1WQWpIuYv+mkQuVzTh/dP=" providerName="System.Data.SqlClient"/>
    <add name="main" connectionString="packet size=4096; Data Source=10.18.200.206;Initial Catalog=bodb02;integrated security=false; user id=bodbExtAccNet; password=vYhXhbKA6zC1WQWpIuYv+mkQuVzTh/dP=" providerName="System.Data.SqlClient"/>
    <add name="archive" connectionString="packet size=4096; Data Source=10.18.200.215;Initial Catalog=bodb02;Connect Timeout=600;integrated security=false; user id=bodbExtAccNet; password=vYhXhbKA6zC1WQWpIuYv+mkQuVzTh/dP=" providerName="System.Data.SqlClient"/>
    <!--<add name="archive" connectionString="packet size=4096; Data Source=10.18.200.215;Initial Catalog=bodb02;Connect Timeout=600;integrated security=false; user id=bodbAdminnet; password=i9hNnaZltx04XF6oTNOKTnvvtLC/zfxr=" providerName="System.Data.SqlClient"/>-->
    <!--<add name="archive" connectionString="packet size=4096; Data Source=10.18.200.215;Initial Catalog=bodb02;Connect Timeout=600;integrated security=false; user id=bodbDownlineNet; password=TBAw8F+PqCx3u382anlnOVRxKIJYMsMwXVn1hJpeyKk==" providerName="System.Data.SqlClient"/>-->
  </connectionStrings>
  <system.web>
    <customErrors mode="Off"/>
    <httpRuntime executionTimeout="600" maxRequestLength="2000000000" maxUrlLength="200" maxQueryStringLength="2097151" requestValidationMode="2.0" requestPathInvalidCharacters=""/>
    <compilation debug="true" targetFramework="4.0">
      <assemblies>
        <add assembly="System.Runtime.Remoting, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089"/>
      </assemblies>
    </compilation>
    <trust level="Full"/>
    <sessionState mode="StateServer" cookieless="false"/>
    <authentication mode="Forms">
      <forms loginUrl="~/Account/Login/" defaultUrl="~/Home/Index" timeout="2880"/>
    </authentication>
    <pages>
      <namespaces>
        <add namespace="System.Web.Helpers"/>
        <add namespace="System.Web.Mvc"/>
        <add namespace="System.Web.Mvc.Ajax"/>
        <add namespace="System.Web.Mvc.Html"/>
        <add namespace="System.Web.Routing"/>
        <add namespace="System.Web.WebPages"/>
        <add namespace="System.Web.Optimization"/>
        <add namespace="Fanex.ExternalAccount.Controllers"/>
        <add namespace="Fanex.ExternalAccount.ViewModel"/>
      </namespaces>
    </pages>
    <profile defaultProvider="DefaultProfileProvider">
      <providers>
        <add name="DefaultProfileProvider" type="System.Web.Providers.DefaultProfileProvider, System.Web.Providers, Version=1.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" connectionStringName="DefaultConnection" applicationName="/"/>
      </providers>
    </profile>
    <globalization uiCulture="en-US" culture="en-US"/>
  </system.web>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false"/>
    <modules runAllManagedModulesForAllRequests="true"/>
    <urlCompression doStaticCompression="true" doDynamicCompression="true"/>
    <staticContent>
      <clientCache cacheControlMode="DisableCache" cacheControlMaxAge="30.00:00:00"/>
    </staticContent>
  </system.webServer>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Helpers" publicKeyToken="31bf3856ad364e35"/>
        <bindingRedirect oldVersion="1.0.0.0-2.0.0.0" newVersion="2.0.0.0"/>
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Mvc" publicKeyToken="31bf3856ad364e35"/>
        <bindingRedirect oldVersion="1.0.0.0-4.0.0.0" newVersion="4.0.0.0"/>
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.WebPages" publicKeyToken="31bf3856ad364e35"/>
        <bindingRedirect oldVersion="1.0.0.0-2.0.0.0" newVersion="2.0.0.0"/>
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>