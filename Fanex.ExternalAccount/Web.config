<?xml version="1.0"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  http://go.microsoft.com/fwlink/?LinkId=152368 
-->
<configuration>
  <configSections>
    <section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data"/>
    <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging"/>
    <sectionGroup name="CustomerSetting">
      <section name="Security" type="Fanex.CustomerSetting.Security.Configurations.CustomerSettingSection, Fanex.CustomerSetting.Security"/>
    </sectionGroup>
    <!--Sportsbook-->
    <section name="PTMappingSection" type="Fanex.PTEngine.XmlMapping.PTMappingSection" allowLocation="true" allowDefinition="Everywhere"/>
    <section name="BettingLimitMappingSection" type="Fanex.PTEngine.XmlMapping.BettingLimitMappingSection" allowLocation="true" allowDefinition="Everywhere"/>
    <!--/Sportsbook-->
    <!--racing pt setting-->
    <section name="PTRacingMappingSection" type="Fanex.PTRacing.XmlMapping.PTRacingMappingSection" allowLocation="true" allowDefinition="Everywhere"/>
    <section name="RacingBettingCommSettingMappingSection" type="Fanex.PTRacing.XmlMapping.RacingBettingCommSettingMappingSection" allowLocation="true" allowDefinition="Everywhere"/>
    <!--/racing pt setting-->
    <!--Bingo-->
    <section name="unity" type="Microsoft.Practices.Unity.Configuration.UnityConfigurationSection, Microsoft.Practices.Unity.Configuration, Version=2.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35"/>
    <section name="Sunplus.Bingo" type="Sunplus.Bingo.Core.Configuration.BingoConfigurationSection, Sunplus.Bingo.Core"/>
    <!--/End Bingo-->
    <!--CurrentSession-->
    <section name="CurrentSession" type="Fanex.CustomerSetting.Module.Core.Web.CurrentSessionSection, Fanex.CustomerSetting.Module.Core"/>
    <!--/CurrentSession-->
    <!--CurrentContext-->
    <section name="CurrentContext" type="Fanex.CustomerSetting.Module.Core.Web.CurrentContextSection, Fanex.CustomerSetting.Module.Core"/>
    <!--/CurrentSession-->
  </configSections>
  <!--CurrentContext-->
  <CurrentSession sessionFactory="Fanex.ExternalAccount.Core.Context.CurrentSession, Fanex.ExternalAccount.Core"/>
  <!--/CurrentContext-->
  <!--CurrentSession-->
  <CurrentContext contextFactory="Fanex.ExternalAccount.Core.Context.CurrentContext, Fanex.ExternalAccount.Core"/>
  <!--/CurrentSession-->
  <!--Security-->
  <CustomerSetting>
    <Security allowDirectDownline="false" allowGroups="222|1|65" authenticateFactory="Fanex.ExternalAccount.Core.Context.ExternalAccountAuthenticate, Fanex.ExternalAccount.Core"/>
  </CustomerSetting>
  <!--/Security-->
  <!--Fanex-->
  <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
    <providers>
      <add name="XmlDbSettingProvider" type="Fanex.Data.Configuration.XmlDbSettingProvider, Fanex.Data" resourcePath="~/SpNames.xml" enableWatching="1"/>
    </providers>
  </Fanex.Data.DbSettingProvider>
  <Fanex.Logging msmqPath="FormatName:DIRECT=TCP:10.18.200.201\private$\entlib" defaultCategory="ExternalAccount"/>
  <!--/Fanex-->
  <!--Sportsbook-->
  <PTMappingSection configSource="PTEngine\PTMappingSection.config"/>
  <BettingLimitMappingSection configSource="PTEngine\BettingLimitMappingSection.config"/>
  <!--/Sportsbook-->
  <!--racing pt setting-->
  <PTRacingMappingSection configSource="PTEngine\PTRacingMappingSection.config"/>
  <RacingBettingCommSettingMappingSection configSource="PTEngine\RacingBettingCommSettingMappingSection.config"/>
  <!--/racing pt setting-->
  <!--Bingo-->
  <Sunplus.Bingo MaxPt="0.9" MinPt="0.0" MaxCommission="0.0025" MaxBall="75">
    <BingoGame EnabledMaxTransfer="true" Enabled="true" CodeGameNo="01"/>
    <NumberGame Enabled="true" NoneLiveBettypes="81^1st ball Over/ Under,82^Last ball Over/ Under,83^1st ball Odd/ Even,84^Last ball Odd/ Even,88^FT. Warrior,86^FT. Odd/ Even" LiveBettypes="85^Next Over/ Under,86^Next Odd/ Even,87^Next Hight/ Low,89^Next Combo, 90^Number Group"/>
  </Sunplus.Bingo>
  <!--End Bingo-->
  <!--Bingo API-->
  <unity>
    <typeAliases>
      <!-- Lifetime manager types -->
      <typeAlias alias="singleton" type="Microsoft.Practices.Unity.ContainerControlledLifetimeManager, Microsoft.Practices.Unity"/>
      <typeAlias alias="external" type="Microsoft.Practices.Unity.ExternallyControlledLifetimeManager, Microsoft.Practices.Unity"/>
      <!-- Custom object types -->
      <typeAlias alias="ICustomerService" type="Sunplus.Bingo.Services.ICustomerService, Sunplus.Bingo.Services"/>
      <typeAlias alias="CustomerService" type="Sunplus.Bingo.Services.CustomerService, Sunplus.Bingo.Services"/>
      <typeAlias alias="IReportService" type="Sunplus.Bingo.Services.IReportService, Sunplus.Bingo.Services"/>
      <typeAlias alias="ReportService" type="Sunplus.Bingo.Services.ReportService, Sunplus.Bingo.Services"/>
      <typeAlias alias="ICustomerDAO" type="Sunplus.Bingo.Data.ICustomerDAO, Sunplus.Bingo.Data"/>
      <typeAlias alias="IReportDAO" type="Sunplus.Bingo.Data.IReportDAO, Sunplus.Bingo.Data"/>
      <typeAlias alias="ILogger" type="Sunplus.Core.LoggingLib.ILogger, Sunplus.Core.LoggingLib"/>
      <!--<typeAlias alias="LinqCustomerDAO" type="Sunplus.Bingo.Data.LinqToSql.LinqCustomerDAO, Sunplus.Bingo.Data.LinqToSql"/>
      <typeAlias alias="LinqReportDAO" type="Sunplus.Bingo.Data.LinqToSql.LinqReportDAO, Sunplus.Bingo.Data.LinqToSql"/>-->
      <typeAlias alias="EntLibLogger" type="Sunplus.Core.LoggingLib.EntLibLogger, Sunplus.Core.LoggingLib"/>

      <typeAlias alias="EntlibCustomerDAO" type="Sunplus.Bingo.Data.Entlib.EntlibCustomerDAO, Sunplus.Bingo.Data.Entlib"/>
      <typeAlias alias="EntlibReportDAO" type="Sunplus.Bingo.Data.Entlib.EntlibReportDAO, Sunplus.Bingo.Data.Entlib"/>
    </typeAliases>
    <containers>
      <container name="BingoContainer">
        <types>
          <type type="ICustomerService" mapTo="CustomerService"/>
          <type type="IReportService" mapTo="ReportService"/>
          <type type="ICustomerDAO" mapTo="EntlibCustomerDAO"/>
          <type type="IReportDAO" mapTo="EntlibReportDAO"/>
          <type type="ILogger" mapTo="EntLibLogger"/>
        </types>
      </container>
    </containers>
  </unity>
  <connectionStrings configSource="Configurations\connectionStrings.config" />    
  <appSettings configSource="Configurations\appSettings.config" />
  <system.web>
    <customErrors mode="Off"/>
    <httpRuntime executionTimeout="600" maxRequestLength="2000000000" maxUrlLength="200" maxQueryStringLength="2097151" requestValidationMode="2.0" requestPathInvalidCharacters=""/>
    <compilation debug="true" targetFramework="4.0">
      <assemblies>
        <add assembly="System.Runtime.Remoting, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089"/>
      </assemblies>
    </compilation>
    <trust level="Full"/>
    <sessionState mode="StateServer" cookieless="false"/>
    <authentication mode="Forms">
      <forms loginUrl="~/Account/Login/" defaultUrl="~/Home/Index" timeout="2880"/>
    </authentication>
    <pages>
      <namespaces>
        <add namespace="System.Web.Helpers"/>
        <add namespace="System.Web.Mvc"/>
        <add namespace="System.Web.Mvc.Ajax"/>
        <add namespace="System.Web.Mvc.Html"/>
        <add namespace="System.Web.Routing"/>
        <add namespace="System.Web.WebPages"/>
        <add namespace="System.Web.Optimization"/>
        <add namespace="Fanex.ExternalAccount.Controllers"/>
        <add namespace="Fanex.ExternalAccount.ViewModel"/>
      </namespaces>
    </pages>
    <profile defaultProvider="DefaultProfileProvider">
      <providers>
        <add name="DefaultProfileProvider" type="System.Web.Providers.DefaultProfileProvider, System.Web.Providers, Version=1.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" connectionStringName="DefaultConnection" applicationName="/"/>
      </providers>
    </profile>
    <globalization uiCulture="en-US" culture="en-US"/>
  </system.web>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false"/>
    <modules runAllManagedModulesForAllRequests="true"/>
    <urlCompression doStaticCompression="true" doDynamicCompression="true"/>
    <staticContent>
      <clientCache cacheControlMode="DisableCache" cacheControlMaxAge="30.00:00:00"/>
    </staticContent>
  </system.webServer>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Helpers" publicKeyToken="31bf3856ad364e35"/>
        <bindingRedirect oldVersion="1.0.0.0-2.0.0.0" newVersion="2.0.0.0"/>
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Mvc" publicKeyToken="31bf3856ad364e35"/>
        <bindingRedirect oldVersion="1.0.0.0-4.0.0.0" newVersion="4.0.0.0"/>
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.WebPages" publicKeyToken="31bf3856ad364e35"/>
        <bindingRedirect oldVersion="1.0.0.0-2.0.0.0" newVersion="2.0.0.0"/>
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>