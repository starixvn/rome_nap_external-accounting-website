<?xml version="1.0" encoding="utf-8"?> 
<!--
  For more information on how to configure your ASP.NET application, please visit
  http://go.microsoft.com/fwlink/?LinkId=152368 
-->
<configuration>
  <configSections>
    <section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data" />
    
    <sectionGroup name="CustomerSetting">
      <section name="Security" type="Fanex.CustomerSetting.Security.Configurations.CustomerSettingSection, Fanex.CustomerSetting.Security" />
      <section name="RacingSection" type="Fanex.CustomerSetting.Module.Racebook.Configuration.RacingSection, Fanex.CustomerSetting.Module.Racebook, Version=1.0.0.0, Culture=neutral" />
      <section name="Keno" type="Fanex.CustomerSetting.Module.Keno.KenoSetting.Configurations.KenoSection, Fanex.CustomerSetting.Module.Keno.KenoSetting, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null" />
      <section name="Casino" type="Fanex.CustomerSetting.Module.Casino.Configurations.CasinoSection, Fanex.CustomerSetting.Module.Casino" />
      <section name="ColossusBet" type="Fanex.CustomerSetting.Module.ColossusBetSetting.Configurations.ColossusBetSection, Fanex.CustomerSetting.Module.ColossusBetSetting" />
    </sectionGroup>
    <!--Sportsbook-->
    <section name="PTMappingSection" type="Fanex.PTEngine.XmlMapping.PTMappingSection" allowLocation="true" allowDefinition="Everywhere" />
    <section name="BettingLimitMappingSection" type="Fanex.PTEngine.XmlMapping.BettingLimitMappingSection" allowLocation="true" allowDefinition="Everywhere" />
    <!--/Sportsbook-->
    <!--racing pt setting-->
    <section name="PTRacingMappingSection" type="Fanex.PTRacing.XmlMapping.PTRacingMappingSection" allowLocation="true" allowDefinition="Everywhere" />
    <section name="RacingBettingCommSettingMappingSection" type="Fanex.PTRacing.XmlMapping.RacingBettingCommSettingMappingSection" allowLocation="true" allowDefinition="Everywhere" />
    <!--/racing pt setting-->
    <!--CurrentSession-->
    <section name="CurrentSession" type="Fanex.CustomerSetting.Module.Core.Web.CurrentSessionSection, Fanex.CustomerSetting.Module.Core" />
    <!--/CurrentSession-->
    <!--CurrentContext-->
    <section name="CurrentContext" type="Fanex.CustomerSetting.Module.Core.Web.CurrentContextSection, Fanex.CustomerSetting.Module.Core" />
    <!--/CurrentSession-->
    <section name="dotless" type="dotless.Core.configuration.DotlessConfigurationSectionHandler, dotless.Core" />
    <section name="NoCaptchaSection" type="Fanex.ExternalAccount.Core.Context.NoCaptchaSectionConfiguration, Fanex.ExternalAccount.Core" />
    <section name="StatementSection" type="Fanex.Module.Statement.Configurations.StatementSection, Fanex.Module.Statement, Version=1.0.0.0, Culture=neutral" />
    <section name="LiveCasinoSettings" type="Fanex.LiveCasino.CoreSetting.Configuration.LiveCasinoSettings, Fanex.LiveCasino.CoreSetting" />
    <section name="GoldDeluxeSettings" type="Fanex.GoldDeluxe.CoreSetting.Configuration.GoldDeluxeSettings, Fanex.GoldDeluxe.CoreSetting" />
    <section name="enablestatus" type="Fanex.CustomerSetting.EnableStatus.AllInOne.Mappings.EnableStatusConfiguration, Fanex.CustomerSetting.EnableStatus.AllInOne, Version=1.0.0.0, Culture=neutral" />
    <section name="report" type="Fanex.ExternalAccount.Core.Reports.WinLossDetail.ProductsConfiguration, Fanex.ExternalAccount.Core" />
    <section name="LogsConfiguration" type="Fanex.Module.Logs.Mappings.LogsConfiguration, Fanex.Module.Logs, Version=1.0.0.0, Culture=neutral" />
    <section name="ONEbook.UM" type="ONEbook.UM.Configurations.UMClientConfiguration, ONEbook.UM" />
    <section name="ONEbook.NG2.API" type="ONEbook.NG2.API.Configuration.NG2Configuration, ONEbook.NG2.API" />
    <section name="NumberGame2Section" type="Fanex.HttpModule.NG2.UM.Configurations.NumberGame2Section, Fanex.HttpModule.NG2.UM" />
    <section name="ONEbook.UM.ThirdParty" type="ONEbook.UM.ThirdParty.Configurations.UMClientConfiguration, ONEbook.UM.ThirdParty" />
    <section name="CustomerSettingConfiguration" type="Fanex.CustomerSetting.Client40.Configurations.CustomerSettingConfiguration, Fanex.CustomerSetting.Client40" />
    <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" /></configSections>
  <NumberGame2Section configSource="Areas\NG2\NumberGame2Section.config" />
  <ONEbook.UM.ThirdParty ServiceUris="http://ha.nexdev.net:8887/api" EnableCheckUM="true" EnableUnscheduledUM="false" UMFrom="03:00" UMTo="04:00" UMPageUrl="~/Areas/NG2/UM.aspx">
    <Products>
      <add Id="23" IsUM="false" UMFrom="00:00" UMTo="23:59" />
      <!--For manual control on site each product -->
    </Products>
  </ONEbook.UM.ThirdParty>
  <ONEbook.UM ServiceUris="http://ha.nexdev.net:8889/api" EnableCheckUM="false" EnableUnscheduledUM="false" UMFrom="03:00" UMTo="04:00" SiteId="2000000" UMPageUrl="~/Shared/Offline">
    <AllowedIPs AllowAll="true" />
  </ONEbook.UM>
  <LogsConfiguration configSource="Areas\Logs\LogsConfiguration.config" />
  <report configSource="Areas\Reports\WinlossDetail\Products.config" />
  <enablestatus configSource="Areas\CustomerSetting\Views\EnableStatus\Templates\Products.config" />
  <CustomerSettingConfiguration System="4" ServiceUris="http://ha.nexdev.net:7206/api" CdnUris="http://ha.nexdev.net:7208" ClientLogCategory="DCS-Setting-Client-LOCAL" SecretKey="U6BUFHtVcq5SPQcTl7tHLBG/LF6d5YVRKHrCHD9M+Vw=" AccessDeniedAction="~/SportsbookSetting/ActionDenied" CustomCssUrl="~/Areas/CustomerSettingRenovation/Content/DCSCustom.css" />
  <LiveCasinoSettings UnAuthorizedPath="~/Areas/CustomerSetting/Views/Security/AccessDenied.cshtml" AuthorizationServiceType="Fanex.ExternalAccount.Core.Authorization.LiveCasino.LiveCasinoAuthorizationService, Fanex.ExternalAccount.Core" SystemId="4" />
  <GoldDeluxeSettings UnAuthorizedPath="~/Areas/CustomerSetting/Views/Security/AccessDenied.cshtml" AuthorizationServiceType="Fanex.ExternalAccount.Core.Authorization.GoldDeluxe.GoldDeluxeAuthorizationService, Fanex.ExternalAccount.Core" LanguageSessionKey="Fanex.GoldDeluxe.CoreSetting.Language" SystemId="4" />
  <!--CurrentContext-->
  <CurrentSession sessionFactory="Fanex.ExternalAccount.Core.Context.CurrentSession, Fanex.ExternalAccount.Core" />
  <!--/CurrentContext-->
  <!--CurrentSession-->
  <CurrentContext contextFactory="Fanex.ExternalAccount.Core.Context.CurrentContext, Fanex.ExternalAccount.Core" />
  <!--/CurrentSession-->
  <!--Security-->
  <CustomerSetting>
    <Security allowDirectDownline="false" allowGroups="222|1|65|67|3" authenticateFactory="Fanex.ExternalAccount.Core.Context.ExternalAccountAuthenticate, Fanex.ExternalAccount.Core" />
    <RacingSection configSource="PTEngine\RacingSection.config" />
    <Keno enable="true" showsetting="true" exclude="1502" excludesetting="1515,1516"
          AuthorizationServiceType="Fanex.ExternalAccount.Core.Authorization.KenoAuthorizationService, Fanex.ExternalAccount.Core" UnAuthorizedPath="~/Areas/CustomerSetting/Views/Security/AccessDenied.cshtml"/>
    <Casino IsUMTime="false" UMFrom="12:30PM" UMTo="14:00PM" />
    <ColossusBet AuthorizationServiceType="Fanex.ExternalAccount.Core.Authorization.ColossusBetAuthorizationService, Fanex.ExternalAccount.Core" UnAuthorizedPath="~/Areas/CustomerSetting/Views/Security/AccessDenied.cshtml" />
  </CustomerSetting>
  <!--/Security-->
  <NoCaptchaSection allowIPs="10.21.10.36,10.21.10.14,10.19.10.52" allowAdmins="starix18" />
  <!--Fanex-->
  <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
    <providers>
      <add name="XmlDbSettingProvider" type="Fanex.Data.DbSettingProviderExtension.XmlDbSettingProvider3, Fanex.Data.DbSettingProviderExtension" resourcePath="~/SpNames.CustDB.xml" enableWatching="1" />
    </providers>
  </Fanex.Data.DbSettingProvider>
  <Fanex.Logging msmqPath="FormatName:DIRECT=http://10.18.200.103:808/msmq/Private$/entlib" defaultCategory="NAP-External-LOCAL" />
  <!--/Fanex-->
  <!--Sportsbook-->
  <PTMappingSection configSource="PTEngine\PTMappingSection.config" />
  <BettingLimitMappingSection configSource="PTEngine\BettingLimitMappingSection.config" />
  <!--/Sportsbook-->
  <!--racing pt setting-->
  <PTRacingMappingSection configSource="PTEngine\PTRacingMappingSection.config" />
  <StatementSection configSource="Areas\Statement\StatementSection.config" />
  <RacingBettingCommSettingMappingSection configSource="PTEngine\RacingBettingCommSettingMappingSection.config" />
  <!--/racing pt setting-->
  <connectionStrings configSource="Configurations\connectionStrings.config" />
  <appSettings configSource="Configurations\appSettings.config" />
  <!--
    For a description of web.config changes see http://go.microsoft.com/fwlink/?LinkId=235367.

    The following attributes can be set on the <httpRuntime> tag.
      <system.Web>
        <httpRuntime targetFramework="4.6.1" />
      </system.Web>
  -->
  <system.web>
    <customErrors mode="Off" />
    <httpRuntime enableVersionHeader="false" executionTimeout="600" maxRequestLength="2000000000" maxUrlLength="200" maxQueryStringLength="2097151" requestValidationMode="2.0" requestPathInvalidCharacters="" />
    <compilation debug="true" targetFramework="4.6.1">
      <assemblies>
        <add assembly="System.Runtime.Remoting, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089" />
      </assemblies>
    </compilation>
    <trust level="Full" />
    <sessionState mode="StateServer" timeout="20" stateConnectionString="tcpip=ha.nexdev.net:42424" />
    <authentication mode="Forms">
      <forms loginUrl="~/Account/Login/" defaultUrl="~/Home/Index" timeout="20" name=".EXTNAPFORMSAUTH" />
    </authentication>
    <pages controlRenderingCompatibilityVersion="4.0">
      <namespaces>
        <add namespace="System.Web.Helpers" />
        <add namespace="System.Web.Mvc" />
        <add namespace="System.Web.Mvc.Ajax" />
        <add namespace="System.Web.Mvc.Html" />
        <add namespace="System.Web.Routing" />
        <add namespace="System.Web.WebPages" />
        <add namespace="System.Web.Optimization" />
        <add namespace="Fanex.ExternalAccount.Controllers" />
        <add namespace="Fanex.ExternalAccount.ViewModel" />
      </namespaces>
    </pages>
    <profile defaultProvider="DefaultProfileProvider">
      <providers>
        <add name="DefaultProfileProvider" type="System.Web.Providers.DefaultProfileProvider, System.Web.Providers, Version=1.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" connectionStringName="DefaultConnection" applicationName="/" />
      </providers>
    </profile>
    <globalization uiCulture="en-US" culture="en-US" />
    <httpHandlers>
      <add path="*.less" verb="GET" validate="false" type="dotless.Core.LessCssHttpHandler, dotless.Core" />
    </httpHandlers>
  </system.web>
  <dotless minifyCss="false" cache="true" web="false" />
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <modules runAllManagedModulesForAllRequests="true">
      <remove name="NG2HttpModule" />
      <add name="NG2HttpModule" type="Fanex.HttpModule.NG2.UM.NG2HttpModule" preCondition="integratedMode" />
    </modules>
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />
    <staticContent>
      <remove fileExtension=".less" />
      <mimeMap fileExtension=".less" mimeType="text/css" />
      <clientCache cacheControlMode="DisableCache" cacheControlMaxAge="30.00:00:00" />
    </staticContent>
    <handlers>
      <add name="dotless" path="*.less" verb="GET" type="dotless.Core.LessCssHttpHandler,dotless.Core" resourceType="File" preCondition="integratedMode" />
    </handlers>
  </system.webServer>
  <system.net>
    <settings>
      <httpWebRequest useUnsafeHeaderParsing="true" />
    </settings>
  </system.net>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="NPOI" publicKeyToken="0DF73EC7942B34E1" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-1.2.4.0" newVersion="1.2.4.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="NPOI" publicKeyToken="0df73ec7942b34e1" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-2.0.6.0" newVersion="2.0.6.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Runtime" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-2.6.10.0" newVersion="2.6.10.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Threading.Tasks" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-2.6.10.0" newVersion="2.6.10.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-3.5.0.0" newVersion="3.5.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Helpers" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="1.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.WebPages" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="0.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Mvc" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="0.0.0.0-5.2.3.0" newVersion="5.2.3.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Practices.Unity" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-2.0.414.0" newVersion="2.0.414.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
