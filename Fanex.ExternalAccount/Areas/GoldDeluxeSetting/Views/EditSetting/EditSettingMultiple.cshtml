@{
    Layout = "~/Areas/GoldDeluxeSetting/Views/EditSetting/_EditSetting.cshtml";
    ViewBag.Title = GoldDeluxeLang.lblEditMultipleGoldDeluxe;
}
@model EditSettingMultipleViewModel

@section modeldata
{
    <script type="text/javascript">
        @(Html.ToJavascriptObject(Model, "settingViewModel"))
    </script>
}

@section Customer
{
    <div id="tblCustInfo" class="col-xs-12">
        <table data-ng-controller="CustomerInfoController" class="cust-info">
            <tbody>
                <tr>
                    <td class="bold left">
                        @(Model.Usernames.TrimEnd(',').Replace(",", ", "))
                    </td>
                </tr>
                @if (Model.Level == CustomerLevel.Member
                    && Model.UpLineLevel == CustomerLevel.Agent
                    && Fanex.GoldDeluxe.CoreSetting.Web.WebHelper.IsCustomerNotBelongToSpecialSites())
                {
                    <tr>
                        <td class="right">
                            <label for="chbEnableGoldDuxe">
                                <input id="chbEnableGoldDuxe" type="checkbox" data-ng-model="enableGoldDeluxe" data-ng-disabled="$parent.isReadOnly" />
                                @GoldDeluxeLang.lblEnable
                            </label>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @Html.Partial("~/Areas/GoldDeluxeSetting/Views/EditSetting/Setting/PTAndCom.cshtml", Model)
    @Html.Partial("~/Areas/GoldDeluxeSetting/Views/EditSetting/Setting/MemberWinLimit.cshtml", Model)
    @Html.Partial("~/Areas/GoldDeluxeSetting/Views/EditSetting/Setting/GameSetting.cshtml", Model)
    @Html.Hidden("UpdateGoldDeluxeSettingUrl", Url.Content("~/GoldDeluxeSetting/GoldDeluxe/UpdateSettingMultiple"))
    @Html.Hidden("UpdatePTComSettingUrl", Url.Content("~/GoldDeluxeSetting/GoldDeluxe/UpdatePTAndComMultiple"))
    @Html.Hidden("UpdateWinLimitUrl", Url.Content("~/GoldDeluxeSetting/GoldDeluxe/UpdateWinLimitMultiple"))
    @Html.Hidden("UpdateGameSettingUrl", Url.Content("~/GoldDeluxeSetting/GoldDeluxe/UpdateGameSettingMultiple"))
}


