@model EditSettingViewModel
<div id="tblMaxWinLimit" class="pt-container col-xs-12" data-ng-controller="CustomerWinLimitController">
    <div class="pt-title">
        <span class="pt-title-text">@GoldDeluxeLang.lblMemberWinLimit</span><span data-ng-click="updateWinLimitSetting()"
                                                                                  data-ng-if="!$parent.isReadOnly && $parent.isUpdateWinLimitPartial" class="btn-save-partial" title="@GoldDeluxeLang.lblUpdate"></span>
    </div>
    <table class="win-limit">
        <tbody>
            <tr>
                <td class="col-xs-3 right bold">
                    @GoldDeluxeLang.lblMaximumWin
                </td>
                <td class="col-xs-4">
                    <select id="maxWinLimit" name="maxWinLimit" data-ng-options="opt as opt.lable for opt in maxWinLimits"
                            data-ng-disabled="$parent.isReadOnly || !$parent.isUpdateWinLimitPartial" data-ng-model="maxWinLimitModel.Max"></select>
                    <span>&nbsp;@GoldDeluxeLang.lblOnGivenCredit</span>
                </td>
                <td class="col-xs-6">
                    <label class="checkbox-inline">
                        <input type="checkbox" id="dailyAutoReset" name="dailyAutoReset" data-ng-model="maxWinLimitModel.IsAutoReset"
                               data-ng-disabled="!maxWinLimitModel.UplineAutoReset||$parent.isReadOnly || !$parent.isUpdateWinLimitPartial">@GoldDeluxeLang.lblDailyAutoResetLimit
                        </label>
                    </td>
                </tr>
                @if (Model.Level == CustomerLevel.Member)
                {
                    <tr>
                        <td class="col-xs-3 right bold">
                            @GoldDeluxeLang.lblCurrentWinLimit
                        </td>
                        <td class="col-xs-3 left ng-binding">
                            <div id="showWinLimit" class="member-win-limit" data-ng-click="showCurrentWinLimit(@Model.CustId)" data-ng-show="!isShowCurrentWinLimit">
                                @GoldDeluxeLang.lblClickToViewCurrentWinLimit
                            </div>
                            <div id="currentWinLimit"
                                 data-ng-show="isShowCurrentWinLimit && currentWinLimit !='-1'">
                                <span class="{{isPercentShowRedColor?'text-red':''}}">{{percent}}{{percent == 'N/A' ? '' : '%'}}</span>
                                &nbsp;&nbsp;(<span class="{{CurrentAmount >= MaxWinCredit && MaxWinCredit != 0 ? 'text-red':''}}">{{CurrentAmount}}</span>/<span class="{{MaxWinCredit <= 0 ? 'text-red' : ''}}">{{MaxWinCredit}}</span>)
                            </div>
                            <div class="current-win-limit" id="currentWinLimit" data-ng-show="isShowCurrentWinLimit && currentWinLimit == '-1'">
                                @GoldDeluxeLang.lblUnlimited
                            </div>
                        </td>
                        <td class="col-xs-3"></td>
                    </tr>
                }
            </tbody>
        </table>
        @Html.Hidden("memberWinLimitLink", Url.Content("~/GoldDeluxeSetting/GoldDeluxe/GetCurrentWinLimit"))
    </div>