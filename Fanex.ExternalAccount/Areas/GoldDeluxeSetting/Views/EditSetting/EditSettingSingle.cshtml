@using Fanex.ExternalAccount.Core.Shared
@{
    Layout = "~/Areas/GoldDeluxeSetting/Views/EditSetting/_EditSetting.cshtml";
    ViewBag.Title = GoldDeluxeLang.lblEditGoldDeluxe;
}
@model EditSettingViewModel
@section modeldata
{
    <script type="text/javascript">
        @(Html.ToJavascriptObject(Model, "settingViewModel"))
    </script>
}
@section Customer
{
    <div id="tblCustInfo" class="col-xs-12">
        <table data-ng-controller="CustomerInfoController" class="cust-info">
            <tr class="title">
                <td colspan="4" class="center">
                    @GoldDeluxeLang.lblCustomerInformation
                </td>
            </tr>
            <tr>
                <td class="right bold info-lable">
                    @GoldDeluxeLang.lblUsername
                </td>
                <td class="left info-value">
                    @Model.Setting.Username
                </td>
                <td class="right bold info-lable">
                    @GoldDeluxeLang.lblFirstName
                </td>
                <td class="left info-value">
                    {{SuperInfo.FirstName}}
                </td>
            </tr>
            <tr>
                <td class="right bold info-lable">
                    @GoldDeluxeLang.lblLastName
                </td>
                <td class="left info-value">
                    {{SuperInfo.LastName}}
                </td>
                <td class="right bold info-lable">
                    @GoldDeluxeLang.lblPhone
                </td>
                <td class="left info-value">
                    {{SuperInfo.Phone}}
                </td>
            </tr>
            <tr>
                <td class="right bold info-lable">
                    @GoldDeluxeLang.lblMobilePhone
                </td>
                <td class="left info-value">
                    {{SuperInfo.MobilePhone}}
                </td>
                <td class="right bold info-lable">
                    @GoldDeluxeLang.lblFax
                </td>
                <td class="left info-value">
                    {{SuperInfo.Fax}}
                </td>
            </tr>
            @if (!(Model.Level == CustomerLevel.Member && Model.UpLineLevel == CustomerLevel.Master)
                && !(Model.Level == CustomerLevel.Member && Model.UpLineLevel == CustomerLevel.Super)
                && Fanex.GoldDeluxe.CoreSetting.Web.WebHelper.IsCustomerNotBelongToSpecialSites())
            {
                <tr>
                    <td class="right bold info-lable">
                        @GoldDeluxeLang.ProductStatus
                    </td>
                    <td class="left info-value">
                        <input type="checkbox" data-ng-model="enableGoldDeluxe" data-ng-disabled="disableCheckBoxGoldDeluxe || $parent.isReadOnly" ng-change="updateDownlineStatus()" />
                        <label>@Model.Level.ToString()</label>
                    </td>
                    <td class="right bold info-lable"></td>
                    <td class="left info-value"></td>
                </tr>
            }
        </table>
    </div>
    @Html.Partial("~/Areas/GoldDeluxeSetting/Views/EditSetting/Setting/PTAndCom.cshtml", Model)
    @Html.Partial("~/Areas/GoldDeluxeSetting/Views/EditSetting/Setting/MemberWinLimit.cshtml", Model)
    @Html.Partial("~/Areas/GoldDeluxeSetting/Views/EditSetting/Setting/GameSetting.cshtml", Model)
    @Html.Hidden("UpdateGoldDeluxeSettingUrl", Url.Content("~/GoldDeluxeSetting/GoldDeluxe/UpdateSetting"))
    @Html.Hidden("UpdatePTComSettingUrl", Url.Content("~/GoldDeluxeSetting/GoldDeluxe/UpdatePTAndCom"))
    @Html.Hidden("UpdateWinLimitUrl", Url.Content("~/GoldDeluxeSetting/GoldDeluxe/UpdateWinLimit"))
    @Html.Hidden("UpdateGameSettingUrl", Url.Content("~/GoldDeluxeSetting/GoldDeluxe/UpdateGameSetting"))
    @Html.Hidden("GetSuperInfoUrl", Url.Content("~/MainSuper/GetInfo"))
}

