@using Fanex.ExternalAccount.Core.Shared
@using Fanex.ExternalAccount.Statement.Resources;
@using Fanex.ExternalAccount.Statement.Configurations;
@{
    ViewBag.Title = Labels.Statement_Report;
    Layout = "";
    var isInternalCustomer = 0;
    var newLayoutDate = string.Format("{0:MM/dd/yyyy}", StatementSection.Instance.NewLayoutDate);
    var balanceUpDay = "1/10/2015";
    var moveBetsDay = "1/11/2015";
}
<div id="view-guidelines-icon">
    View Guildelines
</div>
<div id="GridContainer" class="freegrid">
</div>
<script type="text/javascript" src="@Url.Content("~/Scripts/_Libs/jQuery/jquery-1.8.2.min.js")"></script>
<script type="text/javascript" src="@Url.Content("~/Scripts/_Libs/jQuery/jquery-ui-1.9.1.min.js")"></script>
<script type="text/javascript" src="@Url.Content("~/Scripts/_Libs/PopUp/dialogbox.js")"></script>
<script type="text/javascript" src="@Url.Content("~/Scripts/Fanex.Grid/Fanex.Grid.js")"></script>
<script type="text/javascript" src="@Url.Content("~/Scripts/Fanex.Grid/Fanex.Grid.js")"></script>
<script type="text/javascript" src="@Url.Content("~/Scripts/Fanex.Grid/Fanex.Pagination.js")"></script>
<script type="text/javascript" src="@Url.Content("~/Scripts/Fanex.Grid/moment.js")"></script>
<script type="text/javascript" src="@Url.Content("~/Scripts/Fanex.Grid/numeral.js")"></script>
<script src="@Url.Content("~/Areas/Statement/Views/Report/Scripts/StatementReportManager.js?v=1")" type="text/javascript"></script>
<script type="text/javascript">
    window.rootUrl = '@Url.Content("~")';
    var isInternalCustomer = @isInternalCustomer;
    var balanceUpDay = '@balanceUpDay';
    var moveBetsDay = '@moveBetsDay';
    var newLayoutDate = '@newLayoutDate';
    var statementResources = {
        Invalid_Date_Range: '@Labels.Invalid_Date_Range',
        Date: "@Labels.Date",
        Opening_Balance: "@Labels.Opening_Balance",
        Turnover: "@Labels.Turnover",
        Void_Cancelled: "@(Labels.Void + "/" + Labels.Rejected)",
        Outstanding: "@Labels.Outstanding",
        Win_Loss: "@Labels.Win_Loss",
        Commission: "@Labels.Commission",
        Transfer_Amt: "@Labels.Transfer_Amt",
        Accumulated_Total: "@Labels.Accumulated_Total",
        Symbol_NoData: "@Labels.Symbol_NoData",
        Transfer_Details: "@Labels.Transfer_Details",
        Bet_List: '@Labels.Bet_List',
        GrandPrize: '@Labels.GrandPrize'
    };

    function viewGuidelines() {
        OpenPopup(
                window.rootUrl + "StatementReport/Guideline/?roleId=" + @Role.Agent, 
           "Statement Guidelines",
           900,
           600);
    }

    jQuery(document).ready(function() {
        domain = window.rootUrl;
        $("#view-guidelines-icon").click(function() {
            viewGuidelines();
        });

        statementReportManager.initFunction(null, function(options) {
            OpenPopup(options.url, options.title, options.width, options.height);
        });
        statementReportManager.getStatementReport( {
            fromDate: "12/1/2014",
            toDate: "1/23/2015",
            custId: 0,
                roleId: @Role.Member,
            balanceUpDay: balanceUpDay,
            moveBetDay: moveBetsDay,
            username: "member01"
        });
    });
</script>