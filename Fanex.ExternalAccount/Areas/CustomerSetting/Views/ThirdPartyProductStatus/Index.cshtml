@using Fanex.ExternalAccount.Resources
@model Fanex.ExternalAccount.ViewModel.Customer.ThirdPartyProductStatusViewModel
@{ var iframeHeight = Model.Height - 100; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="" name="description">
    <meta content="" name="author">
    <link rel="stylesheet" href="@Url.Content("~/Areas/CustomerSetting/Styles/jquery-ui.css")">
    <link rel="stylesheet" href="@Url.Content("~/Areas/CustomerSetting/Styles/Common.css")">
</head>
<body>
    <div id="ThirdPartyProductStatusTabs">
        <iframe id="iframeNewVersion"
                width="100%"
                height="@iframeHeight"
                frameborder="0"
                src="@Url.Content(string.Format(
                    "{0}ProductStatusSetting/Index?custId={1}&custName={2}&custRole={3}&productId={4}&sporttypeid={5}",
                    Url.Content("~"), Model.CustId, Model.CustName, Model.CustRole, Model.ProductId, Model.SportTypeId))">
    </div>
    <script type="text/javascript" src="@Url.Content("~/Areas/CustomerSetting/Scripts/jquery.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Areas/CustomerSetting/Scripts/jquery-ui-1.9.1.min.js")"></script>
    <script type="text/javascript">
        $(function () { $("#ThirdPartyProductStatusTabs").tabs(); });
    </script>
    @Html.Raw(Fanex.Logging.LogManager.RenderJavascriptLogger())
</body>
</html>