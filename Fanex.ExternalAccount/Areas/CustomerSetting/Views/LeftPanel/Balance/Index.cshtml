@using Fanex.ExternalAccount.Utilities
@model System.Data.DataTable
    @{ 
        Layout = null;
    }

<div class="page-title">Customer Balance</div>

<table id="tblInner" class="table w100 margin-top-10">
    <thead>
        <tr class="row-special">
            <th colspan="5"></th>
            <th>
                <input type="button" value="Submit" class="btn -submit" onclick="Update()" />
            </th>
            <th colspan="3"></th>
        </tr>
		<tr>
			<th>No.</th>
			<th>Credit</th>
			<th>Balance</th>
			<th>Yesterday Balance</th>
			<th>3rd Party Pending Transfer</th>
			<th>Outstanding</th>
			<th><input id="all" type="checkbox" onclick="CheckAll()" /></th>
			<th>Username</th>
			<th>First Name</th>
			<th>Last Name</th>
		</tr>
    </thead>
    <tbody>
        @if (Model == null || Model.Rows.Count == 0)
        {
            <tr>
                <td colspan="9" class="C">There is no information available</td>
            </tr>
        }
        else
        {
            int index = 0;
            string disabled = string.Empty;

            foreach (System.Data.DataRow row in Model.Rows)
            {
                index++;
                disabled = Utils.ToDecimal(row["YesterdayBalance"]) == 0m ? "disabled='disabled'" : string.Empty;
			<tr>
				<td class="text-center">@index</td>
				<td class="text-right bold">@Html.Raw(Utils.ToDecimal(row["GivenCredit"]).ToStringFormat())</td>
				<td class="text-right bold">@Html.Raw(Utils.ToDecimal(row["Balance"]).ToStringFormat())</td>
				<td class="text-right bold">@Html.Raw(Utils.ToDecimal(row["YesterdayBalance"]).ToStringFormat())</td>
				<td class="text-right bold">@Html.Raw(Utils.ToDecimal(row["PendingTransfer3rd"]).ToStringFormat())</td>
				<td class="text-right bold">@Html.Raw(Utils.ToDecimal(row["Outstanding"]).ToStringFormat())</td>
				<td class="text-center"><input type="checkbox" @disabled id="@row["CustId"]" onclick="Check(this)" /></td>
				<td class="text-center bold">@row.DecodeHtml("UserName")</td>
				<td class="text-center bold">@row.DecodeHtml("FirstName")</td>
				<td class="text-center bold">@row.DecodeHtml("LastName")</td>
			</tr>
            }
        }
        <tr class="row-special">
            <td colspan="5"></td>
            <td class="text-center">
                <input type="button" value="Submit" class="btn -submit" onclick="Update()" />
            </td>
            <td colspan="3"></td>
        </tr>
    </tbody>

</table>

@Html.AntiForgeryToken()
<script type="text/javascript">
    var custId = '@ViewBag.CustId';
</script>
<script src="@Url.Content("~/Areas/CustomerSetting/Views/LeftPanel/Balance/Scripts/BalanceController.js")" type="text/javascript"></script>
