@using Newtonsoft.Json
@using Newtonsoft.Json.Serialization
@model Fanex.ExternalAccount.Module.LeftPanel.ViewModels.CustomerModel
@{
    var customerModel = JsonConvert.SerializeObject(this.Model, Formatting.None, new JsonSerializerSettings
    {
        ContractResolver = new CamelCasePropertyNamesContractResolver(),
        NullValueHandling = NullValueHandling.Ignore
    });

    var userId = ViewBag.UserId;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Left panel</title>
    @*<link href="@Url.Content("~/Areas/CustomerSetting/Styles/jquery-ui.css")" rel="stylesheet" type="text/css" />*@
    <link href="@Url.Content("~/assets/styles/fonts/AlphaAdmin/style.css?v=1")" rel="stylesheet" />
    <link href="@Url.Content("~/assets/styles/pages/default/left-panel.css")" rel="stylesheet" />
</head>
<body>
    <div id="ng-app" data-ng-app="leftPanelApp" class="hide left-panel-container">
        <div id="leftPanel" class="left-panel-content" data-ng-controller="LeftPanelController">
            <div data-ng-controller="NoInfoController" data-ng-init="model.hide = model != null" data-ng-hide="model.hide">
                @Html.Raw(ViewBag.ErrorMessage)
            </div>
            <div id="usernameInfo" data-ng-controller="LineInfoController" data-ng-hide="{{model==null}}">
	            <div class="row" data-ng-repeat="person in personalInfo.downlines">
		            <div class="pull-left width-90" data-ng-if="person.value">{{person.text}}</div>
		            <div class="pull-left detail bold" data-ng-if="person.value" data-ng-click="ViewUser('{{person.value}}')">{{person.value}}</div>
		            <a class="floatRight icon-home" data-ng-if="person.value" href="~/User/InternalLogin/?username={{person.value}}&groupname=@(Model == null ? string.Empty : Model.GroupName)" target="_blank"></a>
	            </div>
            </div>
            <div id="customerInfo" class="customer-info" data-ng-controller="PersonalInfoController" data-ng-hide="{{model==null}}">
                <div class="currentUser">
                    <a title="{{personalInfo.status.tooltip}}" class="detail2 {{personalInfo.backgroundColor.value}}" href="javascript:;" data-ng-click="ViewUser('{{personalInfo.currentLevel.value}}')">{{personalInfo.currentLevel.value}}</a>
                    <span id="personalInfo" class="icon-collapse" data-ng-click="TooglePersonalInfo()"></span>
                </div>
                <div class="user-info" id="UserInfoContainer">
                    <div class="row">
                        <div class="pull-left width-90">
                            {{personalInfo.name.text}}:
                        </div>
                        <div>{{personalInfo.name.value.decodeHtml()}}</div>
                    </div>
                    <div class="row">
                        <div class="pull-left width-90">
                            {{personalInfo.nickname.text}}:
                        </div>
                        <div>{{personalInfo.nickname.value.decodeHtml()}}</div>
                    </div>
                    <div class="row">
                        <div class="pull-left width-90">
                            {{personalInfo.fax.text}}:
                        </div>
                        <div>{{personalInfo.fax.value.decodeHtml()}}</div>
                    </div>
                    <div class="row">
                        <div class="pull-left width-90">
                            {{personalInfo.phone.text}}:
                        </div>
                        <div>{{personalInfo.phone.value.decodeHtml()}}</div>
                    </div>
	                <div class="row">
		                <div class="pull-left width-90">
			                {{personalInfo.mobile.text}}:
		                </div>
		                <div>{{personalInfo.mobile.value.decodeHtml()}}</div>
	                </div>
	                <div class="row">
		                <div class="pull-left width-90">
			                {{personalInfo.headline.text}}:
		                </div>
                        <div>{{personalInfo.headline.value.decodeHtml()}}</div>
	                </div>
                </div>
            </div>
            <div id="viewInfo" class="view-info" data-ng-controller="ViewInfoController" data-ng-hide="{{model==null}}">
                <div id="btnCustList" data-ng-hide="{{personalInfo.roleId.value == 1}}" class="btn -list" data-ng-click="GetCustomerList(); collapseSidebar();">{{personalInfo.custList.value}}</div>
                <div id="btnStatement" class="btn -green" data-ng-click="GetStatementList({{personalInfo.custId.value}}); collapseSidebar();">Statement</div>
                <div id="btnBalance" data-ng-hide="{{personalInfo.roleId.value != 2}}" class="btn -special" data-ng-click="GetBalance({{personalInfo.custId.value}}); collapseSidebar();">Balance</div>
            </div>
            <div id="balanceInfo" class="balance-info" data-ng-controller="BalanceDownlineInfoController" data-ng-hide="{{model==null}}">
                <ul class="tabs nav-tabs">
                    <li id="tab1"><a href="#tabs-1">Balance Info</a></li>
	                <li id="tab2" data-ng-click="GetDownline(false,{{personalInfo.custId.value}})"><a href="#tabs-2">@((Model != null && (int)Model.PersonalInfo.RoleId.Value == 4) ? "Master": (Model != null && (int)Model.PersonalInfo.RoleId.Value == 3) ? "Agent" : "Member")</a></li>
	                <li id="tab3" data-ng-click="GetDownline(true,{{personalInfo.custId.value}})"><a href="#tabs-2">Direct Member</a></li>
                </ul>
                <div id="tabs-1" class="tab-content" data-ng-init="balances=balanceInfo.balances;isHide=balances.length < 7" data-ng-controller="BalanceController">
                    <div class="row">
                        <div class="pull-left">{{balanceInfo.currency.text}}</div>
                        <div class="pull-right bold">{{balanceInfo.currency.value}}</div>
                    </div>
                    <div class="row">
                        <div class="pull-left">{{balances[0].text}}</div>
                        <div class="{{myClass0}} pull-right bold" data-ng-init="myClass0 = balances[0].value < 0">
                            {{balances[0].value.toFixed(2).formatNumber()}}
                        </div>
                    </div>
                    <div class="row">
                        <div class="pull-left">{{balances[1].text}}</div>
                        <div class="{{myClass1}} pull-right bold" data-ng-init="myClass1 = balances[1].value < 0">
                            {{balances[1].value.toFixed(2).formatNumber()}}
                        </div>
                    </div>
                    <div class="row">
                        <div class="pull-left">{{balances[2].text}}</div>
                        <div class="{{myClass2}} pull-right bold" data-ng-init="myClass2 = balances[2].value < 0">
                            {{balances[2].value.toFixed(2).formatNumber()}}
                        </div>
                    </div>
                    <div class="row">
                        <div class="pull-left">{{balances[3].text}}</div>
                        <div class="{{myClass2}} pull-right bold" data-ng-init="myClass2 = balances[3].value < 0">
                            {{balances[3].value.toFixed(2).formatNumber()}}
                        </div>
                    </div>
                    <div class="row">
                        <div class="pull-left">{{balances[4].text}}</div>
                        <div class="{{myClass3}} pull-right bold" data-ng-init="myClass3 = balances[4].value < 0">
                            <div class="floatLeftBalance R" data-ng-hide="{{model.isUpdateCredit == false}}">
                                <a id="linkGivenCredit" href="javascript:;" data-ng-click="EditCredit()">{{balances[4].value.toFixed(2).formatNumber()}}</a>
                                <input style="text-align: right; margin-right: 0; height: 20px !important" data-ng-blur="RevertCredit({{preVal}})" data-ng-init="preVal=balances[4].value" maxlength="14" onkeyup="return Fanex.CustomerSetting.Core.CheckNumber(event, this, true)" onkeypress="return Fanex.CustomerSetting.Core.CheckNumber(event, this, true)" data-ng-keypress="UpdateCredit($event)" onpaste="return false;" oncut="return false;" id="givenCredit" type="text" data-ng-hide="true" />
                            </div>
                            <div style="color: #2489CE"
                                 title="You are not authorized on this function" class="floatLeftBalance R"
                                 data-ng-hide="{{model.isUpdateCredit == true}}">
                                {{balances[4].value.toFixed(2).formatNumber()}}
                            </div>
                        </div>
                    </div>
                    <div data-ng-hide="{{isHide}}" class="row">
                        <div class="pull-left">{{balances[5].text}}&nbsp;[<a href="javascript:;" data-ng-click="CreditDetail(); collapseSidebar();">Detail</a>]</div>
                        <div class="{{myClass4}} pull-right bold" data-ng-init="myClass4 = balances[5].value < 0">
                            {{balances[5].value.toFixed(2).formatNumber()}}
                        </div>
                    </div>
                    <div data-ng-hide="{{isHide}}" class="row">
                        <div class="pull-left">{{balances[6].text}}</div>
                        <div class="{{myClass5}} pull-right bold" data-ng-init="myClass5 = balances[6].value < 0">
                            {{balances[6].value.toFixed(2).formatNumber()}}
                        </div>
                    </div>
                    <div data-ng-hide="{{isHide}}" class="row">
                        <div class="pull-left">{{balances[7].text}}</div>
                        <div class="{{myClass6}} pull-right bold" data-ng-init="myClass6 = balances[7].value < 0">
                            {{balances[7].value.toFixed(2).formatNumber()}}
                        </div>
                    </div>
                    <div data-ng-hide="{{isHide}}" class="row">
                        <div class="pull-left">{{balances[8].text}}</div>
                        <div class="{{myClass7}} pull-right bold" data-ng-init="myClass7 = balances[8].value < 0">
                            {{balances[8].value.toFixed(2).formatNumber()}}
                        </div>
                    </div>
                    <div class="row" data-ng-hide="{{rewardInfo.rewardReceivable == null}}">
                        <div class="pull-left">{{rewardInfo.rewardReceivable.text}} <span class="icon-alert-circle-outline" title="{{rewardInfo.rewardReceivable.tooltip}}"></span></div>
                        <div class="{{myClass8}} pull-right bold" >
                            {{rewardInfo.rewardCurrency.value}} {{rewardInfo.rewardReceivable.value.toFixed(2).formatNumber()}}
                        </div>
                    </div>
                    <div class="row" data-ng-hide="{{rewardInfo.rewardPayable ==null}}">
                        <div class="pull-left">{{rewardInfo.rewardPayable.text}}  <span class="icon-alert-circle-outline" title="{{rewardInfo.rewardPayable.tooltip}}"></span></div>
                        <div class="{{myClass9}} pull-right bold" >
                            {{rewardInfo.rewardCurrency.value}} {{rewardInfo.rewardPayable.value.toFixed(2).formatNumber()}}
                        </div>
                    </div>
                </div>
                <div class="tab-content" id="tabs-2" data-ng-controller="DownlineListController">
                    <div id="downlines" data-ng-hide="true"></div>
                    <div class="pagination">
                        <div id="page" class="text" data-ng-hide="true">Page</div>
                        <div id="pages" class="page-number" data-ng-init="Init()" data-ng-hide="true"></div>
                    </div>
                    <div id="nodownline" class="no-downline" data-ng-hide="true">No downline list</div>
                </div>
            </div>
            <div id="settingInfo" class="setting-info" data-ng-controller="SettingController" data-ng-hide="{{model==null}}" data-ng-init="Init()">
                <ul class="tabs nav-tabs">
                    <li><a href="#tab-1">Setting</a></li>
                    <li><a href="#tab-2">Detail</a></li>
                    <li><a href="#tab-3">Login</a></li>
                    <li data-ng-click="GetOnline({{model.personalInfo.custId.value}})"><a href="#tab-4">Online List</a></li>
                </ul>
                <div id="tab-1" class="tab-content setting-tab">
                    <div class="edit-item" data-ng-repeat="editItem in setting.editItems">
                        <div data-ng-hide="{{editItem.isHide || !editItem.visibled}}" class="settingEdit"
                             title="{{editItem.tooltip}}" data-ng-click="{{editItem.key}}()"><span class="icon-link"></span><span class="txt-setting">{{editItem.text}}</span></div>
                    </div>
                    <div class="enabled-item" data-ng-repeat="enableItem in setting.enableItems">
                        <div data-ng-click="{{enableItem.key}}({{enableItem.value}}, '{{enableItem.key}}',{{enableItem.disabled}})"
                             class="setting-enable-item" data-ng-disabled="{{enableItem.disabled}}">
                            <div data-ng-hide="{{enableItem.isHide || !enableItem.visibled}}" class="pull-left">
                                <input title="{{enableItem.tooltip}}" id="{{enableItem.key}}" type="checkbox" data-ng-model="enableItem.value" data-ng-disabled="{{enableItem.disabled}}" />
                            </div>
                            <div data-ng-hide="{{enableItem.isHide || !enableItem.visibled}}" class="pull-left" title="{{enableItem.tooltip}}">{{enableItem.text}}</div>
                        </div>
                    </div>
                </div>
                <div class="tab-content detail-tab" id="tab-2">
                    <div class="subTab-parent">
                        <div data-ng-click="ViewSubTab('sub-edit')" id="sub-edit"
                             data-ng-hide="model.personalInfo.roleId.value != 1"
                             class="pull-left subTab subTab-active">Edit</div>
                        <div data-ng-click="ViewSubTab('sub-super-pt')" id="sub-super-pt" class="subTab"
                             data-ng-hide="model.personalInfo.roleId.value != 1 || model.personalInfo.uplineId.value == -4">Super PT</div>
	                    <div data-ng-click="ViewSubTab('sub-master-pt')" id="sub-master-pt" class="subTab"
	                         data-ng-hide="model.personalInfo.roleId.value != 1 || model.personalInfo.uplineId.value == -4 || model.personalInfo.uplineId.value == -3">Master PT</div>
                    </div>
	                <div id="edit">
		                <div class="edit-item" data-ng-repeat="item in setting.details">
			                <div data-ng-hide="item.isHide || !item.visibled" class="settingEdit"
			                     data-ng-click="{{item.key}}();"><span class="icon-bullet"></span><span class="product-name">{{item.value}}</span></div>
		                </div>
	                </div>
                    <div id="superPT" style="display: none">
                        <div class="edit-item" data-ng-repeat="item in setting.superPts">
                            <div data-ng-hide="item.isHide || !item.visibled" class="settingEdit"
                                 data-ng-click="Super{{item.key}}(); collapseSidebar();"><span class="icon-bullet"></span><span class="product-name">{{item.value}}</span></div>
                        </div>
                    </div>
                    <div id="masterPT" style="display: none">
                        <div class="edit-item" data-ng-repeat="item in setting.masterPts">
                            <div data-ng-hide="item.isHide || !item.visibled" class="settingEdit"
                                 data-ng-click="Master{{item.key}}(); collapseSidebar();"><span class="icon-bullet"></span><span class="product-name">{{item.value}}</span></div>
                        </div>
                    </div>
                </div>
                <div class="tab-content login-tab" id="tab-3" data-ng-controller="LoginController" data-ng-init="length = loginInfo.length">
                    <div class="row">
                        <div class="pull-left bold">{{loginInfo[0].text}}</div>
                        <div class="pull-right">{{loginInfo[0].value}}</div>
                    </div>
                    <div class="row">
                        <div class="pull-left bold">{{loginInfo[1].text}}</div>
                        <div class="pull-right">{{loginInfo[1].value}}</div>
                    </div>
                    <div class="row">
                        <div class="pull-left bold">{{loginInfo[2].text}}</div>
                        <div class="pull-right">{{loginInfo[2].value}}</div>
                    </div>
                    <div class="row">
                        <div class="pull-left bold" title="{{loginInfo[3].tooltip}}">{{loginInfo[3].text}}</div>
                        <div class="pull-right">{{loginInfo[3].value}}</div>
                    </div>
                    <div class="row" data-ng-init="tmpId = model == null ? 0 : model.personalInfo.custId.value">
                        <div class="pull-left bold">
                            {{loginInfo[4].text}}&nbsp;[<a href="javascript:;" data-ng-click="ResetPassword({{tmpId}}, '{{model.personalInfo.currentLevel.value}}')">Change</a>]
                        </div>
                        <div class="pull-right">
                            {{loginInfo[4].value}}
                        </div>
                    </div>
                    <div class="row">
                        <div class="pull-left bold">{{loginInfo[5].text}}</div>
                        <div class="pull-right detail">
                            <a href="javascript:;" data-ng-click="ShowIp('{{loginInfo[5].value}}')">
                                {{loginInfo[5].value}}
                            </a>
                        </div>
                    </div>
                    <div class="row" data-ng-show="{{model.uplineHasSecurityCode && model.personalInfo.roleId.value > 1}}">
                        <div class="pull-left bold">{{loginInfo[6].text}}&nbsp;[<a href="javascript:;" data-ng-click="ResetSecurityCode({{model != null ? model.personalInfo.custId.value : 0}}, {{model != null ? model.personalInfo.roleId.value : 0}}, '{{model != null ? model.personalInfo.currentLevel.value : 0}}')">Change</a>]</div>
                        <div class="pull-right">{{loginInfo[6].value}}</div>
                    </div>
                    <div class="row" data-ng-hide="{{length == 7}}">
                        <div class="pull-left bold">{{loginInfo[7].text}}</div>
                        <div class="pull-right">{{loginInfo[7].value}}</div>
                    </div>
                    <div class="row" data-ng-hide="{{model.personalInfo.roleId.value == 1}}">
                        <div class="pull-left bold">{{loginInfo[8].text}}&nbsp;[<a href="javascript:;" data-ng-click="RemoveOTP({{model != null ? model.personalInfo.custId.value : 0}}, '{{model != null ? model.personalInfo.currentLevel.value : 0}}');collapseSidebar();">Remove</a>]</div>
                        <div class="pull-right">{{loginInfo[8].value}}</div>
                    </div>
                </div>
                <div class="tab-content online-list-tab" id="tab-4" data-ng-controller="OnlineListController">
                    <table class="table">
                        <thead>
                            <tr>
                                <th class="p10">No</th>
                                <th class="p32">IP</th>
                                <th>Last Login</th>
                            </tr>
                        </thead>
                        <tbody id="onlines" data-ng-init="Init()" data-ng-hide="true"></tbody>
                    </table>
                    <div id="online" data-ng-hide="true" class="no-info">This user is not online</div>
                </div>
            </div>
            @Html.Hidden("SCode", (string)ViewBag.Code)
        </div>
        @Html.AntiForgeryToken()
    </div>
    <script src="@Url.Content("~/Areas/CustomerSetting/Scripts/jquery.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Areas/CustomerSetting/Scripts/jquery.blockUI.1.33.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Areas/CustomerSetting/Scripts/jquery-ui-1.9.1.min.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Areas/CustomerSetting/Scripts/angular.min.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Areas/CustomerSetting/Scripts/Validators.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Scripts/Fanex.ExtAcc.Utils.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Scripts/isMobile.min.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Areas/CustomerSetting/Scripts/Fanex.CustomerSetting.Core.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Areas/CustomerSetting/Views/LeftPanel/Scripts/BalanceController.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Areas/CustomerSetting/Views/LeftPanel/Scripts/BalanceDownlineInfoController.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Areas/CustomerSetting/Views/LeftPanel/Scripts/DownlineListController.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Areas/CustomerSetting/Views/LeftPanel/Scripts/LeftPanelController.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Areas/CustomerSetting/Views/LeftPanel/Scripts/LineInfoController.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Areas/CustomerSetting/Views/LeftPanel/Scripts/LoginController.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Areas/CustomerSetting/Views/LeftPanel/Scripts/NoInfoController.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Areas/CustomerSetting/Views/LeftPanel/Scripts/OnlineListController.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Areas/CustomerSetting/Views/LeftPanel/Scripts/PersonalInfoController.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Areas/CustomerSetting/Views/LeftPanel/Scripts/SettingController.js?v=9")" type="text/javascript"></script>
    <script src="@Url.Content("~/Areas/CustomerSetting/Views/LeftPanel/Scripts/SettingPTController.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Areas/CustomerSetting/Views/LeftPanel/Scripts/ViewInfoController.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Areas/CustomerSetting/Views/LeftPanel/Scripts/AjaxSetup.js")" type="text/javascript"></script>
    <script type="text/javascript">
        var model = @(Html.Raw(customerModel));
    </script>
    <script type="text/javascript">
        var userId = parseInt('@userId');

        if (model) {
            $('#balanceInfo').tabs();
            $('#settingInfo').tabs();

            if (model.personalInfo.roleId.value == 1) {
                $('#tab2').remove();
                $('#tab3').remove();
            }

            if (model.personalInfo.roleId.value == 2) {             
                $('#tab3').remove();
            }
              
        }
        else {
            $('#balanceInfo').remove();
            $('#settingInfo').remove();
        }
    </script>
    @Fanex.ExternalAccount.Core.Helpers.GoogleAnalyticHepler.Render()
    @Fanex.ExternalAccount.Core.Helpers.TrackJSHelper.Render()
    @Html.Raw(Fanex.Logging.LogManager.RenderJavascriptLogger())
</body>
</html>