@using Newtonsoft.Json
@using Newtonsoft.Json.Serialization
@model Fanex.ExternalAccount.Module.LeftPanel.ViewModels.CustomerModel
@{
    var customerModel = JsonConvert.SerializeObject(this.Model, Formatting.None, new JsonSerializerSettings
    {
        ContractResolver = new CamelCasePropertyNamesContractResolver(),
        NullValueHandling = NullValueHandling.Ignore
    });

    var userId = ViewBag.UserId;
}
<link href="@Url.Content("~/Areas/CustomerSetting/Styles/jquery-ui.css")" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/Areas/CustomerSetting/Views/LeftPanel/Styles/LeftPanel.css")" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/Areas/CustomerSetting/Styles/Common.css")" rel="stylesheet" type="text/css" />
<div id="ng-app" data-ng-app="leftPanelApp" class="hidden" style="display: none">
    <div id="leftPanel" class="clearBoth" data-ng-controller="LeftPanelController">
        <div data-ng-controller="NoInfoController" data-ng-init="model.hide = model != null" data-ng-hide="model.hide" class="red">There is no information.</div>
        <div id="usernameInfo" data-ng-controller="LineInfoController" data-ng-hide="{{model==null}}">
            <div class="headerLevel" data-ng-repeat="person in personalInfo.downlines">
                <div class="title bold">{{person.text}}</div>
                <div class="floatLeft bold detail" data-ng-click="ViewUser('{{person.value}}')">{{person.value}}</div>
                <a class="floatRight home" href="~/User/InternalLogin/?username={{person.value}}" target="_blank"></a>
            </div>
        </div>
        <div id="customerInfo" data-ng-controller="PersonalInfoController" data-ng-hide="{{model==null}}">
            <div class="bold currentUser headerLevel">
                <div class="floatLeft bold"><a title="{{personalInfo.status.tooltip}}" class="detail2 {{personalInfo.backgroundColor.value}}" href="javascript:;" data-ng-click="ViewUser('{{personalInfo.currentLevel.value}}')">{{personalInfo.currentLevel.value}}</a></div>
                <div id="personalInfo" class="floatRight userDown" data-ng-click="TooglePersonalInfo()">&nbsp;&nbsp;</div>
            </div>
            <div class="clearBoth">
                <div class="title">
                    {{personalInfo.name.text}}
                </div>
                <div class="floatLeft red bold">{{personalInfo.name.value.decodeHtml()}}</div>
            </div>
            <div class="clearBoth">
                <div class="title">
                    {{personalInfo.nickname.text}}
                </div>
                <div class="floatLeft red bold">{{personalInfo.nickname.value.decodeHtml()}}</div>
            </div>
            <div class="clearBoth">
                <div class="title">
                    {{personalInfo.fax.text}}
                </div>
                <div class="floatLeft red bold">{{personalInfo.fax.value.decodeHtml()}}</div>
            </div>
            <div class="clearBoth">
                <div class="title">
                    {{personalInfo.phone.text}}
                </div>
                <div class="floatLeft red bold">{{personalInfo.phone.value.decodeHtml()}}</div>
            </div>
            <div class="clearBoth">
                <div class="title">
                    {{personalInfo.mobile.text}}
                </div>
                <div class="floatLeft red bold">{{personalInfo.mobile.value.decodeHtml()}}</div>
            </div>
        </div>
        <div class="clearBoth" style="display: inline"></div>
        <div id="viewInfo" data-ng-controller="ViewInfoController" data-ng-hide="{{model==null}}">
            <div id="btnCustList" data-ng-hide="{{personalInfo.roleId.value == 1}}" class="floatLeft ui-state-default list {{className}} btnDetail" data-ng-click="GetCustomerList()" style="height: 25px">{{personalInfo.custList.value}}</div>
            <input id="btnStatement" type="button" class="floatLeft ui-state-default list {{className}} btnDetail" data-ng-click="GetStatementList({{personalInfo.custId.value}})" value="Statement" />
            <input id="btnBalance" type="button" data-ng-hide="{{personalInfo.roleId.value != 2}}" class="floatLeft ui-state-default list {{className}} btnDetail" data-ng-click="GetBalance({{personalInfo.custId.value}})" value="Balance" />
        </div>
        <div id="balanceInfo" class="clearBoth" style="border:none" data-ng-controller="BalanceDownlineInfoController" data-ng-hide="{{model==null}}">
            <ul class="tabs">
                <li id="tab1"><a href="#tabs-1">Balance Info</a></li>
                <li id="tab2" data-ng-click="GetDownline({{personalInfo.custId.value}})"><a href="#tabs-2">Downline List</a></li>
            </ul>
            <div style="height: 208px" id="tabs-1" data-ng-init="balances=balanceInfo.balances;isHide=balances.length < 7" data-ng-controller="BalanceController">
                <div class="clearBoth">
                    <div class="balanceTitle">{{balanceInfo.currency.text}}</div>
                    <div class="floatLeftBalance R">{{balanceInfo.currency.value}}</div>
                </div>
                <div class="clearBoth">
                    <div class="balanceTitle">{{balances[0].text}}</div>
                    <div class="{{myClass0}}" data-ng-init="myClass0 = balances[0].value < 0">
                        <div class="floatLeftBalance R">{{balances[0].value.toFixed(2).formatNumber()}}</div>
                    </div>
                </div>
                <div class="clearBoth">
                    <div class="balanceTitle">{{balances[1].text}}</div>
                    <div class="{{myClass1}}" data-ng-init="myClass1 = balances[1].value < 0">
                        <div class="floatLeftBalance R">{{balances[1].value.toFixed(2).formatNumber()}}</div>
                    </div>
                </div>
                <div class="clearBoth">
                    <div class="balanceTitle">{{balances[2].text}}</div>
                    <div class="{{myClass2}}" data-ng-init="myClass2 = balances[2].value < 0">
                        <div class="floatLeftBalance R">{{balances[2].value.toFixed(2).formatNumber()}}</div>
                    </div>
                </div>
                <div class="clearBoth">
                    <div class="balanceTitle">{{balances[3].text}}</div>
                    <div class="{{myClass3}}" data-ng-init="myClass3 = balances[3].value < 0">
                        <div class="floatLeftBalance R" data-ng-hide="{{model.isUpdateCredit == false}}">
                            <a id="linkGivenCredit" href="javascript:;" data-ng-click="EditCredit()">{{balances[3].value.toFixed(2).formatNumber()}}</a>
                            <input style="text-align: right; margin-right: 0; height: 20px !important" data-ng-blur="RevertCredit({{preVal}})" data-ng-init="preVal=balances[3].value" maxlength="14" onkeyup="return Fanex.CustomerSetting.Core.CheckNumber(event, this, true)" onkeypress="return Fanex.CustomerSetting.Core.CheckNumber(event, this, true)" data-ng-keypress="UpdateCredit($event)" onpaste="return false;" oncut="return false;" id="givenCredit" type="text" data-ng-hide="true" />
                        </div>
                        <div style="color: #2489CE" title="You are not authorized on this function" class="floatLeftBalance R" data-ng-hide="{{model.isUpdateCredit == true}}">{{balances[3].value.toFixed(2).formatNumber()}}</div>
                    </div>
                </div>
                <div data-ng-hide="{{isHide}}" class="clearBoth">
                    <div class="balanceTitle">{{balances[4].text}}&nbsp;[<a href="javascript:;" data-ng-click="CreditDetail()">Detail</a>]</div>
                    <div class="{{myClass4}}" data-ng-init="myClass4 = balances[4].value < 0">
                        <div class="floatLeftBalance R">{{balances[4].value.toFixed(2).formatNumber()}}</div>
                    </div>
                </div>
                <div data-ng-hide="{{isHide}}" class="clearBoth">
                    <div class="balanceTitle">{{balances[5].text}}</div>
                    <div class="{{myClass5}}" data-ng-init="myClass5 = balances[5].value < 0">
                        <div class="floatLeftBalance R">{{balances[5].value.toFixed(2).formatNumber()}}</div>
                    </div>
                </div>
                <div data-ng-hide="{{isHide}}" class="clearBoth">
                    <div class="balanceTitle">{{balances[6].text}}</div>
                    <div class="{{myClass6}}" data-ng-init="myClass6 = balances[6].value < 0">
                        <div class="floatLeftBalance R">{{balances[6].value.toFixed(2).formatNumber()}}</div>
                    </div>
                </div>
                <div data-ng-hide="{{isHide}}" class="clearBoth">
                    <div class="balanceTitle">{{balances[7].text}}</div>
                    <div class="{{myClass7}}" data-ng-init="myClass7 = balances[7].value < 0">
                        <div class="floatLeftBalance R">{{balances[7].value.toFixed(2).formatNumber()}}</div>
                    </div>
                </div>
            </div>
            <div class="auto" id="tabs-2" data-ng-controller="DownlineListController" style="height: 208px">
                <div id="downlines" style="overflow: auto;" data-ng-hide="true">
                </div>
                <div id="page" data-ng-hide="true" class="floatLeft" style="height: 20px">
                    Page
                </div>
                <div id="pages" data-ng-init="Init()" data-ng-hide="true" style="height: 20px" class="floatLeft page">
                </div>
                <div id="nodownline" class="C" data-ng-hide="true">No downline list</div>
            </div>
        </div>
        <div id="settingInfo" style="border:none" class="clearBoth" data-ng-controller="SettingController" data-ng-hide="{{model==null}}">
            <ul class="tabs">
                <li><a href="#tab-1">Setting</a></li>
                <li><a href="#tab-2">Detail</a></li>
                <li><a href="#tab-3">Login</a></li>
                <li data-ng-click="GetOnline({{model.personalInfo.custId.value}})"><a href="#tab-4">Online List</a></li>
            </ul>
            <div id="tab-1" class="auto" style="height: 100%">
                <div class="floatLeft" data-ng-repeat="editItem in setting.editItems">
                    <div data-ng-hide="{{editItem.isHide || !editItem.visibled}}" class="settingEdit floatLeft" title="{{editItem.tooltip}}" data-ng-click="{{editItem.key}}()">{{editItem.text}}</div>
                </div>
                <br />
                <div class="floatLeft" data-ng-repeat="enableItem in setting.enableItems">
                    <div data-ng-hide="{{enableItem.isHide || !enableItem.visibled}}" class="settingTitle floatLeft" title="{{enableItem.tooltip}}">{{enableItem.text}}</div>
                    <div data-ng-hide="{{enableItem.isHide || !enableItem.visibled}}" class="floatLeft">
                        <input title="{{enableItem.tooltip}}" data-ng-disabled="{{enableItem.disabled}}" id="{{enableItem.key}}" type="checkbox" data-ng-model="enableItem.value"
                               data-ng-click="{{enableItem.key}}({{enableItem.value}}, '{{enableItem.key}}')" />
                    </div>
                </div>
            </div>
            <div class="auto" id="tab-2" data-ng-controller="SettingController" data-ng-init="Init()">
                <div class="subTab-parent">
                    <div data-ng-click="ViewSubTab('sub-edit')" id="sub-edit" class="floatLeft subTab subTab-active">Edit</div>
                    <div data-ng-click="ViewSubTab('sub-min-max')" id="sub-min-max" class="floatLeft subTab" data-ng-hide="model.personalInfo.roleId.value == 4 || model.personalInfo.roleId.value == 1">Min/Max PT</div>
                    <div data-ng-click="ViewSubTab('sub-super-pt')" id="sub-super-pt" class="floatLeft subTab" data-ng-hide="model.personalInfo.roleId.value != 1">Super PT</div>
                    <div data-ng-click="ViewSubTab('sub-master-pt')" id="sub-master-pt" class="floatLeft subTab" data-ng-hide="model.personalInfo.roleId.value != 1">Master PT</div>
                </div>
                <div style="clear: both"></div>
                <div id="edit">
                    <div class="detail icn-right" data-ng-repeat="item in setting.details">
                        <a data-ng-hide="{{item.isHide || !item.visibled}}" data-ng-click="{{item.key}}()" href="javascript:;">{{item.value}}</a>
                    </div>
                </div>
                <div id="minMax" style="display: none">
                    <div class="detail icn-right" data-ng-repeat="minMaxPt in setting.minMaxPts">
                        <a data-ng-hide="{{minMaxPt.isHide || !minMaxPt.visibled}}" data-ng-click="{{minMaxPt.key}}()" href="javascript:;">{{minMaxPt.value}}</a>
                    </div>
                </div>
                <div id="superPT" style="display: none">
                    <div class="detail icn-right" data-ng-repeat="superPt in setting.superPts">
                        <a data-ng-hide="{{superPt.isHide || !superPt.visibled}}" data-ng-click="Super{{superPt.key}}()" href="javascript:;">{{superPt.value}}</a>
                    </div>
                </div>
                <div id="masterPT" style="display: none">
                    <div class="detail icn-right" data-ng-repeat="masterPt in setting.masterPts">
                        <a data-ng-hide="{{masterPt.isHide || !masterPt.visibled}}" data-ng-click="Master{{masterPt.key}}()" href="javascript:;">{{masterPt.value}}</a>
                    </div>
                </div>
            </div>
            <div class="auto" style="height: 100%" id="tab-3" data-ng-controller="LoginController" data-ng-init="length = loginInfo.length">
                <div class="clearBoth">
                    <div class="balanceTitle bold">{{loginInfo[0].text}}</div>
                    <div class="floatLeftBalance normal R">{{loginInfo[0].value}}</div>
                </div>
                <div class="clearBoth">
                    <div class="balanceTitle bold">{{loginInfo[1].text}}</div>
                    <div class="floatLeftBalance normal R">{{loginInfo[1].value}}</div>
                </div>
                <div class="clearBoth">
                    <div class="balanceTitle bold">{{loginInfo[2].text}}</div>
                    <div class="floatLeftBalance normal R">{{loginInfo[2].value}}</div>
                </div>
                <div class="clearBoth">
                    <div class="balanceTitle bold" title="{{loginInfo[3].tooltip}}">{{loginInfo[3].text}}</div>
                    <div class="floatLeftBalance normal R">{{loginInfo[3].value}}</div>
                </div>
                <div class="clearBoth" data-ng-init="tmpId = model == null ? 0 : model.personalInfo.custId.value">
                    <div class="balanceTitle bold">
                        {{loginInfo[4].text}}&nbsp;[<a href="javascript:;" data-ng-click="ResetPassword({{tmpId}}, '{{model.personalInfo.currentLevel.value}}')">Change</a>]
                    </div>
                    <div class="floatLeftBalance normal R">
                        {{loginInfo[4].value}}
                    </div>
                </div>
                <div class="clearBoth">
                    <div class="balanceTitle bold">{{loginInfo[5].text}}</div>
                    <div class="floatLeftBalance normal R detail">
                        <a href="javascript:;" data-ng-click="ShowIp('{{loginInfo[5].value}}')">
                            {{loginInfo[5].value}}
                        </a>
                    </div>
                </div>
                <div class="clearBoth" data-ng-show="{{model.uplineHasSecurityCode && model.personalInfo.roleId.value > 1}}">
                    <div class="balanceTitle bold">{{loginInfo[6].text}}&nbsp;[<a href="javascript:;" data-ng-click="ResetSecurityCode({{model != null ? model.personalInfo.custId.value : 0}}, {{model != null ? model.personalInfo.roleId.value : 0}}, '{{model != null ? model.personalInfo.currentLevel.value : 0}}')">Change</a>]</div>
                    <div class="floatLeftBalance normal R">{{loginInfo[6].value}}</div>
                </div>
                <div class="clearBoth" data-ng-hide="{{length == 7}}">
                    <div class="balanceTitle bold">{{loginInfo[7].text}}</div>
                    <div class="floatLeftBalance normal R">{{loginInfo[7].value}}</div>
                </div>
                <div class="clearBoth" data-ng-hide="{{model.personalInfo.roleId.value == 1}}">
                    <div class="balanceTitle bold">{{loginInfo[8].text}}&nbsp;[<a href="javascript:;" data-ng-click="RemoveOTP({{model != null ? model.personalInfo.custId.value : 0}}, '{{model != null ? model.personalInfo.currentLevel.value : 0}}')">Remove</a>]</div>
                    <div class="floatLeftBalance normal R">{{loginInfo[8].value}}</div>
                </div>
            </div>
            <div class="auto" id="tab-4" data-ng-controller="OnlineListController" style="height: 178px">
                <div class="clearBoth">
                    <div class="floatLeft bold p10">No</div>
                    <div class="floatLeft bold p32">IP</div>
                    <div class="floatRight bold p58">Last Login</div>
                </div>
                <div id="onlines" data-ng-init="Init()" class="clearBoth" data-ng-hide="true">
                </div>
                <div id="online" data-ng-hide="true" class="C">This user is not online</div>
            </div>
        </div>
    </div>
    @Html.AntiForgeryToken()
</div>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/jquery.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/jquery.blockUI.1.33.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/jquery-ui-1.9.1.min.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/angular.min.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/Validators.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/Fanex.CustomerSetting.Core.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Views/LeftPanel/Scripts/BalanceController.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Views/LeftPanel/Scripts/BalanceDownlineInfoController.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Views/LeftPanel/Scripts/DownlineListController.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Views/LeftPanel/Scripts/LeftPanelController.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Views/LeftPanel/Scripts/LineInfoController.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Views/LeftPanel/Scripts/LoginController.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Views/LeftPanel/Scripts/NoInfoController.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Views/LeftPanel/Scripts/OnlineListController.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Views/LeftPanel/Scripts/PersonalInfoController.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Views/LeftPanel/Scripts/SettingController.js?v=999")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Views/LeftPanel/Scripts/SettingPTController.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Views/LeftPanel/Scripts/ViewInfoController.js")" type="text/javascript"></script>
<script type="text/javascript" src="@Url.Content("~/CustomerSetting/LeftPanel/SearchCustomer/GetData?custId=" + Request.QueryString["id"] + "&uplineId=" + Request.QueryString["uplineId"] + "&pageIndex=" + Request.QueryString["pageIndex"])">
</script>
<script type="text/javascript">
    var userId = parseInt('@userId');

    if (model) {
        $('#balanceInfo').tabs();
        $('#settingInfo').tabs();

        if (model.personalInfo.roleId.value == 1)
            $('#tab2').remove();
    }
    else {
        $('#balanceInfo').remove();
        $('#settingInfo').remove();
    }
</script>