@using Newtonsoft.Json
@using Newtonsoft.Json.Serialization
@model Fanex.ExternalAccount.Module.LeftPanel.ViewModels.CustomerModel
@{
    var customerModel = JsonConvert.SerializeObject(this.Model, Formatting.None, new JsonSerializerSettings
    {
        ContractResolver = new CamelCasePropertyNamesContractResolver(),
        NullValueHandling = NullValueHandling.Ignore
    });

    var userId = ViewBag.UserId;
}
<link href="@Url.Content("~/Areas/CustomerSetting/Styles/jquery-ui.css")" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/Areas/CustomerSetting/Views/LeftPanel/Styles/LeftPanel.css")" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/Areas/CustomerSetting/Styles/Common.css")" rel="stylesheet" type="text/css" />
<div id="ng-app" ng-app="leftPanelApp" class="hidden">
    <div id="leftPanel" class="clearBoth" ng-init="Init()" ng-controller="LeftPanelController">
        <div ng-controller="PersonalInfoController" ng-init="model.hide = model != null" ng-hide="model.hide" class="red">There is no information.</div>        
        <div id="usernameInfo" ng-controller="PersonalInfoController" ng-hide="{{model==null}}">
            <div class="headerLevel" ng-repeat="person in personalInfo.downlines">
                <div class="title bold">{{person.text}}</div>
                <div class="floatLeft bold detail" onclick="parent.Fanex.ExtAcc.ViewUser('{{person.value}}')">{{person.value}}</div>                
                <div class="floatRight home" ng-click="Login('{{person.value}}')">&nbsp;&nbsp;</div>
            </div>            
        </div>
        <div id="customerInfo" ng-controller="PersonalInfoController" ng-hide="{{model==null}}">
            <div class="bold currentUser headerLevel">
                <div class="floatLeft bold"><a class="detail2" href="javascript:;" onclick="parent.Fanex.ExtAcc.ViewUser('{{personalInfo.currentLevel.value}}')">{{personalInfo.currentLevel.value}}</a></div>
                <div id="personalInfo" class="floatRight userDown" ng-click="TooglePersonalInfo()">&nbsp;&nbsp;</div>
            </div>            
            <div class="clearBoth">
                <div class="title">
                    {{personalInfo.name.text}}</div>
                <div class="floatLeft red bold">{{personalInfo.name.value.decodeHtml()}}</div>
            </div>
            <div class="clearBoth">
                <div class="title">
                    {{personalInfo.nickname.text}}</div>
                <div class="floatLeft red bold">{{personalInfo.nickname.value.decodeHtml()}}</div>
            </div>
            <div class="clearBoth">
                <div class="title">
                    {{personalInfo.fax.text}}</div>
                <div class="floatLeft red bold">{{personalInfo.fax.value.decodeHtml()}}</div>
            </div>
            <div class="clearBoth">
                <div class="title">
                    {{personalInfo.phone.text}}</div>
                <div class="floatLeft red bold">{{personalInfo.phone.value.decodeHtml()}}</div>
            </div>
            <div class="clearBoth">
                <div class="title">
                    {{personalInfo.mobile.text}}</div>
                <div class="floatLeft red bold">{{personalInfo.mobile.value.decodeHtml()}}</div>
            </div>
        </div>
        <div id="viewInfo" ng-controller="PersonalInfoController" ng-hide="{{model==null}}">
            <input id="btnCustList" type="button" ng-hide="{{personalInfo.roleId.value == 1}}" class="floatLeft ui-state-default list {{className}} btnDetail" ng-click="GetCustomerList()" value="{{personalInfo.custList}}" />
            <input id="btnStatement" type="button" class="floatLeft ui-state-default list {{className}} btnDetail" ng-click="GetStatementList({{personalInfo.custId.value}})" value="Statement" />
            <input id="btnBalance" type="button" ng-hide="{{personalInfo.roleId.value != 2}}" class="floatLeft ui-state-default list {{className}} btnDetail" ng-click="GetBalance({{personalInfo.custId.value}})" value="Balance" />
        </div>        
        <div id="balanceInfo" class="clearBoth" style="border:none" ng-controller="PersonalInfoController" ng-hide="{{model==null}}">
            <ul class="tabs">
                <li id="tab1"><a href="#tabs-1">Balance Info</a></li>
                <li id="tab2"><a href="#tabs-2">Downline List</a></li>
            </ul>
            <div id="tabs-1" ng-init="balances=balanceInfo.balances;isHide=balances.length < 7" ng-controller="BalanceController">
                <div class="clearBoth">
                    <div class="balanceTitle">{{balanceInfo.currency.text}}</div>
                    <div class="floatLeftBalance R">{{balanceInfo.currency.value}}</div>
                </div>
                <div class="clearBoth">
                    <div class="balanceTitle">{{balances[0].text}}</div>
                    <div class="{{myClass0}}" ng-init="myClass0 = balances[0].value < 0">
                        <div class="floatLeftBalance R">{{balances[0].value.toFixed(2).formatNumber()}}</div>
                    </div>
                </div>
                <div class="clearBoth">
                    <div class="balanceTitle">{{balances[1].text}}</div>
                    <div class="{{myClass1}}" ng-init="myClass1 = balances[1].value < 0">
                        <div class="floatLeftBalance R">{{balances[1].value.toFixed(2).formatNumber()}}</div>
                    </div>
                </div>
                <div class="clearBoth">
                    <div class="balanceTitle">{{balances[2].text}}</div>
                    <div class="{{myClass2}}" ng-init="myClass2 = balances[2].value < 0">
                        <div class="floatLeftBalance R">{{balances[2].value.toFixed(2).formatNumber()}}</div>
                    </div>
                </div>
                <div class="clearBoth">
                    <div class="balanceTitle">{{balances[3].text}}</div>
                    <div class="{{myClass3}}" ng-init="myClass3 = balances[3].value < 0">
                        <div class="floatLeftBalance R">
                            <a id="linkGivenCredit" href="javascript:;" ng-click="EditCredit()">{{balances[3].value.toFixed(2).formatNumber()}}</a>
                            <input style="text-align: right; margin-right: 0" onblur="RevertCredit({{preVal}})" ng-init="preVal=balances[3].value" maxlength="14" onkeyup="return Fanex.CustomerSetting.Core.CheckNumber(event, this, true)" ng-keypress="UpdateCredit($event)" onpaste="return false;" oncut="return false;" id="givenCredit" type="text" value="{{balances[3].value.toFixed(2).formatNumber()}}" ng-hide="true" />
                        </div>
                    </div>
                </div>
                <div ng-hide="{{isHide}}" class="clearBoth">
                    <div class="balanceTitle">{{balances[4].text}}&nbsp;[<a href="javascript:;" ng-click="CreditDetail()">Detail</a>]</div>
                    <div class="{{myClass4}}" ng-init="myClass4 = balances[4].value < 0">
                        <div class="floatLeftBalance R">{{balances[4].value.toFixed(2).formatNumber()}}</div>
                    </div>
                </div>
                <div ng-hide="{{isHide}}" class="clearBoth">
                    <div class="balanceTitle">{{balances[5].text}}</div>
                    <div class="{{myClass5}}" ng-init="myClass5 = balances[5].value < 0">
                        <div class="floatLeftBalance R">{{balances[5].value.toFixed(2).formatNumber()}}</div>
                    </div>
                </div>
                <div ng-hide="{{isHide}}" class="clearBoth">
                    <div class="balanceTitle">{{balances[6].text}}</div>
                    <div class="{{myClass6}}" ng-init="myClass6 = balances[6].value < 0">
                        <div class="floatLeftBalance R">{{balances[6].value.toFixed(2).formatNumber()}}</div>
                    </div>
                </div>
                <div ng-hide="{{isHide}}" class="clearBoth">
                    <div class="balanceTitle">{{balances[7].text}}</div>
                    <div class="{{myClass7}}" ng-init="myClass7 = balances[7].value < 0">
                        <div class="floatLeftBalance R">{{balances[7].value.toFixed(2).formatNumber()}}</div>
                    </div>
                </div>
            </div>
            <div style="overflow: hidden" class="auto" id="tabs-2" ng-controller="DownlineListController">
                <div id="downlines" style="overflow: auto">
                    <div ng-hide="{{model.length == 0}}" class="downlineTitle percent50" ng-repeat="user in model">
                        <a class="detail2" href="javascript:;"  onclick="parent.Fanex.ExtAcc.ViewUser('{{user.text}}')">{{user.text}}</a>
                    </div>
                </div>
                <div ng-hide="{{pages.length == 1 || model.length == 0}}" class="floatLeft" style="height: 20px">Page
                </div>
                <div ng-init="Init()" ng-hide="{{pages.length == 1}}" style="height: 20px" class="floatLeft page" ng-repeat="page in pages"><a id="link-{{page.value}}" class="page" href="javascript:;" ng-click="ViewUser('{{personalInfo.currentLevel.value}}', {{page.value}})">{{page.value}}</a></div>
                <div class="C" ng-hide="{{model.length > 0}}">No downline list</div>
            </div>
        </div>
        <div id="settingInfo" style="border:none" class="clearBoth" ng-controller="SettingController" ng-hide="{{model==null}}">
            <ul class="tabs">
                <li><a href="#tab-1">Setting</a></li>
                <li><a href="#tab-2">Detail</a></li>
                <li><a href="#tab-3">Login</a></li>
                <li><a href="#tab-4">Online List</a></li>
            </ul>
            <div id="tab-1">
                <div class="floatLeft" ng-repeat="editItem in setting.editItems">
                    <div class="settingEdit" title="{{editItem.tooltip}}">{{editItem.text}}</div>
                </div>
                <div class="floatLeft" ng-repeat="enableItem in setting.enableItems">
                    <div class="settingTitle" title="{{enableItem.tooltip}}">{{enableItem.text}}</div>
                    <div class="floatLeft"><input type="checkbox" ng-model="enableItem.value" /></div>
                </div>    
            </div>
            <div class="auto" id="tab-2" ng-controller="SettingController" ng-init="Init()">
                <div class="detail icn-right" ng-repeat="item in setting.details">
                    <a ng-hide="item.isHide" ng-click="{{item.key}}()" href="javascript:;">{{item.value}}</a>
                </div>    
            </div>
            <div class="auto" id="tab-3" ng-controller="LoginController" ng-init="length = loginInfo.length">
                <div class="clearBoth">
                    <div class="balanceTitle bold">{{loginInfo[0].text}}</div>
                    <div class="floatLeftBalance normal R">{{loginInfo[0].value}}</div>
                </div>
                <div class="clearBoth">
                    <div class="balanceTitle bold">{{loginInfo[1].text}}</div>
                    <div class="floatLeftBalance normal R">{{loginInfo[1].value}}</div>
                </div>
                <div class="clearBoth">
                    <div class="balanceTitle bold">{{loginInfo[2].text}}</div>
                    <div class="floatLeftBalance normal R">{{loginInfo[2].value}}</div>
                </div>
                <div class="clearBoth">
                    <div class="balanceTitle bold" title="{{loginInfo[3].tooltip}}">{{loginInfo[3].text}}</div>
                    <div class="floatLeftBalance normal R">{{loginInfo[3].value}}</div>
                </div>
                <div class="clearBoth" ng-init="tmpId = model == null ? 0 : model.personalInfo.custId.value">
                    <div class="balanceTitle bold">{{loginInfo[4].text}}&nbsp;[<a href="javascript:;" ng-click="ResetPassword({{tmpId}}, '{{model.personalInfo.currentLevel.value}}')">Change</a>]
                    </div>
                    <div class="floatLeftBalance normal R">
                            {{loginInfo[4].value}}
                    </div>
                </div>
                <div class="clearBoth">
                    <div class="balanceTitle bold">{{loginInfo[5].text}}</div>
                    <div class="floatLeftBalance normal R detail">
                        <a href="javascript:;" onclick="javascript:parent.Fanex.ExtAcc.Customer.ShowIpInfo('{{loginInfo[5].value}}')">
                            {{loginInfo[5].value}}
                        </a>
                    </div>
                </div>
                <div class="clearBoth">
                    <div class="balanceTitle bold">{{loginInfo[6].text}}&nbsp;[<a href="javascript:;" onclick="javascript:;">Change</a>]</div>
                    <div class="floatLeftBalance normal R">{{loginInfo[6].value}}</div>
                </div>
                <div class="clearBoth" ng-hide="{{length == 7}}">
                    <div class="balanceTitle bold">{{loginInfo[7].text}}</div>
                    <div class="floatLeftBalance normal R">{{loginInfo[7].value}}</div>
                </div>
            </div>
            <div class="auto" id="tab-4" ng-controller="OnlineListController">
                <div class="clearBoth">
                    <div class="floatLeft bold p10">No</div>
                    <div class="floatLeft bold p32">IP</div>
                    <div class="floatLeft bold p58">Last Login</div>
                </div>
                <div ng-init="Init()" class="clearBoth" ng-hide="onlineList == null || onlineList.length == 0" ng-repeat="item in onlineList">
                    <div class="floatLeft percent10">{{item.index}}</div>
                    <div class="floatLeft percent32">
                        <a href="javascript:;" onclick="javascript:parent.Fanex.ExtAcc.Customer.ShowIpInfo('{{item.iP.text}}')">
                            {{item.iP.text}}
                        </a>
                    </div>
                    <div class="floatRight percent58">{{item.loginTime.text}}</div>
                </div>
                <div ng-hide="onlineList != null && onlineList.length > 0" class="C">This user is not online</div>    
            </div>
        </div>
    </div>
</div>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/jquery.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/jquery.blockUI.1.33.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/jquery-ui-1.9.1.min.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/angular.min.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/Validators.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/Fanex.CustomerSetting.Core.js")" type="text/javascript"></script>
<script type="text/javascript">
    var userId = parseInt('@userId');
    var model = $.parseJSON(Fanex.CustomerSetting.Core.DecodeHtml('@customerModel'));
    $(document).ready(function () {
        if (model) {
            $('#balanceInfo').tabs();
            $('#settingInfo').tabs();

            if (model.personalInfo.roleId.value == 1)
                $('#tab2').remove();
        }
        else {
            $('#balanceInfo').remove();
            $('#settingInfo').remove();
        }
    });
</script>
<script src="@Url.Content("~/Areas/CustomerSetting/Views/LeftPanel/Scripts/LeftPanelController.js")" type="text/javascript"></script>