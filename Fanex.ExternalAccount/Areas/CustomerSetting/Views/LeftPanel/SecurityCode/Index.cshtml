<link href="@Url.Content("~/Areas/CustomerSetting/Views/LeftPanel/Styles/LeftPanel.css")" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/Areas/CustomerSetting/Styles/Common.css")" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/Areas/CustomerSetting/Styles/Validators.css")" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/Areas/CustomerSetting/Views/LeftPanel/SecurityCode/Styles/SecurityCode.css")" rel="stylesheet" type="text/css" />
<div style="margin: 12px 2px; border: 1px solid #CCC">
    <div id="errMsg" style="display: none; margin: 2px" class="errMsg">
    </div>
    <table class="tableInfo" cellpadding="0" cellspacing="0" border="0" width="300px !important" style="width: 300px !important; margin: 2px">
        <tr>
            <td colspan="2" class="titleSC bold">Reset Security Code: <font color="#6dcff6">@ViewBag.Username</font></td>
        </tr>
        <tr>
            <td style="width: 50%" class="bold">Security Code</td>
            <td><input type="text" id="securityCode" maxlength="6" /></td>
        </tr>
        <tr>
            <td class="bold">Confirm Security Code</td>
            <td><input type="text" id="securityCodeConfirm" maxlength="6" /></td>
        </tr>
        <tr>
            <td colspan="2" class="C"><input type="button" class="buttonPopup" value="Submit" onclick="Update()" />
                <input type="button" class="buttonPopup" value="Reset" onclick="Reset()" />
            </td>
        </tr>
    </table>
    <div class="warning l" id="reportNote">
        <ul>
            <li>Security Code (SC) must be:
                <ul>
                    <li> Numeric digits only.</li>
                    <li> 6 digits from 0-9.</li>
                    <li> At least 2 different digits in the SC.</li>
                    <li> Not a forward run AND not a backward run number:
                        <ul>
                            <li> A "Forward Run" number is an integer whose digits are all in consecutive, ascending
                                order, left to right. </li>
                            <li> A "Backward Run" number is an integer whose digits are all in consecutive, descending
                                order, left to right.</li>
                            <li> For example: 123456, 456789, 765432, etc. are not allowed.</li>
                        </ul>
                    </li>
                </ul>
            </li>
        </ul>
    </div>
</div>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/jquery.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/jquery.blockUI.1.33.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/Validators.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/Fanex.CustomerSetting.Core.js")" type="text/javascript"></script>
<script type="text/javascript">
    var custId = parseInt('@ViewBag.custId');    
    var roleId = parseInt('@ViewBag.roleId');
</script>
<script src="@Url.Content("~/Areas/CustomerSetting/Views/LeftPanel/SecurityCode/Scripts/SecurityCode.js")" type="text/javascript"></script>