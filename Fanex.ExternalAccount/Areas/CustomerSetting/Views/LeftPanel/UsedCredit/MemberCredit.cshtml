@using Fanex.ExternalAccount.Utilities
@model Fanex.ExternalAccount.Module.LeftPanel.ViewModels.MemberUsedCreditModel
@{
    Layout = null;
}
<div class="manage-product">
    <div class="page-title">Credit Detail</div>
    <div id="tabs" style="border: none ; width: auto">
        <ul class="tabs">
            <li>
                <a href="#tabs-1">@ViewLang.Member</a>
            </li>

            @if (Model != null && Model.CashMemberUsedCreditItems != null && Model.CashMemberUsedCreditItems.Any())
            {
                <li>
                    <a href="#tabs-2">@ViewLang.CashMember</a>
                </li>
            }
        </ul>
        <div id="tabs-1">
            <table id="tblInner" class="table width-700" style="margin: 10px 0 10px 0">
                <thead>
                    <tr>
                        <th class="group-title" colspan="4">Active Account</th>
                    </tr>
                    <tr>
                        <th>Username</th>
                        <th>First Name</th>
                        <th>Last Name</th>
                        <th>Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || Model.MemberUsedCreditItems == null || !Model.MemberUsedCreditItems.Any())
                    {
                        <tr>
                            <td class="title C" colspan="4">There is no information available.</td>
                        </tr>
                    }
                    else
                    {
                        var index = 0;

                        foreach (var item in Model.ActiveMemberUsedCreditItems)
                        {
                            var className = index % 2 == 0 ? string.Empty : "odd";

                            <tr>
                                <td class="C @className">@item.Username.DecodeHtml()</td>
                                <td class="C @className">@item.FirstName.DecodeHtml()</td>
                                <td class="C @className">@item.LastName.DecodeHtml()</td>
                                <td class="R @className">@Html.Raw(item.Amount.ToStringFormat())</td>
                            </tr>

                            index++;
                        }
                        <tr>
                            <td class="total bold R" colspan="3">TOTAL</td>
                            <td class="total bold R">@Html.Raw(Model.TotalActiveMemberUsedCredit.ToStringFormat())</td>
                        </tr>
                    }
                </tbody>
            </table>

            <table id="tblInner" class="table width-700 margin-top-10">
                <thead>
                    <tr>
                        <th class="group-title" colspan="4">Inactive Account</th>
                    </tr>
                    <tr>
                        <th>Username</th>
                        <th>First Name</th>
                        <th>Last Name</th>
                        <th>Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || Model.MemberUsedCreditItems == null || !Model.MemberUsedCreditItems.Any())
                    {
                        <tr>
                            <td class="title C" colspan="4">There is no information available.</td>
                        </tr>
                    }
                    else
                    {
                        var index = 0;
                        var grandTotal = Model.TotalActiveMemberUsedCredit + Model.TotalInactiveMemberUsedCredit;

                        foreach (var item in Model.InactiveMemberUsedCreditItems)
                        {
                            var className = index % 2 == 0 ? string.Empty : "odd";

                            <tr>
                                <td class="C @className">@item.Username.DecodeHtml()</td>
                                <td class="C @className">@item.FirstName.DecodeHtml()</td>
                                <td class="C @className">@item.LastName.DecodeHtml()</td>
                                <td class="R @className">@Html.Raw(item.Amount.ToStringFormat())</td>
                            </tr>

                            index++;
                        }
                        <tr>
                            <td class="total bold R" colspan="3">TOTAL</td>
                            <td class="total bold R">@Html.Raw(Model.TotalInactiveMemberUsedCredit.ToStringFormat())</td>
                        </tr>
                        <tr>
                            <td class="bold R grandTotal" colspan="3">TOTAL Active + Inactive</td>
                            <td class="bold R grandTotal">@Html.Raw(grandTotal.ToStringFormat())</td>
                        </tr>
                    }
                    @if (Model.TotalActiveMemberUsedCredit + Model.TotalInactiveMemberUsedCredit != 0m)
                    {
                        <tr>
                            <td class="bold R defaultBgColor" colspan="4">
                                <input onclick="ResetInactiveAccountCredit(@ViewBag.CustId,2)" class="buttonPopup btnResetCredit" type="button" value="Reset All Closed Account Credit To 0" />
                                <input class="buttonPopup btnResetCredit" type="button" value="Reset All Account Credit To 0" onclick="ResetAllAccountCredit(@ViewBag.CustId,2)" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model != null && Model.CashMemberUsedCreditItems != null && Model.CashMemberUsedCreditItems.Any())
        {
            <div id="tabs-2">
                <table id="tblInner" class="table width-700" style="margin: 10px 0 10px 0">
                    <thead>
                        <tr>
                            <th class="group-title" colspan="4">Active Account</th>
                        </tr>
                        <tr>
                            <th>Username</th>
                            <th>First Name</th>
                            <th>Last Name</th>
                            <th>Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{var index = 0;

                            foreach (var item in Model.ActiveCashMemberUsedCreditItems)
                            {
                                var className = index % 2 == 0 ? string.Empty : "odd";

                                <tr>
                                    <td class="C @className">@item.Username.DecodeHtml()</td>
                                    <td class="C @className">@item.FirstName.DecodeHtml()</td>
                                    <td class="C @className">@item.LastName.DecodeHtml()</td>
                                    <td class="R @className">@Html.Raw(item.Amount.ToStringFormat())</td>
                                </tr>

                                index++;
                            }
                        }
                        <tr>
                            <td class="total bold R" colspan="3">TOTAL</td>
                            <td class="total bold R">@Html.Raw(Model.TotalActiveCashMemberUsedCredit.ToStringFormat())</td>
                        </tr>
                    </tbody>
                </table>

                <table id="tblInner" class="table width-700 margin-top-10">
                    <thead>
                        <tr>
                            <th class="group-title" colspan="4">Inactive Account</th>
                        </tr>
                        <tr>
                            <th>Username</th>
                            <th>First Name</th>
                            <th>Last Name</th>
                            <th>Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || Model.CashMemberUsedCreditItems == null || !Model.CashMemberUsedCreditItems.Any())
                        {
                            <tr>
                                <td class="title C" colspan="4">There is no information available.</td>
                            </tr>
                        }
                        else
                        {
                            index = 0;
                            var grandTotal = Model.TotalActiveCashMemberUsedCredit + Model.TotalInactiveCashMemberUsedCredit;

                            foreach (var item in Model.InactiveCashMemberUsedCreditItems)
                            {
                                var className = index % 2 == 0 ? string.Empty : "odd";

                                <tr>
                                    <td class="C @className">@item.Username.DecodeHtml()</td>
                                    <td class="C @className">@item.FirstName.DecodeHtml()</td>
                                    <td class="C @className">@item.LastName.DecodeHtml()</td>
                                    <td class="R @className">@Html.Raw(item.Amount.ToStringFormat())</td>
                                </tr>

                                index++;
                            }
                            <tr>
                                <td class="total bold R" colspan="3">TOTAL</td>
                                <td class="total bold R">@Html.Raw(Model.TotalInactiveCashMemberUsedCredit.ToStringFormat())</td>
                            </tr>
                            <tr>
                                <td class="bold R grandTotal" colspan="3">TOTAL Active + Inactive</td>
                                <td class="bold R grandTotal">@Html.Raw(grandTotal.ToStringFormat())</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
@Html.AntiForgeryToken()
<script>
    $("#tabs").tabs();
</script>
<script src="@Url.Content("~/Areas/CustomerSetting/Views/LeftPanel/UsedCredit/Scripts/MasterAgentUsedCreditController.js")" type="text/javascript"></script>
