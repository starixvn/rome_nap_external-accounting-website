@using Newtonsoft.Json
@using Newtonsoft.Json.Serialization
@using Fanex.ExternalAccount.Utilities
@model Fanex.ExternalAccount.Module.LeftPanel.ViewModels.MemberUsedCreditModel
<div style="width: 702px; margin: 3px 0 0 3px">
    <table width="100%" id="tblInner" border="1" cellpadding="0" cellspacing="0">
    <tr>
        <td colspan="4"><div class="bgTitle titleForm creditDetail">Credit Detail</div></td>            
        </tr>
        <tr>
            <td colspan="4"><div class="C bgTitle titleForm creditDetail">Active Account</div></td>            
        </tr>
        <tr>
            <td class="C bold" style="background: #D4E3EB">Username</td>
            <td class="C bold" style="background: #D4E3EB">First Name</td>
            <td class="C bold" style="background: #D4E3EB">Last Name</td>
            <td class="C bold" style="background: #D4E3EB">Amount</td>        
        </tr>
        @if (Model == null || Model.MemberUsedCreditItems == null || Model.MemberUsedCreditItems.Count == 0)
        {
            <tr>
                <td class="title C" colspan="4">There is no information available.</td>            
            </tr>
        }
        else
        {
            int index = 0;
            string className = string.Empty;
            
            foreach (var item in Model.ActiveMemberUsedCreditItems)
            {
                className = index % 2 == 0 ? string.Empty : "odd";    
                
                 <tr>
                    <td class="C @className">@item.Username.DecodeHtml()</td>
                    <td class="C @className">@item.FirstName.DecodeHtml()</td>
                    <td class="C @className">@item.LastName.DecodeHtml()</td>
                    <td class="R @className">@Html.Raw(item.Amount.ToStringFormat())</td>
                </tr>   
                
                index++;
            }            
            <tr>
                <td class="total bold R" colspan="3">TOTAL</td>
                <td class="total bold R">@Html.Raw(Model.TotalActiveMemberUsedCredit.ToStringFormat())</td>
            </tr>
        }        
    </table>
    <div>&nbsp;</div>
    <table width="100%" id="tblInner" border="1" cellpadding="0" cellspacing="0">
        <tr>
            <td colspan="4"><div class="C bgTitle titleForm creditDetail">Inactive Account</div></td>            
        </tr>
        <tr>
            <td class="C bold" style="background: #D4E3EB">Username</td>
            <td class="C bold" style="background: #D4E3EB">First Name</td>
            <td class="C bold" style="background: #D4E3EB">Last Name</td>
            <td class="C bold" style="background: #D4E3EB">Amount</td>        
        </tr>
        @if (Model == null || Model.MemberUsedCreditItems == null || Model.MemberUsedCreditItems.Count == 0)
        {
            <tr>
                <td class="title C" colspan="4">There is no information available.</td>            
            </tr>
        }
        else
        {
            int index = 0;
            string className = string.Empty;
            decimal grandTotal = Model.TotalActiveMemberUsedCredit + Model.TotalInactiveMemberUsedCredit;
            
            foreach (var item in Model.InactiveMemberUsedCreditItems)
            {
                className = index % 2 == 0 ? string.Empty : "odd";    
                
                 <tr>
                    <td class="C @className">@item.Username.DecodeHtml()</td>
                    <td class="C @className">@item.FirstName.DecodeHtml()</td>
                    <td class="C @className">@item.LastName.DecodeHtml()</td>
                    <td class="R @className">@Html.Raw(item.Amount.ToStringFormat())</td>
                </tr>   
                
                index++;
            }            
            <tr>
                <td class="total bold R" colspan="3">TOTAL</td>
                <td class="total bold R">@Html.Raw(Model.TotalInactiveMemberUsedCredit.ToStringFormat())</td>
            </tr>
            <tr>
                <td class="bold R grandTotal" colspan="3">TOTAL Active + Inactive</td>
                <td class="bold R grandTotal">@Html.Raw(grandTotal.ToStringFormat())</td>
            </tr>            
        }
        @if (Model.TotalActiveMemberUsedCredit + Model.TotalInactiveMemberUsedCredit != 0m)
        {
            <tr>
                <td class="bold R defaultBgColor" colspan="4">
                    <input onclick="ResetInactiveAccountCredit(@ViewBag.CustId)" class="buttonPopup btnResetCredit" type="button" value="Reset All Closed Account Credit To 0" />
                    <input class="buttonPopup btnResetCredit" type="button" value="Reset All Account Credit To 0" onclick="ResetAllAccountCredit(@ViewBag.CustId)" />
                </td>                
            </tr>
        }
    </table>
</div>
<script src="@Url.Content("~/Areas/CustomerSetting/Views/LeftPanel/UsedCredit/Scripts/MasterAgentUsedCreditController.js")" type="text/javascript"></script>