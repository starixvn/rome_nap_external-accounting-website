@using Fanex.ExternalAccount.Utilities
@model Fanex.ExternalAccount.Module.LeftPanel.ViewModels.MasterAgentUsedCreditModel
@{
    Layout = null;
}
<div class="page-title">Credit Detail</div>
<table id="tblInner" class="table width-700">
    <thead>
        <tr>
            <th>Username</th>
            <th>Given Credit</th>
            <th>Used Credit</th>
        </tr>
    </thead>
    <tbody>
        @if (Model == null || Model.MasterAgentUsedCreditItems == null || Model.MasterAgentUsedCreditItems.Count == 0)
        {
            <tr>
                <td class="title C" colspan="3">There is no information available.</td>
            </tr>
        }
        else
        {
            int index = 0;
            string className = string.Empty;

            foreach (var item in Model.MasterAgentUsedCreditItems)
            {
                className = index % 2 == 0 ? string.Empty : "odd";

                <tr>
                    <td class="C @className">@item.Username.DecodeHtml()</td>
                    <td class="R @className">@Html.Raw(item.GivenCredit.ToStringFormat())</td>
                    <td class="R @className">@Html.Raw(item.UsedCredit.ToStringFormat())</td>
                </tr>

                index++;
            }
            <tr>
                <td class="total bold C">TOTAL</td>
                <td class="total bold R">@Html.Raw(Model.Total.GivenCredit.ToStringFormat())</td>
                <td class="total bold R">@Html.Raw(Model.Total.UsedCredit.ToStringFormat())</td>
            </tr>
        }
    </tbody>   
</table>
@Html.AntiForgeryToken()