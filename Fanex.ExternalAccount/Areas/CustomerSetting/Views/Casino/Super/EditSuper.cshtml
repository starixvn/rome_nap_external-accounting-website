@using Fanex.CustomerSetting.Module.Core
@using Fanex.CustomerSetting.Module.Casino.ViewModels
@using Newtonsoft.Json
@using Newtonsoft.Json.Serialization
@using Fanex.CustomerSetting.Module.Casino.Resources
﻿@using Fanex.ExternalAccount.Core.Context
@model CasinoSettingModel
@{
    Layout = "~/Areas/CustomerSetting/Views/Casino/Shared/_Layout.cshtml";
    var isPtByGameType = false;// For testing purpose/super level only
                               //var isPtByGameType = Model.IsPtByGameType;
                               //Model.IsPtByGameType = isPtByGameType;// For testing purpose only
    var settingModel = JsonConvert.SerializeObject(Model, Formatting.None, new JsonSerializerSettings
    {
        ContractResolver = new CamelCasePropertyNamesContractResolver(),
        NullValueHandling = NullValueHandling.Ignore
    });
}
<div style="width: 1100px">
    <div id="errMsg" style="display: none;" class="successMsg">
    </div>
    <div id="arrowUpDown" class="collapse">
    </div>
    <div id="names" style="display: none;" class="names">
    </div>
    <div>
        @Html.Action("CustomerInfo", "CasinoCustomer", new { area = string.Empty, id = Utils.ToInt32(Request.QueryString["id"]), uplineId = Utils.ToInt32(Request.QueryString["uplineId"]) })
    </div>
    <div>
        <div style="border-right: none" id="settingContainer" data-ng-controller="EditSuperController">
            <table class="tableInfo" border="1" cellpadding="0" cellspacing="0">
                <tr>
                    <td class="headerPositionTaking" style="border-right: 1px solid #ccc;">
                        @NGCasinoLang.positiontaking
                    </td>
                </tr>
                <tr data-ng-controller="GameGroupController" data-ng-repeat="gameGroup in customer.gameGroups"
                    data-ng-finish-render="rendered">
                    <td class="noneBorderBottom noneBorderTop noneBorderL">
                        <table class="tableInfo" border="1" cellpadding="0" cellspacing="0">
                            <tr ng-if="$first">
                                <td class="gameGroupWidth noneBorderL  noneBorderR">
                                    &nbsp;
                                </td>
                                <td class="gameTypeWidth noneBorderL  R"></td>
                                <td class="ptTitle  tdWidthSuper">
                                    @NGCasinoLang.lblSuperMaxPosition
                                </td>
                                <td class="ptTitle  tdWidthSuper">
                                    @NGCasinoLang.lblSuperMinPosition
                                </td>
                                <td class="ptTitle  tdWidthSuper noneBorderR">
                                    @NGCasinoLang.lblSuperCommission
                                </td>
                            </tr>
                            <tr>
                                <td rowspan="{{gameGroup.gameTypes.length + 1}}" class="gameGroupWidth gameTitle noneBorderTop">
                                    {{gameGroup.gameGroupName}}
                                </td>
                                <td class="gameTypeWidth ptTitle R noneBorderTop noneBorderL">
                                    @NGCasinoLang.lblGroupSetting
                                </td>
                                <td class="C ptTitle noneBorderTop tdWidthSuper">
                                    <span class="spanPT" ptarea="true" min="0" max="s4" selected="s3" data-ng-model="setting">
                                    </span>
                                </td>
                                <td class="C ptTitle noneBorderTop tdWidthSuper">
                                    <span class="spanPT" ptarea="true" min="0" max="s3" selected="n3" data-ng-model="setting">
                                    </span>
                                </td>
                                <td class="C ptTitle noneBorderTop tdWidthSuper" style="border-right: 0px none">
                                    <span class="spanPT" ptarea="true" min="0" max="sco" selected="mco" data-ng-model="setting"
                                          iscomm="true"></span>
                                </td>
                            </tr>
                            @if (isPtByGameType)
                            {
                                <tr data-ng-controller="GameTypeController" data-ng-repeat="gameType in gameGroup.gameTypes">
                                    <td colspan="5" style="border: none">
                                        <table class="tableInfo" cellpadding="0" cellspacing="0">
                                            <tr data-ng-hide="customer.isUnchecked">
                                                <td rowspan="2" class="gameTypeWidth R noneBorderL noneBorderT">
                                                    {{gameType.gameTypeName}}
                                                </td>
                                                <td class="C noneBorderT tdWidthSuper">
                                                    <span class="spanPT" showbutton="false" ptarea="true" min="0" max="s4" selected="s3"
                                                          data-ng-model="setting"></span>
                                                </td>
                                                <td class="C noneBorderT tdWidthSuper">
                                                    <span class="spanPT" showbutton="false" ptarea="true" min="0" max="s3" selected="n3"
                                                          data-ng-model="setting"></span>
                                                </td>
                                                <td class="noneBorderR C noneBorderT noneBorderRight tdWidthSuper">
                                                    <span class="spanPT" showbutton="false" ptarea="true" min="0" max="sco" selected="mco"
                                                          data-ng-model="setting" iscomm="true"></span>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td class="gameTypeWidth R noneBorderL noneBorderT" data-ng-hide="customer.isUnchecked == false">
                                                    {{gameType.gameTypeName}}
                                                </td>
                                                <td colspan="3" class="noneBorderRight noneBorderT stake-level">
                                                    <span>@NGCasinoLang.lblBettingLimit: </span>
                                                    <span data-ng-controller="BettingLimitController" data-ng-repeat="stake in gameType.bettingLimits">
                                                        <input type="checkbox" data-ng-model="stake.isChecked" /><span>{{stake.stakeLevelName}}</span>
                                                    </span>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                <tr data-ng-controller="GameTypeController" data-ng-repeat="gameType in gameGroup.gameTypes">
                                    <td class="gameTypeWidth R noneBorderL">
                                        {{gameType.gameTypeName}}
                                    </td>
                                    <td colspan="5" class="noneBorderR stake-level">
                                        <span>@NGCasinoLang.lblBettingLimit: </span>
                                        <span data-ng-controller="BettingLimitController" data-ng-repeat="stake in gameType.bettingLimits" >
                                            <input type="checkbox" data-ng-model="stake.isChecked" /><span>{{stake.stakeLevelName}}</span>
                                        </span>
                                    </td>
                                </tr>
                            }
                        </table>
                    </td>
                </tr>
            </table>
        </div>
    </div>
</div>
@section Scripts{
    <script src="@Url.Content("~/Areas/CustomerSetting/Views/Casino/Scripts/EditSuperController.js")" type="text/javascript"></script>
    <script type="text/javascript">
        var customerSetting = $.parseJSON(Fanex.CustomerSetting.Core.DecodeHtml('@settingModel'));
        var isBelongToSpecialGroups = @Json.Encode(CurrentSession.Instance.IsBelongToSpecialGroups);
        $(document).ready(function () {
            //var casinoController = new CasinoController(userId, username, isMultiple, custIds, usernames);
            var casinoController = new CasinoController(uplineId, '');

            $('.buttonPopup').bind('click', function () {
                casinoController.Update();
            });

            //$('.buttonPopup').remove();
        });
    </script>
}