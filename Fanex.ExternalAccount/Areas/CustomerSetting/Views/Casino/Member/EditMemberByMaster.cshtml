@using Fanex.CustomerSetting.Module.Core
@using Fanex.CustomerSetting.Module.Casino.ViewModels
@using Newtonsoft.Json
@using Newtonsoft.Json.Serialization
@using Fanex.CustomerSetting.Module.Casino.Resources
@using Fanex.ExternalAccount.Core.Context

@model CasinoSettingModel
@{
    //var isPtByGameType = true;// For testing purpose only
    var isPtByGameType = Model.IsPtByGameType;
    //Model.IsPtByGameType = isPtByGameType;// For testing purpose only
    var settingModel = JsonConvert.SerializeObject(Model, Formatting.None, new JsonSerializerSettings
        {
            ContractResolver = new CamelCasePropertyNamesContractResolver(),
            NullValueHandling = NullValueHandling.Ignore
        });    
}
<div id="ng-app" style="display: none; width: 1024px" data-ng-app="settingApp">
    <div id="errMsg" style="display: none;" class="successMsg">
    </div>
    <div id="arrowUpDown" class="collapse">
    </div>
    <div id="names" style="display: none;" class="names">
    </div>    
    <div>
        <input class="buttonPopup" type="button" value="Submit" />
    </div>
    <div id="info">
        @Html.Action("CustomerInfo", "CasinoCustomer", new { area = string.Empty, id = Utils.ToInt32(Request.RequestContext.RouteData.Values["id"]), uplineId = Utils.ToInt32(Request.RequestContext.RouteData.Values["uplineId"]) })
    </div>    
    <div>
        <div class="headerPositionTaking" style="border: 1px solid #ccc; border-top: 0">
            @NGCasinoLang.positiontaking
        </div>                                                                                                                                                                                                                                                                                                                                                            
        <div style="border-right: none" id="settingContainer" data-ng-controller="EditMemberByMasterController">
            <table class="tableInfo" border="1" cellpadding="0" cellspacing="0">
                <tr>
                    <td class="gameGroupWidth noneBorderL noneBorderTop noneBorderR">&nbsp;</td>
                    <td class="gameTypeWidth noneBorderL noneBorderTop">&nbsp;</td>
                    <td ng-class="{'memberWidth' : isDisableAutoMPT, 'tdWidth' : !isDisableAutoMPT}" class="ptTitle noneBorderTop">@NGCasinoLang.lblMasterPT</td>
                     <td data-ng-hide="isDisableAutoMPT" class="ptTitle noneBorderTop masterAutoPtWidth">@NGCasinoLang.lblMasterAutoPT</td>
                    <td ng-class="{'memberWidth' : isDisableAutoMPT, 'tdWidth' : !isDisableAutoMPT}" class="ptTitle noneBorderTop">@NGCasinoLang.lblAgentPT</td>
                </tr>
                <tr data-ng-controller="GameGroupController" data-ng-repeat="gameGroup in customer.gameGroups" data-ng-finish-render="rendered">
                    <td class="gameGroupWidth gameTitle noneBorderTop">{{gameGroup.gameGroupName}}</td>
                    <td colspan="4" class="noneBorderBottom noneBorderTop">
                        <table class="tableInfo" border="1" cellpadding="0" cellspacing="0">
                            <tr>
                                <td class="gameTypeWidth ptTitle R noneBorderTop noneBorderL">@NGCasinoLang.lblGroupSetting</td>
                                <td ng-class="{'memberWidth' : isDisableAutoMPT, 'tdWidth' : !isDisableAutoMPT}" class="C noneBorderTop">
                                    <span islabel="{{gameGroup.im2}}" enable="gameGroup.im1" data-ng-init="gameGroup.l4 = gameGroup.s4 - gameGroup.m2" class="spanPT" ptarea="true" min="n2" max="l4" selected="m3" data-ng-model="setting"></span>
                                </td>
                                <td data-ng-hide="isDisableAutoMPT" class="C ptTitle noneBorderTop masterAutoPtWidth">
                                    <input type="checkbox" data-ng-model="gameGroup.im1" />
                                    <span enable="gameGroup.im1 == false" class="spanPT" ptarea="false" min="0" max="s4" selected="um1" data-ng-model="setting"></span>
                                </td>
                                <td ng-class="{'memberWidth' : isDisableAutoMPT, 'tdWidth' : !isDisableAutoMPT}" class="C noneBorderTop" style="border-right: 0px none">
                                    <span>{{gameGroup.m2}}</span>
                                </td>
                            </tr>         
                            @if (isPtByGameType)
                            {                
                            <tr data-ng-controller="GameTypeController" data-ng-repeat="gameType in gameGroup.gameTypes">
                                <td colspan="4" style="border: none">
                                    <table class="tableInfo" cellpadding="0" cellspacing="0">
                                        <tr>
                                            <td  class="gameTypeWidth R noneBorderL noneBorderT">
                                                {{gameType.gameTypeName}}
                                            </td>
                                            <td ng-class="{'memberWidth' : isDisableAutoMPT, 'tdWidth' : !isDisableAutoMPT}" class="C noneBorderTop">
                                                <span islabel="{{gameType.im2}}" enable="gameType.im1" showbutton="false" class="spanPT" data-ng-init="gameType.l4 = gameType.s4 - gameType.m2" class="spanPT" ptarea="true" min="n2" max="l4" selected="m3" data-ng-model="setting"></span>
                                            </td>
                                            <td data-ng-hide="isDisableAutoMPT" class="C ptTitle noneBorderTop masterAutoPtWidth">
                                                <input type="checkbox" data-ng-model="gameType.im1" />
                                                <span showbutton="false" enable="gameType.im1 == false" class="spanPT" ptarea="true" min="0" max="s4" selected="um1" data-ng-model="setting"></span>
                                            </td>
                                            <td ng-class="{'memberWidth' : isDisableAutoMPT, 'tdWidth' : !isDisableAutoMPT}" class="C noneBorderTop" style="border-right: 0px none">
                                                <span>{{gameGroup.m2}}</span>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td colspan="4" class="noneBorderRight"><span>@NGCasinoLang.lblBettingLimit: </span>
                                                <span data-ng-controller="BettingLimitController" data-ng-repeat="stake in gameType.bettingLimits">
                                                    <input type="checkbox" data-ng-model="stake.isChecked" /><span>{{stake.stakeLevelName}}</span>
                                                </span>
                                            </td>
                                        </tr>
                                    </table>
                                </td>                    
                            </tr>                
                            }
                            else
                            {
		                    <tr data-ng-controller="GameTypeController" data-ng-repeat="gameType in gameGroup.gameTypes">
                                <td class="gameTypeWidth R noneBorderL">
                                    {{gameType.gameTypeName}}
                                </td>
                                <td colspan="4" class="noneBorderR"><span>@NGCasinoLang.lblBettingLimit: </span>
                                    <span data-ng-controller="BettingLimitController" data-ng-repeat="stake in gameType.bettingLimits">
                                        <input type="checkbox" data-ng-model="stake.isChecked" /><span>{{stake.stakeLevelName}}</span>
                                    </span>
                                </td>
                            </tr>
                            }
                        </table>
                    </td>                    
                </tr>                                        
            </table>            
        </div>
    </div>
    <div>
        <input class="buttonPopup" type="button" value="Submit" />
    </div>
</div>    
<script src="@Url.Content("~/Areas/CustomerSetting/Views/Casino/Scripts/EditMemberByMasterController.js")" type="text/javascript"></script>
<script type="text/javascript">
    var customerSetting = $.parseJSON(Fanex.CustomerSetting.Core.DecodeHtml('@settingModel'));
    try {
        var casinoController = new CasinoController(parseInt('@CurrentSession.Instance.UserId'), '@CurrentSession.Instance.UserName', parent.Fanex.ExtAcc.Customer.IsMultiple, parent.Fanex.ExtAcc.Customer.Ids(), parent.Fanex.ExtAcc.Customer.Names());

        $('.buttonPopup').bind('click', function () {
            casinoController.Update(function (errorCode, errorMessage) {
                if (errorCode == 0) {
                    var timeout = setTimeout(function () {
                        clearTimeout(timeout);

                        if (parent.document.getElementById('customerListGrid')) {
                            parent.Fanex.ExtAcc.Customer.CallBackCustomerList();
                            parent.Fanex.ExtAcc.Form.Close();
                        }
                        else {
                            document.location.reload(true);
                        }
                    }, 2000);
                }
            });
        });
    } catch (e) {
    }

    var timeout = setTimeout(function () {
        clearTimeout(timeout);
        $('#chkEnable').attr('disabled', true);
        $('#maxTransfer').attr('disabled', true);
        $('#isAutoReset').attr('disabled', true);
    }, 1000);
</script>