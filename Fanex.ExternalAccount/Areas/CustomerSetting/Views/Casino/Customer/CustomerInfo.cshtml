@using Fanex.CustomerSetting.Module.Core
@using Fanex.CustomerSetting.Module.Casino.Resources
@{
    var id = Utils.ToInt32(Request.QueryString["id"]);
    var uplineId = Utils.ToInt32(Request.QueryString["uplineId"]);

}
<link rel="stylesheet" type="text/css" href="@Url.Content("~/Areas/CustomerSetting/Styles/Validators.css")" />
<link rel="stylesheet" type="text/css" href="@Url.Content("~/Areas/CustomerSetting/Styles/Common.css")" />
<link rel="stylesheet" type="text/css" href="@Url.Content("~/Areas/CustomerSetting/Views/Casino/Styles/Casino.css")" />
<div class="custInfo" data-ng-controller="CustomerController">
    <div class="headerPositionTaking noneBorderLR custInfoHeader">
        @NGCasinoLang.lblCustomerInformation
    </div>
    <div id="userInfo">
        <table cellpadding="0" cellspacing="0" class="tableInfo">
            <tr>
                <td class="tdTitleLeft">@NGCasinoLang.lblUsername</td>
                <td style="width: 35%"><span>{{CustomerModel.userName}}</span></td>
                <td class="tdTitleRight">@NGCasinoLang.lblNickname</td>
                <td class="noneBorderRight"><span>{{CustomerModel.userName2}}</span></td>
            </tr>
            <tr>
                <td class="tdTitleLeft">@NGCasinoLang.lblFirstName</td>
                <td><span>{{CustomerModel.firstName.decodeHtml()}}</span></td>
                <td class="tdTitleRight">@NGCasinoLang.lblPhone</td>
                <td class="noneBorderRight"><span>{{CustomerModel.phone.decodeHtml()}}</span></td>
            </tr>
            <tr>
                <td class="tdTitleLeft">@NGCasinoLang.lblLastName</td>
                <td><span>{{CustomerModel.lastName.decodeHtml()}}</span></td>
                <td class="tdTitleRight">@NGCasinoLang.lblMobilePhone</td>
                <td class="noneBorderRight"><span>{{CustomerModel.mobilePhone.decodeHtml()}}</span></td>
            </tr>
            <tr>
                <td class="tdTitleLeft">@NGCasinoLang.lblFax</td>
                <td><span>{{CustomerModel.fax.decodeHtml()}}</span></td>
                <td class="tdTitleRight">@NGCasinoLang.ProductStatus</td>
                <td class="noneBorderRight">
                    <div style="float: left; height: 24px">
                        <input type="checkbox" id="chkEnable" style="margin-top: 5px"
                               data-ng-init="CustomerModel.originalCasinoEnabled = !CustomerModel.casinoDisabled; CustomerModel.casinoEnabled = !CustomerModel.casinoDisabled && (CustomerModel.casinoSync || !CustomerModel.uplineDisabledCasino)"
                               data-ng-model="CustomerModel.casinoEnabled"
                               data-ng-change="CustomerModel.casinoDisabled = !CustomerModel.casinoEnabled;"
                               data-ng-disabled="CustomerModel.uplineDisabledCasino" />
                        <label for="chkEnable" ng-switch="{{CustomerModel.roleId}}">
                            <span ng-switch-when="4">@NGCasinoLang.Super</span>
                            <span ng-switch-when="3">@NGCasinoLang.Master</span>
                            <span ng-switch-when="2">@NGCasinoLang.Agent</span>
                            <span ng-switch-default>@NGCasinoLang.Member</span>
                        </label>
                    </div>
                </td>
            </tr>
        </table>
    </div>
    <div id="statusInfo" class="statusInfo">
        <input type="checkbox" id="chkEnable" style="margin-top: 5px"
               data-ng-init="CustomerModel.originalCasinoEnabled = !CustomerModel.casinoDisabled; CustomerModel.casinoEnabled = !CustomerModel.casinoDisabled && (CustomerModel.casinoSync || !CustomerModel.uplineDisabledCasino)"
               data-ng-model="CustomerModel.casinoEnabled"
                data-ng-change="CustomerModel.casinoDisabled = !CustomerModel.casinoEnabled;"
               data-ng-disabled="CustomerModel.uplineDisabledCasino" />
        <label for="chkEnable" ng-switch="{{CustomerModel.roleId}}">
            <span ng-switch-when="4">@NGCasinoLang.Super</span>
            <span ng-switch-when="3">@NGCasinoLang.Master</span>
            <span ng-switch-when="2">@NGCasinoLang.Agent</span>
            <span ng-switch-default>@NGCasinoLang.Member</span>
        </label>
    </div>
    <div class="headerPositionTaking noneBorderLR noneBorderBottom">
        <span data-ng-bind="CustomerModel.roleId != 1 ? '@NGCasinoLang.lblMemberWinLimit' : '@NGCasinoLang.lblMemberWinLossLimit'"></span>
    </div>
    <table cellpadding="0" cellspacing="0" class="tableInfo">
        <tr>
            <td style="width: 20%" class="noneBorderLeft tdTitleRight">@NGCasinoLang.lblMaximumWin</td>
            <td style="width: 30%">
                <div>
                    <select id="maxWinLimit" style="width: 80px !important" data-ng-model="CustomerModel.memberWinLimit.maximumWin" data-ng-options="opt.Key for opt in CustomerModel.memberWinLimit.maximumWinLimits track by opt.Value"></select>&nbsp;@NGCasinoLang.lblOnGivenCredit
                </div>
            </td>
            <td class="noneBorderRight" rowspan="{{CustomerModel.roleId != 1 ? 3 : 4}}"><div><label><input type="checkbox" data-ng-disabled="CustomerModel.memberWinLimit.isDailyAutoResetUpline == false && CustomerModel.roleId != 4" data-ng-model="CustomerModel.memberWinLimit.isDailyAutoReset" />@NGCasinoLang.lblDailyAutoResetLimit</label></div></td>
        </tr>
        <tr>
            <td class="noneBorderLeft tdTitleRight">@NGCasinoLang.lblMaxLoss</td>
            <td>
                <div>
                    <input id="maxTransfer1" oncut="return false;" onpaste="return false;" onkeyup="return Fanex.CustomerSetting.Core.CheckNumber(event, this)" maxlength="13" type="text" data-ng-change="CustomerModel.memberWinLimit.maximumLoss = CustomerModel.memberWinLimit.maximumLossFormated" data-ng-model="CustomerModel.memberWinLimit.maximumLossFormated" />
                </div>
            </td>
        </tr>
        <tr>
            <td class="noneBorderLeft tdTitleRight"></td>
            <td><div>(<span id="minCredit1">{{CustomerModel.memberWinLimit.minimumLoss.formatNumber()}}</span>&nbsp;-&nbsp;<span id="maxCredit1">{{CustomerModel.memberWinLimit.maximumLossLimit == 0 && CustomerModel.roleId == 4 ? '@NGCasinoLang.noLimited' : CustomerModel.memberWinLimit.maximumLossLimit.formatNumber()}}</span>)</div></td>
        </tr>
        <tr data-ng-hide="CustomerModel.roleId != 1">
            <td class="noneBorderLeft tdTitleRight">@NGCasinoLang.lblCurrentWinLossAmount</td>
            <td class=""><div id="currentWinLimit" style="color: #0000ff; cursor: pointer" data-ng-click="GetCurrentWinLimit()">@NGCasinoLang.lblClickToViewCurrentWinLossAmount</div></td>
        </tr>
    </table>
    @Html.AntiForgeryToken()
    <script type="text/javascript" src="@Url.Content("~/Areas/CustomerSetting/Scripts/jquery.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Areas/CustomerSetting/Scripts/jquery.blockUI.1.33.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Areas/CustomerSetting/Scripts/angular.min.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Areas/CustomerSetting/Scripts/Validators.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Areas/CustomerSetting/Scripts/Fanex.CustomerSetting.Core.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Areas/CustomerSetting/Scripts/ptarea.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Areas/CustomerSetting/Views/Casino/Scripts/CustomerController.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Areas/CustomerSetting/Views/Casino/Scripts/CasinoController.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/CustomerSetting/Casino/CasinoCustomer/CustomerData?id=" + id + "&uplineid=" + uplineId)"></script>
    <script type="text/javascript">
        var casinoLang = {
            winning: '@NGCasinoLang.lblWinning' + '%',
            losing: '@NGCasinoLang.lblLosing' + '%',
            of: '@NGCasinoLang.lblOf',
            unlimited: '@NGCasinoLang.lblUnlimited'
        };

        var custId = '@id';
        var uplineId = '@uplineId';
        var domain = '@Url.Content("~")';
        function toUrl(relativeUrl) {
            return '@Url.Content("~/CustomerSetting/Casino/")' + relativeUrl;
        }
    </script>
</div>