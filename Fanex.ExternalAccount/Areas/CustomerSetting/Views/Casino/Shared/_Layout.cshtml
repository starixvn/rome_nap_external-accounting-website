@using Fanex.CustomerSetting.Module.Core
@using Fanex.CustomerSetting.Module.Casino.Resources
@{
    var id = Utils.ToInt32(Request.QueryString["id"]);
    var uplineId = Utils.ToInt32(Request.QueryString["uplineId"]);
}
<!DOCTYPE html>
<html style="display: none;" data-ng-app="settingApp" id="ng-app">
<head>
    <meta name="viewport" content="width=device-width" />
    <title></title>
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/Areas/CustomerSetting/Styles/Validators.css")" />
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/Areas/CustomerSetting/Styles/Common.css")" />
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/Areas/CustomerSetting/Views/Casino/Styles/Casino.css")" />
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/assets/styles/pages/customer/Casino.min.css")" />
</head>
<body>
    @RenderBody()
    @Html.AntiForgeryToken()
    <script type="text/javascript" src="@Url.Content("~/Areas/CustomerSetting/Scripts/jquery.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Areas/CustomerSetting/Scripts/jquery.blockUI.1.33.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Areas/CustomerSetting/Scripts/angular.min.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Areas/CustomerSetting/Scripts/Validators.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Areas/CustomerSetting/Scripts/Fanex.CustomerSetting.Core.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Areas/CustomerSetting/Scripts/ptarea.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Areas/CustomerSetting/Views/Casino/Scripts/CustomerController.js?v=1")"></script>
    <script type="text/javascript" src="@Url.Content("~/Areas/CustomerSetting/Views/Casino/Scripts/CasinoController.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/CustomerSetting/Casino/CasinoCustomer/CustomerData?id=" + id + "&uplineid=" + uplineId)"></script>
    <script type="text/javascript">
        var casinoLang = {
            winning: '@NGCasinoLang.lblWinning' + '%',
            losing: '@NGCasinoLang.lblLosing' + '%',
            of: '@NGCasinoLang.lblOf',
            unlimited: '@NGCasinoLang.lblUnlimited'
        };

        var custId = '@id';
        var uplineId = '@uplineId';
        var domain = '@Url.Content("~")';
        var userId = @Fanex.ExternalAccount.Core.Context.CurrentSession.Instance.UserId;
        var subAccId = 0;
        function toUrl(relativeUrl) {
            return '@Url.Content("~/CustomerSetting/Casino/")' + relativeUrl;
        }
    </script>
    @RenderSection("Scripts", false)
</body>
</html>