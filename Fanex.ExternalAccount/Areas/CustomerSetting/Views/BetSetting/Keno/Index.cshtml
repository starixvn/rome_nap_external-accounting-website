@using Fanex.CustomerSetting.Module.Core
@{
    var id = Utils.ToInt32(Request["custId"]);
    var uplineId = Utils.ToInt32(Request["uplineId"]);
    var userId = Utils.ToInt32(Request["userId"]);
    var siteName = Request["groupName"];

    Layout = "~/Areas/CustomerSetting/Views/BetSetting/Shared/_Layout.cshtml";
}    
@section Keno{
    <iframe id="product-8"  width="100%" height="570px" frameborder="0" src="@Url.Content("~/CustomerSetting/BetSetting/KenoBetting/Content?custId=" + id + "&uplineId=" + uplineId + "&userId=" + userId + "&groupName=" + siteName)">
    </iframe>
}