@using Fanex.CustomerSetting.Module.Core
@using Newtonsoft.Json
@using Newtonsoft.Json.Serialization
@model Fanex.CustomerSetting.Module.BetSetting.ViewModels.CasinoModel
@{
    var bettingLimit = JsonConvert.SerializeObject(Model, Formatting.None , new JsonSerializerSettings
    { 
        ContractResolver = new CamelCasePropertyNamesContractResolver(),
        NullValueHandling = NullValueHandling.Ignore
    });

    var id = Utils.ToInt32(Request.RequestContext.RouteData.Values["id"]);
    var uplineId = Utils.ToInt32(Request.RequestContext.RouteData.Values["uplineId"]);
    var userId = Utils.ToInt32(Request.RequestContext.RouteData.Values["userId"]);
    var siteName = Request.RequestContext.RouteData.Values["siteName"];    
}
<link href="@Url.Content("~/Areas/CustomerSetting/Styles/jquery-ui.css")" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/Areas/CustomerSetting/Styles/Common.css")" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/Areas/CustomerSetting/Styles/Validators.css")" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/Areas/CustomerSetting/Views/BetSetting/Casino/Styles/Casino.css")" rel="stylesheet" type="text/css" />
<div id="ng-app" data-ng-app="bettingApp" data-ng-controller="Fanex.CustomerSetting.Betting.Casino" data-ng-init="Init()" style="width: 815px; display: none">
    <div id="errMsg" style="display: none" class="errMsg">
    </div>
    <div style="text-align: right" data-ng-hide="model == null" >
        <input class="btn -submit buttonPopup" type="button" value="Submit" />
    </div>
    <div class="title C bold header">
        Update Bet Setting: @ViewBag.Username
    </div>
    <div data-ng-hide="model != null" style="color: Red; height: 25px; border: 1px solid #CCC" class="C">There is no information available.</div>
    <table class="tableInfo" border="1" cellpadding="0" cellspacing="0" data-ng-hide="model == null">      
        <tr>
            <td colspan="3" style="border: none">
                <table class="tableInfo" border="0" cellpadding="0" cellspacing="0">
                    <tr data-ng-repeat="gameKind in gameKinds">
                        <td class="widthGameTypeTitle noneBorderTop bold">{{gameKind.gameGroupName}}</td>
                        <td class="noneBorderTop" style="border: none">
                            <table class="tableInfo" border="0" cellpadding="0" cellspacing="0">
                                <tr data-ng-repeat="gameType in gameKind.gameTypes">
                                    <td class="widthGameTypeTitle noneBorderLeft noneBorderTop">{{gameType.gameTypeName}}</td>
                                    <td class="noneBorderLeft noneBorderTop">
                                        <div class="floatLeft">                                              
                                            <div class="floatLeft">Betting Limit:&nbsp;</div>
                                            <div class="floatLeft" data-ng-repeat="betting in gameType.bettingLimits">
                                                <div class="floatLeft">
                                                    <input type="checkbox" data-ng-model="betting.isChecked" /><span>{{betting.stakeLevelName}}</span>
                                                </div>                                        
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            </table>                                
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
    <div style="text-align: right" data-ng-hide="model == null" >
        <input class="btn -submit buttonPopup" type="button" value="Submit" />
    </div>
</div>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/jquery.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/jquery.blockUI.1.33.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/jquery-ui-1.9.1.min.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/angular.min.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/Validators.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/Fanex.CustomerSetting.Core.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Views/BetSetting/Scripts/BetSetting.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Views/BetSetting/Casino/Scripts/CasinoController.js?v=2")" type="text/javascript"></script>
<script type="text/javascript">
    var model = @Html.Raw(bettingLimit);
    var custId = parseInt('@id');
    var uplineId = parseInt('@uplineId');
    var userId = parseInt('@userId');
    var siteName = '@siteName';
    var syncCasino = '@ViewBag.SyncCasino';

    function toUrl(relativeUrl) {
        return '@Url.Content("~/CustomerSetting/BetSetting/")' + relativeUrl;
    }

    $(document).ready(function () {
        if (syncCasino == 'False') {
            $('#tab6').remove();
        }       

        $('#tab6').addClass('ui-tabs-active ui-state-active');
        $('#tab1').removeClass('ui-tabs-active ui-state-active');
        $('#tab2').removeClass('ui-tabs-active ui-state-active');
        $('#tab3').removeClass('ui-tabs-active ui-state-active');
        $('#tab4').removeClass('ui-tabs-active ui-state-active');

        $('.buttonPopup').bind('click', function () {
            Fanex.CustomerSetting.Betting.Casino.Update(function (data) {
                if (data.errorCode == "0") {
                    var timeout = setTimeout(function () {
                        clearTimeout(timeout);

                        $('#ng-app').hide();

                        Fanex.CustomerSetting.Core.BlockUI();

                        document.location.reload(true);
                    }, 2000);
                }
            });
        });
    });
</script>