@using Fanex.CustomerSetting.Module.Core
@model bool
@{
    var id = Utils.ToInt32(Request["custId"]);
    var uplineId = Utils.ToInt32(Request["uplineId"]);
    var userId = Utils.ToInt32(Request["userId"]);
    var siteName = Request["groupName"];

    Layout = "~/Areas/CustomerSetting/Views/BetSetting/MultipleSportsbook/_Layout.cshtml";
}
@section BetSettings{
    @if (Model)
    {
        <div class="errMsg">There is no information available</div>
    }
    else
    {
        if (Request.Url.ToString().IndexOf("edit") != -1)
        {
            <div id="tabs-1">
                <div><iframe id="product-1-0" width="100%" height="550px" frameborder="0" src=""></iframe></div>
            </div>
            <div id="tabs-2">
                <div><iframe id="product-1-1" width="100%" height="550px" frameborder="0" src="@Url.Content("~/CustomerSetting/BetSetting/Sportsbook/EditMultipleBetSettingContent?edit=1&custId=" + id + "&uplineId=" + uplineId + "&userId=" + userId + "&groupName=" + siteName)"></iframe></div>
            </div>
        }
        else
        {
            <div id="tabs-1">
                <div><iframe id="product-1-0" width="100%" height="550px" frameborder="0" src="@Url.Content("~/CustomerSetting/BetSetting/Sportsbook/EditMultipleBetSettingContent?copy=1&custId=0&uplineId=0&userId=" + userId + "&groupName=" + siteName)"></iframe></div>
            </div>
            <div id="tabs-2">
                <div><iframe id="product-1-1" width="100%" height="550px" frameborder="0" src=""></iframe></div>
            </div>
        }
    }
}