@using Fanex.PTEngine.BusinessObjects
@using Newtonsoft.Json
@using Newtonsoft.Json.Serialization
@using Fanex.ExternalAccount.Core.Context
@model IBettingLimit<BettingLimitItem>
@{
    var bettingLimit = JsonConvert.SerializeObject(Model, Formatting.None, new JsonSerializerSettings
    {
        ContractResolver = new CamelCasePropertyNamesContractResolver(),
        NullValueHandling = NullValueHandling.Ignore
    });
    var session = CurrentSession.Instance;
    var isSpecialGroup = session.IsBelongToSpecialGroups ? 1 : 0;
}
<link href="@Url.Content("~/Areas/CustomerSetting/Styles/jquery-ui.css")" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/Areas/CustomerSetting/Styles/Common.css")" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/Areas/CustomerSetting/Styles/Validators.css")" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/Areas/CustomerSetting/Views/BetSetting/MultipleSportsbook/Styles/MultipleSportsbook.css")" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/assets/styles/pages/customer/bet-limit.css")" rel="stylesheet" type="text/css" />
<div style="display: none" id="ng-app" data-ng-app="bettingApp" data-ng-controller="Fanex.CustomerSetting.Betting.MultipleSportsbook" data-ng-init="Init()">
    <table class="tableInfo" border="1" cellpadding="0" cellspacing="0">
        <tr>
            <td id="notes" colspan="5" class="title bold C"><span class="betsetting-title">Bet Setting </span><span data-ng-click="ShowBetSettingNotes()" class="bet-type-detail-icon sport-type-detail-icon betsetting-icon"></span></td>
        </tr>
        <tr>
            <td class="title titleWidth"><label><input id="All" type="checkbox" data-ng-click="Check('All')" checked />All</label></td>
            <td class="title bold C numberGameWidth">Min Bet</td>
            <td class="title bold C numberGameWidth">Max Bet</td>
            <td class="title bold C numberGameWidth">Max Per Match</td>
            <td class="title bold C numberGameWidth">
                Max Payout Per Match
                <a href="~/ViewMaxPayoutSettingInformation/Index" target="_blank">
                    <span class="bet-type-detail-icon sport-type-detail-icon"></span>
                </a>
            </td>
        </tr>
        <tr data-ng-model="betting.bgClass" class="{{betting.bgClass}}" id="{{betting.resourceKey}}" data-ng-hide="" data-ng-init="betting.bgClass = ''; betting.className = betting.key == 'Soccer' || betting.key == 'Basketball'|| betting.key == 'Number Game'" data-ng-repeat="betting in bettingLimits">
            <td class="title {{betting.bgClass}}">
                <label><input id="chk{{betting.resourceKey}}" type="checkbox" data-ng-click="Check('{{betting.resourceKey}}')" checked />{{betting.name}}</label>
                <label style="float: right" title="{{betting.title}}" id="_{{betting.resourceKey}}" class="{{betting.className}} {{betting.bgClass}}" data-ng-click="Copy(this)"></label>
                <span data-ng-click="ShowMixSportsParlay()" style="float: right; padding-top: 3px" data-ng-show="betting.resourceKey == 'mixsports'" class="bet-type-detail-icon sport-type-detail-icon betsetting-icon"></span>
            </td>
            <td>
                <input class="input-betting-limit" id="txt{{betting.resourceKey}}Min" data-ng-readonly="betting.bgClass == 'inactive'" oncut="return false;" onpaste="return false;" onkeyup="return Fanex.CustomerSetting.Core.CheckNumber(event, this, true)" maxlength="14" data-ng-init="betting.showminBetMax = betting.minBetMax > 0; betting.minBetFormated = betting.minBet.formatNumber(); betting.preValMinBet = betting.minBetFormated" type="text" class="BettingLimitTextBox9" data-ng-model="betting.minBetFormated" data-ng-change="betting.minBet = betting.minBetFormated.replaceAll(',', '').formatNumber()" />
            </td>
            <td>
                <input class="input-betting-limit" id="txt{{betting.resourceKey}}Max" data-ng-readonly="betting.bgClass == 'inactive'" oncut="return false;" onpaste="return false;" onkeyup="return Fanex.CustomerSetting.Core.CheckNumber(event, this, true)" maxlength="14" data-ng-init="betting.showmaxBetMin = betting.maxBetMin > 0; betting.maxBetFormated = betting.maxBet.formatNumber(); betting.preValMaxBet = betting.maxBetFormated" type="text" class="BettingLimitTextBox9" data-ng-model="betting.maxBetFormated" data-ng-change="betting.maxBet = betting.maxBetFormated.replaceAll(',', '').formatNumber()" />
            </td>
            <td>
                <input class="input-betting-limit" id="txt{{betting.resourceKey}}MaxPerMatch" data-ng-readonly="betting.bgClass == 'inactive'" oncut="return false;" onpaste="return false;" onkeyup="return Fanex.CustomerSetting.Core.CheckNumber(event, this, true)" maxlength="14" data-ng-init="betting.showmaxPerMatchMax = betting.maxPerMatchMax > 0; betting.maxPerMatchFormated = betting.maxPerMatch.formatNumber(); betting.preValMaxPerMatch = betting.maxPerMatchFormated" type="text" class="BettingLimitTextBox9" data-ng-model="betting.maxPerMatchFormated" data-ng-change="betting.maxPerMatch = betting.maxPerMatchFormated.replaceAll(',', '').formatNumber()" />
            </td>
            <td>
                <input class="input-betting-limit" id="txt{{betting.resourceKey}}MaxPayoutPerMatch" data-ng-readonly="betting.bgClass == 'inactive'" oncut="return false;" onpaste="return false;" onkeyup="return Fanex.CustomerSetting.Core.CheckNumber(event, this, true)" maxlength="14" data-ng-init="betting.showmaxPayoutPerMatchMax = betting.maxPayoutPerMatchMax > 0; betting.maxPayoutPerMatchFormated = betting.maxPayoutPerMatch.formatNumber(); betting.preValMaxPayoutPerMatch = betting.maxPayoutPerMatchFormated" type="text" class="BettingLimitTextBox9" data-ng-model="betting.maxPayoutPerMatchFormated" data-ng-change="betting.maxPayoutPerMatch = betting.maxPayoutPerMatchFormated.replaceAll(',', '').formatNumber()" />
            </td>
        </tr> 
    </table>
    <div style="text-align: right">
        <input id="btnSubmit" class="btn -submit buttonPopup" type="button" value="Submit" />
    </div>
</div>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/jquery.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/jquery.blockUI.1.33.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/jquery-ui-1.9.1.min.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/angular.min.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/Validators.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/Fanex.CustomerSetting.Core.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Views/BetSetting/Scripts/BetSetting.js?v=1.0")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Views/BetSetting/MultipleSportsbook/Scripts/MultipleSportsbookController.js?v=1.1")" type="text/javascript"></script>
<script type="text/javascript">
    var model = @Html.Raw(bettingLimit);
    var isSpecialGroup = @isSpecialGroup;

    function toUrl(relativeUrl) {
        return '@Url.Content("~/CustomerSetting/BetSetting/")' + relativeUrl;
    }

    $(document).ready(function () {
        $('.buttonPopup').bind('click', function () {
            Fanex.CustomerSetting.Betting.MultipleSportsbook.Update(@(Request.Url.ToString().IndexOf("copy") != -1 ? 1 : 0));
        });

        setTimeout(function () {
            $("#ng-app").show();
        }, 1000);
    });
</script>