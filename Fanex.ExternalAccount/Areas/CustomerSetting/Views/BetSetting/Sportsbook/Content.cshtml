@using Fanex.PTEngine.BusinessObjects
@using Fanex.CustomerSetting.Module.Core
@using Newtonsoft.Json
@using Newtonsoft.Json.Serialization
@model IBettingLimit<BettingLimitItem>
@{
    var bettingLimit = JsonConvert.SerializeObject(Model, Formatting.None , new JsonSerializerSettings
    { 
        ContractResolver = new CamelCasePropertyNamesContractResolver(),
        NullValueHandling = NullValueHandling.Ignore
    });

    var id = Utils.ToInt32(Request.RequestContext.RouteData.Values["id"]);
    var uplineId = Utils.ToInt32(Request.RequestContext.RouteData.Values["uplineId"]);
    var userId = Utils.ToInt32(Request.RequestContext.RouteData.Values["userId"]);
    var siteName = Request.RequestContext.RouteData.Values["siteName"];    
}
<link href="@Url.Content("~/Areas/CustomerSetting/Styles/jquery-ui.css")" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/Areas/CustomerSetting/Styles/Common.css")" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/Areas/CustomerSetting/Styles/Validators.css")" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/Areas/CustomerSetting/Views/BetSetting/Sportsbook/Styles/Sportsbook.css")" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/assets/styles/pages/customer/bet-limit.css")" rel="stylesheet" type="text/css" />
<div id="ng-app" data-ng-app="bettingApp" data-ng-controller="Fanex.CustomerSetting.Betting.Sportsbook" data-ng-init="Init()" style="width: 815px; display: none">
    <div id="errMsg" style="display: none" class="errMsg">
    </div>
    <div class="title C bold header">
        Update Bet Setting: @ViewBag.Username
    </div>
    <table class="tableInfo" border="1" cellpadding="0" cellspacing="0">
        <tr>
            <td class="title titleWidth"></td>
            <td class="title bold C betWidth">Min Bet</td>
            <td class="title bold C betWidth">Max Bet</td>
            <td class="title bold C betWidth">Max Per Match</td>
        </tr>
        <tr data-ng-model="betting.bgClass" class="{{betting.bgClass}}" id="{{betting.resourceKey}}" data-ng-hide="betting.isNumberGame" data-ng-init="betting.bgClass = ''; betting.isNumberGame = betting.resourceKey == 'numbergame'; betting.className = betting.key == 'Soccer' || betting.key == 'Basketball'" data-ng-repeat="betting in bettingLimits">
            <td title="{{betting.title}}" id="_{{betting.resourceKey}}" class="title {{betting.className}} {{betting.bgClass}}" data-ng-click="Copy(this)">{{betting.name}}</td>
            <td>
                <input style="text-align: right; width: 100px" id="txt{{betting.resourceKey}}Min" data-ng-readonly="betting.bgClass == 'inactive'" oncut="return false;" onpaste="return false;" onkeyup="return Fanex.CustomerSetting.Core.CheckNumber(event, this)" maxlength="14" data-ng-init="betting.showminBetMax = betting.minBetMax > 0; betting.minBetFormated = betting.minBet.formatNumber(); betting.preValMinBet = betting.minBetFormated" type="text" class="BettingLimitTextBox" data-ng-model="betting.minBetFormated" data-ng-change="betting.minBet = betting.minBetFormated.replaceAll(',', '').formatNumber()" />
                <span data-ng-show="betting.showminBetMax">>={{betting.minBetMax.formatNumber()}}</span>
            </td>
            <td>
                <input style="text-align: right; width: 100px" id="txt{{betting.resourceKey}}Max" data-ng-readonly="betting.bgClass == 'inactive'" oncut="return false;" onpaste="return false;" onkeyup="return Fanex.CustomerSetting.Core.CheckNumber(event, this)" maxlength="14" data-ng-init="betting.showmaxBetMin = betting.maxBetMin > 0; betting.maxBetFormated = betting.maxBet.formatNumber(); betting.preValMaxBet = betting.maxBetFormated" type="text" class="BettingLimitTextBox" data-ng-model="betting.maxBetFormated" data-ng-change="betting.maxBet = betting.maxBetFormated.replaceAll(',', '').formatNumber()" />
                <span data-ng-show="betting.showmaxBetMin"><={{betting.maxBetMin.formatNumber()}}</span>
            </td>
            <td>
                <input style="text-align: right; width: 100px" id="txt{{betting.resourceKey}}MaxPerMatch" data-ng-readonly="betting.bgClass == 'inactive'" oncut="return false;" onpaste="return false;" onkeyup="return Fanex.CustomerSetting.Core.CheckNumber(event, this)" maxlength="14" data-ng-init="betting.showmaxPerMatchMax = betting.maxPerMatchMax > 0; betting.maxPerMatchFormated = betting.maxPerMatch.formatNumber(); betting.preValMaxPerMatch = betting.maxPerMatchFormated" type="text" class="BettingLimitTextBox" data-ng-model="betting.maxPerMatchFormated" data-ng-change="betting.maxPerMatch = betting.maxPerMatchFormated.replaceAll(',', '').formatNumber()" />
                <span data-ng-show="betting.showmaxPerMatchMax"><={{betting.maxPerMatchMax.formatNumber()}}</span>
            </td>
        </tr>
        <tr data-ng-init="betting = bettingLimits[bettingLimits.length - 1]">
            <td colspan="4">
                <table cellpadding="0" cellspacing="0" class="tableInfo">
                    <tr>
                        <td rowspan="2" class="title titleWidth noneBorderTop noneBorderLeft noneBorderBottom">{{betting.name}}</td>
                        <td class="title bold C numberGameWidth noneBorderTop">Min Bet</td>
                        <td class="title bold C numberGameWidth noneBorderTop">Max Bet</td>
                        <td class="title bold C numberGameWidth noneBorderTop">Max Per Match</td>
                        <td class="title bold C numberGameWidth noneBorderTop noneBorderRight">Max Per Ball</td>
                    </tr>
                    <tr>                        
                        <td class="noneBorderBottom">
                            <input style="text-align: right" id="txt{{betting.resourceKey}}Min1" class="BettingLimitTextBox9" oncut="return false;" onpaste="return false;" onkeyup="return Fanex.CustomerSetting.Core.CheckNumber(event, this)" maxlength="14" data-ng-init="betting.showminBetMax = betting.minBetMax > 0; betting.minBetFormated = betting.minBet.formatNumber()" type="text" class="BettingLimitTextBox" data-ng-model="betting.minBetFormated" data-ng-change="betting.minBet = betting.minBetFormated.replaceAll(',', '').formatNumber()" />
                            <span data-ng-show="betting.showminBetMax">>={{betting.minBetMax.formatNumber()}}</span>
                        </td>
                        <td class="noneBorderBottom">
                            <input style="text-align: right" id="txt{{betting.resourceKey}}Max1" class="BettingLimitTextBox9" oncut="return false;" onpaste="return false;" onkeyup="return Fanex.CustomerSetting.Core.CheckNumber(event, this)" maxlength="14" data-ng-init="betting.showmaxBetMin = betting.maxBetMin > 0; betting.maxBetFormated = betting.maxBet.formatNumber()" type="text" class="BettingLimitTextBox" data-ng-model="betting.maxBetFormated" data-ng-change="betting.maxBet = betting.maxBetFormated.replaceAll(',', '').formatNumber()" />
                            <span data-ng-show="betting.showmaxBetMin"><={{betting.maxBetMin.formatNumber()}}</span>
                        </td>
                        <td class="noneBorderBottom">
                            <input style="text-align: right" id="txt{{betting.resourceKey}}MaxPerMatch1" class="BettingLimitTextBox9" oncut="return false;" onpaste="return false;" onkeyup="return Fanex.CustomerSetting.Core.CheckNumber(event, this)" maxlength="14" data-ng-init="betting.showmaxPerMatchMax = betting.maxPerMatchMax > 0; betting.maxPerMatchFormated = betting.maxPerMatch.formatNumber()" type="text" class="BettingLimitTextBox" data-ng-model="betting.maxPerMatchFormated" data-ng-change="betting.maxPerMatch = betting.maxPerMatchFormated.replaceAll(',', '').formatNumber()" />
                            <span data-ng-show="betting.showmaxPerMatchMax"><={{betting.maxPerMatchMax.formatNumber()}}</span>
                        </td>
                        <td class="noneBorderBottom noneBorderRight">
                            <input style="text-align: right" id="txt{{betting.resourceKey}}MaxPerBall1" class="BettingLimitTextBox9" oncut="return false;" onpaste="return false;" onkeyup="return Fanex.CustomerSetting.Core.CheckNumber(event, this)" maxlength="14" data-ng-init="betting.showmaxPerBallMax = betting.maxPerBallMax > 0; betting.maxPerBallFormated = betting.maxPerBall.formatNumber()" type="text" class="BettingLimitTextBox" data-ng-model="betting.maxPerBallFormated" data-ng-change="betting.maxPerBall = betting.maxPerBallFormated.replaceAll(',', '').formatNumber()" />
                            <span data-ng-show="betting.showmaxPerBallMax"><={{betting.maxPerBallMax.formatNumber()}}</span>
                        </td>
                    </tr>
                </table>
            </td>            
        </tr>
    </table>
    <div style="text-align: right">
        <input class="buttonPopup" type="button" value="Submit" />
    </div>
</div>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/jquery.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/jquery.blockUI.1.33.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/jquery-ui-1.9.1.min.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/angular.min.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/Validators.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/Fanex.CustomerSetting.Core.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Views/BetSetting/Scripts/BetSetting.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Views/BetSetting/Sportsbook/Scripts/SportsbookController.js")" type="text/javascript"></script>
<script type="text/javascript">
    var model = @Html.Raw(bettingLimit);
    var custId = parseInt('@id');
    var uplineId = parseInt('@uplineId');
    var userId = parseInt('@userId');
    var siteName = '@siteName';
    var syncCasino = '@ViewBag.SyncCasino';
    var syncLiveCasino = '@ViewBag.SyncLiveCasino';

    function toUrl(relativeUrl) {
        return '@Url.Content("~/CustomerSetting/BetSetting/")' + relativeUrl;
    }

    $(document).ready(function () {
        if (syncCasino == 'False') {
            $('#tab6').remove();
        }

        if (syncLiveCasino == 'False') {
            $('#tab4').remove();
        }

        $('#tab2').removeClass('ui-tabs-active');

        $('.buttonPopup').bind('click', function () {
            Fanex.CustomerSetting.Betting.Sportsbook.Update(function (data) {
                if (data.errorCode == "0") {
                    var timeout = setTimeout(function () {
                        clearTimeout(timeout);

                        $('#ng-app').hide();

                        Fanex.CustomerSetting.Core.BlockUI();

                        document.location.reload(true);
                    }, 2000);
                }
            });
        });
    });
</script>