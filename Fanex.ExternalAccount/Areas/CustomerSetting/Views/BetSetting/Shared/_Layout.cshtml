@using Newtonsoft.Json;
@using Newtonsoft.Json.Serialization;
@using Fanex.CustomerSetting.Module.BetSetting;
@using Fanex.ExternalAccount.Utilities;
@using Utils = Fanex.CustomerSetting.Module.Core.Utils;
@{
    var id = Utils.ToInt32(Request["custId"]);
    var uplineId = Utils.ToInt32(Request["uplineId"]);
    var userId = Utils.ToInt32(Request["userId"]);
    var roleId = Utils.ToInt32(Request["roleId"]);
    var siteName = Request["groupName"];
    var customer = new Fanex.CustomerSetting.Module.BetSetting.Services.Impl.CustomerService();
    var cust = customer.UserInfo(id);
    var custInfo = JsonConvert.SerializeObject(cust, Formatting.None, new JsonSerializerSettings
    {
        ContractResolver = new CamelCasePropertyNamesContractResolver(),
        NullValueHandling = NullValueHandling.Ignore
    });
   
    var visibleGroupTabs = BetSettingProductIntegration.GetVisibledProductGroupBetSettingTabs(id, roleId, Config.SettingStatus);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title></title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="" name="description">
    <meta content="" name="author">
    <link href="@Url.Content("~/Areas/CustomerSetting/Styles/jquery-ui.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Areas/CustomerSetting/Styles/Common.css")" rel="stylesheet" type="text/css" />
</head>
<body>
    <div id="tabs" style="float: left; width: 1255px; border: none">
        <ul class="tabs">
            <li id="tab1" onclick="LoadSB()"><a href="#tabs-1">Sportsbook</a></li>
            @foreach (var tab in visibleGroupTabs)
            {
                <li id="tab-group-@(tab.Id)"
                    onclick="LoadProductGroup(@(tab.Id))">
                    <a href="#content-@(tab.Id)">@(tab.Name)</a>
                </li>
            }
         
        </ul>
        <div id="tabs-1">
            <div style="clear: both; border: 1px solid #ccc; font-weight: bold; text-align: center; height: 22px; line-height:22px; background-color: #e7f7ff; margin-left: 2px; width: 1215px;">
                Update Bet Setting: @cust.Username
            </div>
            @RenderSection("Sportsbook", false)
        </div>

        @foreach (var tab in visibleGroupTabs)
        {
            <div id="content-@(tab.Id)">
                <div style="clear: both; border: 1px solid #ccc; font-weight: bold; text-align: center; height: 22px; line-height: 22px; background-color: #e7f7ff; margin-left: 2px; width: 1225px;">
                    Update Bet Setting: @cust.Username
                </div>
                <div><iframe id="product-group-@(tab.Id)" width="100%" height="500px" frameborder="0" src=""></iframe></div>
            </div>
        }
    </div>
    <script src="@Url.Content("~/Areas/CustomerSetting/Scripts/jquery.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Areas/CustomerSetting/Scripts/jquery.blockUI.1.33.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Areas/CustomerSetting/Scripts/jquery-ui-1.9.1.min.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Areas/CustomerSetting/Scripts/angular.min.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Areas/CustomerSetting/Scripts/Fanex.CustomerSetting.Core.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Areas/CustomerSetting/Views/BetSetting/Scripts/BetSetting.js")" type="text/javascript"></script>
    <script type="text/javascript">
        function toUrl(relativeUrl) {
            return '@Url.Content("~/CustomerSetting/BetSetting/")' + relativeUrl;
        }

        $(document).ready(function () {
            var url = document.URL.toLowerCase();
            var index = url.indexOf('sportsbook') != -1 ? 0 :
                url.indexOf('virtualsportsbetting') != -1 ? 1 :
                url.indexOf('product-6') != -1 ? 2 :
                url.indexOf('livecasino') != -1 ? 3 :
                url.indexOf('voidbridge') != -1 ? 4 :
                url.indexOf('rnglottery') != -1 ? 5 :
                url.indexOf('product-30') != -1 ? 6 :
                url.indexOf('product-42') != -1 ? 7 :
                url.indexOf('product-66') != -1 ? 8 :
                url.indexOf('product-69') != -1 ? 9 : 0;
            var custInfo = @Html.Raw(custInfo);

            $('#tabs').tabs({ selected: index });
        });

        var custId = parseInt('@id');
        var uplineId = parseInt('@uplineId');
        var userId = parseInt('@userId');
        var siteName = '@siteName';
    </script>
    @RenderSection("Scripts", false)
    @Fanex.ExternalAccount.Core.Helpers.GoogleAnalyticHepler.Render()
    @Fanex.ExternalAccount.Core.Helpers.TrackJSHelper.Render()
    @Html.Raw(Fanex.Logging.LogManager.RenderJavascriptLogger())
</body>
</html>