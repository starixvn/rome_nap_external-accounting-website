@using Fanex.CustomerSetting.Module.Core
@{
    var id = Utils.ToInt32(Request["custId"]);
    var uplineId = Utils.ToInt32(Request["uplineId"]);
    var userId = Utils.ToInt32(Request["userId"]);
    var siteName = Request["groupName"];

    Layout = "~/Areas/CustomerSetting/Views/BetSetting/Shared/_Layout.cshtml";
    var url = "~/CustomerSetting/BetSetting/GoldDeluxeBetting/Content?upLineLevel=0&formType=1&level=4&uplineId=0&actorId=" + userId + "&custId=" + id + "&groupName=" + siteName;

}
@section GoldDeluxe{
    <iframe id="product-12" width="100%" height="250px" frameborder="0" src="@Url.Content(url)"></iframe>
}
@section Scripts{
    <script type="text/javascript">
        var isBelongToSpecialGroups = @Json.Encode(Fanex.ExternalAccount.Core.Context.CurrentSession.Instance.IsBelongToSpecialGroups);
    </script>
}