@using Fanex.CustomerSetting.Module.Core
@{
    var id = Utils.ToInt32(Request.RequestContext.RouteData.Values["id"]);
    var uplineId = Utils.ToInt32(Request.RequestContext.RouteData.Values["uplineId"]);
    var userId = Utils.ToInt32(Request.RequestContext.RouteData.Values["userId"]);
    var siteName = Request.RequestContext.RouteData.Values["siteName"];
    
    Layout = "~/Areas/CustomerSetting/Views/BetSetting/Shared/_Layout.cshtml";
    var url = "~/CustomerSetting/BetSetting/GoldDeluxeBetting/Content?upLineLevel=0&formType=1&level=4&uplineId=0&actorId=" + userId + "&custId=" + id + "&groupName=" + siteName;

}
@section GoldDeluxe{
    <iframe id="product-12"  width="100%" height="250px" frameborder="0" src="@Url.Content(url)">
    </iframe>
}