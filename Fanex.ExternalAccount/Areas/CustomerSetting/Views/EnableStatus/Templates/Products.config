    <product id="colossusBet" reloadafterupdate="true" function="EnableColossusBets" closepopupjs="parent.Fanex.ExtAcc.Form.Close();">
      <sps>
		  <sp key="Acc_CustomerSelProductStatus" type="SELECT">
			  <params>
				  <param name="CustId" mapproperty="CustId" />
				  <param name="SportName" mapproperty="SportTypeName" default="ColossusBets" />
				  <param name="RoleId" mapproperty="Level" />
			  </params>
			  <results>
				  <column name="UplineStatus" mapproperty="DisabledUplines" />
				  <column name="Status" mapproperty="Disabled" />
				  <column name="downlinestatus" mapproperty="DisabledDownlines" />
			  </results>
		  </sp>
        <sp key="Acc_CustomerUpdDisableColossusBet" type="UPDATE">
          <params>
            <param name="CustId" mapproperty="CustId" />
            <param name="Disable" mapproperty="Disabled"/>
            <param name="EnableDownlines" mapproperty="DisabledDownlines" reverse="true" />

            <param name="UserId" mapproperty="UserId" />
            <param name="SubAccID" mapproperty="SubAccID" />
            <param name="language" mapproperty="Language" />
            <param name="errcode" mapproperty="ErrorCode" />
            <param name="errmsg" mapproperty="ErrorMessage" />
            <param name="ip" mapproperty="Ip" />
          </params>
          <results>
            <column name="errcode" mapproperty="ErrorCode" />
            <column name="errmsg" mapproperty="ErrorMessage" />
          </results>
        </sp>
      </sps>
    </product>    
