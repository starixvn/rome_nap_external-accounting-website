@using Fanex.CustomerSetting.Module.ColossusBetSetting.Resources;
@using Fanex.ExternalAccount.Core.Shared
@model Fanex.CustomerSetting.Module.ColossusBetSetting.Entities.ColossusBetModel
<table class="tableColor tableWidth" ng-controller="statusController">
    <tr>
        <td colspan="4" class="header c b">
            <span>@Messages.Status</span>
             @if (Model.CustomerInformationPartial.RoleId < Role.Super)
             {
            <input ng-class-name="btnSave" check-disable-element ng-model="statusPartial.IsStatusUpdated"
                ng-click="!statusPartial.IsStatusUpdated||updated(true, 'StatusPartial')" type="button" />
             }
        </td>
    </tr>
    <tr>
        <td colspan="4" class="formatCol l betSetting" style="height: 34px;">
            <span class="b" style="padding-left: 30px;">Colossus Bets </span>
            <div style="display: inline-block; padding-left: 30px;">
                <input ng-disabled="!statusPartial.Upline.IsEnabled" type="checkbox" ng-model="statusPartial.IsEnabled" />
                @Messages.Enable
                @if (Model.CustomerInformationPartial.RoleId != Role.Member && Model.StatusPartial.IsHasDownlines)
                {
                    <input ng-disabled="IsDownlinechkDisabled" type="checkbox" ng-model="statusPartial.IsDownlinesEnabled" />
                    @Messages.EnableDownlines
                }
            </div>
        </td>
    </tr>
</table>
