@using Fanex.CustomerSetting.Module.ColossusBetSetting.Resources;
@using Fanex.ExternalAccount.Core.Shared
@model Fanex.CustomerSetting.Module.ColossusBetSetting.Entities.ColossusBetModel
<!DOCTYPE html>
<html ng-app='colossusBetSettingModule' id="ng-app">
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link href="~/assets/styles/pages/customer/colossusbet-setting.css"
        rel="stylesheet" type="text/css" />
    <link href="~/Areas/CustomerSetting/Views/ColossusBet/Setting/Scripts/Tipsy/tipsy.css"
        rel="stylesheet" type="text/css" />
    <link href="~/Areas/CustomerSetting/Styles/input.css" rel="stylesheet"
        type="text/css" />
</head>
<body>
    <div ng-controller="mainController" class="content">
    <div id="page_main" >
        <div id="customerInfo" class="tableWidth"  >
           <div id="errMsg" style="display: none" ng-class="{'errMsg' : errors, 'successMsg' : !errors}">
       </div>
     <div id="arrowUpDown" style="display: none;"  class="collapse ">
    </div>
    <div id="names" style="display: none; width: 829px;" class="names"></div>
    <div>  
            @Html.Partial("~/Areas/CustomerSetting/Views/ColossusBet/Setting/Views/_CustomerInfor.cshtml")
            @Html.Partial("~/Areas/CustomerSetting/Views/ColossusBet/Setting/Views/_Status.cshtml")
            @Html.Partial("~/Areas/CustomerSetting/Views/ColossusBet/Setting/Views/_Commission.cshtml", Model)
            @Html.Partial("~/Areas/CustomerSetting/Views/ColossusBet/Setting/Views/_CashInShare.cshtml", Model)
            @Html.Hidden("UpdateSettingtUrl", Url.Content("~/customersetting/colossusBetSetting/colossusBetSetting/UpdateSetting"))

          @if (Model.CustomerInformationPartial.RoleId < Role.Super)
          {
           <div  class="btnLeft">
                <input ng-class-name="btnUpdate" check-disable-element ng-model="isUpdatedAll" ng-click="updated(false)"
                    value="Update" type="button" class="btnUpdate" />
            </div>
          }
        </div>
        </div>
     @Html.AntiForgeryToken()
    </div>
</body>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/jquery.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/jquery.blockUI.1.33.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/jquery-ui-1.9.1.min.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/angular.min.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/Fanex.CustomerSetting.Core.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Views/ColossusBet/Setting/Scripts/controllers/main.controller.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Views/ColossusBet/Setting/Scripts/controllers/status.controller.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Views/ColossusBet/Setting/Scripts/controllers/cashInShare.controller.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Views/ColossusBet/Setting/Scripts/controllers/commission.controller.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Views/ColossusBet/Setting/Scripts/repositories/repositories.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Views/ColossusBet/Setting/Scripts/directives/commonDirective.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Views/ColossusBet/Setting/Scripts/services/commonService.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Views/ColossusBet/Setting/Scripts/Tipsy/jquery.tipsy.js")" type="text/javascript"></script>
<script type="text/javascript">
    var colossusBetSetting = @Html.Raw(Json.Encode(Model));
    var domain = '@Url.Content("~")';
    var resources = {
        successful: "@Messages.Msg_0",
        failed: "@Messages.UpdatedFail",
        more_than: "@Messages.MoreThan",
        less_than: "@Messages.LessThan"
    };

     var custids;
    var usernames;
    var isMultipleEdit;

    if(parent.Fanex.ExtAcc.Customer.IsMultiple) {
        InitMultipleEditInformation();
        Fanex.CustomerSetting.Core.ProcessDisplayMultiple(80, parent.Fanex.ExtAcc.Customer.Usernames);
    }

    function InitMultipleEditInformation() {
        if (custids == null || custids == undefined) {
            var elementByCustids = parent.Fanex.ExtAcc.Customer.Ids();
            if (elementByCustids != null) {
                custids = elementByCustids;
                usernames = parent.Fanex.ExtAcc.Customer.Names();
            }
        }

        isMultipleEdit = custids != null && custids != undefined && custids.length > 1 ? true : false;
        if (isMultipleEdit) {
            $("arrowUpDown").show();
        }
    }

</script>
</html>
