@using Fanex.PTRacing
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link rel="Stylesheet" href="@HttpContext.Current.GetWebResourceUrl("Fanex.PTRacing.UI.Core.css")" />
    @Styles.Render("~/bundles/racingstyle")
    @functions
    {
    }
</head>
    <body>
        <div class="maincontent" style="width: 1012px;">
            <div id="divShowInfo" class="maincontent_box" style="width:1012px;display:none;">
                <div id="err" class="errMsg">
                </div>
                <div id="errMsg" class="error-message">
                </div>
            </div>
            <div class="floatR">
                <input type="button" onclick="return customerPTRacingSetting.updateCustomerSettings();" value="Submit" class="buttonPopup btnTop" id="buttonPopup" />
            </div>
            <div class="bg_table" style="width: 1012px;">
                <div id="divCustInfo">
                </div>
                @Html.Partial("~/Areas/CustomerSetting/Views/Racebook/Setting/RacingSetting.cshtml")
       
                <div class="floatR">
                    <input type="button" onclick="return customerPTRacingSetting.updateCustomerSettings();" value="Submit" class="buttonPopup btnTop" id="buttonPopup" />
                </div>
            </div>
        </div>
        @RenderBody()
    </body>
    
    <script type="text/javascript">
        //var Roles=@Html.Raw(ViewBag.PageRole);
        
        window.uplineId = '@Fanex.Common.Converter.ToInt(Request["uplineId"])';
        window.custId = '@Fanex.Common.Converter.ToInt(Request["custId"])';
        window.rootUrl = '@ViewBag.RootUrl';
    </script>

    @Scripts.Render("~/bundles/racingsetting")
    
    <script type="text/javascript" src="@HttpContext.Current.GetWebResourceUrl("Fanex.PTRacing.UI.Languages.en.js")"></script>
    <script type="text/javascript" src="@HttpContext.Current.GetWebResourceUrl("Fanex.PTRacing.UI.Core.js")"></script>
    <script type="text/javascript" src="@HttpContext.Current.GetWebResourceUrl("Fanex.PTRacing.UI.BetTypeGroup.js")"></script>
    <script type="text/javascript" src="@HttpContext.Current.GetWebResourceUrl("Fanex.PTRacing.UI.BetType.js")"></script>
    <script type="text/javascript" src="@HttpContext.Current.GetWebResourceUrl("Fanex.PTRacing.UI.BettingCommSetting.js")"></script>
    
    @RenderSection("scripts", required: false)
   
</html>
