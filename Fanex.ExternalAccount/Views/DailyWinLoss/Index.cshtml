@using Fanex.ExternalAccount.Utilities
@using System.Web.Optimization
@{
    ViewBag.Title = "Home Page";
}

<div>
    <div class="page-title">
        <div class="wlDetail">
            Daily Win Loss
        </div>
    </div>
    <div class="search-form filterbox">
        <div class="searchBar floatL">
            <div class="form-group">
                <label class="label">@ViewLang.Username</label>
                <input class="" type="text" maxlength="50" autocomplete="off" name="txtUserName" id="txtUserName" />
            </div>
            <div class="form-group">
                <label class="label">@ViewLang.Date</label>
                <div class="user-group pull-left">
                    <input id="dtpWinLossDate" type="text" readonly="readonly" />
                    <input id="BalanceUpDay" type="hidden" value="@Fanex.ExternalAccount.Service.Impl.Report.ReportService.BalanceUpDate" />
                </div>
            </div>
            <div class="form-group">
                <input type="button" value="Submit" id='Submit' class="btn -submit btnSearch" />
                <span id="exporttoexcel" title="@ViewLang.ExportExcel" class="icon-excel"></span>
            </div>            
        </div>
        <div class="HideMG">
            <input type="button" value="Hide Margin" id='btnHideMG' style="display: none" />
        </div>
    </div>
    <div id="headlineDaily">
        <div id="InfoDate">
            <span id="SelectedLevel">Super</span> Daily Win Loss on <span id="DateValueInfo"></span>
        </div>
        <div class="groupBack">
            <div id="tabAgent">
                Agent
            </div>
            <div id="tabMaster">
                Master
            </div>
            <div id="tabSuper">
                Super
            </div>
        </div>
        
    </div>
    <div id="mainGrid" class="hide">
        <table id="tbl-report" class="table">
            <thead>
                <tr>
                    <th rowspan="2"><div class="col-no"></div>No</th>
                    <th class="col-username" rowspan="2"><div class="col-130">Username</div></th>
                    <th class="col-total-turnover" rowspan="2"><div class="col-130">Total Turnover</div></th>
                    <th colspan="8">Turnover & Position Taking</th>
                    <th colspan="8" class="col-win-loss-margin">Win/Loss & Margin</th>
                    <th colspan="4" class="col-win-loss hide">Win/Loss</th>
                </tr>
                <tr>
                    <th class="col-company" colspan="2"><div class="col-pt">Company - %</div></th>
                    <th class="col-super" colspan="2"><div class="col-pt">Super - %</div></th>
                    <th class="col-master" colspan="2"><div class="col-pt">Master - %</div></th>
                    <th class="col-agent" colspan="2"><div class="col-pt">Agent - %</div></th>

                    <th class="col-company" colspan="2"><div class="col-pt">Company <span>- %</span></div></th>
                    <th class="col-super" colspan="2"><div class="col-pt">Super <span>- %</span></div></th>
                    <th class="col-master" colspan="2"><div class="col-pt">Master <span>- %</span></div></th>
                    <th class="col-agent" colspan="2"><div class="col-pt">Agent <span>- %</span></div></th>
                </tr>
            </thead>
            <tbody></tbody>
            <tfoot></tfoot>
        </table>
    </div>
    <div id='msgNoinfo'>
        There is no data.
    </div>
    @Html.AntiForgeryToken()
</div>
@if (HttpContext.Current.IsDebuggingEnabled)
{
    <script src="@Url.Content("~/Scripts/_Libs/jQuery/pagination/jquery.draggable.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Scripts/_Libs/jQuery/pagination/jquery.linkbutton.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Scripts/_Libs/jQuery/pagination/jquery.parser.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Scripts/_Libs/jQuery/pagination/jquery.resizable.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Scripts/_Libs/jQuery/pagination/jquery.pagination.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Scripts/Reports/Fanex.ExtAcc.DailyWinLoss.js")" type="text/javascript"></script>
}
else
{
    <script src="@BundleTable.Bundles.ResolveBundleUrl("~/bootstrap/dailywinloss/js")" type="text/javascript"></script>
}