@using Fanex.ExternalAccount.Utilities
@using System.Web.Optimization
@{
    ViewBag.Title = "Home Page";
}

<div>
    <div class="page-title">
        <div class="wlDetail">
            Daily Win Loss
        </div>
        <div class="groupBack  hide">
            <div id="tabAgent">
                Agent
            </div>
            <div id="tabMaster">
                Master
            </div>
            <div id="tabSuper">
                Super
            </div>
        </div>
        <span class="icon-filter"></span>
    </div>
    <div class="search-form filterbox">
        <div class="searchBar">
            <div class="form-group">
                <label class="label">@ViewLang.Username</label>
                <input class="" type="text" maxlength="50" autocomplete="off" name="txtUserName" id="txtUserName" />
            </div>
            <div class="form-group">
                <label class="label">@ViewLang.Date</label>
                <div class="user-group pull-left">
                    <input id="dtpWinLossDate" type="text" readonly="readonly" />
                    <input id="BalanceUpDay" type="hidden" value="@Fanex.ExternalAccount.Service.Impl.Report.ReportService.BalanceUpDate" />
                </div>
            </div>
            <div class="form-group">
                <input type="button" value="Submit" id='Submit' class="btn -submit btnSearch" />
                <span id="exporttoexcel" title="@ViewLang.ExportExcel" class="icon-excel hide"></span>
            </div>
        </div>
    </div>
    <div id="mainGrid" class="hide">
        <div id="jqgrid" class="removeRadius freegrid content-grid"></div>
    </div>
    <div id='msgNoinfo'>
        There is no data.
    </div>
    @Html.AntiForgeryToken()
</div>
@if (HttpContext.Current.IsDebuggingEnabled)
{
    <script src="@Url.Content("~/Scripts/Reports/Fanex.ExtAcc.DailyWinLoss.js")" type="text/javascript"></script>
}
else
{
    <script src="@BundleTable.Bundles.ResolveBundleUrl("~/bootstrap/dailywinloss/js")" type="text/javascript"></script>
}