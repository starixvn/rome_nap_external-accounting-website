@using Fanex.ExternalAccount.Utilities

<form class="form-add">
    <div id="errMsg" class="successMsg hide"> </div>

    <div class="group">
        <div class="pull-left width-100 text-right">
            @Html.Label(ViewLang.Group, new { @class = "divMargin" })
        </div>
        <div class="pull-left width-250">
            @Html.TextBox("GroupName", "This is subgroup", new { @class = "form-control width-250" })
        </div>
    </div>
    <div class="group">
        <div class="pull-left width-100 text-right">
            @Html.Label(ViewLang.Admin, new { @class = "label" })
        </div>
        <div class="pull-left">
            @Html.TextBox("Admin", "Select Admin", new { @class = "form-control width-250" })
        </div>
    </div>
    <div class="group">
        <div class="pull-left width-100 text-right">
            @Html.Label(ViewLang.Newpassword, new { @class = "divMargin" })
        </div>
        <div class="pull-left width-250">
            @Html.Password("newpassword", "", new { @class = "form-control width-250", autocomplete = "new-password" })
        </div>
    </div>
    <div class="group">
        <div class="pull-left width-100 text-right">
            @Html.Label(ViewLang.Confirmnewpassword, new { @class = "divMargin" })
        </div>
        <div class="pull-left width-250">
            @Html.Password("confirmpassword", "", new { @class = "form-control width-250", autocomplete = "new-password" })
        </div>
    </div>
    <div class="group form-action">
        <input class="btn -submit" type="button" value="Submit" onclick="Fanex.ExtAcc.SubGroup.ChangeSubGroupAdminPassword()" />
    </div>
</form>