@using Fanex.ExternalAccount.Utilities
<div id='jqWidget' style="display: none;">
    <div class="page-title">
        <div class="pull-left">@ViewLang.AssignSuperToSubGroup</div>
    </div>
    <div id="searchBar" class="search-form filterbox">
        <div class="searchBar">
            <div class="form-group">
                <div class="label">@ViewLang.Username</div>
                <input id="txtUserName" type="text" class="usernameInput" autocomplete="off" />
            </div>
            <div class="form-group">
                <label for="selSubGroup" class="pointer">@ViewLang.SubGroup<span class="text-red">*</span></label>
                <select id="selSubGroup" class="usernameInput group">
                </select>
            </div>
            <div class="form-group">
                <input id="btnSearch" type="button" value="Submit" class="btn -submit" />
            </div>
        </div>
    </div>
    <div id="mainGrid">
        <div id="errMsg" class="successMsg hide"> </div>
        <div id="jqgrid-group" class="removeRadius freegrid content-grid">
        </div>
    </div>
    @Html.AntiForgeryToken()
</div>
<div id="divNoPermission" style="display: none;">
    @Html.Partial("../Shared/NoPermission")
</div>
<script src="@Url.Content("~/Scripts/Manage/Fanex.ExtAcc.SubGroup.js")" type="text/javascript"></script>
