@using Fanex.ExternalAccount.Utilities
@model Fanex.ExternalAccount.RewardManagement.ViewModels.RewardManagementViewModel
@{
    Layout = null;
    var typeReport = "reward-detail";
}
@StaticResources.RenderStyles("~/assets/styles/pages/reports/reward-detail")
<div class="">
    <div class="page-title">Reward Detail</div>

    <div class="search-form search-form-report-by-cur filterbox">
        <div class="form-group daterangepicker-container">
            <label class="label-form-control" for="@typeReport-date-range-picker">@ViewLang.DateRange</label>
            <div class="input-group date datepicker">
                <input type="text"
                       class="form-control"
                       id="@typeReport-date-range-picker"
                       autocomplete="off"
                       readonly
                       data-mindate="@Model.FormatedMinDate"
                       data-maxdate="@Model.FormatedToday"
                       data-fromdate="@Model.FormatedToday"
                       data-todate="@Model.FormatedToday"
                       data-currentdate="@Model.FormatedToday"
                       data-label-today="@ViewLang.Today"
                       data-label-yesterday="@ViewLang.Yesterday"
                       data-label-thisweek="@ViewLang.ThisWeek"
                       data-label-lastweek="@ViewLang.LastWeek"
                       data-label-thismonth="@ViewLang.ThisMonth"
                       data-label-lastmonth="@ViewLang.LastMonth"
                       data-label-sincelastmonth="@ViewLang.SinceLastMonth"/>
                <label class="input-group-addon" for="@typeReport-date-range-picker">
                    <span class="icon-calendar"></span>
                </label>
            </div>
        </div>
        <div class="form-group">
            <div class="label-form-control">Program</div>
            <div class="ddl-filter-component ddl-programs">
                <div id="@typeReport-ddl-programs"></div>
            </div>
        </div>
        <div class="form-group">
            <div class="label-form-control">Member Payment Status</div>
            <div id="userGroup" class="user-group pull-left ddl-filter-component ddl-payment-status">
                @* <div id="@typeReport-ddl-payment-status"></div> *@
                <select name="@typeReport-ddl-payment-status" id="@typeReport-ddl-payment-status">
                    <option value="0" selected>All</option>
                    <option value="1">Unpaid</option>
                    <option value="2">Paid</option>
                </select>
            </div>
        </div>
        <div class="form-group">
            <div class="label">@ViewLang.Username</div>
            <div>
                <input id="@typeReport-username-filter" type="text" autocomplete="off" maxlength="50"/>
            </div>
        </div>
        <div class="form-group btn-box">
            <input type="button" value="@ViewLang.Submit" id="@typeReport-submit-btn" class="btn -submit btnSearch"/>
        </div>
        <div class="form-group" style="display: flex; justify-content: space-between; align-items: flex-start;">
            <div class="note-text"></div>
            <div id="@typeReport-ddl-columns-container" class="columns-container" style="display: none">
                <div class="label-form-control">Columns</div>
                <div class="ddl-filter-component columns-list">
                    <div id="@typeReport-ddl-columns"></div>
                </div>
            </div>
        </div>
    </div>
    <div id="@typeReport-mainGrid" class="settlement-grid daily" style="display: none">
        <div id="@typeReport-jqgrid" class="removeRadius freegrid content-grid"></div>
    </div>
    <div id="@typeReport-msgNoInfo" class="div-noData msgNoInfo" style="display: none">@ViewLang.NoData</div>

</div>

@Html.Hidden("hidden-today", Model.FormatedToday)
@Html.Hidden("inp-programs", Newtonsoft.Json.JsonConvert.SerializeObject(Model.Programs))
@StaticResources.RenderScripts("~/assets/bundles/reward-management-report/index")