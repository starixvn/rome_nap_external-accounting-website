@using Fanex.ExternalAccount.Utilities
@model IList<Fanex.ExternalAccount.DTO.UserControl.HierarchicalFunction>
@{
    int funcId = ViewBag.FuncId ?? 0;
}
<div id="jqWidget" class="grant-permission">
    @if (funcId == 0)
    {
        <div class="page-title">@ViewLang.GrantPermission</div>
    }
    <div class="search-form filterbox">
        <div class="searchBar">
            <div class="form-group">
                <label class="label">@ViewLang.PermissionFrom</label>
                <div class="groupCboMenu pull-left">
                    <select id="functionFrom">
                        <option value="0" selected style="display:none"></option>
                        @foreach (var func in Model)
                        {
                            if (func.HasSubFunctions)
                            {
                                <optgroup label="@func.Name">
                                    @foreach (var sub in func.SubFunctions)
                                    {
                                        <option value="@sub.Id">@sub.Name</option>
                                    }
                                </optgroup>
                            }
                            else
                            {
                                <option value="@func.Id">@func.Name</option>
                            }
                        }
                    </select>
                </div>
            </div>
            <div class="form-group">
                <label class="label">@ViewLang.PermissionTo</label>
                <div class="groupCboMenu pull-left">
                    <select id="functionTo">
                        <option value="0" style="display:none" @(funcId == 0 ? "selected" : string.Empty)></option>
                        @foreach (var func in Model)
                        {
                            if (func.HasSubFunctions)
                            {
                                 <optgroup label="@func.Name">
                                     @foreach (var sub in func.SubFunctions)
                                     {
                                         <option value="@sub.Id" @(sub.Id == funcId ? "selected" : string.Empty)>@sub.Name</option>
                                     }
                                 </optgroup>
                            }
                            else
                            {
                                 <option value="@func.Id" @(func.Id == funcId ? "selected" : string.Empty)>@func.Name</option>
                            }
                        }
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div id="err-message" class="hide"></div>
    <div id="tabs" class="hide" style="float: left; border: none">
        <ul class="tabs">
            <li><a href="#tabs-GroupPolicy">@ViewLang.GroupPermission</a></li>
            <li><a href="#tabs-UserPolicy">@ViewLang.UserPermission</a></li>
        </ul>
        <div id="tabs-GroupPolicy" style="padding:10px 0 0 10px;width:100%;">
            <div id="groupPolicyGrid">
                <div id="jqgrid-groupPolicy" class="removeRadius freegrid content-grid">
                </div>
                <input type="button" value="Submit" class="btn -submit" style="float:left;margin:15px 15px 15px 540px" id="updateGroupPolicy" />
            </div>
        </div>
        <div id="tabs-UserPolicy" style="padding:10px 0 0 10px;width:100%;">
            <div id="userPolicyGrid">
                <div id="jqgrid-userPolicy" class="removeRadius freegrid content-grid">
                </div>
                <input type="button" value="@ViewLang.Submit" class="btn -submit" style="float:left;margin:15px 15px 15px 722px" id="updateUserPolicy" />
            </div>
        </div>
    </div>
    @Html.AntiForgeryToken()
    <input id="gridExpandHeightHiddenField" type="hidden" value="@(funcId == 0 ? 256 : 430)" />
</div>
<script type="text/javascript" src="@Url.Content("~/Scripts/Manage/Fanex.ExtAcc.Permission.js")"></script>
