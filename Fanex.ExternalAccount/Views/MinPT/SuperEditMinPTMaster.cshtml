@using Fanex.ExternalAccount.Utilities
@using Fanex.PTEngine
<script src="@HttpContext.Current.GetWebResourceUrl("Fanex.PTEngine.UI.BetTypeGroup.js")" type="text/javascript"></script>
<script src="@HttpContext.Current.GetWebResourceUrl("Fanex.PTEngine.UI.BetType.js")" type="text/javascript"></script>
<script src="@HttpContext.Current.GetWebResourceUrl("Fanex.PTEngine.UI.BettingLimit.js")" type="text/javascript"></script>
<div style="margin-top: 5px;">
    <table width="100%" border="0" cellpadding="2">
        <tr>
            <td>
                <div class="minWidthCustomer">
                    <input type="hidden" name="txtCustomerObject" id="txtCustomerObject" />
                    <div class="pt7">
                        <input id="btnSubmit" class="buttonPopup" type="button" value="Submit" data-bind='click: saveCustomer' />
                    </div>
                    <div class="customerInfo">
                        <div class="headerTab">
                            @ViewLang.generalInformation</div>
                        <div class="clearBlock">
                            <div class="customerInfoViewBlock1">
                                @ViewLang.Username</div>
                            <div class="customerInfoViewBlock2 lineR">
                                <span data-bind="text: customer.userName"></span>
                            </div>
                            <div class="customerInfoViewBlock1">
                                @ViewLang.Firstname</div>
                            <div class="customerInfoViewBlock2">
                                <span data-bind="text: customer.firstName"></span>
                            </div>                
                        </div>
                        <div class="clearBlock">
                            <div class="customerInfoViewBlock1">
                                @ViewLang.Lastname</div>
                            <div class="customerInfoViewBlock2 lineR">
                                <span data-bind="text: customer.lastName"></span>
                            </div>
                            <div class="customerInfoViewBlock1">
                                @ViewLang.Phone</div>
                            <div class="customerInfoViewBlock2">
                                <span data-bind="text: customer.phone"></span>
                            </div>                
                        </div>
                        <div class="clearBlock">
                            <div class="customerInfoViewBlock1">
                                @ViewLang.MobilePhone</div>
                            <div class="customerInfoViewBlock2 lineR">
                                <span data-bind="text: customer.mobilePhone"></span>
                            </div>
                            <div class="customerInfoViewBlock1">
                                @ViewLang.Fax</div>
                            <div class="customerInfoViewBlock2">
                                <span data-bind="text: customer.fax"></span>
                            </div>
                        </div>
                    </div>
                    <div class="headerPositionTaking">
                        @ViewLang.sbminpt</div>
                    <div class="positionTaking">
                        <div id="ptContainer">
                        </div>
                    </div>
                    <div class="clearBlock">
                    </div>
                    <div class="pt7">
                        <input id="btnSubmitFooter" class="buttonPopup" type="button" value="Submit" data-bind='click: saveCustomer' />
                    </div>
                </div>
            </td>
        </tr>
        <tr>
            <td>
                <div id="errMsg" style="display: none;" class="errMsg">
                </div>
            </td>
        </tr>
    </table>
</div>
<script src="../../Scripts/Customer/Fanex.ExtAcc.Customer.SuperEditMinPTMaster.js" type="text/javascript"></script>