
@{
    ViewBag.Title = "OTP";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <title>@ViewBag.Title</title>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=9" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    @StaticResources.RenderStyles("~/assets/bundles/login/login")
</head>
<body>
   @using (Html.BeginForm("VerifyOTP", "OTP", FormMethod.Post, new { id = "otp-form", method = "Post" }))
   {
        <div class="block-login">
            <div class="row">
                <div class="login-logo icon-outline-lock"></div>
            </div>
            @if (ViewBag.redirect)
            {
                <div id="err-message" class="row errMsg">
                    Verify OTP fail
                </div>
            }
            <div class="row">
                <input type="password" autocomplete="off" class="form-control" name="otp" id="otp" placeholder="Input OTP" maxlength="6">
                <label id="otp-error" class="error"></label>
                <span class="icon-lock"></span>
            </div>

            <div class="row">
                <button id="btnLogin" class="btnLogin">Submit</button>
            </div>
        </div>

    }

    <script type="text/javascript">
        function resolveClientUrl(relativeUrl) {
            return '@Url.Content("~/")' + relativeUrl;
        }
    </script>
    @StaticResources.RenderScripts("~/assets/bundles/login/login")
</body>
</html>