            <td style="width: 120px; text-align: right">
                @Html.HiddenFor(m => m.UserID) @Html.LabelFor(m => m.Username, ViewLang.Username, new { @style = "width: 100px;" })
            </td>
            <td style="width: 235px; text-indent: 2px; color: #2489CE">
                @Model.Username
            </td>
        </tr>
*@        <tr>
            <td style="text-align: right">
                @Html.HiddenFor(m => m.UserID)@Html.LabelFor(m => m.Password, ViewLang.Newpassword, new { @style = "width: 235px;" })
            </td>
            <td>
                @Html.PasswordFor(m => m.Password, new { @style = "width: 235px;" })
            </td>
        </tr>
        <tr>
            <td style="text-align: right">
                <label for="confirmPwd">@ViewLang.Confirmpassword</label>
            </td>
            <td>
                <input id="confirmPwd" type="password" style="width: 235px;" />
            </td>
        </tr>
        <tr>
            <td colspan="2">
                <div class="warningResetPwd" id="warningResetPwd">
                    * New password will be applied for all systems</div>
                <div style="float: right; margin-right: 1px">
                    <input class="buttonPopup" type="button" value="Submit" onclick="Fanex.ExtAcc.User.ResetPwd()" />
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="2">
                <div id="errMsg" style="display: none;" class="successMsg">
                </div>
            </td>
        </tr>
    </table>
    <script type="text/javascript">
        $(document).ready(function () {
            if ('@ViewBag.IsInternalAdmin' == 'True') {
                $('#warningResetPwd').css('display', 'block');
            }
            else {
                $('#warningResetPwd').css('display', 'none');
            }
        });
    </script>
</div>
