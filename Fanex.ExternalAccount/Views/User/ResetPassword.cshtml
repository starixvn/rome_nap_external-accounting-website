@using Fanex.ExternalAccount.Utilities
@using Fanex.ExternalAccount.DTO.UserControl
@model User
<div>
    <table width="100%" border="0" cellpadding="2">
        <tr>
            <td style="width: 120px; text-align: right">
                @Html.HiddenFor(m => m.UserID) @Html.LabelFor(m => m.Username, ViewLang.Username, new { @style = "width: 100px; height: 30px" })
            </td>
            <td style="width: 235px; height: 30px; text-indent: 2px; color: #2489CE">
                @Model.Username
            </td>
        </tr>
        <tr>
            <td style="text-align: right">
                @Html.LabelFor(m => m.Password, ViewLang.Newpassword, new { @style = "width: 235px; height: 30px" })
            </td>
            <td>
                @Html.PasswordFor(m => m.Password, new { @style = "width: 235px; height: 30px" })
            </td>
        </tr>
        <tr>
            <td style="text-align: right">
                <label for="confirmPwd" class="divMargin">@ViewLang.Confirmpassword</label>
            </td>
            <td>
                <input id="confirmPwd" type="password" style="width: 235px; height: 30px;" />
            </td>
        </tr>
        <tr>
            <td colspan="2">
                <div class="warningResetPwd" id="warningResetPwd">
                    * New password will be applied for all systems</div>
                <div style="float: right">
                    <input class="buttonPopup" type="button" value="Submit" onclick="Fanex.ExtAcc.User.ResetPwd()" />
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="2">
                <div id="errMsg" style="display: none;" class="errMsg">
                </div>
            </td>
        </tr>
    </table>
    <script type="text/javascript">
        $(document).ready(function () {
            if ('@ViewBag.IsInternalAdmin' == 'True') {
                $('#warningResetPwd').css('display', 'block');
            }
            else {
                $('#warningResetPwd').css('display', 'none');
            }
        });
    </script>
</div>