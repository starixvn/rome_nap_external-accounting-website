@using Fanex.ExternalAccount.Utilities
@using Fanex.ExternalAccount.DTO.UserControl
@model User

<form class="form-add">
    <div id="err-message" class="row errMsg hide"></div>

    <div class="group">
        <div class="pull-left width-120 text-right">
            @Html.HiddenFor(m => m.UserID)@Html.LabelFor(m => m.Password, ViewLang.Newpassword, new { @class = "label" })
        </div>
        <div class="pull-left width-250">
            @Html.PasswordFor(m => m.Password, new { @class = "form-control width-250" })
        </div>
    </div>
    <div class="group">
        <div class="pull-left width-120 text-right">
            <label for="confirmPwd" class="label">@ViewLang.Confirmpassword</label>
        </div>
        <div class="pull-left">
            <input id="confirmPwd" type="password" class="form-control width-250" />
        </div>
    </div>
    <div class="group form-action with-label-120">
        <input class="btn -submit" type="button" value="Submit" onclick="Fanex.ExtAcc.User.ResetPwd()" />
    </div>
    <div class="group">
        <div class="warningResetPwd" id="warningResetPwd">
            * New password will be applied for all systems
        </div>
    </div>
    </div>
</form>

<script type="text/javascript">
        $(document).ready(function () {
            if ('@ViewBag.IsInternalAdmin' == 'True') {
                $('#warningResetPwd').css('display', 'block');
            }
            else {
                $('#warningResetPwd').css('display', 'none');
            }
        });
</script>
