@using Fanex.ExternalAccount.Utilities
@using Fanex.ExternalAccount.DTO.UserControl
@using Fanex.ExternalAccount.DTO
@{
    var funcs = (IEnumerable<Function>)ViewBag.UserFunc;
    var subFuncs = (IEnumerable<Function>)ViewBag.UserSubFunc;
}
<div style="height: 25px; font-weight: bold;">@ViewLang.Username: <font color="#4b91be">@ViewBag.Username</font></div>
<div id="errMsg" style="margin: 5px 0 30px 0; display: none;" class="successMsg">
</div>
<table id="tblInner" style="width: 100%">
    <tr>
        <th rowspan="2">
            <input type="hidden" id="UserID" value="@ViewBag.UserID" />@ViewLang.Functions
        </th>
        <th colspan="2" style="width: 120px">
            @ViewLang.UserPermission
        </th>
        <th colspan="2" style="width: 120px">
            @ViewLang.GroupPermission
        </th>
    </tr>
    <tr>
        <th style="width: 60px">
            @ViewLang.Read
        </th>
        <th style="width: 60px">
            @ViewLang.Write
        </th>
        <th style="width: 60px">
            @ViewLang.Read
        </th>
        <th style="width: 60px">
            @ViewLang.Write
        </th>
    </tr>
    @foreach (Function fn in funcs)
    {
        var className = "";

        className = subFuncs.Any(o => o.ParentID == fn.FuncID) ? "permItemParent" : "permItemParentOnly";

        string activeR = "permInactive";
        string activeW = "permInactive";
        string val = "0";

        string activeGroupR = "permInactive";
        string activeGroupW = "permInactive";

        if (fn.Policy != null)
        {
            if (fn.Policy == EPolicy.Create ||
                fn.Policy == EPolicy.Delete ||
                fn.Policy == EPolicy.Update)
            {
                activeR = activeW = "permActive";
                val = "2";
            }
            else if (fn.Policy == EPolicy.Read)
            {
                activeR = "permActive";
                activeW = "permInactive";
                val = "1";
            }
            else
            {
                activeR = activeW = "permInactive";
            }
        }

        if (fn.GroupPolicy != null)
        {
            if (fn.GroupPolicy == EPolicy.Create ||
                fn.GroupPolicy == EPolicy.Delete ||
                fn.GroupPolicy == EPolicy.Update)
            {
                activeGroupR = activeGroupW = "permActive";
            }
            else if (fn.GroupPolicy == EPolicy.Read)
            {
                activeGroupR = "permActive";
                activeGroupW = "permInactive";
            }
            else
            {
                activeGroupR = activeGroupW = "permInactive";
            }
        }

        <tr title="@fn.FuncDesc.DecodeHtml()">
            <td>
                <div id="parent-@fn.FuncID" expand="true" style="cursor:pointer" class="@className" onclick="Fanex.ExtAcc.ToggleRows(@fn.FuncID)">@fn.FuncName</div>
            </td>
            <td>
                <div id="r-@fn.FuncID" class="@activeR" parent="r-@fn.FuncID" permission="1" onclick="Fanex.ExtAcc.UserPolicy.GrantPermissionsRead(this);">
                </div>
            </td>
            <td>
                <div id="w-@fn.FuncID" class="@activeW" parent="w-@fn.FuncID" val="@val" permission="2" onclick="Fanex.ExtAcc.UserPolicy.GrantPermissionsWrite(this);">
                </div>
            </td>
            <td style="background-color: #DFDFDF">
                <div class="@activeGroupR" style="cursor: default" >
                </div>
            </td>
            <td style="background-color: #DFDFDF">
                <div class="@activeGroupW" style="cursor: default" >
                </div>
            </td>
        </tr>
        foreach (Function subfn in subFuncs)
        {
            if (fn.FuncID == subfn.ParentID)
            {

                string SubactiveR = "permInactive";
                string SubactiveW = "permInactive";
                string Subval = "0";

                string SubactiveGroupR = "permInactive";
                string SubactiveGroupW = "permInactive";

                if (subfn.Policy != null)
                {
                    if (subfn.Policy == EPolicy.Create ||
                        subfn.Policy == EPolicy.Delete ||
                        subfn.Policy == EPolicy.Update)
                    {
                        SubactiveR = SubactiveW = "permActive";
                        Subval = "2";
                    }
                    else if (subfn.Policy == EPolicy.Read)
                    {
                        SubactiveR = "permActive";
                        SubactiveW = "permInactive";
                        Subval = "1";
                    }
                    else
                    {
                        SubactiveR = SubactiveW = "permInactive";
                    }
                };

                if (subfn.GroupPolicy != null)
                {
                    if (subfn.GroupPolicy == EPolicy.Create ||
                        subfn.GroupPolicy == EPolicy.Delete ||
                        subfn.GroupPolicy == EPolicy.Update)
                    {
                        SubactiveGroupR = SubactiveGroupW = "permActive";
                    }
                    else if (subfn.GroupPolicy == EPolicy.Read)
                    {
                        SubactiveGroupR = "permActive";
                        SubactiveGroupW = "permInactive";
                    }
                    else
                    {
                        SubactiveGroupR = SubactiveGroupW = "permInactive";
                    }
                }
        <tr parentid="@subfn.ParentID" title="@subfn.FuncDesc.DecodeHtml()">
            <td>
                <span class="permItemChild">@subfn.FuncName</span>
            </td>
            <td>
                <div id="r-@subfn.FuncID" parent="r-@subfn.ParentID" permission="1" class="@SubactiveR" onclick="Fanex.ExtAcc.UserPolicy.GrantPermissions(this);">
                </div>
            </td>
            <td>
                <div id="w-@subfn.FuncID" parent="w-@subfn.ParentID" val="@Subval"  permission="2" class="@SubactiveW" onclick="Fanex.ExtAcc.UserPolicy.GrantPermissions(this);">
                </div>
            </td>
            <td style="background-color: #DFDFDF">
                <div class="@SubactiveGroupR" style="cursor: default" >
                </div>
            </td>
            <td style="background-color: #DFDFDF">
                <div class="@SubactiveGroupW" style="cursor: default" >
                </div>
            </td>
        </tr>
            }
        }
    }
</table>
<div style="float: right; margin: 5px 0px 30px 0px">
    <input class="buttonPopup" type="button" value="Submit" onclick="Fanex.ExtAcc.UserPolicy.SaveUserPolicy()" />
</div>
<script src="@Url.Content("~/Scripts/Manage/Fanex.ExtAcc.UserPolicy.js")" type="text/javascript"></script>