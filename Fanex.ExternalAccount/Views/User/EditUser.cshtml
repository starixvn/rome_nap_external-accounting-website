@using Fanex.ExternalAccount.Utilities
@using Fanex.ExternalAccount.DTO.UserControl
@model User
@{
    var groupList = (IEnumerable<Group>)ViewBag.GroupList;
    var counter = -1;
    var index = 0;
}
<link href="@Url.Content("~/Scripts/Combobox/Combobox.css")" rel="stylesheet" type="text/css" />
<div>
    <table width="100%" border="0" cellpadding="2">
        <tr>
            <td style="width: 80px; text-align: right">
                @Html.HiddenFor(m => m.UserID) @Html.LabelFor(m => m.Username, ViewLang.Username, new { @class = "divMargin" })
            </td>
            <td class="editControl" style="text-indent: 2px; color: #2489CE">
                <div>@Model.Username</div>
            </td>
        </tr>
        <tr>
            <td style="text-align: right">
                @Html.LabelFor(m => m.FirstName, ViewLang.Firstname, new { @class = "divMargin" })
            </td>
            <td>
                @Html.TextBoxFor(m => m.FirstName, new { @class = "editControl" })
            </td>
        </tr>
        <tr>
            <td style="text-align: right">
                @Html.LabelFor(m => m.LastName, ViewLang.Lastname, new { @class = "divMargin" })
            </td>
            <td>
                @Html.TextBoxFor(m => m.LastName, new { @class = "editControl" })
            </td>
        </tr>
        <tr>
            <td style="text-align: right">
                @Html.LabelFor(m => m.GroupID, ViewLang.Group, new { @class = "divMargin" })
            </td>
            <td class="groupCboMenu">
                <select id="GroupID" name="GroupID" class="cboControl">
                    @foreach (var item in groupList)
                    {
                        <option value="@item.GroupID" @(item.GroupID == Model.GroupID ? "selected=selected" : "")>@item.GroupName</option>
                        if (item.GroupID == Model.GroupID)
                        {
                            counter = index;
                        }

                        index++;
                    }
                </select>
            </td>
        </tr>
        <tr>
            <td colspan="2">
                <div style="float: right">
                    <input class="buttonPopup" type="button" value="Submit" onclick="Fanex.ExtAcc.User.Edit()" />
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="2">
                <div id="errMsg" style="display: none;" class="successMsg">
                </div>
            </td>
        </tr>
    </table>
</div>
<script src="@Url.Content("~/Scripts/Combobox/Combobox.js")" type="text/javascript"></script>
<script type="text/javascript">
    $('#GroupID').combobox();
    $(document).ready(function () {
        var select = document.getElementById('GroupID');
        $('.groupCboMenu input').val(select.options[@counter].text);
        $(".groupCboMenu input").attr("readonly", "true");
        $(".groupCboMenu input").bind("click", function () {
            $(this).autocomplete("search", '');
        });
    });
</script>