<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <title>Under Maintenance</title>
    <style type="text/css">
        body
        {
            margin-top: 10px;
            font-family: Arial;
            font-size: 14px;
            text-align: center;
            letter-spacing: 1px;
            line-height: 17px;
            cursor: default;
        }
        .text_time
        {
            color: #F00;
            font-weight: bold;
            text-align: center;
            width: 100%;
            left: 00px;
            right: 0px;
            position: absolute;
        }
        .contain
        {
            background: url(@Url.Content("~/Images/UnderMaintenance.gif")) no-repeat scroll center center;
            width: 90%;
            left: 0px;
            right: 0px;
            top: 0px;
            height: 286px;
            position: absolute;
        }
    </style>
</head>
<body>
    <div class="contain">
        <div class="text_time" style="margin-top: 100px; padding-left: 9px; top: 0px;">
            @(ViewBag.UmFromTime)
            <font color="#555">until</font>
            @(ViewBag.UmToTime) (GMT+8)</div>
        <div class="text_time" style="margin-top: 77px; padding-left: 85px; top: 118px;">
            @(ViewBag.UmFromTime)
            <font color="#555">至</font>
            @(ViewBag.UmToTime) (GMT+8)
        </div>
    </div>
    <script type="text/javascript">

        function resolveClientUrl(relativeUrl) {
            return '@Url.Content("~/")' + relativeUrl;
        }

        function navigateToUrl(url, delayTime) {
            if (delayTime == undefined) delayTime = 2000;
            setInterval("window.location.replace('" + resolveClientUrl(url) + "');", delayTime);
        }
    </script>
    <script src="@Url.Content("~/Scripts/Lib/jquery-ui-1.9.1/jquery-1.8.3.min.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Scripts/UnderMaintenance.js")" type="text/javascript"></script>
</body>
</html>