@using Fanex.ExternalAccount.Core.Context;
@using Fanex.ExternalAccount.Utilities
@using Fanex.ExternalAccount.Core.Authorization
@using Fanex.PTEngine
@using Fanex.ExternalAccount.Module.LeftPanel
@using Newtonsoft.Json;

@{
    var isLocal = Request.IsLocal ? 1 : 0;
    var userId = CurrentSession.Instance.UserId;
    var admins = AuthorizationServiceImpl.Instance.HasOpenSuperPermission(userId) ? new int[] { userId } : new int[] { };
    var showBetSetting = AuthorizationServiceImpl.Instance.HasReadPermissionOnFunctions(AccountInfoProductConfiguration.VisibleBetSettingPermissions.Values, userId) ? 1 : 0;
    var allowAdminEditSuperStatus = JsonConvert.SerializeObject(admins, Formatting.None, new JsonSerializerSettings
    {
        ContractResolver = new Newtonsoft.Json.Serialization.CamelCasePropertyNamesContractResolver(),
        NullValueHandling = NullValueHandling.Ignore
    });
    var isUpdateCredit = AuthorizationServiceImpl.Instance.HasUpdateCreditPermission(userId) ? 1 : 0;
    var hasClose = AuthorizationServiceImpl.Instance.HasCloseCustomerPermission(userId) ? 1 : 0;
    var hasSuspend = AuthorizationServiceImpl.Instance.HasSuspendCustomerPermission(userId) ? 1 : 0;
    var allowAutoPT = AuthorizationServiceImpl.Instance.HasAllowAutoMPTPermission(userId) ? 1 : 0;
    var hasClearCredit = AuthorizationServiceImpl.Instance.HasClearCreditPermission(userId) ? 1 : 0;
    var enableKeno = ProductSettings.IsShowKeno ? 1 : 0;
    var showKenoSetting = ProductSettings.ShowKenoSetting ? "true" : "false";
    var showGoldDeluxeSetting = ProductSettings.IsShowGoldDeluxe ? 1 : 0;
    var showColossusBets = ProductSettings.IsShowColossusBets ? 1 : 0;
    var showSportsbook2 = ProductSettings.IsShowSportsbook2 ? 1 : 0;
    var showCockfighting = ProductSettings.IsShowCockfighting ? 1 : 0;
    var showCricket = ProductSettings.IsShowCricket ? 1 : 0;
    var showAllbet = ProductSettings.IsShowAllbet ? 1 : 0;
    var showVoidbridge = ProductSettings.IsShowVoidBridge ? 1 : 0;
    var showNG2 = ProductSettings.IsShowNG2 ? 1 : 0;
    var showFishingWorld = ProductSettings.IsShowFishingWorld ? 1 : 0;
    var showLottery = ProductSettings.IsShowLottery ? 1 : 0;
    var showLucky3 = ProductSettings.IsShowLucky3 ? 1 : 0;
    var showBullfighting = ProductSettings.IsShowBullfighting ? 1 : 0;
    var ng2Text = RemotingRef.RefData.GetResourceDataByRefIdAndResourceId("Product", "23", "en-US", "NG2");
    var products = JsonConvert.SerializeObject(ProductSettings.SiteProducts.Values);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <title>External Accounting Site</title>
    <meta http-equiv="x-ua-compatible" content="ie=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1" />
    <meta name="author" content="Nathan Smith" />
    <meta name="copyright" content="Licensed under GPL and MIT." />
    <meta name="description" content="Adapt.js serves CSS based on screen width." />
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />
    <link href='https://fonts.googleapis.com/css?family=Cabin' rel='stylesheet' type='text/css' />
    <link href='https://fonts.googleapis.com/css?family=Cinzel' rel='stylesheet' type='text/css' />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.4/css/select2.min.css" rel="stylesheet" />
    <link href="@HttpContext.Current.GetWebResourceUrl("Fanex.PTEngine.UI.Core.css")" rel="stylesheet" />

    @StaticResources.RenderStyles("~/assets/bundles/common")

    @RenderSection("StyleSheet", false)
</head>
<body style="overscroll-behavior-y: none">
    <div id="groupName" style="display: none">@CurrentSession.Instance.CurrencyGroup</div>
    <div id="selectedGroupIndex" style="display: none">@CurrentSession.Instance.GroupId</div>
    <div id="selectedGroupName" style="display: none"></div>
    <div id="container">
        <header id="header" class="header">
            <div id="iconUserInfo" class="icon-account-settings active"></div>
            <div id='accMenuGroup' class="group-user">
                <select id="ddlGroupName"></select>
            </div>
            @Html.Action("_Menu", "Shared")
            <div class="info" id="accMenu">
                <ul class="list" id="userNameMenu">
                    <li><span class="circle">@CurrentSession.Instance.UserName</span></li>
                    <li><span class="icon-lock-reset" onclick="Fanex.ExtAcc.User.ShowResetPwd(@CurrentSession.Instance.UserId, true, '@CurrentSession.Instance.UserName')" title="Reset Password"></span></li>
                    <li><span class="icon-logout" onclick="Fanex.ExtAcc.Account.Logout()" title="Log out"></span></li>
                </ul>
            </div>
            <!-- For mobile -->
            <div id="iconNav" class="icon-nav">
                <span></span>
                <span></span>
                <span></span>
            </div>
        </header>
        <div class="sidebar" id="sidebar">
            <div class="profile">
                <div class="picture">
                    <span class="text">@CurrentSession.Instance.UserName.FirstOrDefault()</span>
                </div>
                <span class="username">@CurrentSession.Instance.UserName</span>
                <div class="list-action">
                    <button class="btn -reset" onclick="Fanex.ExtAcc.User.ShowResetPwd(@CurrentSession.Instance.UserId, true, '@CurrentSession.Instance.UserName')">Reset Password</button>
                    <button class="btn -logout" onclick="Fanex.ExtAcc.Account.Logout()">Log Out</button>
                </div>
            </div>
            @Html.Action("_Menu", "Shared")
        </div>

        <div id='mainContent' class="main-content">
            <div id="mainSplitter">
                <div class="splitter-panel" id="leftSplitter">
                    <div id="search" class="group-search">
                        <input placeholder="username" class="search" maxlength="50" id="txtLeftPanelUserName" type="text" autocomplete="off" />
                        <span class="icon-magnify" id="searchPanel" title="Search"></span>
                    </div>
                    <iframe id="leftFrame" class="iframe"></iframe>
                </div>
                <div class="content" id="contentSplitter">
                    @RenderBody()
                </div>
            </div>
        </div>
    </div>
    <div id="footer">
    </div>

    @StaticResources.RenderScripts("~/assets/bundles/common")

    <script type="text/javascript">
        function resolveClientUrl(relativeUrl) {
            return '@Url.Content("~/")' + relativeUrl;
        }

        function navigateToUrl(url, delayTime) {
            if (delayTime == undefined) delayTime = 2000;
            setInterval("window.location.replace('" + resolveClientUrl(url) + "');", delayTime);
        }

        Fanex.ExtAcc.IsInternalAdmin = '@CurrentSession.Instance.IsInternalAdmin';
        Fanex.ExtAcc.IsITAdmin = '@CurrentSession.Instance.IsITAdmin';

        var isLocal = @isLocal;
        var showBetSetting = '@showBetSetting';
        var allowAdminEditSuperStatus = '@allowAdminEditSuperStatus';
        var userId = '@userId';
        var username = '@CurrentSession.Instance.UserName';
        var menuTitles = '{"ResetPwd" : "@ViewLang.ResetPassword", "CreateExistUser" : "@ViewLang.AddExistingUser", "CreateUser" : "@ViewLang.NewUser", "EditUser" : "@ViewLang.EditUserInfo", "Edit": "@ViewLang.EditMenu", "Activate": "@ViewLang.Activate", "Delete": "@ViewLang.Delete", "Create" : "@ViewLang.NewMenu", "Deactivate" : "@ViewLang.Deactivate", "EditGroup" : "@ViewLang.EditGroup", "EditFunction":"@ViewLang.EditFunction", "CreateFunction" : "@ViewLang.NewFunction"}';
        var isUpdateCredit = '@isUpdateCredit';
        var hasClose = '@hasClose';
        var hasSuspend = '@hasSuspend';
        var allowAutoPT = '@allowAutoPT';
        var hasClearCredit = '@hasClearCredit';
        var enableKeno = '@enableKeno';
        var showKenoSetting = '@showKenoSetting';
        var showGoldDeluxeSetting = '@showGoldDeluxeSetting';
        var showColossusBets = '@showColossusBets';
        var showSportsbook2 = @showSportsbook2;
        var showCockfighting = @showCockfighting;
        var showCricket = @showCricket;
        var showAllbet = @showAllbet;
        var showVoidbridge = @showVoidbridge;
        var showFishingWorld = @showFishingWorld;
        var showAllbetBetting = true;
        var showVoidbridgeBetting = true;
        var showNG2 = @showNG2;
        //var showFishingWorldBetting = true;
        var showNG2Betting = true;
        var showBullfighting = @showBullfighting;
        var showBullfightingBetting = true;
        var ng2Text = '@ng2Text';
        var showLottery = @showLottery;
        var showLucky3 = @showLucky3;

        var siteLevelProducts = @(Html.Raw(products));

        $(document).ready(function () {
            Fanex.ExtAcc.Customer.ReCheckin();
            setInterval(Fanex.ExtAcc.Customer.ReCheckin, 20000);
            disablePulldownAndReleaseRefresh();
        });

        var titles = ['@ViewLang.EditPersonalInfo', '@ViewLang.editTransferCondition', '@ViewLang.confirmTransCondition', '@ViewLang.choonseDaily', '@ViewLang.chooseOneDay'];
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.4/js/select2.min.js"></script>
    @RenderSection("Scripts", false)

</body>
</html>