                            <path d="M144.5 228.015C155.884 228.015 165.113 218.382 165.113 206.499C165.113 194.616 155.884 184.983 144.5 184.983C133.116 184.983 123.887 194.616 123.887 206.499C123.887 218.382 133.116 228.015 144.5 228.015Z" fill="#2F80ED" />
                            <path d="M284.482 60.3869C207.285 -20.129 81.715 -20.129 4.51839 60.3869C-1.50613 66.6752 -1.50613 76.9093 4.51839 83.2593C10.5429 89.5477 20.3475 89.5477 26.4311 83.2593C91.5196 15.2585 197.48 15.2585 262.628 83.2593C265.64 86.4035 269.597 88.0064 273.555 88.0064C277.512 88.0064 281.469 86.4035 284.482 83.2593C290.506 76.9709 290.506 66.7369 284.482 60.3869Z" fill="#BDBDBD" />
                        </svg>

                    </span>
                </li>
                <li class="line-network"><span class="text">Line 4</span><span class="icon-wifi"></span></li>
                <li class="line-network in-use">
                    <span class="text">Line 1 - In use</span>
                    <span class="wifi-img">
                        <svg width="24" height="24" viewBox="0 0 289 229" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M46.9854 104.775C40.9609 111.064 40.9609 121.298 46.9854 127.648C53.01 133.936 62.8146 133.936 68.8982 127.648C110.597 84.1224 178.462 84.1224 220.161 127.648C223.173 130.792 227.131 132.395 231.088 132.395C235.045 132.395 239.002 130.792 242.015 127.648C248.039 121.359 248.039 111.125 242.015 104.775C188.266 48.6116 100.734 48.6116 46.9854 104.775Z" fill="#BDBDBD" />
