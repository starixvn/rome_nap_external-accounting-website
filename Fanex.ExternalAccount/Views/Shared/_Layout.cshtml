@using Fanex.ExternalAccount.Core.Context;
@using Fanex.ExternalAccount.Utilities
@using Fanex.ExternalAccount.Core.Authorization
@using Fanex.PTEngine
@using Fanex.ExternalAccount.Module.LeftPanel
@using Newtonsoft.Json;
@using Fanex.RemotingRef;
@using System.Configuration;

@{
    var authenService = AuthorizationServiceImpl.Instance;
    var isLocal = Request.IsLocal ? 1 : 0;
    var userId = CurrentSession.Instance.UserId;
    var admins = authenService.HasOpenSuperPermission(userId) ? new int[] { userId } : new int[] { };
    var showBetSetting = authenService.HasReadPermissionOnFunctions(AccountInfoProductConfiguration.VisibleBetSettingPermissions.Values, userId) ? 1 : 0;
    var allowAdminEditSuperStatus = JsonConvert.SerializeObject(admins, Formatting.None, new JsonSerializerSettings
    {
        ContractResolver = new Newtonsoft.Json.Serialization.CamelCasePropertyNamesContractResolver(),
        NullValueHandling = NullValueHandling.Ignore
    });
    var isUpdateCredit = authenService.HasUpdateCreditPermission(userId) ? 1 : 0;
    var hasClose = authenService.HasCloseCustomerPermission(userId) ? 1 : 0;
    var hasSuspend = authenService.HasSuspendCustomerPermission(userId) ? 1 : 0;
    var allowAutoPT = authenService.HasAllowAutoMPTPermission(userId) ? 1 : 0;
    var hasClearCredit = authenService.HasClearCreditPermission(userId) ? 1 : 0;
    var enableKeno = ProductSettings.IsShowKeno ? 1 : 0;
    var showKenoSetting = ProductSettings.ShowKenoSetting ? "true" : "false";
    var showGoldDeluxeSetting = ProductSettings.IsShowGoldDeluxe ? 1 : 0;
    var showLiveCasino = ProductSettings.IsShowLiveCasino ? 1 : 0;
    var showVoidbridge = ProductSettings.IsShowVoidBridge ? 1 : 0;
    var showNG2 = ProductSettings.IsShowNG2 ? 1 : 0;
    var showFishingWorld = ProductSettings.IsShowFishingWorld ? 1 : 0;
    var showRNGLottery = ProductSettings.IsShowRNGLottery ? 1 : 0;
    var ng2Text = new RemotingRefService().GetResourceDataByRefIdAndResourceId("Product", "23", "en-US", "NG2");
    var productsExcludeSabaVS = ProductSettings.SiteProducts.Where(i => i.Key != 54).ToDictionary(p => p.Key, p => p.Value);
    
    var products = JsonConvert.SerializeObject(productsExcludeSabaVS.Values);
    string Env = ConfigurationManager.AppSettings["EnvTheme"].ToString();

}
<!DOCTYPE html>
<html lang="en">
<head>
    <title>External Accounting Site</title>
    <meta http-equiv="x-ua-compatible" content="ie=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1" />
    <meta name="author" content="Nathan Smith" />
    <meta name="copyright" content="Licensed under GPL and MIT." />
    <meta name="description" content="Adapt.js serves CSS based on screen width." />
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />
    <link href="@HttpContext.Current.GetWebResourceUrl("Fanex.PTEngine.UI.Core.css")" rel="stylesheet" />

    @StaticResources.RenderStyles("~/assets/bundles/common")

    @RenderSection("StyleSheet", false)
</head>
<body style="overscroll-behavior-y: none">
    <div id="groupName" style="display: none">@CurrentSession.Instance.CurrencyGroup</div>
    <div id="selectedGroupIndex" style="display: none">@CurrentSession.Instance.GroupId</div>
    <div id="selectedGroupName" style="display: none"></div>
    <div id="container">
        <header id="header" class="header @Env">
            @if (!string.IsNullOrEmpty(Env))
            {
                @Html.Raw("<div class='env'>(" + Env + ")</div>");
            }
            <div id="iconUserInfo" class="icon-account-settings active"></div>
            <div id='accMenuGroup' class="group-user">
                <select id="ddlGroupName"></select>
            </div>
            @Html.Action("_Menu", "Shared")
            <div class="info" id="accMenu">
                <ul class="list" id="userNameMenu">
                    <li><span class="circle">@CurrentSession.Instance.UserName</span></li>
                    <li><span class="icon-lock-reset" onclick="Fanex.ExtAcc.User.ShowResetPwd(@CurrentSession.Instance.UserId, true, '@CurrentSession.Instance.UserName')" title="Reset Password"></span></li>
                    <li><span class="icon-logout" onclick="Fanex.ExtAcc.Account.Logout()" title="Log out"></span></li>
                    <li>@Html.Partial("~/Views/Domain/SSO.cshtml")</li>
                </ul>
            </div>
            <!-- For mobile -->
            <div class="wifi-box"><span class="icon-wifi"></span></div>
            <ul class="list-wifi">
                <li class="line-network">
                    <span class="text">Line 3 - Recommend</span>
                    <span class="wifi-img">
                        <svg width="24" height="24" viewBox="0 0 289 229" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M46.9854 104.775C40.9608 111.064 40.9608 121.298 46.9854 127.648C53.0099 133.936 62.8145 133.936 68.8981 127.648C110.597 84.1224 178.462 84.1224 220.161 127.648C223.173 130.792 227.13 132.395 231.088 132.395C235.045 132.395 239.002 130.792 242.015 127.648C248.039 121.359 248.039 111.125 242.015 104.775C188.266 48.6116 100.734 48.6116 46.9854 104.775Z" fill="#2F80ED" />
