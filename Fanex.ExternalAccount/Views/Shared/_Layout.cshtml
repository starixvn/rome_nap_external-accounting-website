@using Fanex.ExternalAccount.Controllers
@using Fanex.ExternalAccount.Core.Context;
@using Fanex.ExternalAccount.Utilities
@using System.Web.Optimization
@using Fanex.PTEngine
@using Fanex.ExternalAccount.Module.LeftPanel.Extensions
@using Fanex.CustomerSetting.Security.Authenticate
@{
    var groupId = CurrentSession.Instance.GroupId;
    var groups = GroupConfigurations.AllowBettingGroups;
    var admins = Config.AdminUsersEditSuperStatus;
    var showBetSetting = groups.Contains(groupId) ? 1 : 0;
    var allowBetSettingGroups = Newtonsoft.Json.JsonConvert.SerializeObject(groups, Newtonsoft.Json.Formatting.None, new Newtonsoft.Json.JsonSerializerSettings
    {
        ContractResolver = new Newtonsoft.Json.Serialization.CamelCasePropertyNamesContractResolver(),
        NullValueHandling = Newtonsoft.Json.NullValueHandling.Ignore
    });
    var allowAdminEditSuperStatus = Newtonsoft.Json.JsonConvert.SerializeObject(admins, Newtonsoft.Json.Formatting.None, new Newtonsoft.Json.JsonSerializerSettings
    {
        ContractResolver = new Newtonsoft.Json.Serialization.CamelCasePropertyNamesContractResolver(),
        NullValueHandling = Newtonsoft.Json.NullValueHandling.Ignore
    });
    var isUpdateCredit = CustomerModelExtensions.IsAuthorized(CurrentSession.Instance.UserId, eFunctions.UpdateCredit, AuthenticateAction.AuthenticationType.Host) ? 1 : 0;
    var hasClose = CustomerModelExtensions.IsAuthorized(CurrentSession.Instance.UserId, eFunctions.CloseCustomer, AuthenticateAction.AuthenticationType.Host) ? 1 : 0;
    var hasSuspend = CustomerModelExtensions.IsAuthorized(CurrentSession.Instance.UserId, eFunctions.SuspendCustomer, AuthenticateAction.AuthenticationType.Host) ? 1 : 0;
    var allowAutoPT = CustomerModelExtensions.IsAuthorized(CurrentSession.Instance.UserId, eFunctions.AllowAutoMPT, AuthenticateAction.AuthenticationType.Host) ? 1 : 0;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <title>External Accounting Site</title>
    <meta http-equiv="x-ua-compatible" content="ie=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1" />
    <meta name="author" content="Nathan Smith" />
    <meta name="copyright" content="Licensed under GPL and MIT." />
    <meta name="description" content="Adapt.js serves CSS based on screen width." />
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />
    <link href='http://fonts.googleapis.com/css?family=Cabin' rel='stylesheet' type='text/css' />
    <link href='http://fonts.googleapis.com/css?family=Cinzel' rel='stylesheet' type='text/css' />
    @if (HttpContext.Current.IsDebuggingEnabled)
    {
        <link href="@Url.Content("~/Content/normalize.css")" rel="stylesheet" type="text/css" />
        <link href="@Url.Content("~/Scripts/Fanex.Grid/Fanex.Grid/Fanex.Pagination.css")" rel="stylesheet" type="text/css" />
        <link href="@Url.Content("~/Scripts/Fanex.Grid/Fanex.Grid/Fanex.Grid.css")" rel="stylesheet" type="text/css" />
        <link rel="stylesheet" type="text/css" href="@Url.Content("~/Content/Main.css")" />
        <link rel="stylesheet" type="text/css" href="@Url.Content("~/Scripts/MultiSelect/jquery.multiselect.css")" />
        <link href="@Url.Content("~/Content/Validators.css")" rel="stylesheet" type="text/css" />
        <link href="@Url.Content("~/Content/UserControl/UserControl.css")" rel="stylesheet" type="text/css" />
        <link href="@Url.Content("~/Scripts/Lib/jquery-ui-1.9.1/themes/base/jquery-ui.css")" rel="stylesheet" type="text/css" />
        <link href="@Url.Content("~/Scripts/superfish/superfish.css")" rel="stylesheet" type="text/css" />
        <link href="@Url.Content("~/Content/Customer/Customer.css")" rel="stylesheet" type="text/css" />
        <link href="@HttpContext.Current.GetWebResourceUrl("Fanex.PTEngine.UI.Core.css")" rel="stylesheet" type="text/css" />
        <link href="@Url.Content("~/Content/Customer/PTEngine.css")" rel="stylesheet" type="text/css" />
        <link href="@Url.Content("~/Scripts/ContextMenu/jquery.contextMenu.css")" rel="Stylesheet" type="text/css" />
    }
    else
    {
        <link href="@BundleTable.Bundles.ResolveBundleUrl("~/bootstrap/css")" rel="stylesheet" type="text/css" />
    }
    @RenderSection("StyleSheet", false)
</head>
<body>
    <div id="groupName" style="display: none">@CurrentSession.Instance.CurrencyGroup</div>
    <div id="selectedGroupIndex" style="display: none">@CurrentSession.Instance.GroupId</div>
    <div id="selectedGroupName" style="display: none">
    </div>
    <div id="container">
        <div id="header">
            <div>
                <div style="float: left" class="logo">
                    &nbsp;
                </div>
            </div>
            <div id="rightMenu" style="position: absolute; right: 0px;">
                <div class="accMenu" id='accMenu'>
                    <ul id="userMenu" class="sf-menu">
                        <li id="userNameMenu"><a class="logoutTextTop" href="#" ignorehref="1">@CurrentSession.Instance.UserName</a>
                            <ul id="dllUsername" class="menuULRight">
                                <li class="divUL">
                                    <div class="sf-menu divLI" onclick="Fanex.ExtAcc.Account.Logout()">@ViewLang.Logout</div>
                                </li>
                                <li class="divUL">
                                    <div class="sf-menu divLI" onclick="Fanex.ExtAcc.User.ShowResetPwd(@CurrentSession.Instance.UserId, true, '@CurrentSession.Instance.UserName')">@ViewLang.ResetPassword</div>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </div>
                <div class="accMenu" id='accMenuGroup'>
                    <ul id="groupsMenu" class="sf-menu">
                        <li id="groupNameMenu"><a class="groupTextTop" id="selectedGroup" href="#" ignorehref="1">@ViewLang.Group</a>
                            <ul id="ddlGroupName" class="menuULRight">
                            </ul>
                        </li>
                    </ul>
                </div>
                <div id="grpText" class="groupMenuTop">
                    @ViewLang.Group
                </div>
            </div>
            <div style="float: left; background-color: transparent">
                @Html.Action("_Menu", "Shared")
            </div>
        </div>
        <div id='mainContent'>
            <div id="mainSplitter">
                <div class="splitter-panel" id="leftSplitter">
                    <div style="float: left" id="search" class="search">
                        <div style="float: left">
                            <input class="usernameInput" style="height: 19px; padding-top: 2px; margin: 1px" maxlength="50" id="txtLeftPanelUserName" type="text" autocomplete="off" /></div>
                        <div style="float: left">
                            <input style="padding: 0; margin: 0" class="buttonPopup" id="btnSearchLeftPanel" type="button" value="Search" /></div>
                    </div>
                    <div>
                        <iframe id="leftFrame" width="100%" frameborder="0" style="overflow: auto">
                        </iframe>
                    </div>
                </div>
                <div id="splitterBar">
                    <div>
                    </div>
                </div>
                <div class="splitter-panel" id="contentSplitter">
                    @RenderBody()
                </div>
            </div>
        </div>
    </div>
    <div id="footer">
    </div>
    @if (HttpContext.Current.IsDebuggingEnabled)
    {
        <script src="@Url.Content("~/Scripts/Lib/jquery-ui-1.9.1/jquery-1.8.2.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Lib/jquery-ui-1.9.1/ui/jquery-ui.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Lib/jquery-ui-1.9.1/ui/jquery.ui.core.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Lib/jquery-ui-1.9.1/ui/jquery.ui.widget.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Lib/jquery-ui-1.9.1/ui/jquery.ui.button.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Lib/jquery-ui-1.9.1/ui/jquery.ui.position.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Lib/jquery-ui-1.9.1/ui/jquery.ui.menu.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Lib/jquery-ui-1.9.1/ui/jquery.ui.autocomplete.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Lib/jquery-ui-1.9.1/ui/jquery.ui.datepicker.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Lib/jquery-ui-1.9.1/ui/jquery.ui.dialog.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/superfish/superfish.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/numeral.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/jquery.blockUI.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/MultiSelect/jquery.multiselect.min.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/cookie.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Fanex.ExtAcc.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Fanex.ExtAcc.Header.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Fanex.ExtAcc.Form.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Account/Fanex.ExtAcc.Account.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Validators.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Manage/Fanex.ExtAcc.User.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Fanex.Grid/Fanex.Grid/Fanex.Pagination.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Fanex.Grid/Fanex.Grid/Fanex.Grid.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Fanex.Grid/moment.min.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Combobox/Combobox.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/ContextMenu/jquery.contextMenu.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Customer/Fanex.ExtAcc.Customer.js")" type="text/javascript"></script>
        <script src="@HttpContext.Current.GetWebResourceUrl("Fanex.PTEngine.UI.Languages.en.js")" type="text/javascript"></script>
        <script src="@HttpContext.Current.GetWebResourceUrl("Fanex.PTEngine.UI.Core.js")" type="text/javascript"></script>
        <script src="@HttpContext.Current.GetWebResourceUrl("Fanex.PTEngine.UI.knockout-2.0.0.js")" type="text/javascript"></script>
    }
    else
    {
        <script src="@BundleTable.Bundles.ResolveBundleUrl("~/bootstrap/js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Fanex.Grid/moment.min.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/knockout.min-2.0.js")" type="text/javascript"></script>
    }
    <script type="text/javascript">
        function resolveClientUrl(relativeUrl) {
            return '@Url.Content("~/")' + relativeUrl;
        }

        function navigateToUrl(url, delayTime) {
            if (delayTime == undefined) delayTime = 2000;
            setInterval("window.location.replace('" + resolveClientUrl(url) + "');", delayTime);
        }

        Fanex.ExtAcc.IsInternalAdmin = '@CurrentSession.Instance.IsInternalAdmin';
        Fanex.ExtAcc.IsITAdmin = '@CurrentSession.Instance.IsITAdmin';

        var showBetSetting = '@showBetSetting';
        var allowBetSettingGroups = '@allowBetSettingGroups';
        var allowAdminEditSuperStatus = '@allowAdminEditSuperStatus';
        var userId = '@CurrentSession.Instance.UserId';
        var username = '@CurrentSession.Instance.UserName';
        var menuTitles = '{"ResetPwd" : "@ViewLang.ResetPassword", "CreateExistUser" : "@ViewLang.AddExistingUser", "CreateUser" : "@ViewLang.NewUser", "EditUser" : "@ViewLang.EditUserInfo", "Edit": "@ViewLang.EditMenu", "Activate": "@ViewLang.Activate", "Delete": "@ViewLang.Delete", "Create" : "@ViewLang.NewMenu", "Deactivate" : "@ViewLang.Deactivate", "EditGroup" : "@ViewLang.EditGroup", "EditFunction":"@ViewLang.EditFunction", "CreateFunction" : "@ViewLang.NewFunction"}';
        var isUpdateCredit = '@isUpdateCredit';
        var hasClose = '@hasClose';
        var hasSuspend = '@hasSuspend';
        var allowAutoPT = '@allowAutoPT';
        
        $(document).ready(function () {
            Fanex.ExtAcc.Account.ReCheckin();
            setInterval(Fanex.ExtAcc.Account.ReCheckin, 10000);
        });

        var titles = ['@ViewLang.EditPersonalInfo', '@ViewLang.editTransferCondition', '@ViewLang.confirmTransCondition', '@ViewLang.choonseDaily', '@ViewLang.chooseOneDay'];
    </script>
    @RenderSection("Scripts", false)
</body>
</html>