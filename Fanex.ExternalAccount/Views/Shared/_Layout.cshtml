@using Fanex.ExternalAccount.Controllers
@using Fanex.ExternalAccount.Core.Context;
@using Fanex.ExternalAccount.Utilities
@using System.Web.Optimization
@using Fanex.PTEngine
@using Fanex.ExternalAccount.Module.LeftPanel.Extensions
@using Fanex.CustomerSetting.Security.Authenticate
@using Fanex.CustomerSetting.Module.Keno.KenoSetting.Configurations
@{
    var isLocal = Request.IsLocal ? 1 : 0;
    var userId = CurrentSession.Instance.UserId;
    var admins = CustomerModelExtensions.IsAuthorized(userId, eFunctions.OpenSuper, AuthenticateAction.AuthenticationType.Host) ? new int[] { CurrentSession.Instance.UserId } : new int[] { };
    var showBetSetting = CustomerModelExtensions.IsAuthorized(userId, eFunctions.CasinoBetting, AuthenticateAction.AuthenticationType.Read) ||
        CustomerModelExtensions.IsAuthorized(userId, eFunctions.GoldDeluxeBetting, AuthenticateAction.AuthenticationType.Read) ||
        CustomerModelExtensions.IsAuthorized(userId, eFunctions.KenoBetting, AuthenticateAction.AuthenticationType.Read) ||
        CustomerModelExtensions.IsAuthorized(userId, eFunctions.LiveCasinoBetting, AuthenticateAction.AuthenticationType.Read) ||
        CustomerModelExtensions.IsAuthorized(userId, eFunctions.RacingBetting, AuthenticateAction.AuthenticationType.Read) ||
        CustomerModelExtensions.IsAuthorized(userId, eFunctions.SportsbookBetting, AuthenticateAction.AuthenticationType.Read) ||
        CustomerModelExtensions.IsAuthorized(userId, eFunctions.VirtualSportsBetting, AuthenticateAction.AuthenticationType.Read) ||
        CustomerModelExtensions.IsAuthorized(userId, eFunctions.AllbetBetting, AuthenticateAction.AuthenticationType.Read) ||
        CustomerModelExtensions.IsAuthorized(userId, eFunctions.VoidbridgeBetting, AuthenticateAction.AuthenticationType.Read) ||
        CustomerModelExtensions.IsAuthorized(userId, eFunctions.NG2Betting, AuthenticateAction.AuthenticationType.Read) ||
        CustomerModelExtensions.IsAuthorized(userId, eFunctions.LotteryBetting, AuthenticateAction.AuthenticationType.Read) ||
        CustomerModelExtensions.IsAuthorized(userId, eFunctions.BullfightingBetting, AuthenticateAction.AuthenticationType.Read) ? 1 : 0;
    var allowAdminEditSuperStatus = Newtonsoft.Json.JsonConvert.SerializeObject(admins, Newtonsoft.Json.Formatting.None, new Newtonsoft.Json.JsonSerializerSettings
    {
        ContractResolver = new Newtonsoft.Json.Serialization.CamelCasePropertyNamesContractResolver(),
        NullValueHandling = Newtonsoft.Json.NullValueHandling.Ignore
    });
    var isUpdateCredit = CustomerModelExtensions.IsAuthorized(userId, eFunctions.UpdateCredit, AuthenticateAction.AuthenticationType.Host) ? 1 : 0;
    var hasClose = CustomerModelExtensions.IsAuthorized(userId, eFunctions.CloseCustomer, AuthenticateAction.AuthenticationType.Host) ? 1 : 0;
    var hasSuspend = CustomerModelExtensions.IsAuthorized(userId, eFunctions.SuspendCustomer, AuthenticateAction.AuthenticationType.Host) ? 1 : 0;
    var allowAutoPT = CustomerModelExtensions.IsAuthorized(userId, eFunctions.AllowAutoMPT, AuthenticateAction.AuthenticationType.Host) ? 1 : 0;
    var hasClearCredit = CustomerModelExtensions.IsAuthorized(userId, eFunctions.ClearCredit, AuthenticateAction.AuthenticationType.Host) ? 1 : 0;
    var enableKeno = System.Configuration.ConfigurationManager.AppSettings["EnableKeno"] == "true" ? 1 : 0;
    var showKenoSetting = KenoSection.Instance.ShowSetting == true ? "true" : "false";
    var showGoldDeluxeSetting = System.Configuration.ConfigurationManager.AppSettings["IsShowGoldDeluxeSettingForCredit"] == "1" ? 1 : 0;
    var showColossusBets = System.Configuration.ConfigurationManager.AppSettings["IsShowColossusBets"] == "1" ? 1 : 0;
    var showSportsbook2 = System.Configuration.ConfigurationManager.AppSettings["IsShowSportsbook2"] == "1" ? 1 : 0;
    var showCockfighting = System.Configuration.ConfigurationManager.AppSettings["IsShowCockfighting"] == "1" ? 1 : 0;
    var showCricket = System.Configuration.ConfigurationManager.AppSettings["IsShowCricket"] == "1" ? 1 : 0;
    var showAllbet = System.Configuration.ConfigurationManager.AppSettings["IsShowAllbet"] == "1" ? 1 : 0;
    var showVoidbridge = System.Configuration.ConfigurationManager.AppSettings["IsShowMacauGames"] == "1" ? 1 : 0;
    var showNG2 = System.Configuration.ConfigurationManager.AppSettings["IsShowNG2"] == "1" ? 1 : 0;
    var showFishingWorld = System.Configuration.ConfigurationManager.AppSettings["IsShowFishingWorld"] == "1" ? 1 : 0;
    var showLottery = System.Configuration.ConfigurationManager.AppSettings["IsShowLottery"] == "1" ? 1 : 0;
    var showLucky3 = System.Configuration.ConfigurationManager.AppSettings["IsShowLucky3"] == "1" ? 1 : 0;
    var showBullfighting = System.Configuration.ConfigurationManager.AppSettings["IsShowBullfighting"] == "1" ? 1 : 0;
    var ng2Text = RemotingRef.RefData.GetResourceDataByRefIdAndResourceId("Product", "23", "en-US", "NG2");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <title>External Accounting Site</title>
    <meta http-equiv="x-ua-compatible" content="ie=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1" />
    <meta name="author" content="Nathan Smith" />
    <meta name="copyright" content="Licensed under GPL and MIT." />
    <meta name="description" content="Adapt.js serves CSS based on screen width." />
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />
    <link href='https://fonts.googleapis.com/css?family=Cabin' rel='stylesheet' type='text/css' />
    <link href='https://fonts.googleapis.com/css?family=Cinzel' rel='stylesheet' type='text/css' />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.4/css/select2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="@Url.Content("~/assets/styles/fonts/AlphaAdmin/style.css?v=1")" />

    @if (HttpContext.Current.IsDebuggingEnabled)
    {
        <link href="@Url.Content("~/Content/normalize.css")" rel="stylesheet" />
        <link href="@Url.Content("~/Scripts/Fanex.Grid/Fanex.Grid/Fanex.Pagination.css")" rel="stylesheet" />
        <link href="@Url.Content("~/Scripts/Fanex.Grid/Fanex.Grid/Fanex.Grid.css")" rel="stylesheet" />
        <link rel="stylesheet" href="@Url.Content("~/Scripts/MultiSelect/jquery.multiselect.css")" />
        <link href="@Url.Content("~/Scripts/Lib/jquery-ui-1.9.1/themes/base/jquery-ui.css")" rel="stylesheet" />
        <link href="@Url.Content("~/Scripts/superfish/superfish.css")" rel="stylesheet" />
        <link href="@HttpContext.Current.GetWebResourceUrl("Fanex.PTEngine.UI.Core.css")" rel="stylesheet" />
        <link href="@Url.Content("~/Content/Customer/PTEngine.css")" rel="stylesheet" />
        <link href="@Url.Content("~/Scripts/ContextMenu/jquery.contextMenu.css")" rel="Stylesheet" />
        <link rel="stylesheet" href="@Url.Content("~/assets/styles/fonts/AlphaAdmin/style.css?v=1")" />
        <link rel="stylesheet" href="@Url.Content("~/assets/styles/pages/default/common.css?v=2")" />
        <link href="@Url.Content("~/assets/styles/base/Validators.css")" rel="stylesheet" />
        <link href="@Url.Content("~/Content/UserControl/UserControl.css")" rel="stylesheet" />
        <link href="@Url.Content("~/assets/styles/pages/customer/customer-setting.css")" rel="stylesheet" type="text/css" />
    }
    else
    {
        <link href="@BundleTable.Bundles.ResolveBundleUrl("~/bootstrap/css")" rel="stylesheet" />
        <link href="@HttpContext.Current.GetWebResourceUrl("Fanex.PTEngine.UI.Core.css")" rel="stylesheet" />
    }
    @RenderSection("StyleSheet", false)
</head>
<body>
    <div id="groupName" style="display: none">@CurrentSession.Instance.CurrencyGroup</div>
    <div id="selectedGroupIndex" style="display: none">@CurrentSession.Instance.GroupId</div>
    <div id="selectedGroupName" style="display: none"></div>
    <div id="container">
        <header id="header" class="header">            
            <div id='accMenuGroup' class="group-user">
                <select id="ddlGroupName"></select>
            </div>
            @Html.Action("_Menu", "Shared")
            <div class="info" id="accMenu">
                <ul class="list" id="userNameMenu">
                    <li><span class="icon-lock-reset" onclick="Fanex.ExtAcc.User.ShowResetPwd(@CurrentSession.Instance.UserId, true, '@CurrentSession.Instance.UserName')"></span></li>
                    <li><span class="icon-logout" onclick="Fanex.ExtAcc.Account.Logout()"></span></li>
                    <li><span class="circle">@CurrentSession.Instance.UserName</span></li>
                </ul>
            </div>
            <!-- For mobile -->
            <div id="iconUserInfo" class="icon-user"></div>
            <div id="iconNav" class="icon-nav">
                <span></span>
                <span></span>
                <span></span>
            </div>
        </header>
        <div class="sidebar" id="sidebar">
            <div class="profile">
                <div class="picture">
                    <span class="text">S</span>
                </div>
                <span class="username">sa</span>
                <div class="list-action">
                    <button class="btn -reset" onclick="Fanex.ExtAcc.User.ShowResetPwd(@CurrentSession.Instance.UserId, true, '@CurrentSession.Instance.UserName')">Reset Password</button>
                    <button class="btn -logout" onclick="Fanex.ExtAcc.Account.Logout()">Log Out</button>
                </div>
            </div>
            @Html.Action("_Menu", "Shared")
           
        </div>
        <div id='mainContent' class="main-content">
            <div id="mainSplitter">
                <div class="splitter-panel" id="leftSplitter">
                    <div id="search" class="group-search">
                        <input placeholder="username" class="search" maxlength="50" id="txtLeftPanelUserName" type="text" autocomplete="off" />
                        <span class="icon-magnify" id="searchPanel" title="Search"></span>
                    </div>
                    <iframe id="leftFrame" class="iframe"></iframe>
                </div>
                <div id="splitterBar">
                    <div>
                    </div>
                </div>
                <div class="content" id="contentSplitter">
                    @RenderBody()
                </div>
            </div>
        </div>
    </div>
    <div id="footer">
    </div>
    @if (HttpContext.Current.IsDebuggingEnabled)
    {
        <script src="@Url.Content("~/Scripts/Lib/jquery-ui-1.9.1/jquery-1.8.2.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Lib/jquery-ui-1.9.1/ui/jquery-ui.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Lib/jquery-ui-1.9.1/ui/jquery.ui.core.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Lib/jquery-ui-1.9.1/ui/jquery.ui.widget.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Lib/jquery-ui-1.9.1/ui/jquery.ui.button.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Lib/jquery-ui-1.9.1/ui/jquery.ui.position.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Lib/jquery-ui-1.9.1/ui/jquery.ui.menu.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Lib/jquery-ui-1.9.1/ui/jquery.ui.autocomplete.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Lib/jquery-ui-1.9.1/ui/jquery.ui.datepicker.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Lib/jquery-ui-1.9.1/ui/jquery.ui.dialog.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/superfish/superfish.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/numeral.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/jquery.blockUI.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/MultiSelect/jquery.multiselect.min.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/cookie.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Fanex.ExtAcc.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Fanex.ExtAcc.Header.js?v=1")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Fanex.ExtAcc.Form.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Account/Fanex.ExtAcc.Account.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Validators.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Manage/Fanex.ExtAcc.User.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Fanex.Grid/Fanex.Grid/Fanex.Pagination.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Fanex.Grid/Fanex.Grid/Fanex.Grid.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Fanex.Grid/moment.min.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Combobox/Combobox.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/ContextMenu/jquery.contextMenu.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Customer/Fanex.ExtAcc.Customer.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Customer/SuperList.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Customer/MasterList.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Customer/AgentList.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Customer/MemberList.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Customer/EditMultiple.js")" type="text/javascript"></script>
        <script src="@HttpContext.Current.GetWebResourceUrl("Fanex.PTEngine.UI.Languages.en.js")" type="text/javascript"></script>
        <script src="@HttpContext.Current.GetWebResourceUrl("Fanex.PTEngine.UI.Core.js")" type="text/javascript"></script>
        <script src="@HttpContext.Current.GetWebResourceUrl("Fanex.PTEngine.UI.knockout-2.0.0.js")" type="text/javascript"></script>
    }
    else
    {
        <script src="@BundleTable.Bundles.ResolveBundleUrl("~/bootstrap/js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Customer/SuperList.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Customer/MasterList.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Customer/AgentList.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Customer/MemberList.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Customer/EditMultiple.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Fanex.Grid/moment.min.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/knockout.min-2.0.js")" type="text/javascript"></script>
    }
    <script type="text/javascript">
        function resolveClientUrl(relativeUrl) {
            return '@Url.Content("~/")' + relativeUrl;
        }

        function navigateToUrl(url, delayTime) {
            if (delayTime == undefined) delayTime = 2000;
            setInterval("window.location.replace('" + resolveClientUrl(url) + "');", delayTime);
        }

        Fanex.ExtAcc.IsInternalAdmin = '@CurrentSession.Instance.IsInternalAdmin';
        Fanex.ExtAcc.IsITAdmin = '@CurrentSession.Instance.IsITAdmin';

        var isLocal = @isLocal;
        var showBetSetting = '@showBetSetting';
        var allowAdminEditSuperStatus = '@allowAdminEditSuperStatus';
        var userId = '@userId';
        var username = '@CurrentSession.Instance.UserName';
        var menuTitles = '{"ResetPwd" : "@ViewLang.ResetPassword", "CreateExistUser" : "@ViewLang.AddExistingUser", "CreateUser" : "@ViewLang.NewUser", "EditUser" : "@ViewLang.EditUserInfo", "Edit": "@ViewLang.EditMenu", "Activate": "@ViewLang.Activate", "Delete": "@ViewLang.Delete", "Create" : "@ViewLang.NewMenu", "Deactivate" : "@ViewLang.Deactivate", "EditGroup" : "@ViewLang.EditGroup", "EditFunction":"@ViewLang.EditFunction", "CreateFunction" : "@ViewLang.NewFunction"}';
        var isUpdateCredit = '@isUpdateCredit';
        var hasClose = '@hasClose';
        var hasSuspend = '@hasSuspend';
        var allowAutoPT = '@allowAutoPT';
        var hasClearCredit = '@hasClearCredit';
        var enableKeno = '@enableKeno';
        var showKenoSetting = '@showKenoSetting';
        var showGoldDeluxeSetting = '@showGoldDeluxeSetting';
        var showColossusBets = '@showColossusBets';
        var showSportsbook2 = @showSportsbook2;
        var showCockfighting = @showCockfighting;
        var showCricket = @showCricket;
        var showAllbet = @showAllbet;
        var showVoidbridge = @showVoidbridge;
        var showFishingWorld = @showFishingWorld;
        var showAllbetBetting = true;
        var showVoidbridgeBetting = true;
        var showNG2 = @showNG2;
        //var showFishingWorldBetting = true;
        var showNG2Betting = true;
        var ng2Text = '@ng2Text';
        var showLottery = @showLottery;
        var showLucky3 = @showLucky3;
        var showBullfighting = @showBullfighting;

        $(document).ready(function () {
            Fanex.ExtAcc.Customer.ReCheckin();
            setInterval(Fanex.ExtAcc.Customer.ReCheckin, 10000);
        });

        var titles = ['@ViewLang.EditPersonalInfo', '@ViewLang.editTransferCondition', '@ViewLang.confirmTransCondition', '@ViewLang.choonseDaily', '@ViewLang.chooseOneDay'];
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.4/js/select2.min.js"></script>
    @RenderSection("Scripts", false)
</body>
</html>