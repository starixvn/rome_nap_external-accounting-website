<div id="Bleft_Parent02">
    <div id="left_submenu">
        <div id="left_line02">
            <img height="1" width="1" alt="" src="../_GlobalResources/Images/dot.gif" name="" /></div>
        <div class="Bleft_Sub02">
            <form name="frmAgent" id="frmAgent" method="get" action="" target="menu" style="float:left;">   
                <div id="from_tab">                            
                    <input maxlength="50" id="txtUsername" type="text" onkeydown="onclickUser('{static:Resources.Lang.enterusername}')" onclick="onclickUser('{static:Resources.Lang.enterusername}')" onblur="onblurUser('{static:Resources.Lang.enterusername}')" value="{usernamesearch}" style="width: 145px;" class="{classStyle}" name="txtUsername" />
                </div>
                <div id="b_serachL">
                    <a id="lnkSearch" class="imaLink" href="#" onclick="javascript:checkAndSubmitUI();">
                        <img height="18" width="21" alt="Search" title="{static:Resources.Lang.search}" border="0" nowap="nowap" src="../_GlobalResources/Images/icon_search.jpg" />
                    </a>
                 </div>
            </form><br />
            <!--fornotdirectdownline-->                                                            
            <table cellspacing="0" cellpadding="0" border="0" width="100%">
                <tbody> 
                    <!--uplineinfo-->
                    <tr>
                        <td>
                            {agent}
                        </td>
                        <td align="right" class="text_org">
                            <a href="AccountInfo.aspx?username={AgentNameValue}" class="linkAg">{agentname}</a>
                        </td>
                    </tr>
                    <!--/uplineinfo-->
                </tbody>
            </table>
            <!--/fornotdirectdownline--> 
            <div class="line_info">
                <img height="9" width="1" alt="" src="../_GlobalResources/Images/dot.gif" name="" />
            </div>
            <!--CustInfo-->
            <table width="100%" cellspacing="0" cellpadding="0" border="0">
                <tbody>
                    <tr>
                        <td>
                            {lblCustomerUsername}:
                        </td>
                        <td align="right" class="text_org">
                            {CustomerUsername}
                        </td>
                    </tr>
                    <!--blCustomerNickname-->
                    <tr>
                        <td>
                            {static:Resources.Lang.nickname}:
                        </td>
                        <td align="right" class="text_bold">
                            {CustomerNickname}
                        </td>
                    </tr>
                    <!--/blCustomerNickname-->
                    <!--blCustomerFullName-->
                    <tr>
                        <td>
                            {static:Resources.Lang.name}:
                        </td>
                        <td align="right" class="text_bold">
                            {CustomerFullName}
                        </td>
                    </tr>
                    <!--/blCustomerFullName-->
                    <!--blCustomerPhone-->
                    <tr>
                        <td>
                            {static:Resources.Lang.lblPhone}:
                        </td>
                        <td align="right" class="text_bold">
                            {CustomerPhone}
                        </td>
                    </tr>
                    <!--/blCustomerPhone-->
                    <!--blCustomerMobile-->
                    <tr>
                        <td>
                            {static:Resources.Lang.lblMobilePhone}:
                        </td>
                        <td align="right" class="text_bold">
                            {CustomerMobile}
                        </td>
                    </tr>
                    <!--/blCustomerMobile-->
                    <!--blCustomerFax-->
                    <tr>
                        <td>
                            {static:Resources.Lang.lblFax}:
                        </td>
                        <td align="right" class="text_bold">
                            {CustomerFax}
                        </td>
                    </tr>
                    <!--/blCustomerFax-->
                </tbody>
            </table>
            <!--/CustInfo-->
        </div>        
    </div>    
</div>        

<!--GroupCustomerList-->
<div id="button_nLeft01"><a class="b_nleft" onclick="clearTopMenu(); ClearCurrentLeftMenu();" target="main" href="{memberlistlink}">{memberlist}</a></div>
<!--/GroupCustomerList-->
<!--GroupStatement-->
<div id="button_nLeft02"><a class="b_nleft" onclick="clearTopMenu(); ClearCurrentLeftMenu();" target="main" href="{statementlink}">{static:Resources.Lang.lblStatement}</a></div>
<!--/GroupStatement-->
<div id="clear02">
    <img height="5" width="1" alt="" src="../_GlobalResources/Images/dot.gif" name="" /></div>
