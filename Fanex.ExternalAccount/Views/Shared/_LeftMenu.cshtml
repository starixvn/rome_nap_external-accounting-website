<div style="float: left; padding-top: 2px; padding-left: 2px; visibility:hidden">
    <input id="jqInput" placeholder="Enter user name" class="input" type="text" />
    <input type="button" value="Search" id='jqButtonSearch' />
    <div id="leftpanewrapper">
        <div id="tab_menu">
            <div id="tab_menu_m">
                <a class="tab_menu01" target="menu" href="../_Menu/Menu.aspx">{static:Resources.Lang.mainmenu}</a></div>
            <div id="tab_menu_L">
                <a class="tab_menu02AC" style="cursor: default;">{static:Resources.Lang.userinfo}</a></div>
        </div>
        <div id="clear0" />
        <div id="leftpane02">
            <div id="button_left02">
                <!--NoData-->
                <div id="Bleft_Parent02">    
                    <div id="left_submenu">
                        <div id="left_line02">
                            <img height="1" width="1" alt="" src="../_GlobalResources/Images/dot.gif" name="" /></div>
                        <div class="Bleft_Sub02">
                            <form name="frmAgent" id="frmAgent" method="get" action="" target="menu" style="float:left;">   
                                <div id="from_tab">                            
