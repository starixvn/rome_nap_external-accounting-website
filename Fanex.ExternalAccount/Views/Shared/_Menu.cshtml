@{
    var menuDict = ViewBag.MenuDict as Dictionary<string, Fanex.ExternalAccount.ViewModel.Shared.MenuItem>;
}
<div style="float: left; margin-left: 50px; margin-top: 10px; background-color: transparent">
    <div class="menuBar" style="background-color: transparent; position: absolute">
        <ul class="sf-menu" id="functionsMenu">
            @foreach (var value in menuDict.Values)
            {
                <li><a href="#" ignorehref="1">@value.Name</a>
                    <ul>
                        @if (value.Children.Count > 0)
                        {
                            foreach (var menu in value.Children)
                            {
                            <li><a href="@(menu.Url != "" ? @Url.Content(menu.Url) : "")">
                                @menu.Name
                            </a></li>
                            }
                        }
                    </ul>
                </li>
            }
        </ul>
    </div>
</div>
<div style="clear: both">
</div>