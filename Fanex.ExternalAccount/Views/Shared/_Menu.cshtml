@{
    var menuDict = ViewBag.MenuDict as Dictionary<string, Fanex.ExternalAccount.ViewModel.Shared.MenuItem>;
}

<ul class="main-menu list" id="functionsMenu">
    @foreach (var value in menuDict.Values)
    {
        var id = "ddl-" + value.Name.Replace(" ", string.Empty);

        <li class="menu">
            <a href="#" ignorehref="1" class="link hasChild"><span class="icon-@value.Name.ToLower()"></span>@value.Name</a>
            <ul class="submenu list" id="@id">
                @if (value.Children.Count > 0)
                {
                    foreach (var menu in value.Children)
                    {
                        <li class="menu">
                            <a class="link" parent="ddl-@value.Name.Replace(" ", string.Empty)" href="javascript:;" onclick="Fanex.ExtAcc.LoadMainFrame('@(!string.IsNullOrWhiteSpace(menu.Url) ? @Url.Content(menu.Url) : "")', '@id', null)">
                                        @menu.Name
                            </a>
                        </li>
                    }
                }
            </ul>
        </li>
    }
</ul>