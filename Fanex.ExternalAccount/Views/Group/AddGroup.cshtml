@using Fanex.ExternalAccount.Utilities
@using Fanex.ExternalAccount.DTO.UserControl
@model Group
<div>
    <table width="100%" border="0" cellpadding="2">
        <tr>
            <td style="width: 100px; text-align: right">
                @Html.HiddenFor(m => m.GroupID) @Html.LabelFor(m => m.GroupName, ViewLang.GroupName, new { @class = "divMargin" })
            </td>
            <td>
                @Html.TextBoxFor(m => m.GroupName, new { @style = "width: 235px;" })
            </td>
        </tr>
        <tr>
            <td style="vertical-align: top; text-align: right">
                @Html.LabelFor(m => m.Description, ViewLang.Description, new { @class = "divMargin" })
            </td>
            <td>
                @Html.TextAreaFor(m => m.Description, new { @style = "width: 235px; height: 150px" })
            </td>
        </tr>
        <tr>
            <td colspan="2">
                <div style="float: right">
                    <input class="buttonPopup" type="button" value="Submit" onclick="Fanex.ExtAcc.Group.Add()" />
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="2">
                <div id="errMsg" style="display: none;" class="errMsg">
                </div>
            </td>
        </tr>
    </table>
</div>