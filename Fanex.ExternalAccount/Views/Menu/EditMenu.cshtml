@using Fanex.ExternalAccount.Utilities
@using Fanex.ExternalAccount.DTO.UserControl
@model Menu
@{
    var menuList = (IEnumerable<Menu>)ViewBag.MenuList;
    var funcList = (IEnumerable<Function>)ViewBag.FunctionList;

    var menuSelectList = menuList.Where(o => o.ParentID == 0).Select(o => new SelectListItem
    {
        Value = o.MenuID.ToString(),
        Text = o.MenuName
    }).ToList();

    var counter = 0;
    var index = 0;

    var counter2 = 0;
    var index2 = 1;
}
<link href="@Url.Content("~/Scripts/Combobox/Combobox.css")" rel="stylesheet" type="text/css" />
<div>
    <table width="100%" border="0" cellpadding="2">
        <tr>
            <td style="width: 80px; text-align: right">
                @Html.HiddenFor(m => m.MenuID) @Html.LabelFor(m => m.MenuName, ViewLang.MenuItem, new { @class = "divMargin" })
            </td>
            <td>
                @Html.TextBoxFor(m => m.MenuName, new { @class = "editControl" })
            </td>
        </tr>
        <tr>
            <td style="vertical-align: top; text-align: right">
                @Html.LabelFor(m => m.MenuDesc, ViewLang.Description, new { @class = "divMargin" })
            </td>
            <td>
                @Html.TextAreaFor(m => m.MenuDesc, new { @class = "editControl desc" })
            </td>
        </tr>
        <tr>
            <td style="text-align: right">
                @Html.LabelFor(m => m.Url, ViewLang.Url, new { @class = "divMargin" })
            </td>
            <td>
                @Html.TextBoxFor(m => m.Url, new { @class = "editControl" })
            </td>
        </tr>
        <tr>
            <td style="text-align: right">
                @Html.LabelFor(m => m.FuncID, ViewLang.Function, new { @class = "divMargin" })
            </td>
            <td class="groupCboMenu">
                <select id="FuncID" name="FuncID" class="cboControl">
                    @foreach (var item in funcList)
                    {
                        <option value="@item.FuncID" @(item.FuncID == Model.FuncID ? "selected=selected" : "") @(item.ParentID != 0 ? "class=subItem" : "")>@item.FuncName</option>
                        if (item.FuncID == Model.FuncID)
                        {
                            counter = index;
                        }

                        index++;
                    }
                </select>
            </td>
        </tr>
        <tr>
            <td style="text-align: right">
                @Html.LabelFor(m => m.ParentName, ViewLang.Parent, new { @class = "divMargin" })
            </td>
            <td class="groupCboMenu">
                <select id="ParentName" name="ParentName" class="cboControl">
                    <option value="-1">@ViewLang.None</option>
                    @foreach (var item in menuList)
                    {
                        <option value="@item.MenuID" @(item.MenuID == Model.ParentID ? "selected=selected" : "") @(item.ParentID != 0 ? "class=subItem" : "")>@item.MenuName</option>
                        if (item.MenuID == Model.ParentID)
                        {
                            counter2 = index2;
                        }

                        index2++;
                    }
                </select>
            </td>
        </tr>
        <tr>
            <td style="text-align: right">
                @Html.LabelFor(m => m.DisplayOrder, ViewLang.Order, new { @class = "divMargin" })
            </td>
            <td>
                @Html.TextBoxFor(m => m.DisplayOrder, new { @class = "order", @maxlength = "3", @onpaste = "return false;", @onkeypress = "return Fanex.ExtAcc.CheckNumber(event, this)", @onkeyup = "return Fanex.ExtAcc.CheckNumber(event, this)" })
            </td>
        </tr>
        <tr>
            <td colspan="2">
                <div style="float: right">
                    <input class="buttonPopup" type="button" value="Submit" onclick="Fanex.ExtAcc.Menus.Edit()" />
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="2">
                <div id="errMsg" style="display: none;" class="successMsg">
                </div>
            </td>
        </tr>
    </table>
</div>
<script src="@Url.Content("~/Scripts/Combobox/Combobox.js")" type="text/javascript"></script>
<script type="text/javascript">
    $('#FuncID').combobox();
    $('#ParentName').combobox();

    $(document).ready(function () {
        var select = document.getElementById('FuncID');
        var sParent = document.getElementById('ParentName');
        $('.groupCboMenu input').first().val(select.options[@counter].text);
        $('.groupCboMenu input').last().val(sParent.options[@counter2].text);
        $(".groupCboMenu input").attr("readonly", "true");
        $(".groupCboMenu input").bind("click", function () {
            $(this).autocomplete("search", '');
        });
    });
</script>