@using Fanex.ExternalAccount.Utilities
<div id='jqWidget'>
    <div class="page-title">
        <div class="pull-left">
            Menu Management</div>
        <div class="pull-right">
            <button id="jqbutton" class="btn -add">
                <span class="icon-add"></span> Add New Menu
            </button>
        </div>
    </div>
    <div id="mainGrid">
        <div id="jqgrid-menu" class="removeRadius freegrid content-grid">
        </div>
    </div>
    @Html.AntiForgeryToken()
</div>
<script src="@Url.Content("~/Scripts/Manage/Fanex.ExtAcc.Menus.js")" type="text/javascript"></script>
<script type="text/javascript">
    Fanex.ExtAcc.Menus.dataTexts = [
    '@ViewLang.MenuItem',
    '@ViewLang.Description',
    '@ViewLang.Url',
    '@ViewLang.Function',
    '@ViewLang.Order',
    '@ViewLang.Lastmodified',
    '@ViewLang.Active',
    '@ViewLang.Delete'
    ];
</script>
