@using System.Web.Configuration;
@using Fanex.ExternalAccount.Core.Context;
@using Fanex.ExternalAccount.DTO.UserControl;
@{
    Layout = null;

    string[] domains = null;
    var appPath = Request.ApplicationPath;
    var virtualDirectory = appPath.Equals("/", StringComparison.OrdinalIgnoreCase) ? string.Empty : appPath;
    var currentDomain = Request.Headers["Host"] + virtualDirectory;

    string currentLine = currentDomain;
    string currentLineValue = string.Empty;

    var supportSwitchLine = !Group.IsOfficeGroup(new CurrentSession().CurrencyGroup);

    if (supportSwitchLine)
    {
        domains = WebConfigurationManager.AppSettings["Domains"].Split(new[] { "," }, StringSplitOptions.RemoveEmptyEntries);

        foreach (var domain in domains)
        {
            if (domain.IndexOf(currentDomain) != -1)
            {
                currentLine = domain.Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries).ElementAt(1);
                break;
            }
        }

        var url = Request.Url;
        currentLineValue = url.Scheme + Uri.SchemeDelimiter + url.Authority + virtualDirectory;
    }
}
@if (supportSwitchLine && domains.Length > 0)
{
    <select onchange="javascript:switchLine(this)" id="ddl-switchLine">
        <option value="@currentLineValue">
            @currentLine
        </option>
            @for (var i = 0; i < domains.Length; i++)
            {
                var domainName = domains[i].Split(';')[0];
                var aliasName = domains[i].Split(';')[1];

                domainName = domainName.IndexOf(currentDomain, StringComparison.OrdinalIgnoreCase) != -1 ? string.Empty : domainName;

                var formatedDomain = domainName.StartsWith("http") ? domainName :
                    string.IsNullOrWhiteSpace(domainName) ? string.Empty : "http://" + domainName;
                if (!string.IsNullOrWhiteSpace(domainName))
                {
                    <option value="@formatedDomain" data-classname="icon-lock-reset">@aliasName</option>
                }
            }
    </select>
}