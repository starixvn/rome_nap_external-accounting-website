@using System.Web.Configuration
@{
    Layout = null;
    var domains = WebConfigurationManager.AppSettings["Domains"].Split(new[] { "," }, StringSplitOptions.RemoveEmptyEntries);
    var currentDomain = Request.Headers["Host"] + 
        (Request.ApplicationPath.Equals("/", StringComparison.OrdinalIgnoreCase) ? string.Empty : Request.ApplicationPath);
}
@if (domains.Length > 0)
{
    <h3>Switch Line</h3>
    <table border="0" width="100%" style="line-height: 30px">
        @for (var i = 0; i < domains.Length; i += 2)
        {
            var domainName1 = domains[i].Split(';')[0];
            var domainName2 = i + 1 < domains.Length ? domains[i + 1].Split(';')[0] : string.Empty;

            domainName1 = domainName1.Equals(currentDomain, StringComparison.OrdinalIgnoreCase) ? string.Empty : domainName1;
            domainName2 = domainName2.Equals(currentDomain, StringComparison.OrdinalIgnoreCase) ? string.Empty : domainName2;

            var aliasName1 = domains[i].Split(';')[1];
            var aliasName2 = i + 1 < domains.Length ? domains[i + 1].Split(';')[1] : string.Empty;

            aliasName1 = string.IsNullOrWhiteSpace(domainName1) ? string.Empty : aliasName1;
            aliasName2 = string.IsNullOrWhiteSpace(domainName2) ? string.Empty : aliasName2;

            var formatedDomain1 = domainName1.StartsWith("http") ? domainName1 :
                string.IsNullOrWhiteSpace(domainName1) ? string.Empty : "http://" + domainName1;

            var formatedDomain2 = domainName2.StartsWith("http") ? domainName2 :
                string.IsNullOrWhiteSpace(domainName2) ? string.Empty : "http://" + domainName2;

            <tr>
                <td><a href="@formatedDomain1">@aliasName1</a></td>
                <td style="text-align: right"><a href="@formatedDomain2">@aliasName2</a></td>
            </tr>
        }
    </table>
}