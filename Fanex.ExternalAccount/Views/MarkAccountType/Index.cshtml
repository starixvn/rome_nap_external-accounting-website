@using Fanex.ExternalAccount.Utilities
<div id="markAccountType">
    <div class="page-title">
        <div class="wlDetail">
            Mark Account Type
        </div>
    </div>
    <div id="searchBar" class="search-form filterbox filter-winloss-detail">
        <div class="searchBar">
            <div class="form-group">
                <div class="label">@ViewLang.Username</div>
                <input id="txtUserName" type="text" class="usernameInput" autocomplete="off" />
            </div>
            <div class="form-group">
                <label for="selLevel" class="pointer">@ViewLang.Level</label>
                <select id="selLevel" class="usernameInput group">
                    <option value="0" selected>@ViewLang.All</option>
                    <option value="1">@ViewLang.Super</option>
                    <option value="2">@ViewLang.Master</option>
                    <option value="3">@ViewLang.Agent</option>
                    <option value="4">@ViewLang.Member</option>
                </select>
            </div>
            <div class="form-group">
                <label for="selType" class="pointer">@ViewLang.Type</label>
                <select id="selType" class="usernameInput group">
                    <option value="0" selected>@ViewLang.All</option>
                    <option value="1">@ViewLang.VIP</option>
                    <option value="2">@ViewLang.Suspicious</option>
                    <option value="3">@ViewLang.Problem</option>
                </select>
            </div>
            <div class="form-group">
                <input id="btnSearch" type="button" value="Submit" class="btn-submit" />
            </div>
        </div>
        <div class="action-bar">
            <input id="btnMarkAccountType" type="button" value="Mark Account" class="btn-submit" />
        </div>
    </div>
    <div class="bgTitle titleSearch">
        <div class="pull-left searchBar">
            <span class="text-select">@ViewLang.Select:</span>
            <span id="spanSelectAll" class="status-select" onclick="Fanex.ExtAcc.MarkAccountType.SelectAll('menuActive')">@ViewLang.All</span>
            <span class="character">
                |
            </span>
            <span id="spanSelectNone" class="status-select" onclick="Fanex.ExtAcc.MarkAccountType.SelectAll('menuInactive')">@ViewLang.None</span>
        </div>
    </div>
    <div id="errUpdateMsg" class="successMsg hide"> </div>
    <div id="markaccountListGrid">
        <div id="jqgrid" class="removeRadius freegrid content-grid">
        </div>
        <div id="msgNoinfo">
            There is no data.
        </div>
    </div>
    @Html.AntiForgeryToken()
</div>
<script>
    Fanex.ExtAcc.MarkAccountType.Init();
</script>