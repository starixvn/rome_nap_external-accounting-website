@using Fanex.ExternalAccount.Utilities
@using Fanex.ExternalAccount.Controllers.Statement
@using System.Web.Optimization
@using Fanex.ExternalAccount.Core.Base;
@using Fanex.Module.Statement.Resources;
@using Fanex.Module.Statement.Configurations;
@using Fanex.ExternalAccount.Service.Impl.Report;
@{
    ViewBag.Title = "Statement";
    var isInternalCustomer = 0;
    var newLayoutDate = string.Format("{0:MM/dd/yyyy}", StatementSection.Instance.NewLayoutDate);
    var balanceUpDay = string.Format("{0:MM/dd/yyyy}", ReportService.BalanceUpDate);
    var moveBetsDay = string.Format("{0:MM/dd/yyyy}", ReportService.MoveBetsDate); 
}
<link rel="stylesheet" type="text/css" href="@Url.Content("~/Scripts/_Libs/FanexGrid/Fanex.Grid.css")"  />
<link rel="stylesheet" type="text/css" href="@Url.Content("~/Scripts/_Libs/FanexGrid/Fanex.Pagination.css")" />
<link rel="stylesheet" type="text/css" href="@Url.Content("~/Areas/Statement/Views/Report/Styles/Statement.css?ver=1")" />
@if (HttpContext.Current.IsDebuggingEnabled)
{
    <link href="@Url.Content("~/Content/Statement/Statement.css")" rel="stylesheet" type="text/css" />
}
else
{
    <link href="@BundleTable.Bundles.ResolveBundleUrl("~/bootstrap/Statement/css")" rel="stylesheet" type="text/css" />
}
<div>
    <div class="bgTitle titleForm">
        <div class="wlDetail">
            Statement - <span id="StatementUsername">@Request.QueryString["username"]</span>
        </div>
    </div>
    <div class="bgTitle titleSearch pdr-normal">
        <div class="searchBar floatL w100">
            <input type="hidden" id="MaxDate" value="@DateTime.Now"/>
            <div class="wFrom">@ViewLang.From</div>
            <div class="floatL">
                <input id="dtpFromDate" type="text" readonly="readonly" />
            </div>
            <div class="pdCommon">@ViewLang.To</div>
            <div class="floatL">
                <input id="dtpToDate" type="text" readonly="readonly" />
            </div>
            <div class="float-margin-left-normal">
                <input type="button" value="Submit" id='Submit' class="btnSearch" />
            </div>
            <span id="view-guidelines-icon" class="note-info-message" title=""></span>
            <input id="exporttoexcel" title="@ViewLang.ExportExcel" type="image" src="@Url.Content("~/Images/excel-icn.png")" name="image" class="excel"/>
        </div>
    </div>
    <div id="mainGrid">
        <div id="jqgrid" class="removeRadius freegrid content-grid">
        </div>
        <div id="GridContainer" class="freegrid">
        </div>
        </div>       
    <div id='msgNoinfo'>
        There is no data.</div>  

    <iframe id="frm" width="0" height="0" frameborder="0" style="display: none"></iframe>
    <input type="hidden" id="CustId" value="@Request.QueryString["id"]" />
    <input type="hidden" id="username" value="@Request.QueryString["username"]" />
</div>
<script type="text/javascript" src="@Url.Content("~/Scripts/_Libs/FanexGrid/Fanex.Grid.js")"></script>
<script type="text/javascript" src="@Url.Content("~/Scripts/_Libs/FanexGrid/Fanex.Pagination.js")"></script>
<script type="text/javascript" src="@Url.Content("~/Scripts/_Libs/FanexGrid/moment.js")"></script>
<script type="text/javascript" src="@Url.Content("~/Scripts/_Libs/FanexGrid/numeral.js")"></script>
<script type="text/javascript">
    var domain = '@Url.Content("~/")';
    var isInternalCustomer = @isInternalCustomer;
    var balanceUpDay = '@balanceUpDay';
    var moveBetsDay = '@moveBetsDay'; 
    var newLayoutDate = '@newLayoutDate';
    var _username = $('#username').val();
    var statementResources = {           
        Invalid_Date_Range: '@Labels.Invalid_Date_Range',
        Date: "@Labels.Date",
        Opening_Balance: "@Labels.Opening_Balance",
        Turnover: "@Labels.Turnover",
        Void_Cancelled: "@(Labels.Void + "/" + Labels.Rejected)",
        Outstanding: "@Labels.Outstanding",
        Win_Loss: "@Labels.Win_Loss",
        Commission: "@Labels.Commission",
        Transfer_Amt: "@Labels.Transfer_Amt",
        Accumulated_Total: "@Labels.Accumulated_Total",
        Symbol_NoData: "@Labels.Symbol_NoData",
        Transfer_Details: "@Labels.Transfer_Details",
        Bet_List: '@Labels.Bet_List',
        Statement_Guidelines: '@Labels.Statement_Guidelines',
        GrandPrize: '@Labels.GrandPrize'
    };
</script>
<script type="text/javascript" src="@Url.Content("~/Areas/Statement/Views/Report/Scripts/StatementReportManager.js")" ></script>
@if (HttpContext.Current.IsDebuggingEnabled)
{
    <script src="@Url.Content("~/Scripts/Statement/Fanex.ExtAcc.Statement.js")" type="text/javascript"></script>
}
else
{
    <script src="@BundleTable.Bundles.ResolveBundleUrl("~/bootstrap/Statement/js")" type="text/javascript"></script>
}