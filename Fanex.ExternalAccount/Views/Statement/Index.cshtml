@using Fanex.ExternalAccount.Utilities
@using System.Web.Optimization
@{
    ViewBag.Title = "Statement";
}
@section StyleSheet
{
    @if (HttpContext.Current.IsDebuggingEnabled)
    {
        <link href="@Url.Content("~/Content/Statement/Statement.css")" rel="stylesheet" type="text/css" />
    }
    else
    {
        <link href="@BundleTable.Bundles.ResolveBundleUrl("~/bootstrap/Statement/css")" rel="stylesheet" type="text/css" />
    }
}
<div>
    <div class="bgTitle titleForm">
        <div class="wlDetail">
            Statement
        </div>
    </div>
    <div class="bgTitle titleSearch">
        <div id="GroupFromToDate">
            <input type="hidden" id="MaxDate" value="@DateTime.Now"/>
            <div class="wFrom">@ViewLang.From</div>
            <div class="floatL">
                <input id="dtpFromDate" type="text" readonly="readonly" />
            </div>
            <div class="pdCommon">@ViewLang.To</div>
            <div class="floatL">
                <input id="dtpToDate" type="text" readonly="readonly" />
            </div>
            <div style="margin-left: 86px; float: left">
                <input type="button" value="Submit" id='Submit' class="btnSearch" />
            </div>
            <input id="exporttoexcel" title="@ViewLang.ExportExcel" type="image" src="@Url.Content("~/Images/excel-icn.png")" name="image"/>
        </div>
    </div>
    <div id="mainGrid">
        <div id="jqgrid" class="removeRadius freegrid content-grid">
        </div>
    </div>
    <div id='msgNoinfo'>
        There is no data.</div>
</div>
@section Scripts
{
    @if (HttpContext.Current.IsDebuggingEnabled)
    {
        <script src="@Url.Content("~/Scripts/Statement/Fanex.ExtAcc.Statement.js")" type="text/javascript"></script>
    }
    else
    {
        <script src="@BundleTable.Bundles.ResolveBundleUrl("~/bootstrap/Statement/js")" type="text/javascript"></script>
    }
}