@using Fanex.ExternalAccount.Utilities
@using Fanex.ExternalAccount.Core.Context;
@using System.Web.Optimization
@using CaptchaMvc.HtmlHelpers
@model Fanex.ExternalAccount.ViewModel.Account.Login
@{
    ViewBag.Title = ViewLang.LoginTitle;
    var showCaptcha = ViewBag.ShowCaptcha == string.Empty ? string.Empty : "none";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <title>@ViewBag.Title</title>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=9" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    @if (HttpContext.Current.IsDebuggingEnabled)
    {
        <link href="@Url.Content("~/assets/styles/base/Validators.css")" rel="stylesheet" type="text/css" />
        <link rel="stylesheet" type="text/css" href="@Url.Content("~/assets/styles/pages/account/login.css")" />
    }
    else
    {
        <link href="@BundleTable.Bundles.ResolveBundleUrl("~/bootstrap/login/css")" rel="stylesheet" type="text/css" />
    }
    <link href="@Url.Content("~/Areas/CustomerSetting/Views/SylouCaptcha/Styles/Index.css")"
          rel="stylesheet" type="text/css" />
</head>
<body>
    @using (Html.BeginForm())
    {
        <div class="block-login">
            <div class="row">
                <div class="login-logo"></div>
            </div>
            <div class="row">
                @Html.TextBoxFor(m => m.UserName, new { @class = "form-control", @maxlength = 50, @placeholder = "UserName" })
                <span class="icon-user"></span>
            </div>
            <div class="row">
                @Html.PasswordFor(m => m.Password, new { @class = "form-control", @maxlength = 50, @autocomplete = "off", @placeholder = "Password" })
                <span class="icon-lock"></span>
            </div>
            <div class="row captcha-container" id="captcha" style="display: @showCaptcha">
                @if (ViewBag.ShowCaptcha == string.Empty)
                {
                    try
                    {
                        @Html.Captcha(5, "~/Areas/CustomerSetting/Views/SylouCaptcha/SylouCaptchaPartialView.cshtml", ViewData)
                    }
                    catch (Exception ex)
                    {
                        Logs.Error(ex);
                    }
                }
            </div>
            <div class="row">
                <button id="btnLogin" class="btnLogin">@ViewLang.LoginTitle</button>
            </div>

            @if (!string.IsNullOrWhiteSpace(CurrentContext.LoginErrorMessage))
            {
                <div class="row errMsg">
                    @CurrentContext.LoginErrorMessage
                    @{CurrentContext.LoginErrorMessage = string.Empty;}
                </div>
                        }
        </div>
        @Html.Hidden("Code", Encryptor.Instance.Code)
                        @Html.AntiForgeryToken()
                        }

    <script type="text/javascript">
        function resolveClientUrl(relativeUrl) {
            return '@Url.Content("~/")' + relativeUrl;
        }
    </script>
    @if (HttpContext.Current.IsDebuggingEnabled)
    {
        <script src="@Url.Content("~/Scripts/Lib/jquery-ui-1.9.1/jquery-1.8.3.min.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Validators.js")" type="text/javascript"></script>
        <script type="text/javascript" src="@Url.Content("~/Scripts/Account/Fanex.ExtAcc.Account.js")"></script>
    }
    else
    {
        <script type="text/javascript" src="@BundleTable.Bundles.ResolveBundleUrl("~/bootstrap/login/js")"></script>
    }
</body>
</html>