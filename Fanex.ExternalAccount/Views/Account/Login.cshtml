@using Fanex.ExternalAccount.Utilities
@using Fanex.ExternalAccount.Core.Context
@using Fanex.ExternalAccount.Controllers
@using System.Web.Optimization
@using CaptchaMvc.HtmlHelpers
@model Fanex.ExternalAccount.ViewModel.Account.LoginModel
@{
    ViewBag.Title = ViewLang.LoginTitle;
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <title>@ViewBag.Title</title>
    @if (HttpContext.Current.IsDebuggingEnabled)
    {
        <link rel="stylesheet" type="text/css" href="@Url.Content("~/Content/Account/Login.css")" />
        <link href="@Url.Content("~/Content/Validators.css")" rel="stylesheet" type="text/css" />
    }
    else
    {
        <link href="@BundleTable.Bundles.ResolveBundleUrl("~/bootstrap/login/css")" rel="stylesheet" type="text/css" />
    }
    <link href="@Url.Content("~/Areas/CustomerSetting/Views/SylouCaptcha/Styles/Index.css")"
                                    rel="stylesheet" type="text/css" /></head>
<body>
    @using (Html.BeginForm())
    {
        <center style="margin-top: 100px">
            <div class="loginRegion">
                <table border="0" width="350px" style="height: 260px" cellpadding="0" cellspacing="0">
                    <tr>
                        <td colspan="2">
                            <div style="height: 64px">
                                <div class="loginHeader">
                                </div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding-left: 20px; width: 80px">
                            @Html.LabelFor(m => m.UserName, ViewLang.Username, new { @class = "label" })
                        </td>
                        <td style="width: 270px">
                            @Html.TextBoxFor(m => m.UserName, new { @class = "username text bgLoginControl", @maxlength = 50 })
                        </td>
                    </tr>
                    <tr>
                        <td style="padding-left: 20px;">
                            @Html.LabelFor(m => m.Password, ViewLang.Password, new { @class = "label" })
                        </td>
                        <td>
                            @Html.PasswordFor(m => m.Password, new { @class = "password bgLoginControl", @maxlength = 50, @autocomplete = "off" })
                        </td>
                    </tr>
                    @if (Model.IsVisibleCaptcha)
                    {
                        <tr id="captcha">
                            <td>
                            </td>
                            <td>
                                 @{
                                     try
                                     {
                                        @Html.Captcha(5, "~/Areas/CustomerSetting/Views/SylouCaptcha/SylouCaptchaPartialView.cshtml", ViewData)
                                     }
                                     catch (Exception ex)
                                     {
                                     Fanex.Logging.Extensions.Web.ExceptionHandler.Handle(ex);
                                     }
                                 }
                            </td>
                        </tr>
                    }
                    <tr>
                        <td>
                        </td>
                        <td>
                            <button id="btnLogin" class="btnLogin">@ViewLang.LoginTitle</button>
                        </td>
                    </tr>
                    <tr>
                        <td>
                        </td>
                        <td>
                            <span class="bestView">@ViewLang.BestViewIn
                                <img class="browser" alt="" src="@Url.Content("~/Images/Login/IE-icn.png")" />
                                IE8+
                                <img class="browser" alt="" src="@Url.Content("~/Images/Login/Firefox-icn.png")" />
                                FF4+</span>
                        </td>
                    </tr>
                </table>
                @if (!string.IsNullOrWhiteSpace(Model.LoginFailedMessage))
                {
                    <table style="margin-top: 50px" border="0" width="350px" cellpadding="0" cellspacing="0">
                        <tr>
                            <td class="errMsg">
                                @Model.LoginFailedMessage
                            </td>
                        </tr>
                    </table>
                }
            </div>
        </center>
        @Html.Hidden("Code", Model.Code)
        @Html.AntiForgeryToken()
    }

    <script type="text/javascript">        
        function resolveClientUrl(relativeUrl) {
            return '@Url.Content("~/")' + relativeUrl;
        }
    </script>
    @if (HttpContext.Current.IsDebuggingEnabled)
    {
        <script src="@Url.Content("~/Scripts/Lib/jquery-ui-1.9.1/jquery-1.8.3.min.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Validators.js")" type="text/javascript"></script>
        <script type="text/javascript" src="@Url.Content("~/Scripts/Account/Fanex.ExtAcc.Account.js")"></script>
    }
    else
    {
        <script type="text/javascript" src="@BundleTable.Bundles.ResolveBundleUrl("~/bootstrap/login/js")"></script>
    }
</body>
</html>