@using Fanex.PTEngine
@using Newtonsoft.Json
@using Newtonsoft.Json.Serialization
@model List<Product>
@{
    var SyncCasino = ViewBag.SyncCasino;
    var HideVirtualSports = ViewBag.HideVirtualSports;
    var HideKeno = ViewBag.HideKeno;
    var HideGoldDeluxe = ViewBag.HideGoldDeluxe;
    var status = new
    {
        syncCasino = SyncCasino,
        hideVirtualSports = HideVirtualSports,
        hideKeno = HideKeno,
        hideGoldDeluxe = HideGoldDeluxe
    };
    var statusJSON = JsonConvert.SerializeObject(status, Formatting.None, new JsonSerializerSettings { NullValueHandling = NullValueHandling.Ignore, ContractResolver = new CamelCasePropertyNamesContractResolver() });
}
<link href="@Url.Content("~/Scripts/Lib/jquery-ui-1.9.1/themes/base/jquery-ui.css")" rel="stylesheet" type="text/css" />
<link href="@HttpContext.Current.GetWebResourceUrl("Fanex.PTEngine.UI.Core.css")" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/assets/styles/pages/customer/pt-engine.css")" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/assets/styles/pages/customer/customer-setting.css")" rel="stylesheet" type="text/css" />

<div id="tabs" style="border:none">
    <ul id="tabs-list" class="tabs">
        @if ((int)ViewBag.CurrentLevel != Role.Member)
        {
            <li id="tab1"><a class="height-auto" href="#tabs-1">Sportsbook's Min PT</a></li>
        }

        @if ((bool)ViewBag.SyncCasino)
        {
            <li id="tab4"><a style="height: auto" href="#tabs-4">Casino</a></li>
        }
        <li id="tab8"><a class="height-auto" href="#tabs-8">Virtual Sports</a></li>
        <li id="tab9"><a class="height-auto" href="#tabs-9">RNG Keno</a></li>
        <li id="tab10"><a class="height-auto" href="#tabs-10">Gold Deluxe</a></li>

        @foreach (var product in Model)
        {
            <li id="tab@(product.Id)" class="dynamic-setting-tab" data-product-id="@(product.Id)">
                <a class="height-auto" href="#tabs-@(product.Id)">
                    @(product.Name)
                </a>
            </li>
        }
    </ul>

    @if ((int)ViewBag.CurrentLevel != Role.Member)
    {
        <div id="tabs-1" class="divTab">
        </div>
    }

    @if ((bool)ViewBag.SyncCasino)
    {
        <div id="tabs-4" class="divTab" style="padding: 0px">
            <iframe id="casinoFrame" height="100%" width="100%" frameborder="0" style="overflow: auto"></iframe>
        </div>
    }

    <div id="tabs-8" class="divTab">
        <iframe id="virtualSportsFrame" height="100%" width="100%" frameborder="0" style="overflow: auto"></iframe>
    </div>

    @if (!HideKeno)
    {
        <div id="tabs-9" class="divTab" style="padding: 0px">
            <iframe id="kenoFrame" height="100%" width="100%" frameborder="0" style="overflow: auto"></iframe>
        </div>
    }
    @if (!HideGoldDeluxe)
    {
        <div id="tabs-10" class="divTab" style="padding: 0px">
            <iframe id="goldDeluxeFrame" height="100%" width="100%" frameborder="0" style="overflow: auto"></iframe>
        </div>
    }

    @foreach (var product in Model)
    {
        <div id="tabs-@(product.Id)" class="divTab" data-product-id="@(product.Id)" style="padding: 0px">
            <iframe id="Frame_@(product.Id)" height="100%" width="100%" frameborder="0" style="overflow: auto"></iframe>
        </div>
    }

</div>
<script type="text/javascript">
    if (typeof Fanex == 'undefined') {
        Fanex = {};
    }

    if (typeof Fanex.ExtAcc == 'undefined') {
        Fanex.ExtAcc = {};
    }

    if (typeof Fanex.ExtAcc.Customer == 'undefined') {
        Fanex.ExtAcc.Customer = {};
    }

    var custStatus = $.parseJSON(Fanex.ExtAcc.DecodeHtml('@statusJSON'));

    Fanex.ExtAcc.Customer.CurrentLevel = '@ViewBag.CurrentLevel';
    Fanex.ExtAcc.Customer.IsMultiple = false;
    Fanex.ExtAcc.Customer.UserId = '@ViewBag.UserId';
    Fanex.ExtAcc.Customer.Master = @Role.Master;
    Fanex.ExtAcc.Customer.Agent = @Role.Agent;
    Fanex.ExtAcc.Customer.Member = @Role.Member;
    Fanex.ExtAcc.Customer.superId = Fanex.ExtAcc.Customer.masterId = Fanex.ExtAcc.Customer.agentId = '@ViewBag.UplineId';
    Fanex.ExtAcc.Customer.SyncCasino = custStatus.syncCasino;
    Fanex.ExtAcc.Customer.HideVirtualSports = custStatus.hideVirtualSports;
    Fanex.ExtAcc.Customer.HideKeno = custStatus.hideKeno;
    Fanex.ExtAcc.Customer.HideGoldDeluxe = custStatus.hideGoldDeluxe;
    Fanex.ExtAcc.Customer.isSuperEditAgent = Fanex.ExtAcc.Customer.isSuperEditMember = Fanex.ExtAcc.Customer.isMasterEditMember = false;
    Fanex.ExtAcc.Customer.CurrentLevel = parseInt(Fanex.ExtAcc.Customer.CurrentLevel);

    Fanex.ExtAcc.Customer.CustomerInfo = function () {
        var obj = new Object();

        obj.custId = parseInt(Fanex.ExtAcc.Customer.UserId);
        obj.roleId = parseInt(Fanex.ExtAcc.Customer.CurrentLevel);
        obj.uplineId = parseInt(Fanex.ExtAcc.Customer.superId);
        obj.uplineRoleId = parseInt(Fanex.ExtAcc.Customer.CurrentLevel) + 1;

        return obj;
    };
</script>
<script src="@HttpContext.Current.GetWebResourceUrl("Fanex.PTEngine.UI.Languages.en.js")" type="text/javascript"></script>
<script src="@HttpContext.Current.GetWebResourceUrl("Fanex.PTEngine.UI.Core.js")" type="text/javascript"></script>
<script src="@HttpContext.Current.GetWebResourceUrl("Fanex.PTEngine.UI.knockout-2.0.0.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Scripts/Customer/Fanex.ExtAcc.Customer.Settings.js")" type="text/javascript"></script>