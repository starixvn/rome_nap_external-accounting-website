@using Fanex.PTEngine
@using Newtonsoft.Json
@using Newtonsoft.Json.Serialization
@using Fanex.CustomerSetting.Module.KenoStatus.Configurations
@using System.Configuration

@{
    var SyncCasino = ViewBag.SyncCasino;
    var SyncBingo = ViewBag.SyncBingo &&  Sunplus.Bingo.Core.BingoSettings.BingoGame.Enabled;
    var SyncLiveCasino = ViewBag.SyncLiveCasino;
    var DisableP2P = ViewBag.DisableP2P;
    var HideVirtualSports = ViewBag.HideVirtualSports;
    var HideKeno = ViewBag.HideKeno || !KenoSection.Instance.ShowSetting;
    var HideGoldDeluxe = ViewBag.HideGoldDeluxe || ConfigurationManager.AppSettings["IsShowGoldDeluxeSettingForCredit"] == "0";
    var HideColossusBets = ViewBag.HideColossusBets || ConfigurationManager.AppSettings["IsShowColossusBets"] == "0";
    var HideSportsbook2 = ViewBag.HideSportsbook2 || ConfigurationManager.AppSettings["IsShowSportsbook2"] == "0";
    var HideCockfighting = ViewBag.HideCockfighting || ConfigurationManager.AppSettings["IsShowCockfighting"] == "0";
    var status = new { syncBingo = SyncBingo, syncCasino = SyncCasino, syncLiveCasino = SyncLiveCasino, disableP2P = DisableP2P, hideVirtualSports = HideVirtualSports, hideKeno = HideKeno, hideGoldDeluxe = HideGoldDeluxe, hideColossusBets = HideColossusBets, hideSportsbook2 = HideSportsbook2, hideCockfighting = HideCockfighting };
    var statusJSON = JsonConvert.SerializeObject(status, Formatting.None, new JsonSerializerSettings { NullValueHandling = NullValueHandling.Ignore, ContractResolver = new CamelCasePropertyNamesContractResolver() });
}
<link href="@Url.Content("~/Scripts/Lib/jquery-ui-1.9.1/themes/base/jquery-ui.css")" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/Content/Customer/Customer.css")" rel="stylesheet" type="text/css" />    
<link href="@HttpContext.Current.GetWebResourceUrl("Fanex.PTEngine.UI.Core.css")" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/Content/Customer/PTEngine.css")" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/Content/Customer/LiveCasino.css")" rel="stylesheet" type="text/css" />
<div id="tabs" style="border:none">
  <ul class="tabs">
    <li id="tab1"><a href="#tabs-1">Sportsbook's Min PT</a></li>
    <li id="tab2"><a href="#tabs-2">Racing</a></li>
    <li id="tab3"><a href="#tabs-3">Racing's Min PT</a></li>
    <li id="tab4"><a href="#tabs-4">Casino</a></li>
    <li id="tab5"><a href="#tabs-5">Bingo</a></li>
    <li id="tab6"><a href="#tabs-6">Poker</a></li>
    <li id="tab7"><a href="#tabs-7">Live Casino</a></li>
    <li id="tab8"><a href="#tabs-8">Virtual Sports</a></li>
    <li id="tab9"><a href="#tabs-9">Keno</a></li>
    <li id="tab10"><a href="#tabs-10">Gold Deluxe</a></li>
    <li id="tab11"><a href="#tabs-11">Colossus Bets</a></li>
    <li id="tab12"><a href="#tabs-12">Sportsbook 2</a></li>
    <li id="tab13"><a href="#tabs-13">Cockfighting</a></li>
  </ul>
  <div id="tabs-1" class="divTab">    
  </div>
  <div id="tabs-2" class="divTab" style="padding: 0px">
    <iframe id="racingFrame" height="100%" width="100%" frameborder="0" style="margin:0;padding:0;overflow:auto;"></iframe>       
  </div>
  <div id="tabs-3" class="divTab" style="padding: 0px">
    <iframe id="minMaxracingFrame" height="100%" width="100%" frameborder="0" style="margin:0;padding:0;overflow:auto;"></iframe>           
  </div>
  <div id="tabs-4" class="divTab" style="padding: 0px">
    <iframe id="casinoFrame" height="100%" width="100%" frameborder="0" style="overflow: auto"></iframe>    
  </div>
  <div id="tabs-5" class="divTab" style="padding: 0px">
    <iframe id="bingoFrame" height="100%" width="100%" frameborder="0" style="overflow: auto"></iframe>           
  </div>
  <div id="tabs-6" class="divTab">    
  </div>
  <div id="tabs-7" class="divTab">
   <iframe id="livecasinoFrame" height="100%" width="100%" frameborder="0" style="overflow: auto"></iframe>           
  </div>
  <div id="tabs-8" class="divTab">    
  </div>
  @if (!HideKeno)
  {
  <div id="tabs-9" class="divTab" style="padding: 0px">
    <iframe id="kenoFrame" height="100%" width="100%" frameborder="0" style="overflow: auto"></iframe>           
  </div>
  }
   @if (!HideGoldDeluxe)
  {
  <div id="tabs-10" class="divTab" style="padding: 0px">
    <iframe id="goldDeluxeFrame" height="100%" width="100%" frameborder="0" style="overflow: auto"></iframe>           
  </div>
  }
    @if (!HideColossusBets)
  {
  <div id="tabs-11" class="divTab" style="padding: 0px">
    <iframe id="colossusBetsFrame" height="100%" width="100%" frameborder="0" style="overflow: auto"></iframe>           
  </div>
  }
    @if (!HideSportsbook2)
  {
  <div id="tabs-12" class="divTab" style="padding: 0px">
    <iframe id="sportsbook2Frame" height="100%" width="100%" frameborder="0" style="overflow: auto"></iframe>           
  </div>
  }
  
    @if (!HideCockfighting)
  {
  <div id="tabs-13" class="divTab" style="padding: 0px">
    <iframe id="cockFightingFrame" height="100%" width="100%" frameborder="0" style="overflow: auto"></iframe>           
  </div>
  }
</div>
<script type="text/javascript">
    if (typeof Fanex == 'undefined') {
        Fanex = {};
    }

    if (typeof Fanex.ExtAcc == 'undefined') {
        Fanex.ExtAcc = {};
    }

    if (typeof Fanex.ExtAcc.Customer == 'undefined') {
        Fanex.ExtAcc.Customer = {};
    }

    var custStatus = $.parseJSON(Fanex.ExtAcc.DecodeHtml('@statusJSON'));

    Fanex.ExtAcc.Customer.CurrentLevel = '@ViewBag.CurrentLevel';
    Fanex.ExtAcc.Customer.IsMultiple = false;
    Fanex.ExtAcc.Customer.UserId = '@ViewBag.UserId';
    Fanex.ExtAcc.Customer.Master = 3;
    Fanex.ExtAcc.Customer.Agent = 2;
    Fanex.ExtAcc.Customer.Member = 1;
    Fanex.ExtAcc.Customer.superId = Fanex.ExtAcc.Customer.masterId = Fanex.ExtAcc.Customer.agentId = '@ViewBag.UplineId';
    Fanex.ExtAcc.Customer.SyncCasino = custStatus.syncCasino;
    Fanex.ExtAcc.Customer.SyncBingo = custStatus.syncBingo;
    Fanex.ExtAcc.Customer.SyncLiveCasino = custStatus.syncLiveCasino;
    Fanex.ExtAcc.Customer.DisableP2P = custStatus.disableP2P;
    Fanex.ExtAcc.Customer.HideVirtualSports = custStatus.hideVirtualSports;
    Fanex.ExtAcc.Customer.HideKeno = custStatus.hideKeno;
    Fanex.ExtAcc.Customer.HideGoldDeluxe = custStatus.hideGoldDeluxe;
    Fanex.ExtAcc.Customer.HideColossusBets = custStatus.hideColossusBets;
    Fanex.ExtAcc.Customer.HideSportsbook2 = custStatus.hideSportsbook2;
    Fanex.ExtAcc.Customer.HideCockfighting = custStatus.hideCockfighting;
    Fanex.ExtAcc.Customer.isSuperEditAgent = Fanex.ExtAcc.Customer.isSuperEditMember = Fanex.ExtAcc.Customer.isMasterEditMember = false;
    Fanex.ExtAcc.Customer.CurrentLevel = parseInt(Fanex.ExtAcc.Customer.CurrentLevel);

    Fanex.ExtAcc.Customer.CustomerInfo = function () {
        var obj = new Object();

        obj.custId = parseInt(Fanex.ExtAcc.Customer.UserId);
        obj.roleId = parseInt(Fanex.ExtAcc.Customer.CurrentLevel);
        obj.uplineId = parseInt(Fanex.ExtAcc.Customer.superId);
        obj.uplineRoleId = parseInt(Fanex.ExtAcc.Customer.CurrentLevel) + 1;

        return obj;
    };
</script>
<script src="@HttpContext.Current.GetWebResourceUrl("Fanex.PTEngine.UI.Languages.en.js")" type="text/javascript"></script>
<script src="@HttpContext.Current.GetWebResourceUrl("Fanex.PTEngine.UI.Core.js")" type="text/javascript"></script>
<script src="@HttpContext.Current.GetWebResourceUrl("Fanex.PTEngine.UI.knockout-2.0.0.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Scripts/Customer/Fanex.ExtAcc.Customer.Settings.js")" type="text/javascript"></script>