@using Fanex.ExternalAccount.Utilities
@using Fanex.ExternalAccount.DTO.UserControl
@model Fanex.ExternalAccount.DTO.Customer.Customer
@{
    var displayMember = Model.RoleId == 1 ? "block" : "none";
    var displayAgent = Model.RoleId != 1 ? "block" : "none";
    var isMember = Model.RoleId == 1 ? 1 : 0;
}
<div>
    <table width="100%" border="0" cellpadding="2">
@*        <tr>
            <td style="width: 120px; text-align: right">
                @Html.LabelFor(m => m.Username, ViewLang.Username, new { @style = "width: 100px;" })
            </td>
            <td style="width: 235px; text-indent: 2px; color: #2489CE">
                @Model.Username
            </td>
        </tr>
*@      
        <tr>
            <td colspan="2">
                <div id="errMsg" style="display: none;" class="successMsg">
                </div>
            </td>
        </tr>  
        <tr>
            <td style="text-align: right">
                 @Html.HiddenFor(m => m.CustId)@Html.LabelFor(m => m.Password, ViewLang.Newpassword, new { @style = "width: 235px;" })
            </td>
            <td>
                @Html.PasswordFor(m => m.Password, new { @style = "width: 235px;", @maxlength = "10" })
            </td>
        </tr>
        <tr>
            <td style="text-align: right">
                <label for="confirmPwd">@ViewLang.Confirmpassword</label>
            </td>
            <td>
                <input id="confirmPwd" type="password" style="width: 235px;" maxlength="10" />
            </td>
        </tr>
        <tr>
            <td colspan="2">
                <div style="float: right; margin-right: 1px">
                    <input class="buttonPopup" type="button" value="Submit" onclick="Fanex.ExtAcc.Customer.ResetPwd(@isMember)" />
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="2">
                <pre id="agentTemplate" style="display: @displayAgent; width: 357px; color:#dd0000; white-space: pre-wrap; font-family: Tahoma, Arial, helvetica, sans-serif; line-height: 15px">
Password must be at least 8 characters without white-space and contain at least 3 of the following:

    • Uppercase letter [A-Z] 
    • Lowercase letter [a-z] 
    • Numeric [0-9] 
    • Special character (!,&#64;,#,etc..)

For example: 59D7!4$h, 493abcDE
Notes: your password is cAsE sEnSiTiVe
                </pre>
            </td>
        </tr>
        <tr>
            <td colspan="2">
                <pre id="memberTemplate" style="display: @displayMember; width: 357px; color:#dd0000; white-space: pre-wrap; font-family: Tahoma, Arial, helvetica, sans-serif; line-height: 15px">
Password must be 6-10 characters without white-space and contain at least 1 uppercase letter, 1 lowercase letter, 1 numeric digit.
                        
For example: 493abcDE, 59D7!4$h                        
Notes: your password is cAsE sEnSiTiVe.
                </pre>
            </td>
        </tr>
    </table>
</div>
<link href="@Url.Content("~/Content/Validators.css")" rel="stylesheet" type="text/css" />
<script src="@Url.Content("~/Scripts/Validators.js")" type="text/javascript"></script>