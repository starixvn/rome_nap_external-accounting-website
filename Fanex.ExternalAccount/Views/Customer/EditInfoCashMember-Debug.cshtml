@model Fanex.ExternalAccount.Controllers.ViewModels.Customer.EditInfoCashMemberViewModel
@using Newtonsoft.Json
<!DOCTYPE html>
<html>
<head>
    <script type="module">
        import RefreshRuntime from "http://localhost:4212/@@react-refresh";
        RefreshRuntime.injectIntoGlobalHook(window);
        window.$RefreshReg$ = () => { };
        window.$RefreshSig$ = () => (type) => type;
        window.__vite_plugin_react_preamble_installed__ = true;
    </script>
    <script type="module" src=@("http://localhost:4212/@vite/client")></script>
    <link rel="stylesheet" href="http://localhost:4212/src/styles.scss" />
</head>
<body>
    <div id="mainGrid" style="visibility: visible">
        @Html.AntiForgeryToken()
        <div id="root"></div>
    </div>
<script type="text/javascript">
        function resolveClientUrl(relativeUrl) {
            return '@Url.Content("~/")' + relativeUrl;
        }
        @* const appConfig = @Html.Raw(Model.AppConfig);
        const params = @Html.Raw(Model.Params); *@

        const updateInfoCustomerPageConfig = @Html.Raw(JsonConvert.SerializeObject(new {
            custId = Model.CustId, 
            username = Model.Username,
            isCashMember = Model.IsCashMember, 
            applicationPath = Model.ApplicationPath,
            cdnUri = Model.CdnUri
        }, Formatting.None, new JsonSerializerSettings
        {
            ContractResolver = new Newtonsoft.Json.Serialization.CamelCasePropertyNamesContractResolver(),
            NullValueHandling = NullValueHandling.Ignore
        }));
    </script>
    @StaticResources.RenderScripts("~/assets/bundles/common")
    <script type="module" src="http://localhost:4212/src/main.tsx"></script>
</body>
</html>