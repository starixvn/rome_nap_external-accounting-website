@using Fanex.ExternalAccount.Utilities
@using Fanex.ExternalAccount.DTO
@using Fanex.PTEngine
<link href="@Url.Content("~/Content/Customer/Customer.css")" rel="stylesheet" type="text/css" />
<link href="@HttpContext.Current.GetWebResourceUrl("Fanex.PTEngine.UI.Core.css")" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/Content/Customer/PTEngine.css")" rel="stylesheet" type="text/css" />
<div id="customerList" style="background-color: #fff">
    <div class="page-title">
        Customer List
    </div>
    <div id="searchBar" class="search-form">
        <div class="searchBar">
            <div style="float: left; margin-right: 5px; margin-top: 5px">
                @ViewLang.Username
            </div>
            <div style="float: left">
                <input id="txtUserName" type="text" class="usernameInput" autocomplete="off" />
            </div>
            <div style="float: left; margin-left: 20px; margin-top: 5px">
                @ViewLang.Status
            </div>
            <div id="userGroup" style="float: left; margin-left: 5px">
                <select id="customerStatus" class="usernameInput group">
                    <option value="-1">@ViewLang.All</option>
                    <option value="1">@ViewLang.Open</option>
                    <option value="3">@ViewLang.Suspended</option>
                    <option value="2">@ViewLang.Closed</option>
                    <option value="4">@ViewLang.Disabled</option>
                </select>
            </div>
            <div style="float: left; margin-left: 10px;">
                <input id="btnSearch" type="button" value="Submit" class="btn -submit" onclick="Fanex.ExtAcc.Customer.Search()" />
            </div>
        </div>
    </div>
    <div class="bgTitle titleSearch">
        <div class="searchBar">
            <div style="float: left; margin-top: 4px;">@ViewLang.Select:</div>
            <div style="float: left; margin-top: 4px; margin-left: 5px; cursor: pointer; font-weight: bold;" onclick="Fanex.ExtAcc.Customer.SelectAll('menuActive')">@ViewLang.All</div>
            <div style="float: left; margin: 2px 5px 0px 5px; color: #C9C9C9">
                |
            </div>
            <div style="float: left; margin-top: 4px; cursor: pointer; font-weight: bold;" onclick="Fanex.ExtAcc.Customer.SelectAll('menuInactive')">@ViewLang.None</div>
        </div>
        <div style="float: right">
            <div id="breadcrumbs">
            </div>
            <div class="floatR">
                <input id="exporttoexcel" title="@ViewLang.ExportExcel" type="image" src="@Url.Content("~/Images/excel-icn.png")" name="image" />
            </div>
        </div>
    </div>
    <div style="margin: 0px 3px 0px 3px" id="customerListGrid">
        <div id="jqgrid" class="removeRadius freegrid content-grid">
        </div>
        <div id="msgNoinfo">
            There is no data.
        </div>
    </div>
    @Html.AntiForgeryToken()
</div>
<form id="targetForm" method="post" target="windowPopup" action="">
    <input type="hidden" id="uplineId" name="uplineId" value="" />
    <input type="hidden" id="parentId" name="parentId" value="" />
    <input type="hidden" id="customerIds" name="customerIds" value="" />
    <input type="hidden" id="customerNames" name="customerNames" value="" />
    <input type="hidden" id="syncStatuses" name="syncStatuses" value="" />
    <input type="hidden" id="usernames" name="usernames" value="" />
    <input type="hidden" id="uplineLevel" name="uplineLevel" value="" />
    <input type="hidden" id="customerLevel" name="customerLevel" value="" />
    <input type="hidden" id="actorId" name="actorId" value="" />
    <input type="hidden" id="actorIdUsername" name="actorIdUsername" value="" />
    <input type="hidden" id="subAccId" name="subAccId" value="" />
    <input type="hidden" id="language" name="language" value="" />
    <input type="hidden" id="groupName" name="groupName" value="" />
    <input type="hidden" id="productId" name="productId" value="" />
    <input type="hidden" name="customerId" id="customerId" value="" />
    <input type="hidden" id="isMultiple" name="isMultiple" value="false" />
    <input type="hidden" id="IsReadOnly" name="IsReadOnly" value="false" />
    <input type="hidden" id="formType" name="formType" value="1" />
    <input type="hidden" id="isForcingMode" name="isForcingMode" value="false" />
</form>
<script type="text/javascript">
    $('#customerStatus').combobox();
    Fanex.ExtAcc.Customer.dataTexts = [
        '@ViewLang.Username',
        '@ViewLang.Firstname',
        '@ViewLang.Lastname',
        '@ViewLang.GroupName',
        '@ViewLang.Creator',
        '@ViewLang.CreatedDate',
        '@ViewLang.Permission',
        '@ViewLang.Active',
        '@ViewLang.Password',
    ];

    $(document).ready(function () {
        $("#userGroup input").val($("#customerStatus")[0].options[0].text);
        $("#userGroup input").attr("readonly", "true");
        $("#userGroup input").bind("click", function () {
            $(this).autocomplete("search", '');
        });
    });

    window.actionAfterUpdatedLiveCasinoSettingMultiple = function () {
        document.getElementById("targetForm").submit();
    };
</script>