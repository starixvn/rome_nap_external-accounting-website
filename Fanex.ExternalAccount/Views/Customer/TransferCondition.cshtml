@using Fanex.ExternalAccount.Utilities
@model bool
<div data-bind="if: displayTransferCondition">
    <div class="transferCondition">
        <div class="headerTab">
            @ViewLang.accbalanceTransferCondition
        </div>
        @if (Model)
        {
            <div class="errMsg" id="transfercondition_message">@ViewLang.TransferConditionsWarning_Master</div>
        }
        <div>
            <label for="rdDaily">
                <input type="radio" onclick="Fanex.Customer.SelectTransferTime();" id="rdDaily" name="transferCondition"
                       value="00000000" checked />@ViewLang.daily
                </label>
            </div>
            <div class="line">
            </div>
            <div id="alldays">
                <label for="rdWeekly">
                    <input type="radio" onclick="Fanex.Customer.SelectTransferTime();" id="rdWeekly"
                           name="transferCondition" value="00000001" @(Model?"disabled":string.Empty)/>@ViewLang.Weekly &nbsp;&nbsp;
                    </label>
                    <span>
                        <label for="chkMon">
                            <input name="chkMon" id="chkMon" type="checkbox" onclick="return Fanex.Customer.ChooseDate();"
                                   disabled />@ViewLang.Mon&nbsp;&nbsp;
                            </label>
                            <label for="chkTue">
                                <input name="chkTue" id="chkTue" type="checkbox" onclick="return Fanex.Customer.ChooseDate();"
                                       disabled />@ViewLang.Tue&nbsp;&nbsp;
                                </label>
                                <label for="chkWed">
                                    <input name="chkWed" id="chkWed" type="checkbox" onclick="return Fanex.Customer.ChooseDate();"
                                           disabled />@ViewLang.Wed&nbsp;&nbsp;
                                    </label>
                                    <label for="chkThurs">
                                        <input name="chkThurs" id="chkThurs" type="checkbox" onclick="return Fanex.Customer.ChooseDate();"
                                               disabled />@ViewLang.Thur&nbsp;&nbsp;
                                        </label>
                                        <label for="chkFri">
                                            <input name="chkFri" id="chkFri" type="checkbox" onclick="return Fanex.Customer.ChooseDate();"
                                                   disabled />@ViewLang.Fri&nbsp;&nbsp;
                                            </label>
                                            <label for="chkSat">
                                                <input name="chkSat" id="chkSat" type="checkbox" onclick="return Fanex.Customer.ChooseDate();"
                                                       disabled />@ViewLang.Sat&nbsp;&nbsp;
                                                </label>
                                                <label for="chkSun">
                                                    <input name="chkSun" id="chkSun" type="checkbox" onclick="return Fanex.Customer.ChooseDate();"
                                                           disabled />@ViewLang.Sun
                                                    </label>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                    <link href="@Url.Content("~/assets/styles/base/Validators.css")" rel="stylesheet" type="text/css" />
                                    <script src="@Url.Content("~/Scripts/Validators.js")" type="text/javascript"></script>