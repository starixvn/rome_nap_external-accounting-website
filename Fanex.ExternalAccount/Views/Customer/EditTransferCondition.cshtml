@using Fanex.ExternalAccount.Utilities
@using Fanex.ExternalAccount.DTO.Customer
@model Transfer
@{
    var custId = ViewBag.CustId;
}
<link href="@Url.Content("~/Content/Customer/Customer.css")" rel="stylesheet" type="text/css" />
<div style="padding-top: 10px;">
    <table width="100%" border="0" cellpadding="2">
        <tr>
            <td colspan="8" style="padding-top: 10px;">
                <div id="errMsg" style="display: none;" class="successMsg">
                </div>
            </td>
        </tr>
        <tr class="rowTransferCondition headerTransferCondition">
            <td colspan="8">
                @ViewLang.accbalanceTransferCondition
            </td>
        </tr>
        <tr class="rowTransferCondition">
            <td style="text-align: left; padding-left: 5px;" colspan="8">
                @Html.RadioButtonFor(m => m.Daily, "true") @Html.LabelFor(m => m.Daily)
            </td>
        </tr>
        <tr class="rowTransferCondition">
            <td style="text-align: left; padding-left: 5px;">
                @Html.RadioButtonFor(m => m.Weekly, "true") @Html.LabelFor(m => m.Weekly)
            </td>
            <td style="text-align: left">
                @Html.CheckBoxFor(m => m.Mon) @Html.LabelFor(m => m.Mon)
            </td>
            <td style="text-align: left">
                @Html.CheckBoxFor(m => m.Tue) @Html.LabelFor(m => m.Tue)
            </td>
            <td style="text-align: left">
                @Html.CheckBoxFor(m => m.Wed) @Html.LabelFor(m => m.Wed)
            </td>
            <td style="text-align: left">
                @Html.CheckBoxFor(m => m.Thu) @Html.LabelFor(m => m.Thu)
            </td>
            <td style="text-align: left">
                @Html.CheckBoxFor(m => m.Fri) @Html.LabelFor(m => m.Fri)
            </td>
            <td style="text-align: left">
                @Html.CheckBoxFor(m => m.Sat) @Html.LabelFor(m => m.Sat)
            </td>
            <td style="text-align: left">
                @Html.CheckBoxFor(m => m.Sun) @Html.LabelFor(m => m.Sun)
            </td>
        </tr>
        <tr>
            <td colspan="8">
                <div style="float: right; padding-top: 10px; padding-right: 0px; margin-right: 0px">
                    <input class="btn -submit buttonPopup" type="button" value="Submit" onclick="Fanex.ExtAcc.Customer.TransferCondition.EditTransferCondition()" />
                </div>
            </td>
        </tr>        
    </table>
    @Html.AntiForgeryToken()
</div>
<script src="@Url.Content("~/Scripts/Customer/Fanex.ExtAcc.Customer.TransferCondition.js")" type="text/javascript"></script>
<script type="text/javascript">
    var custId = parseInt('@custId');
</script>