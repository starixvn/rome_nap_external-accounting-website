@using Fanex.ExternalAccount.Utilities
@using Fanex.ExternalAccount.DTO.Customer
@model Transfer

<div>
    <table width="100%" border="0" cellpadding="2">
        <tr class="rowTransferCondition headerTransferCondition">
            <td colspan="8">
                @ViewLang.accbalanceTransferCondition
            </td>
        </tr>
        <tr class="rowTransferCondition">
            <td style="text-align: left; padding-left: 5px;" colspan="8">
                @Html.RadioButtonFor(m => m.Daily, "true") @ViewLang.daily
            </td>
        </tr>
        <tr class="rowTransferCondition">
            <td style="text-align: left; padding-left: 5px;">
                @Html.RadioButtonFor(m => m.Weekly, "true") @ViewLang.Weekly
            </td>
            <td style="text-align: left">
                @Html.CheckBoxFor(m => m.Mon) @ViewLang.Mon
            </td>
            <td style="text-align: left">
                @Html.CheckBoxFor(m => m.Tue) @ViewLang.Tue
            </td>
            <td style="text-align: left">
                @Html.CheckBoxFor(m => m.Wed) @ViewLang.Wed
            </td>
            <td style="text-align: left">
                @Html.CheckBoxFor(m => m.Thu) @ViewLang.Thur
            </td>
            <td style="text-align: left">
                @Html.CheckBoxFor(m => m.Fri) @ViewLang.Fri
            </td>
            <td style="text-align: left">
                @Html.CheckBoxFor(m => m.Sat) @ViewLang.Sat
            </td>
            <td style="text-align: left">
                @Html.CheckBoxFor(m => m.Sun) @ViewLang.Sun
            </td>
        </tr>
        <tr>
            <td colspan="8">
                <div style="float: right; padding-top: 10px;">
                    <input class="buttonPopup" type="button" value="Submit" onclick="Fanex.ExtAcc.Customer.EditInfo()" />
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="4">
                <div id="errMsg" style="display: none;" class="errMsg">
                </div>
            </td>
        </tr>
    </table>
</div>
<script type="text/javascript">
    var arrWeekly = new Array("#Sun", "#Mon", "#Tue", "#Wed", "#Thu", "#Fri", "#Sat");
    function CheckChooseDaily(){
        var chkCount = 0;
        if ($('input:radio[name=Weekly]').is(':checked')) {
            for (var i = 0; i < arrWeekly.length; i++) {
                if ($(arrWeekly[i]).is(':checked')) {
                    chkCount++;
                    if (chkCount == 7) {
                        alert("grwgwegwer");
                    }
                }
            }
        }
    };

    $(document).ready(function () {
        for (var i = 0; i < arrWeekly.length; i++) {
            $(arrWeekly[i]).bind('click', CheckChooseDaily);
        }

        $('#Daily').bind('click', function () {
            for (var i = 0; i < arrWeekly.length; i++) {
                $(arrWeekly[i]).attr("disabled", true);
            }

            $('input:radio[name=Weekly]').attr("checked", false);
        });

        $('#Weekly').bind('click', function () {
            for (var i = 0; i < arrWeekly.length; i++) {
                $(arrWeekly[i]).attr("disabled", false);
            }

            $('input:radio[name=Daily]').attr("checked", false);
        });
    });
</script>