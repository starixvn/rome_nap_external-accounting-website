@using Fanex.ExternalAccount.Utilities
@using Fanex.ExternalAccount.DTO.Customer
@model Customer

<link href="@Url.Content("~/Scripts/Combobox/Combobox.css")" rel="stylesheet" type="text/css" />
<div>
    <table width="100%" border="0" cellpadding="2">
        <tr>
            <td style="text-align: right">
                @Html.HiddenFor(m => m.CustId) @Html.LabelFor(m => m.FirstName, ViewLang.Firstname, new { @class = "divMargin" })
            </td>
            <td>
                @Html.TextBoxFor(m => m.FirstName, new { @class = "editControl" })
            </td>
            <td style="text-align: right">
                @Html.LabelFor(m => m.LastName, ViewLang.Lastname, new { @class = "divMargin" })
            </td>
            <td>
                @Html.TextBoxFor(m => m.LastName, new { @class = "editControl" })
            </td>
        </tr>
        <tr>
            <td style="text-align: right">
                @Html.LabelFor(m => m.HomePhone, ViewLang.Phone, new { @class = "divMargin" })
            </td>
            <td>
                @Html.TextBoxFor(m => m.HomePhone, new { @class = "editControl" })
            </td>
            <td style="text-align: right">
                @Html.LabelFor(m => m.MobilePhone, ViewLang.MobilePhone, new { @class = "divMargin" })
            </td>
            <td>
                @Html.TextBoxFor(m => m.MobilePhone, new { @class = "editControl" })
            </td>
        </tr>
        <tr>
            <td style="text-align: right">
                @Html.LabelFor(m => m.Email, ViewLang.Email, new { @class = "divMargin" })
            </td>
            <td>
                @Html.TextBoxFor(m => m.Email, new { @class = "editControl" })
            </td>
            <td style="text-align: right">
                @Html.LabelFor(m => m.Fax, ViewLang.Fax, new { @class = "divMargin" })
            </td>
            <td>
                @Html.TextBoxFor(m => m.Fax, new { @class = "editControl" })
            </td>
        </tr>
        <tr>
            <td colspan="4">
                <div style="float: right;">
                    <input class="buttonPopup" type="button" value="Reset" onclick="Fanex.ExtAcc.User.Edit()" />
                </div>
                <div style="float: right; padding-right: 10px;">
                    <input class="buttonPopup" type="button" value="Update" onclick="Fanex.ExtAcc.Customer.EditInfo()" />
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="4">
                <div id="errMsg" style="display: none;" class="errMsg">
                </div>
            </td>
        </tr>
    </table>
</div>
<script src="@Url.Content("~/Scripts/Combobox/Combobox.js")" type="text/javascript"></script>
<script type="text/javascript">


</script>