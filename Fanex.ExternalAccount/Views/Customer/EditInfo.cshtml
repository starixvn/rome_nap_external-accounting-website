@using Fanex.ExternalAccount.Utilities
@using Fanex.ExternalAccount.DTO.Customer
@model Customer

<form class="form-add">
    <div id="errMsg" class="successMsg hide"> </div>
    <div class="group">
        <div class="pull-left width-100 text-right">
            @Html.HiddenFor(m => m.CustId) @Html.LabelFor(m => m.FirstName, ViewLang.Firstname, new { @class = "label" })
        </div>
        <div class="pull-left width-250">
            @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control width-320" })
        </div>
    </div>
    <div class="group">
        <div class="pull-left width-100 text-right">
            @Html.LabelFor(m => m.LastName, ViewLang.Lastname, new { @class = "label" })
        </div>
        <div class="pull-left width-250">
            @Html.TextBoxFor(m => m.LastName, new { @class = "form-control width-320" })
        </div>
    </div>
    <div class="group">
        <div class="pull-left width-100 text-right">
            @Html.LabelFor(m => m.HomePhone, ViewLang.Phone, new { @class = "label" })
        </div>
        <div class="pull-left width-250">
            @Html.TextBoxFor(m => m.HomePhone, new { @class = "form-control width-320" })
        </div>
    </div>
    <div class="group">
        <div class="pull-left width-100 text-right">
            @Html.LabelFor(m => m.MobilePhone, ViewLang.MobilePhone, new { @class = "label" })
        </div>
        <div class="pull-left width-250">
            @Html.TextBoxFor(m => m.MobilePhone, new { @class = "form-control width-320" })
        </div>
    </div>
    <div class="group">
        <div class="pull-left width-100 text-right">
            @Html.LabelFor(m => m.Email, ViewLang.Email, new { @class = "label" })
        </div>
        <div class="pull-left width-250">
            @Html.TextBoxFor(m => m.Email, new { @class = "form-control width-320" })
        </div>
    </div>
    <div class="group">
        <div class="pull-left width-100 text-right">
            @Html.LabelFor(m => m.Fax, ViewLang.Fax, new { @class = "label" })
        </div>
        <div class="pull-left width-250">
            @Html.TextBoxFor(m => m.Fax, new { @class = "form-control width-320" })
        </div>
    </div>
    <div class="group">
        <div class="pull-left width-100 text-right">
            @Html.LabelFor(m => m.Remark, ViewLang.Remark, new { @class = "label" })
        </div>
        <div class="pull-left width-320">
            @Html.TextAreaFor(m => m.Remark, new { @class = "form-control width-320 textarea", @maxlength = "300" })
        </div>
    </div>
    <div class="group form-action">
        <input class="btn -submit buttonPopup" type="button" value="Reset" onclick="Fanex.ExtAcc.Customer.ResetInfo()" />
        <input class="btn -submit buttonPopup" type="button" value="Update" onclick="Fanex.ExtAcc.Customer.EditInfo()" />
    </div>
    @Html.AntiForgeryToken()
</form>

<script type="text/javascript">
    Fanex.ExtAcc.Customer.FirstName = $('#FirstName').val();
    Fanex.ExtAcc.Customer.LastName = $('#LastName').val();
    Fanex.ExtAcc.Customer.HomePhone = $('#HomePhone').val();
    Fanex.ExtAcc.Customer.MobilePhone = $('#MobilePhone').val();
    Fanex.ExtAcc.Customer.Email = $('#Email').val();
    Fanex.ExtAcc.Customer.Fax = $('#Fax').val();
</script>
