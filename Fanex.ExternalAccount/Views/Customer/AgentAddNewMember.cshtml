@using Fanex.ExternalAccount.Utilities
@using Fanex.PTEngine
@using Fanex.ExternalAccount.Core.Context
@model bool
@{
    var parentUsername = Request["username"] ?? Request["groupname"];
    var session = CurrentSession.Instance;
}
<link href="@HttpContext.Current.GetWebResourceUrl("Fanex.PTEngine.UI.Core.css")" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/assets/styles/pages/customer/pt-engine.css")" rel="stylesheet" type="text/css" />
@if (Model)
{
    <div class="errMsg">There is no information available</div>
}
else
{
    <div class="page-title">
        <div class="wlDetail">
            Add New Member
        </div>
    </div>
    <div id="mainGrid" style="margin: 0px 3px; visibility: visible; width: 841px">
        <div id="errMsg" style="display: none; width: 811px" class="successMsg">
        </div>
        <div class="blockBtn">
            <input id="btnSubmit" class="btn -submit buttonPopup btnTop" type="button" value="Submit" data-bind='click: saveCustomer' />
        </div>
        <div class="noteMsg">
            @Resources.Lang.NoteSportsbookSetting
        </div>
        <div class="noteMsg">
            @(session.IsBelongToSpecialGroups ? Resources.Lang.MemberUnlimitedBetSettingWarningMessageDirectionV3 : Resources.Lang.MemberUnlimitedBetSettingWarningMessage)
        </div>
        <div class="customerInfo clear">
            <div class="headerTab">
                @ViewLang.generalInformation
            </div>
            <div class="clear">
                <div class="customerInfoBlock1 bdt0">
                    @ViewLang.Username
                </div>
                <div class="customerInfoBlock2 bdt0">
                    <b><span data-bind="text: customer.userName"></span></b>
                    <select id="selectedOne" name="selectedOne"></select>
                    <select id="selectedTwo" name="selectedTwo"></select>
                    <select id="selectedThree" name="selectedThree"></select>
                    <span id="msgIcon"></span>
                </div>
                <div class="customerInfoBlock3 bdt0">
                    @ViewLang.Password
                </div>
                <div class="customerInfoBlock4 bdt0" id="divPassword">
                    <div class="float_l">
                        <input id="password" autocomplete="off" class="textBoxInfo" type="password" data-bind="value: customer.password"
                               onkeyup="return Fanex.Customer.CheckPassword(this, 'spnNewPwdIcon', true);" maxlength="50" />
                    </div>
                    <div class="float_l pt3">
                        <span id="spnNewPwdIcon">&nbsp;</span>
                    </div>
                </div>
            </div>
            <div class="clear">
                <div class="customerInfoBlock1">
                    @ViewLang.Firstname
                </div>
                <div class="customerInfoBlock2">
                    <input id="firstName" type="text" class="textBoxInfo" data-bind="value: customer.firstName"
                           maxlength="50" />
                </div>
                <div class="customerInfoBlock3">
                    @ViewLang.Lastname
                </div>
                <div class="customerInfoBlock4">
                    <input id="lastName" type="text" class="textBoxInfo" data-bind="value: customer.lastName"
                           maxlength="50" />
                </div>
            </div>
            <div class="clear">
                <div class="customerInfoBlock1">
                    @ViewLang.Phone
                </div>
                <div class="customerInfoBlock2">
                    <input id="phone" type="text" class="textBoxInfo" data-bind="value: customer.phone"
                           maxlength="50" />
                </div>
                <div class="customerInfoBlock3">
                    @ViewLang.MobilePhone
                </div>
                <div class="customerInfoBlock4">
                    <input id="mobilePhone" type="text" class="textBoxInfo" data-bind="value: customer.mobilePhone"
                           maxlength="50" />
                </div>
            </div>
            <div class="clear">
                <div class="customerInfoBlock1">
                    @ViewLang.givencredit
                </div>
                <div class="customerInfoBlock2">
                    <input type="text" id="credit" onpaste="return false;" onkeypress="return Fanex.ExtAcc.CheckNumber(event, this, true)" onkeyup="return Fanex.ExtAcc.CheckNumber(event, this, true)" maxlength="14" class="textBoxCredit textBoxInfo" data-bind="value: Fanex.ExtAcc.FormatNumber(customer.credit), enable: isUpdateCredit == 1, attr: { title: isUpdateCredit == 1 ? '' : 'You are not authorized on this function'}" />
                    <span class="hide">&gt;=<span data-bind="text: customer.minCredit" id="minCredit"></span></span>
                    <= <span data-bind="text: Fanex.ExtAcc.FormatNumber(customer.agentMaxCreditTemp)" id="maxCredit"></span>
                </div>
                <div class="customerInfoBlock3">
                    @ViewLang.Fax
                </div>
                <div class="customerInfoBlock4">
                    <input id="fax" type="text" class="textBoxInfo" data-bind="value: customer.fax" maxlength="50" />
                </div>
            </div>
            <div class="clear">
                <div class="customerInfoBlock1">
                    @ViewLang.Group
                </div>
                <div class="customerInfoBlock2">
                    <select id="group" name="group"></select>
                    <span data-bind="text: customer.group"></span>
                </div>
                <div class="customerInfoBlock3">
                    <label for="closed" style="display: none;">
                        @ViewLang.Closed
                    </label>
                </div>
                <div class="customerInfoBlock4">
                    <input style="display: none;" name="closed" id="closed" type="checkbox" data-bind="checked: customer.statusSetting.closed, enable: (customer.statusSetting.uplineClosed || hasClose == 0) ? false : true, attr: { title: hasClose == 1 ? '' : 'You are not authorized on this function'}" />
                </div>
            </div>
        </div>
        <div id="commissionHeader" class="headerPositionTaking" style="padding: 0; float: left; width: 842px; border-bottom: 0; border-top: 1px solid #ccc">
            Commission
        </div>
        <div class="positionTaking" style="padding: 0; float: left; width: 841px">
            <div style="margin: 0px">
                @Html.Action("EditCommissionMember", "SportsbookSetting")
            </div>
        </div>
        <div class="clear">
        </div>
        <br />
        <div class="headerBetSetting">
            @ViewLang.BetSetting
        </div>
        <div id="bettingLimitContainer">
        </div>
        <br />
        <div class="headerPositionTaking PTHeader">@ViewLang.PositionTaking</div>
        <div class="positionTaking widthPTC">
            <div id="ptContainer">
            </div>
        </div>
        <div class="blockBtn">
            <input id="btnSubmitFooter" class="btn -submit buttonPopup btnTop" type="button" value="Submit" data-bind='click: saveCustomer' />
        </div>
        <input type="hidden" id="parentId" value="@Request["custId"]" />
        <input type="hidden" id="parentUsername" value="@parentUsername" />
        <input type="hidden" id="parentCurrencyId" value="@Request["currencyId"]" />
        <input type="hidden" id="PT3DecimalSites" value="@AppSettings.PT3DecimalSites" />
        @Html.AntiForgeryToken()
    </div>
    <script type="text/javascript">
        var custid = @Request["custId"];
    </script>
    <script src="@HttpContext.Current.GetWebResourceUrl("Fanex.PTEngine.UI.Languages.en.js")" type="text/javascript"></script>
    <script src="@HttpContext.Current.GetWebResourceUrl("Fanex.PTEngine.UI.Core.js")" type="text/javascript"></script>
    <script src="@HttpContext.Current.GetWebResourceUrl("Fanex.PTEngine.UI.knockout-2.0.0.js")" type="text/javascript"></script>
    <script src="@HttpContext.Current.GetWebResourceUrl("Fanex.PTEngine.UI.BetTypeGroup.js")" type="text/javascript"></script>
    <script src="@HttpContext.Current.GetWebResourceUrl("Fanex.PTEngine.UI.BetType.js")" type="text/javascript"></script>
    <script src="@HttpContext.Current.GetWebResourceUrl("Fanex.PTEngine.UI.BettingLimit.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Scripts/Customer/Fanex.ExtAcc.Customer.MemberInfo.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Scripts/Customer/Fanex.ExtAcc.Customer.AgentAddNewMember.js")" type="text/javascript"></script>

}