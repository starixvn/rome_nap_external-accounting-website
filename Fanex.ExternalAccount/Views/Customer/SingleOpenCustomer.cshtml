@using Fanex.ExternalAccount.ViewModel.Customer.OpenCustomer

@model SingleOpenCustomerViewModel

@{
    var listAffectedDownlines = Model.AffectedDownlines();
}

<div id="tab-main">
    <div id="successMsg" class="ui-helper-hidden successMsg"></div>
    <div id="errMsg" class="ui-helper-hidden errMsg"></div>
    <span id="main-header-title">@string.Format(Resources.Lang.OpenedMainTitle, Model.UserName)</span>
    <div class="float_r"><span id="information-box" class="ml10 icon-alert-circle-outline"></span></div>
    <table class="table w100" cellpadding="2" cellspacing="0" border="1">
        <thead>
            <tr>
                <th>Level</th>
                <th>Affected Downlines</th>
                <th>Remain Unchanges Downlines</th>
            </tr>
        </thead>
        <tbody>
            @if (listAffectedDownlines == null || listAffectedDownlines.Count == 0)
            {
                <tr>
                    <td colspan="3" class="red align-center">@Resources.Lang.thereisnodata</td>
                </tr>
            }
            else
            {
                foreach (var row in listAffectedDownlines)
                {
                    <tr>
                        <td>@row.LevelName</td>
                        <td class="text-right">
                            <span class="@(row.AffectedDownlines > 0 ? " dlLink" : string.Empty)"
                                  onclick="@(row.AffectedDownlines > 0
                        ? (" return Fanex.ExtAcc.Customer.ClosedStatus.GetDownlinesDetailInfo(" + Model.CustId + ", '" + Model.UserName +"', true, " + @row.Level + " , 50, 0);")
                        : string.Empty)">
                                @row.AffectedDownlines
                            </span>
                        </td>
                        <td class="text-right">
                            <span class="@(row.RemainUnchangedDownlines > 0 ? " dlLink" : string.Empty)"
                                  onclick="@(row.RemainUnchangedDownlines > 0
                        ? (" return Fanex.ExtAcc.Customer.ClosedStatus.GetDownlinesDetailInfo(" + Model.CustId + ", '" + Model.UserName +"', false, " + @row.Level + " , 50, 0);")
                        : string.Empty)">
                                @row.RemainUnchangedDownlines
                            </span>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
    <input id="custId" type="hidden" value="@Model.CustId" />
    <div class="text-right  pt3">
        <input id="btnOpen" type="button" class="btn -list" value="Open" />
    </div>
    @Html.AntiForgeryToken()
</div>
<div id="tab-detail" class="ui-helper-hidden">
    <span id="detail-header-title"></span>
    <div style="clear:both;"></div>
    <div id="gridContainer" class="grid-container">
        <div id="gridId" class="freegrid"></div>
    </div>
    <div style="margin-top: 30px; text-align: right">
        <input id="btnBack" type="button" class="btn -list" value="Back" />
    </div>
</div>