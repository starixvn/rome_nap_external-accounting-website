@model HomeViewModel

@{
    ViewBag.Title = "Home Page";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@StaticResources.RenderScripts("~/assets/bundles/home/home")

<script type="text/javascript">
    $(document).ready(function () {
         if ("@Json.Encode(Model.EnabledOTP)") {
             localStorage.setItem("@(Model.Username + "_pt")", "@(Model.Username + "_pt")".ec("@Model.Code").hc());
             localStorage.setItem("@(Model.Username + "_cd")", "@(Model.Code)");
        }
    });
</script>