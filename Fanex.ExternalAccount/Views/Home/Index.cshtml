@model HomeViewModel

@{
    ViewBag.Title = "Home Page";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@StaticResources.RenderScripts("~/assets/bundles/home/home")

<script type="text/javascript">
    $(document).ready(function () {
        if (JSON.parse("@Model.EnabledOTP.ToString().ToLower()")) {
            localStorage.setItem("@(Model.Username + "_pt")", "@String.Format(OTP.OTPQuote, Model.Username, Model.ModifiedDate)".encrypt("@Model.Code"));
            localStorage.setItem("@(Model.Username + "_cd")", "@(Model.Code)");
            localStorage.setItem("@(Model.Username + "_md")", "@(Model.ModifiedDate)");
        }
    });

    var LanguageResources = {
        UpdateSuspendSuccess: '@Resources.Lang.UpdateSuspendSuccess',
        SuspendInfoMessage: '@Html.Raw(Resources.Lang.SuspendInfoMessage)',
        UnsuspendSingleConfirmMesssage: '@Resources.Lang.UnsuspendSingleConfirmMesssage',
        UnsuspendMultipleConfirmMessage: '@Resources.Lang.UnsuspendMultipleConfirmMessage',
        SuspendMultipleConfirmMessage: '@Resources.Lang.SuspendMultipleConfirmMessage',
        UnsuspendedTitleAffectedDownlines: '@Resources.Lang.UnsuspendedTitleAffectedDownlines',
        UnsuspendedTitleRemainUnchangedDownlines: '@Resources.Lang.UnsuspendedTitleRemainUnchangedDownlines',
        UpdateCloseSuccess: '@Resources.Lang.UpdateCloseSuccess',
        OpenInfoMessage: '@Html.Raw(Resources.Lang.OpenInfoMessage)',
        OpenSingleConfirmMesssage: '@Resources.Lang.OpenSingleConfirmMesssage',
        OpenMultipleSMAConfirmMessage: '@Resources.Lang.OpenMultipleSMAConfirmMessage',
        OpenMultipleConfirmMessage: '@Resources.Lang.OpenMultipleConfirmMessage',
        CloseMultipleConfirmMessage: '@Resources.Lang.CloseMultipleConfirmMessage',
        OpenedAffectedDownlinesTitle: '@Resources.Lang.OpenedAffectedDownlinesTitle',
        OpenedRemainUnchangedDownlinesTitle: '@Resources.Lang.OpenedRemainUnchangedDownlinesTitle',
        ProceedConfirmMessage: '@Resources.Lang.ProceedConfirmMessage'
    };
</script>