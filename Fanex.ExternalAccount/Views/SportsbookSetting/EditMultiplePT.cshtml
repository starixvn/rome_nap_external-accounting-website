@using Fanex.PTEngine
<link href="@HttpContext.Current.GetWebResourceUrl("Fanex.PTEngine.UI.Core.css")" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/Content/Customer/PTEngine.css")" rel="stylesheet" type="text/css" />
<div style="width: 852px; margin: 2px 0 0 2px">
<div id="errMsg" style="display: none;" class="successMsg">
</div>
<div id="arrowUpDown" class="collapse">
</div>
<div id="names" style="display: none;" class="names">
</div>
<div class="floatR">
    <input id="buttonPopup" class="buttonPopup btnTop" type="button" value="Submit" data-bind='click: saveCustomer' />
</div>
<div id="custInfo" class="customerInfo">
    <div class="headerTab" style="border-bottom: 0px">
        General Information</div>
    <div>
        <div class="customerInfoBlock1">
            First Name</div>
        <div class="customerInfoBlock2">
            <input id="firstName" type="text" class="textBoxInfo" data-bind="value: Fanex.decodeHtml(Fanex.ExtAcc.Customer.PTSetting.customer.firstName)" maxlength="50" /></div>
        <div class="customerInfoBlock3">
            Last Name</div>
        <div class="customerInfoBlock4" style="width: 210px">
            <input id="lastName" type="text" class="textBoxInfo" data-bind="value: Fanex.decodeHtml(Fanex.ExtAcc.Customer.PTSetting.customer.lastName)" maxlength="50" /></div>
    </div>
    <div>
        <div class="customerInfoBlock1">
            Phone</div>
        <div class="customerInfoBlock2">
            <input id="phone" type="text" class="textBoxInfo" data-bind="value: Fanex.decodeHtml(Fanex.ExtAcc.Customer.PTSetting.customer.phone)" maxlength="50" /></div>
        <div class="customerInfoBlock3">
            Mobile Phone</div>
        <div class="customerInfoBlock4" style="width: 210px">
            <input id="mobilePhone" type="text" class="textBoxInfo" data-bind="value: Fanex.decodeHtml(Fanex.ExtAcc.Customer.PTSetting.customer.mobilePhone)" maxlength="50" /></div>
    </div>
    <div id="superSection">
        <div class="customerInfoBlock1">
            Max Credit</div>
        <div class="customerInfoBlock2">
            <input onpaste="return false;" onkeypress="return Fanex.ExtAcc.CheckNumber(event, this, true)" onkeyup="return Fanex.ExtAcc.CheckNumber(event, this, true)" type="text" id="credit" maxlength="14" class="textBoxCredit textBoxInfo" data-bind="value: Fanex.ExtAcc.FormatNumber(Fanex.ExtAcc.Customer.PTSetting.customer.credit), enable: isUpdateCredit == 1, attr: { title: isUpdateCredit == 1 ? '' : 'You are not authorized on this function'}" />
            <span id="minCreditId">&gt;=<span data-bind="text: Fanex.ExtAcc.FormatNumber(Fanex.ExtAcc.Customer.PTSetting.customer.minCredit)" id="minCredit" /></span>
        </div>
        <div class="customerInfoBlock3">
            Fax</div>
        <div class="customerInfoBlock4" style="width: 210px">
            <input id="fax" type="text" class="textBoxInfo" data-bind="value: Fanex.decodeHtml(Fanex.ExtAcc.Customer.PTSetting.customer.fax)" maxlength="50" /></div>
    </div>
    <div id="masterSection">
        <div class="customerInfoBlock1">
            Master Max Credit</div>
        <div class="customerInfoBlock2">
            <input onpaste="return false;" onkeypress="return Fanex.ExtAcc.CheckNumber(event, this, true)" onkeyup="return Fanex.ExtAcc.CheckNumber(event, this, true)" type="text" id="credit" maxlength="14" class="textBoxCredit textBoxInfo" data-bind="value: Fanex.ExtAcc.FormatNumber(Fanex.ExtAcc.Customer.PTSetting.customer.credit), enable: isUpdateCredit == 1, attr: { title: isUpdateCredit == 1 ? '' : 'You are not authorized on this function'}" />
            <span id="minCreditId">&gt;=<span data-bind="text: Fanex.ExtAcc.FormatNumber(Fanex.ExtAcc.Customer.PTSetting.customer.minCredit)" id="minCredit" /></span>&nbsp;and&nbsp;</span> &lt;= <span data-bind="text: Fanex.ExtAcc.FormatNumber(Fanex.ExtAcc.Customer.PTSetting.customer.maxCredit)" id="maxCredit"></span>
        </div>
        <div class="customerInfoBlock3">
            Fax</div>
        <div class="customerInfoBlock4" style="width: 210px">
            <input id="fax" type="text" class="textBoxInfo" data-bind="value: Fanex.decodeHtml(Fanex.ExtAcc.Customer.PTSetting.customer.fax)" maxlength="50" /></div>
    </div>
    <div id="masterStatus">
        <div id="closedId">
            <div class="customerInfoBlock1">
                <label for="closed">
                    Closed</label>
            </div>
            <div class="customerInfoBlock2">
                <input name="closed" id="closed" type="checkbox" data-bind="checked: Fanex.ExtAcc.Customer.PTSetting.customer.statusSetting.closed, enable: hasClose == 1, attr: { title: hasClose == 1 ? '' : 'You are not authorized on this function'}" />
            </div>
        </div>
        <div class="customerInfoBlock3">
            <label for="suspended">
                Suspended</label>
        </div>
        <div class="customerInfoBlock4" style="width: 210px">
            <input name="suspended" id="suspended" type="checkbox" data-bind="checked: Fanex.ExtAcc.Customer.PTSetting.customer.statusSetting.suspended, enable: Fanex.ExtAcc.Customer.PTSetting.context.targetCustId &gt; 0 && hasSuspend == 1 ? true : false, attr: { title: hasSuspend == 1 ? '' : 'You are not authorized on this function'}" /></div>
    </div>
    <div id="agentSection">
        <div class="customerInfoBlock1">
            Agent Max Credit</div>
        <div class="customerInfoBlock2">
            <input type="text" id="credit" onpaste="return false;" onkeypress="return Fanex.ExtAcc.CheckNumber(event, this, true, this)" onkeyup="return Fanex.ExtAcc.CheckNumber(event, this, true, this)" maxlength="14" class="textBoxCredit textBoxInfo" data-bind="value: Fanex.ExtAcc.FormatNumber(Fanex.ExtAcc.Customer.PTSetting.customer.credit), enable: isUpdateCredit == 1, attr: { title: isUpdateCredit == 1 ? '' : 'You are not authorized on this function'}" />
            <span id="minCreditId">&gt;=<span data-bind="text: Fanex.ExtAcc.FormatNumber(Fanex.ExtAcc.Customer.PTSetting.customer.minCredit)" id="minCredit" /></span>&nbsp;and&nbsp;</span> &lt;= <span data-bind="text: Fanex.ExtAcc.FormatNumber(Fanex.ExtAcc.Customer.PTSetting.customer.maxCredit)" id="maxCredit"></span>
        </div>
        <div class="customerInfoBlock3">
            Fax</div>
        <div class="customerInfoBlock4" style="width: 210px">
            <input id="fax" type="text" class="textBoxInfo" data-bind="value: Fanex.ExtAcc.Customer.PTSetting.customer.fax" maxlength="50" /></div>
    </div>
    <div id="agentSection2">
        <div class="customerInfoBlock1">
            Member Max Credit</div>
        <div class="customerInfoBlock2">
            <input onpaste="return false;" onkeypress="return Fanex.ExtAcc.CheckNumber(event, this, true)" onkeyup="return Fanex.ExtAcc.CheckNumber(event, this, true)" type="text" id="memberCredit" maxlength="14" class="textBoxCredit textBoxInfo" data-bind="value: Fanex.ExtAcc.FormatNumber(Fanex.ExtAcc.Customer.PTSetting.customer.memberMaxCredit), enable: isUpdateCredit == 1, attr: { title: isUpdateCredit == 1 ? '' : 'You are not authorized on this function'}" />
            <span id="minCreditId">&gt;=<span data-bind="text: Fanex.ExtAcc.FormatNumber(Fanex.ExtAcc.Customer.PTSetting.customer.memberMinCredit)" id="minCreditMember" /></span>&nbsp;and&nbsp;</span> &lt;= <span data-bind="text: Fanex.ExtAcc.FormatNumber(Fanex.ExtAcc.Customer.PTSetting.customer.credit)" id="maxCreditMember"></span>
        </div>
        <div class="customerInfoBlock3">
            <label for="suspended">
                Suspended</label>
        </div>
        <div class="customerInfoBlock4" style="width: 210px">
            <input name="suspended" id="suspended" type="checkbox" data-bind="checked: Fanex.ExtAcc.Customer.PTSetting.customer.statusSetting.suspended, enable: Fanex.ExtAcc.Customer.PTSetting.context.targetCustId &gt; 0 && hasSuspend == 1 ? true : false, attr: { title: hasSuspend == 1 ? '' : 'You are not authorized on this function'}" /></div>
    </div>
    <div id="agentSection3">
        <div class="customerInfoBlock1">
        </div>
        <div class="customerInfoBlock2">
        </div>
        <div class="customerInfoBlock3">
            <label for="closed">
                Closed</label>
        </div>
        <div class="customerInfoBlock4" style="width: 210px">
            <input name="closed" id="closed" type="checkbox" data-bind="checked: Fanex.ExtAcc.Customer.PTSetting.customer.statusSetting.closed, enable: hasClose == 1, attr: { title: hasClose == 1 ? '' : 'You are not authorized on this function'}" />
        </div>
    </div>
    <div id="memberSection">
        <div class="customerInfoBlock1">
            Given Credit</div>
        <div class="customerInfoBlock2">
            <input onpaste="return false;" onkeypress="return Fanex.ExtAcc.CheckNumber(event, this, true)" onkeyup="return Fanex.ExtAcc.CheckNumber(event, this, true)" type="text" id="credit" maxlength="14" class="textBoxCredit textBoxInfo" data-bind="value: Fanex.ExtAcc.FormatNumber(Fanex.ExtAcc.Customer.PTSetting.customer.credit), enable: isUpdateCredit == 1, attr: { title: isUpdateCredit == 1 ? '' : 'You are not authorized on this function'}" />
            <span id="minCreditId" class="hide">&gt;=<span data-bind="text: Fanex.ExtAcc.FormatNumber(Fanex.ExtAcc.Customer.PTSetting.customer.minCredit)" id="minCredit" /></span>&lt;= <span data-bind="text: Fanex.ExtAcc.FormatNumber(Fanex.ExtAcc.Customer.PTSetting.customer.maxCredit)" id="maxCredit"></span>
        </div>
        <div class="customerInfoBlock3">
            Fax</div>
        <div class="customerInfoBlock4" style="width: 210px">
            <input id="fax" type="text" class="textBoxInfo" data-bind="value: Fanex.ExtAcc.Customer.PTSetting.customer.fax" maxlength="50" /></div>
    </div>
    <div id="memberSection2">
        <div class="customerInfoBlock1">
            Group</div>
        <div class="customerInfoBlock2">
            <span data-bind="text: Fanex.ExtAcc.Customer.PTSetting.customer.group"></span>
        </div>
        <div class="customerInfoBlock3">
            <label for="closed">
                Closed</label>
        </div>
        <div class="customerInfoBlock4" style="width: 210px">
            <input name="closed" id="closed" type="checkbox" data-bind="checked: Fanex.ExtAcc.Customer.PTSetting.customer.statusSetting.closed, enable: hasClose == 1, attr: { title: hasClose == 1 ? '' : 'You are not authorized on this function'}" />
        </div>
    </div>
    <div id="memberSection3">
        <div class="customerInfoBlock1">
        </div>
        <div class="customerInfoBlock2">
        </div>
        <div class="customerInfoBlock3">
            <label for="suspended">
                Suspended</label>
        </div>
        <div class="customerInfoBlock4" style="width: 210px">
            <input name="suspended" id="suspended" type="checkbox" data-bind="checked: Fanex.ExtAcc.Customer.PTSetting.customer.statusSetting.suspended, enable: Fanex.ExtAcc.Customer.PTSetting.context.targetCustId &gt; 0 && hasSuspend == 1 ? true : false, attr: { title: hasSuspend == 1 ? '' : 'You are not authorized on this function'}" /></div>
    </div>
</div>
<div id="statusHeader" class="headerPositionTaking" style="border-top: 1px solid #CCC">
    Status</div>
<div id="statusSection" class="positionTaking" style="padding: 0; border-bottom: 0">
    <table cellpadding="0" cellspacing="0" border="0" width="100%" style="border-color: #CCC; border-collapse: collapse">
        <tr style="height: 22px">
            <td class="groupCom" style="width: 50%; border-right: 1px solid #ccc;">
                <div>
                    <label for="closed">
                        Closed</label></div>
            </td>
            <td>
                <div>
                    <input name="closed" id="closed" type="checkbox" data-bind="checked: Fanex.ExtAcc.Customer.PTSetting.customer.statusSetting.closed, enable: hasClose == 1, attr: { title: hasClose == 1 ? '' : 'You are not authorized on this function'}" /></div>
            </td>
        </tr>
    </table>
</div>
<div id="commissionHeader" class="headerPositionTaking" style="padding: 0; float: left; width: 850px; border-bottom: 0; border-top: 1px solid #ccc">
    Commission</div>
<div class="positionTaking" style="padding: 0; float: left; width: 850px">
    <table id="tblMasterAgent" width="100%" border="0" cellpadding="0">
        <tr>
            <td>
                <div class="commission" style="border-left: 0; border-bottom: 0">
                    <div class="pt3 pb3">
                        <table cellpadding="0" cellspacing="0" border="0" width="100%">
                            <tr>
                                <td class="groupCom">
                                    Group A
                                </td>
                                <td class="widthGroup">
                                    <select id="groupA" name="groupA" class="widthGroup">
                                    </select>
                                </td>
                                <td class="groupCom">
                                    Group B
                                </td>
                                <td class="widthGroup">
                                    <select id="groupB" class="widthGroup">
                                    </select>
                                </td>
                                <td class="groupCom">
                                    Group C
                                </td>
                                <td class="widthGroup">
                                    <select id="groupC" class="widthGroup">
                                    </select>
                                </td>
                                <td class="groupCom">
                                    Group D
                                </td>
                                <td class="widthGroup">
                                    <select id="groupD" class="widthGroup">
                                    </select>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="8" height="5">
                                </td>
                            </tr>
                            <tr>
                                <td colspan="8" class="line">
                                </td>
                            </tr>
                            <tr>
                                <td colspan="8" height="5">
                                </td>
                            </tr>
                            <tr>
                                <td class="groupCom">
                                    1x2 Comm
                                </td>
                                <td>
                                    <select id="discount1x2" class="widthGroup">
                                    </select>
                                </td>
                                <td class="groupCom">
                                    Others Comm
                                </td>
                                <td>
                                    <select id="discountCS" class="widthGroup">
                                    </select>
                                </td>
                                <td class="groupCom" style="width: 120px">
                                    Number Game Comm
                                </td>
                                <td>
                                    <select id="discountNumber" class="widthGroup">
                                    </select>
                                </td>
                                <td class="groupCom">
                                    @Fanex.ExternalAccount.Utilities.ViewLang.HRFixedOdds
                                </td>
                                <td>
                                    <select id="discountHRFixedOdds" class="widthGroup">
                                    </select>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
                <div id="commissionContainer">
                </div>
            </td>
        </tr>
    </table>
    <table id="tblMember" width="100%" border="0" cellpadding="2">
        <tr>
            <td>
                <div class="commission">
                    <div>
                        <div class="commissionBlock1 commissionHeader">
                            &nbsp;
                        </div>
                        <div class="commissionBlock2 commissionHeader">
                            Comm for Agent
                        </div>
                        <div class="commissionBlock2 commissionHeader">
                            Comm for Member
                        </div>
                    </div>
                    <div class="clearBlock">
                        <div class="commissionBlock1">
                            Asian HDP, OU, OE
                        </div>
                        <div class="commissionBlock2">
                            <input type="text" id="textBoxDiscountAsian" name="textBoxDiscountAsian" class="textBoxComm" disabled="true" />
                        </div>
                        <div class="commissionBlock2">
                            <select id="discountAsian" name="discountAsian" class="widthGroup">
                            </select>
                        </div>
                    </div>
                    <div class="clearBlock">
                        <div class="commissionBlock1">
                            1 X 2
                        </div>
                        <div class="commissionBlock2">
                            <input type="text" id="textBoxDiscount1x2" class="textBoxComm" disabled="true" />
                        </div>
                        <div class="commissionBlock2">
                            <select id="discount1x2" name="discount1x2" class="widthGroup">
                            </select>
                        </div>
                    </div>
                    <div class="clearBlock">
                        <div class="commissionBlock1">
                            Other Bettypes
                        </div>
                        <div class="commissionBlock2">
                            <input type="text" id="textBoxDiscountCS" class="textBoxComm" disabled="true" />
                        </div>
                        <div class="commissionBlock2">
                            <select id="discountCS" name="discountCS" class="widthGroup">
                            </select>
                        </div>
                    </div>
                    <div class="clearBlock">
                        <div class="commissionBlock1">
                            Game Comm
                        </div>
                        <div class="commissionBlock2">
                            <input type="text" id="textBoxDiscountNumber" class="textBoxComm" disabled="true" />
                        </div>
                        <div class="commissionBlock2">
                            <select id="discountNumber" name="discountNumber" class="widthGroup">
                            </select>
                        </div>
                    </div>
                    <div class="clearBlock">
                        <div class="commissionBlock1">
                            HR Fixed Odds
                        </div>
                        <div class="commissionBlock2">
                            <input type="text" id="textBoxDiscountHRFixedOdds" class="textBoxComm" disabled="true" />
                        </div>
                        <div class="commissionBlock2">
                            <select id="discountHRFixedOdds" name="discountNumber" class="widthGroup">
                            </select>
                        </div>
                    </div>
                </div>
                <div id="commissionContainer">
                </div>
            </td>
        </tr>
    </table>
</div>
<div class="headerPositionTaking">
    Bet Setting</div>
<div class="positionTaking">
    <div id="betSetting">
    </div>
</div>
<div class="headerPositionTaking">
    Postition Taking</div>
<div class="positionTaking">
    <div id="ptContainer">
    </div>
</div>
<div class="floatR">
    <input id="buttonPopup2" class="buttonPopup" type="button" value="Submit" data-bind='click: saveCustomer' />
</div>
</div>
<script src="@HttpContext.Current.GetWebResourceUrl("Fanex.PTEngine.UI.Languages.en.js")" type="text/javascript"></script>
<script src="@HttpContext.Current.GetWebResourceUrl("Fanex.PTEngine.UI.Core.js")" type="text/javascript"></script>
<script src="@HttpContext.Current.GetWebResourceUrl("Fanex.PTEngine.UI.BetTypeGroup.js")" type="text/javascript"></script>
<script src="@HttpContext.Current.GetWebResourceUrl("Fanex.PTEngine.UI.BetType.js")" type="text/javascript"></script>
<script src="@HttpContext.Current.GetWebResourceUrl("Fanex.PTEngine.UI.BettingLimit.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Scripts/Customer/Fanex.ExtAcc.Customer.MemberInfo.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Scripts/Customer/Fanex.ExtAcc.Customer.PTSetting.js")" type="text/javascript"></script>
<script type="text/javascript">
    $(document).ready(function () {
        if (Fanex.ExtAcc.Customer.CurrentLevel == 1) {
            $('#tblMasterAgent').remove();
        }
        else {
            $('#tblMember').remove();
        }
    });
</script>