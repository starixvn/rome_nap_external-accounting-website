@using Fanex.ExternalAccount.Utilities
@using Fanex.PTEngine
@using Fanex.ExternalAccount.Core.Context
@{
    var roleId = Utils.ToInt32(Request["roleId"]);
    var actionName = roleId.IsNotMember() ? "EditCommission" : "EditCommissionMember";
    var session = CurrentSession.Instance;
}
<link href="@Url.Content("~/assets/styles/pages/customer/pt-engine.css")" rel="stylesheet" type="text/css" />
<div style="margin: 2px 0 0 2px; width: 852px;">
    <div id="errMsg" style="display: none;" class="successMsg">
    </div>
    <div id="arrowUpDown" class="collapse">
    </div>
    <div id="names" style="display: none;" class="names">
    </div>
    <div class="floatR">
        <input id="buttonPopup" class="btn -submit buttonPopup btnTop" type="button" value="Submit" data-bind='click: saveCustomer' />
    </div>
    <div class="noteMsg">
        @Resources.Lang.NoteSportsbookSetting
    </div>
    <div class="noteMsg">
        @Html.Raw(roleId.IsMember() ?
            (session.IsBelongToSpecialGroups ? Resources.Lang.MemberUnlimitedBetSettingWarningMessageDirectionV3: Resources.Lang.MemberUnlimitedBetSettingWarningMessage) :
            (session.IsBelongToSpecialGroups ? Resources.Lang.SMAUnlimitedBetSettingWarningMessageDirectionV3 : Resources.Lang.SMAUnlimitedBetSettingWarningMessage))
    </div>
    <div id="custInfo" class="customerInfo">
        <div class="headerTab" style="border-bottom: 0px">
            General Information
        </div>
        <div>
            <div class="customerInfoBlock1">
                First Name
            </div>
            <div class="customerInfoBlock2">
                <input id="firstName" type="text" class="textBoxInfo" data-bind="value: Fanex.decodeHtml(Fanex.ExtAcc.Customer.PTSetting.customer.firstName)" maxlength="50" />
            </div>
            <div class="customerInfoBlock3">
                Last Name
            </div>
            <div class="customerInfoBlock4" style="width: 210px">
                <input id="lastName" type="text" class="textBoxInfo" data-bind="value: Fanex.decodeHtml(Fanex.ExtAcc.Customer.PTSetting.customer.lastName)" maxlength="50" />
            </div>
        </div>
        <div>
            <div class="customerInfoBlock1">
                Phone
            </div>
            <div class="customerInfoBlock2">
                <input id="phone" type="text" class="textBoxInfo" data-bind="value: Fanex.decodeHtml(Fanex.ExtAcc.Customer.PTSetting.customer.phone)" maxlength="50" />
            </div>
            <div class="customerInfoBlock3">
                Mobile Phone
            </div>
            <div class="customerInfoBlock4" style="width: 210px">
                <input id="mobilePhone" type="text" class="textBoxInfo" data-bind="value: Fanex.decodeHtml(Fanex.ExtAcc.Customer.PTSetting.customer.mobilePhone)" maxlength="50" />
            </div>
        </div>
        <div id="superSection">
            <div class="customerInfoBlock1">
                Max Credit
            </div>
            <div class="customerInfoBlock2">
                <input onpaste="return false;" onkeypress="return Fanex.ExtAcc.CheckNumber(event, this, true)" onkeyup="return Fanex.ExtAcc.CheckNumber(event, this, true)" type="text" id="credit" maxlength="14" class="textBoxCredit textBoxInfo" data-bind="value: Fanex.ExtAcc.FormatNumber(Fanex.ExtAcc.Customer.PTSetting.customer.credit), enable: isUpdateCredit == 1, attr: { title: isUpdateCredit == 1 ? '' : 'You are not authorized on this function'}" />
                <span id="minCreditId">&gt;=<span data-bind="text: Fanex.ExtAcc.FormatNumber(Fanex.ExtAcc.Customer.PTSetting.customer.minCredit)" id="minCredit" /></span>
            </div>
            <div class="customerInfoBlock3">
                Fax
            </div>
            <div class="customerInfoBlock4" style="width: 210px">
                <input id="fax" type="text" class="textBoxInfo" data-bind="value: Fanex.decodeHtml(Fanex.ExtAcc.Customer.PTSetting.customer.fax)" maxlength="50" />
            </div>
        </div>
        <div id="masterSection">
            <div class="customerInfoBlock1">
                Master Max Credit
            </div>
            <div class="customerInfoBlock2">
                <input onpaste="return false;" onkeypress="return Fanex.ExtAcc.CheckNumber(event, this, true)" onkeyup="return Fanex.ExtAcc.CheckNumber(event, this, true)" type="text" id="credit" maxlength="14" class="textBoxCredit textBoxInfo" data-bind="value: Fanex.ExtAcc.FormatNumber(Fanex.ExtAcc.Customer.PTSetting.customer.credit), enable: isUpdateCredit == 1, attr: { title: isUpdateCredit == 1 ? '' : 'You are not authorized on this function'}" />
                <span id="minCreditId">&gt;=<span data-bind="text: Fanex.ExtAcc.FormatNumber(Fanex.ExtAcc.Customer.PTSetting.customer.minCredit)" id="minCredit" />&nbsp;and&nbsp;</span> &lt;= <span data-bind="text: Fanex.ExtAcc.FormatNumber(Fanex.ExtAcc.Customer.PTSetting.customer.maxCredit)" id="maxCredit"></span>
            </div>
            <div class="customerInfoBlock3">
                Fax
            </div>
            <div class="customerInfoBlock4" style="width: 210px">
                <input id="fax" type="text" class="textBoxInfo" data-bind="value: Fanex.decodeHtml(Fanex.ExtAcc.Customer.PTSetting.customer.fax)" maxlength="50" />
            </div>
        </div>
        <div id="masterStatus">
            <div id="closedId">
                <div class="customerInfoBlock1">
                    <label for="closed">
                        Closed
                    </label>
                </div>
                <div class="customerInfoBlock2">
                    <input name="closed" id="closed" type="checkbox" data-bind="checked: Fanex.ExtAcc.Customer.PTSetting.customer.statusSetting.closed, enable: hasClose == 1, attr: { title: hasClose == 1 ? '' : 'You are not authorized on this function'}" />
                </div>
            </div>
            <div class="customerInfoBlock3">
            </div>
            <div class="customerInfoBlock4" style="width: 210px">
            </div>
        </div>
        <div id="agentSection">
            <div class="customerInfoBlock1">
                Agent Max Credit
            </div>
            <div class="customerInfoBlock2">
                <input type="text" id="credit" onpaste="return false;" onkeypress="return Fanex.ExtAcc.CheckNumber(event, this, true, this)" onkeyup="return Fanex.ExtAcc.CheckNumber(event, this, true, this)" maxlength="14" class="textBoxCredit textBoxInfo" data-bind="value: Fanex.ExtAcc.FormatNumber(Fanex.ExtAcc.Customer.PTSetting.customer.credit), enable: isUpdateCredit == 1, attr: { title: isUpdateCredit == 1 ? '' : 'You are not authorized on this function'}" />
                <span id="minCreditId">&gt;=<span data-bind="text: Fanex.ExtAcc.FormatNumber(Fanex.ExtAcc.Customer.PTSetting.customer.minCredit)" id="minCredit" />&nbsp;and&nbsp;</span> &lt;= <span data-bind="text: Fanex.ExtAcc.FormatNumber(Fanex.ExtAcc.Customer.PTSetting.customer.maxCredit)" id="maxCredit"></span>
            </div>
            <div class="customerInfoBlock3">
                Fax
            </div>
            <div class="customerInfoBlock4" style="width: 210px">
                <input id="fax" type="text" class="textBoxInfo" data-bind="value: Fanex.ExtAcc.Customer.PTSetting.customer.fax" maxlength="50" />
            </div>
        </div>
        <div id="agentSection2">
            <div class="customerInfoBlock1">
                Member Max Credit
            </div>
            <div class="customerInfoBlock2">
                <input onpaste="return false;" onkeypress="return Fanex.ExtAcc.CheckNumber(event, this, true)" onkeyup="return Fanex.ExtAcc.CheckNumber(event, this, true)" type="text" id="memberCredit" maxlength="14" class="textBoxCredit textBoxInfo" data-bind="value: Fanex.ExtAcc.FormatNumber(Fanex.ExtAcc.Customer.PTSetting.customer.memberMaxCredit), enable: isUpdateCredit == 1, attr: { title: isUpdateCredit == 1 ? '' : 'You are not authorized on this function'}" />
                <span id="minCreditId">&gt;=<span data-bind="text: Fanex.ExtAcc.FormatNumber(Fanex.ExtAcc.Customer.PTSetting.customer.memberMinCredit)" id="minCreditMember" /></span>&nbsp;and&nbsp; &lt;= <span data-bind="text: Fanex.ExtAcc.FormatNumber(Fanex.ExtAcc.Customer.PTSetting.customer.credit)" id="maxCreditMember"></span>
            </div>
            <div class="customerInfoBlock3">
                <label for="closed">
                    Closed
                </label>
            </div>
            <div class="customerInfoBlock4" style="width: 210px">
                <input name="closed" id="closed" type="checkbox" data-bind="checked: Fanex.ExtAcc.Customer.PTSetting.customer.statusSetting.closed, enable: hasClose == 1, attr: { title: hasClose == 1 ? '' : 'You are not authorized on this function'}" />
            </div>
        </div>
        <div id="memberSection">
            <div class="customerInfoBlock1">
                Given Credit
            </div>
            <div class="customerInfoBlock2">
                <input onpaste="return false;" onkeypress="return Fanex.ExtAcc.CheckNumber(event, this, true)" onkeyup="return Fanex.ExtAcc.CheckNumber(event, this, true)" type="text" id="credit" maxlength="14" class="textBoxCredit textBoxInfo" data-bind="value: Fanex.ExtAcc.FormatNumber(Fanex.ExtAcc.Customer.PTSetting.customer.credit), enable: isUpdateCredit == 1, attr: { title: isUpdateCredit == 1 ? '' : 'You are not authorized on this function'}" />
                <span id="minCreditId" class="hide">&gt;=<span data-bind="text: Fanex.ExtAcc.FormatNumber(Fanex.ExtAcc.Customer.PTSetting.customer.minCredit)" id="minCredit" /></span>&lt;= <span data-bind="text: Fanex.ExtAcc.FormatNumber(Fanex.ExtAcc.Customer.PTSetting.customer.maxCredit)" id="maxCredit"></span>
            </div>
            <div class="customerInfoBlock3">
                Fax
            </div>
            <div class="customerInfoBlock4" style="width: 210px">
                <input id="fax" type="text" class="textBoxInfo" data-bind="value: Fanex.ExtAcc.Customer.PTSetting.customer.fax" maxlength="50" />
            </div>
        </div>
        <div id="memberSection2">
            <div class="customerInfoBlock1">
                Group
            </div>
            <div class="customerInfoBlock2">
                <span data-bind="text: Fanex.ExtAcc.Customer.PTSetting.customer.group"></span>
            </div>
            <div class="customerInfoBlock3">
                <label for="closed">
                    Closed
                </label>
            </div>
            <div class="customerInfoBlock4" style="width: 210px">
                <input name="closed" id="closed" type="checkbox" data-bind="checked: Fanex.ExtAcc.Customer.PTSetting.customer.statusSetting.closed, enable: hasClose == 1, attr: { title: hasClose == 1 ? '' : 'You are not authorized on this function'}" />
            </div>
        </div>
    </div>
    <div id="statusHeader" class="headerPositionTaking" style="border-top: 1px solid #CCC">
        Status
    </div>
    <div id="statusSection" class="positionTaking" style="border-bottom: 0; padding: 0;">
        <table cellpadding="0" cellspacing="0" border="0" width="100%" style="border-collapse: collapse; border-color: #CCC;">
            <tr style="height: 22px">
                <td style="border-right: 1px solid #ccc; text-align: right; width: 50%;">
                    <div>
                        <label for="closed">
                            Closed
                        </label>
                    </div>
                </td>
                <td>
                    <div>
                        <input name="closed" id="closed" type="checkbox" data-bind="checked: Fanex.ExtAcc.Customer.PTSetting.customer.statusSetting.closed, enable: hasClose == 1, attr: { title: hasClose == 1 ? '' : 'You are not authorized on this function'}" />
                    </div>
                </td>
            </tr>
        </table>
    </div>
    <div id="commissionHeader" class="headerPositionTaking" style="border-bottom: 0; border-top: 1px solid #ccc; float: left; padding: 0; width: 850px;">
        Commission
    </div>
    <div class="positionTaking" style="float: left; padding: 0; width: 850px">
        <div style="margin: 0px">
            @Html.Action(actionName, "SportsbookSetting")
        </div>
    </div>
    <div class="headerPositionTaking">
        Bet Setting
    </div>
    <div class="positionTaking">
        <div id="betSetting">
        </div>
    </div>
    <div class="headerPositionTaking">
        Postition Taking
    </div>
    <div class="positionTaking">
        <div id="ptContainer">
        </div>
    </div>
    <div class="floatR">
        <input id="buttonPopup2" class="btn -submit buttonPopup" type="button" value="Submit" data-bind='click: saveCustomer' />
    </div>
    <input type="hidden" id="PT3DecimalSites" value="@AppSettings.PT3DecimalSites" />
    @Html.AntiForgeryToken()
</div>
<script src="@HttpContext.Current.GetWebResourceUrl("Fanex.PTEngine.UI.Languages.en.js")" type="text/javascript">
</script>
<script src="@HttpContext.Current.GetWebResourceUrl("Fanex.PTEngine.UI.Core.js")" type="text/javascript"></script>
<script src="@HttpContext.Current.GetWebResourceUrl("Fanex.PTEngine.UI.BetTypeGroup.js")" type="text/javascript"></script>
<script src="@HttpContext.Current.GetWebResourceUrl("Fanex.PTEngine.UI.BetType.js")" type="text/javascript"></script>
<script src="@HttpContext.Current.GetWebResourceUrl("Fanex.PTEngine.UI.BettingLimit.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Scripts/Customer/Fanex.ExtAcc.Customer.MemberInfo.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Scripts/Customer/Fanex.ExtAcc.Customer.PTSetting.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Scripts/Customer/Fanex.ExtAcc.Customer.Commission.js")" type="text/javascript"></script>
<script type="text/javascript">
    $(document).ready(function () {
        if (Fanex.ExtAcc.Customer.CurrentLevel == '@Role.Member') {
            $('#tblMasterAgent').remove();
        } else {
            $('#tblMember').remove();
        }
    });
</script>