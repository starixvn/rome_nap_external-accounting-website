@using Fanex.ExternalAccount.ViewModel.Customer.ParlayMaxPayout;
@model ParlayMaxPayoutViewModel
@{
    List<string> rowHeader = new List<string> { Resources.Lang.SoccerParlay, Resources.Lang.mixsports };
    int rowIndex = 0;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Parlay Max Payout</title>
    <link href="~/assets/styles/fonts/AlphaAdmin/style.css" rel="stylesheet" />
    <link href="~/assets/styles/pages/default/common.css" rel="stylesheet" />
    <style type="text/css">
        input[type="text"] {
            width: 120px;
        }

        .R {
            text-align: right;
        }

        .hide {
            display: none;
        }

        .bold {
            font-weight: bold;
        }

        .row-header {
            background-color: #e7f7ff;
        }

        .align-center {
            text-align: center;
        }

        tr {
            line-height: 22px;
            background-color: white;
        }

        .parlay-max-payout-table {
            width: 100%;
            min-width: 1000px;
            border-collapse: collapse;
        }

        .td-disabled {
            background-color: #d3d3d3;
        }

        .input-field, .input-field-unlimited {
            width: 120px;
            font-size: inherit;
        }

        .btn {
            -webkit-border-radius: 2px;
            -khtml-border-radius: 2px;
            -moz-border-radius: 2px;
            -ms-border-radius: 2px;
            -o-border-radius: 2px;
            border-radius: 2px;
            height: 28px;
            line-height: 28px;
            padding-left: 10px;
            padding-right: 10px;
            font-size: 13px !important;
            min-width: 64px;
            border: none;
            outline: none;
            text-indent: 0;
            -webkit-appearance: none;
        }

            .btn.-submit {
                background-color: #6f7d95;
                color: #fff;
            }

                .btn.-submit:hover {
                    background-color: #637187 !important;
                    color: #fff;
                }

        .title {
            background-color: #f1f1a6;
        }

        .check-enable-edit {
            float: right;
        }

        body {
            font-family: 'Tahoma Custom', Tahoma, Arial, Helvetica, sans-serif !important;
            font-size: 11px !important;
        }
    </style>
</head>
<body>
    @helper RenderPayoutBlock(string entityName, string columnName, int sporttype, int bettype, string rowHeader, decimal payoutValue, decimal defaultPayoutValue, bool isUplineUnlimited)
    {
        var id = sporttype + "_" + bettype + "_" + entityName;
        var unlimitedId = "chkUnlimited_" + id;
        <table>
            <tr>
                <td class="@(Model.IsMultiple? "td-disabled" : "")">
                    <input id="@id" value="@payoutValue.ToString("#,0")"
                           @*onkeypress="return parent.Fanex.ExtAcc.CheckNumber(event, this, false)"*@
                           onkeyup="return Fanex.CustomerSetting.Core.CheckNumber(event, this)"
                           data-original-value="@payoutValue.ToString("#,0")"
                           data-sporttype="@sporttype"
                           data-bettype="@bettype"
                           data-fieldname="@entityName"
                           data-row-header="@rowHeader"
                           data-column-name="@columnName"
                           data-default-payout-value="@defaultPayoutValue.ToString("#,0")"
                           data-checkbox-unlimited-id="@unlimitedId"
                           class="R @(payoutValue > 0 ? "" : "hide") input-field"
                           @(Model.IsMultiple? "disabled" : "") />

                    <input id="@(id + "_Unlimited")" value="Unlimited" class="R @(payoutValue > 0 ? "hide" :" ") input-field-unlimited" disabled />

                </td>
                <td class="@(Model.IsMultiple? "td-disabled" : "")">@(defaultPayoutValue == 0 ? "" : "<= " + defaultPayoutValue.ToString("#,0")) </td>
            </tr>
            <tr>
                <td colspan="2" class="@(Model.IsMultiple? "td-disabled" : "")">
                    @if (isUplineUnlimited)
                    {
                        <input id="@unlimitedId" type="checkbox" @(payoutValue == 0 ? "checked" : "") @(Model.IsMultiple? "disabled" : "") />
                        <label for="@unlimitedId"> Unlimited</label>
                    }
                </td>
            </tr>

        </table>
    }
    <div id="result-messages"></div>
    @if (Model.IsMultiple)
    {
        <div id="custIdsName" class="title bold text-center">@String.Join(", ", Model.CustNames.Split(','))</div>
    }
    <table border="1" class="parlay-max-payout-table">
        <thead>
            <tr>
                <td class="row-header align-center bold title" colspan="5">

                    @if (Model.IsMultiple)
                    {
                        @("Parlay Max Payout")
                    }
                    else
                    {
                        @("Parlay Max Payout: " + Model.CustName)
                    }
                </td>
            </tr>
            <tr>
                <td class="row-header align-center"></td>
                <td class="row-header align-center bold">Single Match Parlay</td>
                <td class="row-header align-center bold">Combo 2</td>
                <td class="row-header align-center bold">Combo 3 - 5</td>
                <td class="row-header align-center bold">Combo 6+ & System Parlay</td>
            </tr>
        </thead>
        <tbody>
            @foreach (var entity in Model.ListEntityModel)
            {
                <tr>
                    <td class="row-header">
                        @rowHeader[rowIndex] 
                        @if(Model.IsMultiple)
                        {
                            <input type="checkbox" class="check-enable-edit"  />
                        }
                    </td>
                    <td class="@(Model.IsMultiple? "td-disabled" : "")">@RenderPayoutBlock("SingleMatchParlay", "Single Match Parlay", entity.SportType, entity.Bettype, rowHeader[rowIndex], entity.SingleMatchParlay, entity.UplineSingleMatchParlay, entity.IsAllowUnlimitedSingleMatchParlay)</td>
                    <td class="@(Model.IsMultiple? "td-disabled" : "")">@RenderPayoutBlock("Combo2", "Combo 2", entity.SportType, entity.Bettype, rowHeader[rowIndex], entity.Combo2, entity.UplineCombo2, entity.IsAllowUnlimitedCombo2)</td>
                    <td class="@(Model.IsMultiple? "td-disabled" : "")">@RenderPayoutBlock("Combo35", "Combo 3 - 5", entity.SportType, entity.Bettype, rowHeader[rowIndex], entity.Combo35, entity.UplineCombo35, entity.IsAllowUnlimitedCombo35)</td>
                    <td class="@(Model.IsMultiple? "td-disabled" : "")">@RenderPayoutBlock("ComboOver6", "Combo 6+ & System Parlay", entity.SportType, entity.Bettype, rowHeader[rowIndex], entity.ComboOver6, entity.UplineComboOver6, entity.IsAllowUnlimitedComboOver6)</td>
                </tr>
                rowIndex++;
            }
            @if (!Model.ListEntityModel.Any())
            {

                <tr>
                    <td colspan="5" class="no-data">
                        There is no data.
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (Model.ListEntityModel.Any())
    {
        <input id="btnUpdate" type="button" class="btn -submit" style="margin-top:10px;" value="Update" />
    }
    <input id="txtCustId" type="hidden" value="@Model.CustId" />
    <input id="txtCustIds" type="hidden" value="@Model.CustIds" />
    <input id="txtCustName" type="hidden" value="@Model.CustName" />
    <input id="txtCustNames" type="hidden" value="@Model.CustNames" />
    <input id="txtRoleId" type="hidden" value="@Model.RoleId" />
    @Html.AntiForgeryToken()
    <script src="~/Scripts/Lib/jquery-ui-1.9.1/jquery-1.8.2.js"></script>
    <script src="@Url.Content("~/Views/ParlayMaxPayout/Scripts/Index.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Areas/CustomerSetting/Scripts/Fanex.CustomerSetting.Core.js")" type="text/javascript"></script>
</body>
</html>