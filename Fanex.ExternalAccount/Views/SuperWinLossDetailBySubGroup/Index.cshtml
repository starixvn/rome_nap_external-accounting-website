@using GlobalViewLang = Fanex.ExternalAccount.Utilities.ViewLang
@using Fanex.ExternalAccount.Utilities
@{
    Layout = null;
    ViewBag.Title = "Super Win Loss Detail By Sub Group";
    var currentDate = DateTime.Today;
    var minDate = currentDate.AddMonths(-3).AddDays((-currentDate.Day) + 1);
    var minDateText = minDate.ToString("MMMM dd") + " <sup>" + Utils.GetDaySuffix(minDate.Day) + "</sup>, " + minDate.ToString("yyyy");
}
@model Fanex.ExternalAccount.SuperWinLossDetailBySubGroup.ViewModels.SuperWinLossDetailBySubGroupViewModel
<div id="report-container">
    <div class="page-title">
        <div class="wlDetail">@ViewBag.Title</div>
        <span class="icon-filter active" id="span-iconFilter"></span>
    </div>
    <div class="search-form filterbox filter-winloss-detail" id="filter-container">
        <div class="form-group">
            <div class="label">@GlobalViewLang.Products</div>
            <div class="user-group pull-left ddl-product">
                <div id="ddl-product"></div>
            </div>
        </div>
        <div class="form-group hidden" id="ddl-product-detail-container">
            <div class="label">@GlobalViewLang.ProductDetails</div>
            <div class="user-group pull-left ddl-product">
                <div id="ddl-product-detail"></div>
            </div>
        </div>
        <div class="form-group">
            <div class="label">@GlobalViewLang.SubGroup</div>
            <div class="select-box pull-left">
                @Html.DropDownList("subGroupId", Model.SubGroups, new { id = "ddl-subGroup" })
            </div>
        </div>
        <div class="form-group from-to-date">
            <input type="hidden" id="MinDate" value="@minDate" />
            <input type="hidden" id="MaxDate" value="@currentDate" />
            <div class="label">@GlobalViewLang.Date</div>
            <div id="userGroup" class="user-group pull-left">
                <select id="DateList">
                    <option id="0" selected="selected">Today</option>
                    <option id="1">Yesterday</option>
                    <option id="2">Current Week</option>
                    <option id="3">Last Week</option>
                    <option id="4">Current Month</option>
                    <option id="5">Last Month</option>
                    <option id="6">Since Last Month</option>
                    <option id="7">Date Range</option>
                </select>
            </div>
        </div>
        <div class="form-group from-to-date">
            <div class="label">@GlobalViewLang.From</div>
            <input type="text" readonly="readonly" id="dtpFromDate" />
        </div>
        <div class="form-group from-to-date">
            <div class="label to-width">@GlobalViewLang.To</div>
            <input type="text" readonly="readonly" id="dtpToDate" />
        </div>
        <div class="form-group">
            <button type="button" id="btn-submit" class="btn -submit btnSearch">@GlobalViewLang.Submit</button>
        </div>
        <div class="form-group">
            <span id="exporttoexcel" title="@GlobalViewLang.ExportExcel" class="icon-excel hide"></span>
        </div>
        <div class="form-group" style="display:block;">@GlobalViewLang.ViewReportMinDate @Html.Raw(minDateText)</div>
        <div class="form-group" style="display:block;">If a super is assigned in multiple sub groups it will be shown multiple times. However, the Grand Total only sum each super once.</div>
        <div class="form-group" style="display:block;">@Html.Raw(ViewBag.NoteSabaOthers)</div>

    </div>
    <div class="freegrid-container hide" id="mainGrid">
        <div class="freegrid" id="jqgrid"></div>
    </div>
    <div id="msgNoinfo">@GlobalViewLang.NoData</div>
    <input type="hidden" value="@Model.GroupId" id="hidden-groupId" />
    <input type="hidden" value="@Model.GroupName" id="hidden-groupName" />
</div>

@StaticResources.RenderScripts("~/assets/bundles/SuperWinLossDetailBySubGroup/index")
@Html.Raw(Fanex.Logging.LogManager.RenderJavascriptLogger())
