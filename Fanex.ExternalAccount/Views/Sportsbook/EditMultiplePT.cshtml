@using Fanex.PTEngine
<script src="@HttpContext.Current.GetWebResourceUrl("Fanex.PTEngine.UI.BetTypeGroup.js")" type="text/javascript"></script>
<script src="@HttpContext.Current.GetWebResourceUrl("Fanex.PTEngine.UI.BetType.js")" type="text/javascript"></script>
<script src="@HttpContext.Current.GetWebResourceUrl("Fanex.PTEngine.UI.BettingLimit.js")" type="text/javascript"></script>
<div id="errMsg" style="display: none;" class="errMsg">
</div>
<div id="arrowUpDown" class="collapse">
</div>
<div id="names" style="display: none;" class="names">
</div>
<div class="floatR">
    <input class="buttonPopup btnTop" type="button" value="Submit" data-bind='click: saveCustomer' />
</div>
<div id="custInfo" class="customerInfo" style="width: 850px">
    <div class="headerTab" style="border-bottom: 0px">
        General Information</div>
    <div style="width: 850px">
        <div class="customerInfoBlock1">
            First Name</div>
        <div class="customerInfoBlock2">
            <input id="firstName" type="text" class="textBoxInfo" data-bind="value: Fanex.decodeHtml(Fanex.ExtAcc.Customer.PTSetting.customer.firstName)" maxlength="50" /></div>
        <div class="customerInfoBlock3">
            Last Name</div>
        <div class="customerInfoBlock4" style="width: 210px">
            <input id="lastName" type="text" class="textBoxInfo" data-bind="value: Fanex.decodeHtml(Fanex.ExtAcc.Customer.PTSetting.customer.lastName)" maxlength="50" /></div>
    </div>
    <div style="width: 850px">
        <div class="customerInfoBlock1">
            Phone</div>
        <div class="customerInfoBlock2">
            <input id="phone" type="text" class="textBoxInfo" data-bind="value: Fanex.decodeHtml(Fanex.ExtAcc.Customer.PTSetting.customer.phone)" maxlength="50" /></div>
        <div class="customerInfoBlock3">
            Mobile Phone</div>
        <div class="customerInfoBlock4" style="width: 210px">
            <input id="mobilePhone" type="text" class="textBoxInfo" data-bind="value: Fanex.decodeHtml(Fanex.ExtAcc.Customer.PTSetting.customer.mobilePhone)" maxlength="50" /></div>
    </div>
    <div id="masterSection" style="width: 850px">
        <div class="customerInfoBlock1">
            Master Max Credit</div>
        <div class="customerInfoBlock2">
            <input type="text" id="credit" maxlength="14" class="textBoxCredit textBoxInfo" data-bind="value: Fanex.ExtAcc.Customer.PTSetting.customer.credit" />
            <span id="minCreditId">&gt;=<span data-bind="text: String.prototype.FormatNumber(Fanex.ExtAcc.Customer.PTSetting.customer.minCredit)" id="minCredit" />0</span>&nbsp;and&nbsp;</span> &lt;= <span data-bind="text: String.prototype.FormatNumber(Fanex.ExtAcc.Customer.PTSetting.customer.maxCredit)" id="maxCredit"></span>
        </div>
        <div class="customerInfoBlock3">
            Fax</div>
        <div class="customerInfoBlock4" style="width: 210px">
            <input id="fax" type="text" class="textBoxInfo" data-bind="value: Fanex.decodeHtml(Fanex.ExtAcc.Customer.PTSetting.customer.fax)" maxlength="50" /></div>
    </div>
    <div id="masterStatus" style="width: 850px">
        <div id="closedId">
            <div class="customerInfoBlock1">
                <label for="closed">
                    Closed</label>
            </div>
            <div class="customerInfoBlock2">
                <input name="closed" id="closed" type="checkbox" data-bind="checked: Fanex.ExtAcc.Customer.PTSetting.customer.statusSetting.closed" />
            </div>
        </div>
        <div class="customerInfoBlock3">
            <label for="suspended">
                Suspended</label>
        </div>
        <div class="customerInfoBlock4" style="width: 210px">
            <input name="suspended" id="suspended" type="checkbox" data-bind="checked: Fanex.ExtAcc.Customer.PTSetting.customer.statusSetting.suspended, enable: Fanex.ExtAcc.Customer.PTSetting.context.targetCustId &gt; 0 ? true : !Fanex.ExtAcc.Customer.PTSetting.customer.statusSetting.suspended" /></div>
    </div>
    <div id="agentSection" style="width: 850px">
        <div class="customerInfoBlock1">
            Agent Max Credit</div>
        <div class="customerInfoBlock2">
            <input type="text" id="credit" maxlength="14" class="textBoxCredit textBoxInfo" data-bind="value: Fanex.ExtAcc.Customer.PTSetting.customer.credit" />
            <span id="minCreditId">&gt;=<span data-bind="text: String.prototype.FormatNumber(Fanex.ExtAcc.Customer.PTSetting.customer.minCredit)" id="minCredit" />0</span>&nbsp;and&nbsp;</span> &lt;= <span data-bind="text: String.prototype.FormatNumber(Fanex.ExtAcc.Customer.PTSetting.customer.maxCredit)" id="maxCredit"></span>
        </div>
        <div class="customerInfoBlock3">
            Fax</div>
        <div class="customerInfoBlock4" style="width: 210px">
            <input id="fax" type="text" class="textBoxInfo" data-bind="value: Fanex.ExtAcc.Customer.PTSetting.customer.fax" maxlength="50" /></div>
    </div>
    <div id="agentSection2" style="width: 850px">
        <div class="customerInfoBlock1">
            Member Max Credit</div>
        <div class="customerInfoBlock2">
            <input type="text" id="memberCredit" maxlength="14" class="textBoxCredit textBoxInfo" data-bind="value: Fanex.ExtAcc.Customer.PTSetting.customer.memberMaxCredit" />
            <span id="minCreditId">&gt;=<span data-bind="text: String.prototype.FormatNumber(Fanex.ExtAcc.Customer.PTSetting.customer.memberMinCredit)" id="minCredit" />0</span>&nbsp;and&nbsp;</span> &lt;= <span data-bind="text: String.prototype.FormatNumber(Fanex.ExtAcc.Customer.PTSetting.customer.memberMaxCredit)" id="maxCredit"></span>
        </div>
        <div class="customerInfoBlock3">
            <label for="suspended">
                Suspended</label>
        </div>
        <div class="customerInfoBlock4" style="width: 210px">
            <input name="suspended" id="suspended" type="checkbox" data-bind="checked: Fanex.ExtAcc.Customer.PTSetting.customer.statusSetting.suspended, enable: Fanex.ExtAcc.Customer.PTSetting.context.targetCustId &gt; 0 ? true : !Fanex.ExtAcc.Customer.PTSetting.customer.statusSetting.suspended" /></div>
    </div>
    <div id="agentSection3" style="width: 850px">
        <div class="customerInfoBlock1">
        </div>
        <div class="customerInfoBlock2">
        </div>
        <div class="customerInfoBlock3">
            <label for="suspended">
                Closed</label>
        </div>
        <div class="customerInfoBlock4" style="width: 210px">
            <input name="closed" id="closed" type="checkbox" data-bind="checked: Fanex.ExtAcc.Customer.PTSetting.customer.statusSetting.closed" />
        </div>
    </div>
    <div id="memberSection" style="width: 850px">
        <div class="customerInfoBlock1">
            Given Credit</div>
        <div class="customerInfoBlock2">
            <input type="text" id="credit" maxlength="14" class="textBoxCredit textBoxInfo" data-bind="value: Fanex.ExtAcc.Customer.PTSetting.customer.credit" />
            <span id="minCreditId" class="hide">&gt;=<span data-bind="text: String.prototype.FormatNumber(Fanex.ExtAcc.Customer.PTSetting.customer.minCredit)" id="minCredit" />0</span>&nbsp;and&nbsp;</span> &lt;= <span data-bind="text: String.prototype.FormatNumber(Fanex.ExtAcc.Customer.PTSetting.customer.maxCredit)" id="maxCredit"></span>
        </div>
        <div class="customerInfoBlock3">
            Fax</div>
        <div class="customerInfoBlock4" style="width: 210px">
            <input id="fax" type="text" class="textBoxInfo" data-bind="value: Fanex.ExtAcc.Customer.PTSetting.customer.fax" maxlength="50" /></div>
    </div>
    <div id="memberSection2" style="width: 850px">
        <div class="customerInfoBlock1">
            Group</div>
        <div class="customerInfoBlock2">
            <span data-bind="text: Fanex.ExtAcc.Customer.PTSetting.customer.group"></span>
        </div>
        <div class="customerInfoBlock3">
            <label for="suspended">
                Closed</label>
        </div>
        <div class="customerInfoBlock4" style="width: 210px">
            <input name="closed" id="closed" type="checkbox" data-bind="checked: Fanex.ExtAcc.Customer.PTSetting.customer.statusSetting.closed" />
        </div>
    </div>
    <div id="memberSection3" style="width: 850px">
        <div class="customerInfoBlock1">
        </div>
        <div class="customerInfoBlock2">
        </div>
        <div class="customerInfoBlock3">
            <label for="suspended">
                Suspended</label>
        </div>
        <div class="customerInfoBlock4" style="width: 210px">
            <input name="suspended" id="suspended" type="checkbox" data-bind="checked: Fanex.ExtAcc.Customer.PTSetting.customer.statusSetting.suspended, enable: Fanex.ExtAcc.Customer.PTSetting.context.targetCustId &gt; 0 ? true : !Fanex.ExtAcc.Customer.PTSetting.customer.statusSetting.suspended" /></div>
    </div>
</div>
<div id="statusHeader" class="headerPositionTaking" style="border-top: 1px solid #CCC">
    Status</div>
<div id="statusSection" class="positionTaking" style="padding: 0">
    <table cellpadding="0" cellspacing="0" border="0" width="100%" style="border-color: #CCC; border-collapse: collapse">
        <tbody>
            <tr style="height: 22px">
                <td class="groupCom" style="width: 50%; border-right: 1px solid #ccc;">
                    <div>
                        <label for="closed">
                            Closed</label></div>
                </td>
                <td class="widthGroup">
                    <div>
                        <input name="closed" id="closed" type="checkbox" data-bind="checked: Fanex.ExtAcc.Customer.PTSetting.customer.statusSetting.closed" /></div>
                </td>
            </tr>
        </tbody>
    </table>
</div>
<div id="commissionHeader" class="headerPositionTaking">
    Commission</div>
<div class="positionTaking" style="padding: 0">
    <div>
        <table id="tblMasterAgent" width="100%" border="0" cellpadding="2">
            <tbody>
                <tr>
                    <td>
                        <div class="commission">
                            <div class="pt3 pb3">
                                <table cellpadding="0" cellspacing="0" border="0" width="100%">
                                    <tbody>
                                        <tr>
                                            <td class="groupCom">
                                                Group A
                                            </td>
                                            <td class="widthGroup">
                                                <select id="groupA" name="groupA" class="widthGroup">
                                                </select>
                                            </td>
                                            <td class="groupCom">
                                                Group B
                                            </td>
                                            <td class="widthGroup">
                                                <select id="groupB" class="widthGroup">
                                                </select>
                                            </td>
                                            <td class="groupCom">
                                                Group C
                                            </td>
                                            <td class="widthGroup">
                                                <select id="groupC" class="widthGroup">
                                                </select>
                                            </td>
                                            <td class="groupCom">
                                                Group D
                                            </td>
                                            <td class="widthGroup">
                                                <select id="groupD" class="widthGroup">
                                                </select>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td colspan="8" height="5">
                                            </td>
                                        </tr>
                                        <tr>
                                            <td colspan="8" class="line">
                                            </td>
                                        </tr>
                                        <tr>
                                            <td colspan="8" height="5">
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="groupCom">
                                                1x2 Comm
                                            </td>
                                            <td>
                                                <select id="discount1x2" class="widthGroup">
                                                </select>
                                            </td>
                                            <td class="groupCom">
                                                Others Comm
                                            </td>
                                            <td>
                                                <select id="discountCS" class="widthGroup">
                                                </select>
                                            </td>
                                            <td class="groupCom">
                                                Game Comm
                                            </td>
                                            <td>
                                                <select id="discountNumber" class="widthGroup">
                                                </select>
                                            </td>
                                            <td>
                                            </td>
                                            <td>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div id="commissionContainer">
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
        <table id="tblMember" width="100%" border="0" cellpadding="2">
            <tbody>
                <tr>
                    <td>
                        <div class="commission">
                            <div>
                                <div class="commissionBlock1 commissionHeader">
                                    &nbsp;
                                </div>
                                <div class="commissionBlock2 commissionHeader">
                                    Comm for Agent
                                </div>
                                <div class="commissionBlock2 commissionHeader">
                                    Comm for Member
                                </div>
                            </div>
                            <div class="clearBlock">
                                <div class="commissionBlock1">
                                    Asian HDP, OU, OE
                                </div>
                                <div class="commissionBlock2">
                                    <input type="text" id="textBoxDiscountAsian" name="textBoxDiscountAsian" class="textBoxComm" disabled="true">
                                </div>
                                <div class="commissionBlock2">
                                    <select id="discountAsian" name="discountAsian" class="widthGroup">
                                    </select>
                                </div>
                            </div>
                            <div class="clearBlock">
                                <div class="commissionBlock1">
                                    1 X 2
                                </div>
                                <div class="commissionBlock2">
                                    <input type="text" id="textBoxDiscount1x2" class="textBoxComm" disabled="true">
                                </div>
                                <div class="commissionBlock2">
                                    <select id="discount1x2" name="discount1x2" class="widthGroup">
                                    </select>
                                </div>
                            </div>
                            <div class="clearBlock">
                                <div class="commissionBlock1">
                                    Other Bettypes
                                </div>
                                <div class="commissionBlock2">
                                    <input type="text" id="textBoxDiscountCS" class="textBoxComm" disabled="true">
                                </div>
                                <div class="commissionBlock2">
                                    <select id="discountCS" name="discountCS" class="widthGroup">
                                    </select>
                                </div>
                            </div>
                            <div class="clearBlock">
                                <div class="commissionBlock1">
                                    Game Comm
                                </div>
                                <div class="commissionBlock2">
                                    <input type="text" id="textBoxDiscountNumber" class="textBoxComm" disabled="true">
                                </div>
                                <div class="commissionBlock2">
                                    <select id="discountNumber" name="discountNumber" class="widthGroup">
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div id="commissionContainer">
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
<div class="headerPositionTaking">
    Bet Setting</div>
<div class="positionTaking">
    <div id="betSetting">
    </div>
</div>
<div class="headerPositionTaking">
    Postition Taking</div>
<div class="positionTaking">
    <div id="ptContainer">
    </div>
</div>
<div class="floatR">
    <input class="buttonPopup" type="button" value="Submit" data-bind='click: saveCustomer' />
</div>
<script src="@Url.Content("~/Scripts/Customer/Fanex.ExtAcc.Customer.PTSetting.js")" type="text/javascript"></script>
<script type="text/javascript">
    $(document).ready(function () {
        if (Fanex.ExtAcc.Customer.CurrentLevel == Fanex.ExtAcc.Customer.Member) {
            $('#tblMasterAgent').remove();
        }
        else {
            $('#tblMember').remove();
        }
    });
</script>