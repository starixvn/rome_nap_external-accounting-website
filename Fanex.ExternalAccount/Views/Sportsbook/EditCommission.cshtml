<div style="margin-top: 5px;">
    <table width="100%" border="0" cellpadding="2">
        <tr>
            <td>
                @if ((string.IsNullOrEmpty(Request["isMemberCommission"]) ? "1" : Request["isMemberCommission"].ToString()) != "1")
                {
                    @Html.Raw(new Fanex.PTEngine.Age.Templates.Commission_Template())
                }
                else
                {
                    @Html.Raw(new Fanex.PTEngine.Age.Templates.AddNewMember_CommissionBlock_Block())
                }
                <div id="commissionContainer">
                </div>
            </td>
        </tr>
        <tr>
            <td>
                <div style="float: right;">
                    <input id="btnUpdate" class="buttonPopup" type="button" value="Update"/>
                </div>
            </td>
        </tr>
        <tr>
            <td>
                <div id="errMsg" style="display: none;" class="errMsg">
                </div>
            </td>
        </tr>
    </table>
</div>
<script src="../../Scripts/Customer/Fanex.ExtAcc.Customer.Commission.js" type="text/javascript"></script>