@using Fanex.ExternalAccount.Utilities
<div style="margin-top: 5px;">
    <table width="100%" border="0" cellpadding="2">
        <tr>
            <td>
                <div class="commission">
                    <div class="headerTab">
                        @ViewLang.commission</div>
                    <div class="clear">
                        <div class="commissionBlock1 commissionHeader">&nbsp;
                        </div>
                        <div class="commissionBlock2 commissionHeader">
                            @ViewLang.CommissionForAgent
                        </div>
                        <div class="commissionBlock2 commissionHeader">
                            @ViewLang.CommissionForMember
                        </div>
                    </div>
                    <div class="clearBlock">
                        <div class="commissionBlock1">
                            @ViewLang.AsianHDC_OU_OE
                        </div>
                        <div class="commissionBlock2">
                            <input type="text" id="textBoxDiscountAsian" name="textBoxDiscountAsian" class="textBoxComm"
                                disabled="true" />
                        </div>
                        <div class="commissionBlock2">
                            <select id="discountAsian" name="discountAsian" class="widthGroup">
                            </select>
                        </div>
                    </div>
                    <div class="clearBlock">
                        <div class="commissionBlock1">
                            @ViewLang.lbl1x2
                        </div>
                        <div class="commissionBlock2">
                            <input type="text" id="textBoxDiscount1x2" class="textBoxComm" disabled="true" data-bind="value: customer.commissionSetting.discount1x2" />
                        </div>
                        <div class="commissionBlock2">
                            <select id="discount1x2" name="discount1x2" class="widthGroup">
                            </select>
                        </div>
                    </div>
                    <div class="clearBlock">
                        <div class="commissionBlock1">
                            @ViewLang.OtherTypes
                        </div>
                        <div class="commissionBlock2">
                            <input type="text" id="textBoxDiscountCS" class="textBoxComm" disabled="true" data-bind="value: customer.commissionSetting.discountCS" />
                        </div>
                        <div class="commissionBlock2">
                            <select id="discountCS" name="discountCS" class="widthGroup">
                            </select>
                        </div>
                    </div>
                    <div class="clearBlock">
                        <div class="commissionBlock1">
                            @ViewLang.numbergamecomm
                        </div>
                        <div class="commissionBlock2">
                            <input type="text" id="textBoxDiscountNumber" class="textBoxComm" disabled="true"
                                data-bind="value: customer.commissionSetting.discountNumber" />
                        </div>
                        <div class="commissionBlock2">
                            <select id="discountNumber" name="discountNumber" class="widthGroup">
                            </select>
                        </div>
                    </div>
                </div>
                <div id="commissionContainer">
                </div>
            </td>
        </tr>
        <tr>
            <td>
                <div style="float: right;">
                    <input id="btnUpdate" class="buttonPopup" type="button" value="Update" />
                </div>
            </td>
        </tr>
        <tr>
            <td>
                <div id="errMsg" style="display: none;" class="errMsg">
                </div>
            </td>
        </tr>
    </table>
</div>
<script src="../../Scripts/Customer/Fanex.ExtAcc.Customer.Commission.js" type="text/javascript"></script>
