                </div>
                <div id="GroupViewHistory" class="pdCommon">
                    <div>@ViewLang.NoteViewHistory <span id="ViewHistoryReport" class="history">@ViewLang.ViewHistoryReport</span></div>
                </div>
                <div id="GroupBackToCurrent" class="pdCommon" style="display: none">
                    <span id="BackToCurrentReport" class="history arrow">@ViewLang.BackToCurrentReport</span>
                </div>
            </div>*@
    </div>
    <div id="headlineDaily">
        <div id="InfoDate">
            <span id="SelectedLevel">Super</span> Win Loss Detail <span id="DateValueInfo"></span>
        </div>
        <div class="groupBack">
            <div id="tabAgent">
                Agent
            </div>
            <div id="tabMaster">
                Master
            </div>
            <div id="tabSuper">
                Super
            </div>
        </div>
        <input id="exporttoexcel" title="@ViewLang.ExportExcel" type="image" src="@Url.Content("~/Images/excel-icn.png")" name="image" />
    </div>
    <div id="mainGrid" class="hide">
        <table id="tbl-report" class="table tablesorter">
            <thead>
                <tr>
                    <th rowspan="2">
                        <div class="col-130">Username</div>
                        <div class="col-sorter" data-sortedname="Username"></div>
                    </th>
                    <th rowspan="2">
                        <div class="col-130">Turnover</div>
                        <div class="col-sorter" data-sortedname="Turnover"></div>
                    </th>
                    <th rowspan="2">
                        <div class="col-130">
                            Net Turnover
                            <span id="netTurnover" class="bet-type-detail-icon"></span>
                        </div>
                        <div class="col-sorter" data-sortedname="NetTurnover"></div>
                    </th>
                    <th rowspan="2">
                        <div class="col-130">Gross Comm</div>
                        <div class="col-sorter" data-sortedname="GrossComm"></div>
                    </th>
                    <th colspan="3">Member</th>
                    <th colspan="3">Agent</th>
                    <th colspan="3" class="col-master">Master</th>
                    <th colspan="3" class="col-super">Super</th>
                    <th rowspan="2">
                        <div class="col-130">Company</div>
                        <div class="col-sorter" data-sortedname="Company"></div>
                    </th>
                </tr>
                <tr>
                    <th>
                        <div class="col-130">Win/Loss</div>
                        <div class="col-sorter" data-sortedname="MemberWinlost"></div>
                    </th>
                    <th>
                        <div class="col-130">Comm</div>
                        <div class="col-sorter" data-sortedname="PlayerComm"></div>
                    </th>
                    <th>
                        <div class="col-130">Total</div>
                        <div class="col-sorter" data-sortedname="MemberTotal"></div>
                    </th>
                    <th>
                        <div class="col-130">Win/Loss</div>
                        <div class="col-sorter" data-sortedname="AgWinlost"></div>
                    </th>
                    <th>
                        <div class="col-130">Comm</div>
                        <div class="col-sorter" data-sortedname="AgComm"></div>
                    </th>
                    <th>
                        <div class="col-130">Total</div>
                        <div class="col-sorter" data-sortedname="AgTotal"></div>
                    </th>
                    <th class="col-master">
                        <div class="col-130">Win/Loss</div>
                        <div class="col-sorter" data-sortedname="MAgWinlost"></div>
                    </th>
                    <th class="col-master">
                        <div class="col-130">Comm</div>
                        <div class="col-sorter" data-sortedname="MAgComm"></div>
                    </th>
                    <th class="col-master">
                        <div class="col-130">Total</div>
                        <div class="col-sorter" data-sortedname="MAgTotal"></div>
                    </th>
                    <th class="col-super">
                        <div class="col-130">Win/Loss</div>
                        <div class="col-sorter" data-sortedname="SAgWinlost"></div>
                    </th>
                    <th class="col-super">
                        <div class="col-130">Comm</div>
                        <div class="col-sorter" data-sortedname="SAgComm"></div>
                    </th>
                    <th class="col-super">
                        <div class="col-130">Total</div>
                        <div class="col-sorter" data-sortedname="SAgTotal"></div>
                    </th>
                </tr>
            </thead>
            <tbody></tbody>
            <tfoot></tfoot>
        </table>
    </div>
    <div id='msgNoinfo'>
        There is no data.
    </div>
    @Html.AntiForgeryToken()
</div>
<script src="@Url.Content("~/Scripts/monthPicker/monPickr-0.0.1.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Scripts/Combobox/Combobox.js")" type="text/javascript"></script>
