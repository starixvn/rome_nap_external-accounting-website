@using Fanex.ExternalAccount.Utilities
@using System.Web.Optimization
@{
    ViewBag.Title = "Home Page";
}
@section StyleSheet
{
    @if (HttpContext.Current.IsDebuggingEnabled)
    {
        <link href="@Url.Content("~/Content/Reports/WinLossDetail.css")" rel="stylesheet" type="text/css" />
        <link href="@Url.Content("~/Scripts/monthPicker/monPickr-0.0.1.css")" rel="stylesheet" type="text/css" />
        <link href="@Url.Content("~/Scripts/Combobox/Combobox.css")" rel="stylesheet" type="text/css" />
    }
    else
    {
        <link href="@BundleTable.Bundles.ResolveBundleUrl("~/bootstrap/winlossdetail/css")" rel="stylesheet" type="text/css" />
    }
}
<div>
    <div class="bgTitle titleForm">
        <div class="wlDetail">
            Win Loss Detail
        </div>
    </div>
    <div class="filterBoxWLDetail" style="margin-right: 3px !important">
        <div id="GroupFromToDate">
            <input type="hidden" id="MinDate" value="@DateTime.Now.AddMonths(-3).AddDays((-DateTime.Now.Day) + 1)"/>
            <input type="hidden" id="MaxDate" value="@DateTime.Now"/>
            <div class="wDate">@ViewLang.Date</div>
            <div id="userGroup" style="float: left; font-weight: normal; width: 160px">
                <select name="DateList" id="DateList">
                    <option id="0" selected="selected">Today</option>
                    <option id="1">Yesterday</option>
                    <option id="2">Current Week</option>
                    <option id="3">Last Week</option>
                    <option id="4">Current Month</option>
                    <option id="5">Last Month</option>
                    <option id="6">Since Last Month</option>
                    <option id="7">Date Range</option>
                </select>
            </div>
            <div class="wFrom">@ViewLang.From</div>
            <div style="float: left;">
                <input id="dtpFromDate" type="text" readonly="readonly" />
            </div>
            <div class="pdCommon">@ViewLang.To</div>
            <div style="float: left;">
                <input id="dtpToDate" type="text" readonly="readonly" />
            </div>
        </div>
        <div id="GroupMonthDay" style="display: none;">
            <div>
                <div class="wDate">@ViewLang.Month</div>
                <div style="float: left; width: 160px">
                    <div id="monPickr1">
                    </div>
                </div>
            </div>
            <div class="wFrom">@ViewLang.From</div>
            <div style="float: left;">
                <div id="fromDay1">
                </div>
            </div>
            <div class="toDate">@ViewLang.To</div>
            <div style="float: left; padding-left: 11px;">
                <div id="toDay1">
                </div>
            </div>
        </div>
        <div id="gUserName">
            <div class="wDate">@ViewLang.Username</div>
            <div style="float: left; width: 160px">
                <input class="usernameInput" type="text" maxlength="50" autocomplete="off" name="txtUserName" id="txtUserName" />
            </div>
            <div class="wFrom">@ViewLang.Products</div>
            <div style="float: left;">
                <select name="GroupProducts" id="GroupProducts" multiple="multiple" style="display: none">
                </select>
            </div>
        </div>
        <div style="clear: both;">
            <div style="margin-left: 86px; float: left">
                <input type="button" value="Submit" id='Submit' class="btnSearch" />
            </div>
            <div id="GroupViewHistory" class="pdCommon">
                <div>@ViewLang.NoteViewHistory <span id="ViewHistoryReport" class="history">@ViewLang.ViewHistoryReport</span></div>
            </div>
            <div id="GroupBackToCurrent" class="pdCommon" style="display: none">
                <span id="BackToCurrentReport" class="history arrow">@ViewLang.BackToCurrentReport</span>
            </div>
        </div>
    </div>
    <div id="headlineDaily">
        <div id="InfoDate">
            <span id="SelectedLevel">Super</span> Win Loss Detail <span id="DateValueInfo"></span>
        </div>
        <div class="groupBack">
            <div id="tabAgent">
                Agent</div>
            <div id="tabMaster">
                Master</div>
            <div id="tabSuper">
                Super</div>
        </div>
        <input id="exporttoexcel" title="@ViewLang.ExportExcel" type="image" src="@Url.Content("~/Images/excel-icn.png")" name="image"/>
    </div>
    <div id="mainGrid">
        <table id="jqgrid" class="removeRadius">
        </table>
        <div id="jqpager">
        </div>
    </div>
    <div id='msgNoinfo'>
        There is no data.</div>
</div>
@section Scripts
{
    @if (HttpContext.Current.IsDebuggingEnabled)
    {
        <script src="@Url.Content("~/Scripts/monthPicker/monPickr-0.0.1.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Reports/Fanex.ExtAcc.WinLossDetail.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Combobox/Combobox.js")" type="text/javascript"></script>
    }
    else
    {
        <script src="@BundleTable.Bundles.ResolveBundleUrl("~/bootstrap/winlossdetail/js")" type="text/javascript"></script>
    }
}