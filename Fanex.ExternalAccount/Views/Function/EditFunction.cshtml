@using Fanex.ExternalAccount.Utilities
@using Fanex.ExternalAccount.DTO.UserControl
@model Function
@{
    var parentList = (IEnumerable<Function>)ViewBag.ParentList;
    var groupList = (IEnumerable<Group>)ViewBag.GroupList;

    var parentSelectList = parentList.Select(o => new SelectListItem
    {
        Value = o.ParentID.ToString(),
        Text = o.ParentName
    }).ToList();

    var oldGroups = (string)ViewBag.OldGroups;
    var oldIDs = (string)ViewBag.OldIDs;
    var counter = 0;
    var index = 1;
}
<link href="@Url.Content("~/Scripts/Combobox/Combobox.css")" rel="stylesheet" type="text/css" />
<div>
    <table width="100%" border="0" cellpadding="2">
        <tr>
            <td style="width: 80px; text-align: right">
                @Html.Hidden("oldIDs", oldIDs) @Html.Hidden("oldGroups", oldGroups) @Html.HiddenFor(m => m.FuncID) @Html.LabelFor(m => m.FuncName, ViewLang.Name, new { @class = "divMargin" })
            </td>
            <td>
                @Html.TextBoxFor(m => m.FuncName, new { @class = "editControl" })
            </td>
        </tr>
        <tr>
            <td style="text-align: right">
                @Html.Label(ViewLang.Key, new { @class = "divMargin" })
            </td>
            <td class="editControl">
                @Html.Label(Model.FuncKey, new { @style = "margin-left: 5px;font-size: 13px;" })
            </td>
        </tr>
        <tr>
            <td style="vertical-align: top; text-align: right">
                @Html.LabelFor(m => m.FuncDesc, ViewLang.Description, new { @class = "divMargin" })
            </td>
            <td>
                @Html.TextAreaFor(m => m.FuncDesc, new { @class = "editControl desc" })
            </td>
        </tr>
        <tr>
            <td style="text-align: right">
                @Html.LabelFor(m => m.ParentID, ViewLang.Parent, new { @class = "divMargin" })
            </td>
            <td class="groupCboMenu">
                <select id="ParentID" name="ParentID" class="cboControl">
                    <option value="-1">@ViewLang.None</option>
                    @foreach (var item in parentList)
                    {
                        <option value="@item.FuncID" @(item.FuncID == Model.ParentID ? " selected=selected" : "")>@item.FuncName</option>
                        if (item.FuncID == Model.ParentID)
                        {
                            counter = index;
                        }

                        index++;
                    }
                </select>
            </td>
        </tr>
        <tr>
            <td style="text-align: right">
                @Html.LabelFor(m => m.DisplayOrder, ViewLang.Order, new { @class = "divMargin" })
            </td>
            <td>
                @Html.TextBoxFor(m => m.DisplayOrder, new { @class = "order" })
            </td>
        </tr>
        <tr>
            <td style="vertical-align: middle; text-align: right">
                @Html.Label(ViewLang.AssignTo, new { @class = "divMargin" })
            </td>
            <td style='height: 30px;'>
                <select name="groups" id="groups" multiple="multiple" style="display: none;">
                </select>
                <input type="hidden" id="newGroups" />
            </td>
        </tr>
        <tr>
            <td colspan="2">
                <div style="float: right; margin-right: 8px">
                    <input class="buttonPopup" type="button" value="Submit" onclick="Fanex.ExtAcc.Function.Edit()" />
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="2">
                <div id="errMsg" style="display: none;" class="errMsg">
                </div>
            </td>
        </tr>
    </table>
</div>
<script src="@Url.Content("~/Scripts/Combobox/Combobox.js")" type="text/javascript"></script>
<script type="text/javascript">
    $(document).ready(function () {
        $('#ParentID').combobox();
        var select = document.getElementById('ParentID');
        $(".groupCboMenu input").val(select.options[@counter].text);
        $(".groupCboMenu input").attr("readonly", "true");
        $(".groupCboMenu input").bind("click", function () {
            $(this).autocomplete("search", '');
        });
    });
</script>