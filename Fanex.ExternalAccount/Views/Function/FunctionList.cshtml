@using Fanex.ExternalAccount.Utilities
<div id='jqWidget' style="background-color: #fff; font-size: 13px; font-family: Verdana;">
    <div class="bgTitle titleForm">
        <div style="float: left; margin: 5px; vertical-align: middle;">
            Function Management</div>
        <div style="float: right; margin: 2px">
            <input type="button" id="jqbutton" value="Add New Function" class="button-add" />
        </div>
    </div>
    <div id="mainGrid" style="margin: 0px 3px 0px 3px">
        <div id="jqgrid" class="removeRadius freegrid content-grid">
        </div>
    </div>
</div>
<script src="@Url.Content("~/Scripts/Manage/Fanex.ExtAcc.Function.js")" type="text/javascript"></script>
<script type="text/javascript">
    Fanex.ExtAcc.Function.dataTexts = [
    '@ViewLang.Function',
    '@ViewLang.Key',
    '@ViewLang.Description',
    '@ViewLang.Order',
    '@ViewLang.Lastmodified',
    '@ViewLang.IsTest'
    ];
    Fanex.ExtAcc.InternalGroupIDs = '@ViewBag.InternalGroupIDs';
</script>