@using Fanex.ExternalAccount.Utilities
<div id='jqWidget'>
    <div class="page-title">
        <div class="pull-left">
            Function Management</div>
        <div class="pull-right">
            <button id="jqbutton" class="btn -add" >
                <span class="icon-add"></span> Add New Function
            </button>
        </div>
    </div>
    <div id="mainGrid">
        <div id="jqgrid-function" class="removeRadius freegrid content-grid">
        </div>
    </div>
    @Html.AntiForgeryToken()
</div>
<script src="@Url.Content("~/Scripts/Manage/Fanex.ExtAcc.Function.js")" type="text/javascript"></script>
<script type="text/javascript">
    Fanex.ExtAcc.Function.dataTexts = [
    '@ViewLang.Function',
    '@ViewLang.Key',
    '@ViewLang.Description',
    '@ViewLang.Order',
    '@ViewLang.Lastmodified',
    '@ViewLang.IsTest'
    ];
    Fanex.ExtAcc.InternalGroupIDs = '@ViewBag.InternalGroupIDs';
</script>