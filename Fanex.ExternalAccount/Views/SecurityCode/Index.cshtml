@using Fanex.ExternalAccount.Core.Configurations.SecurityCode;
@using Fanex.ExternalAccount.Core.Context;

@{
    ViewBag.Title = "Security Code Validation";
    Layout = null;
}

@if (ViewBag.IsExternalSite)
{
    <link href="@Url.Content("~/assets/bundles/common.min.css")" rel="stylesheet" type="text/css" />
}
@StaticResources.RenderStyles("~/assets/bundles/securitycode/index")

<div id="securityCodePage" class="securitycode-block-overlay" style="display: none;">
    <div class="securitycode-block">
        <div class="form-title-wrapper">
            <h1 class="form-title">@ViewBag.Title</h1>
        </div>
        <div id="status-message" class="row hidden">
            <div id="status-message-content" class="msg msg-error"></div>
        </div>
        <div class="row">
            <label class="form-body">Hi @ViewBag.UserName.ToUpper()</label>
            <label class="form-body">You have been idled for awhile. Please input your security code before proceeding!</label>
        </div>
        <form class="form-validation">
            <div class="form-group">
                <label for="code">Security Code</label>
                <input class="form-control txt-code"
                       type="password"
                       id="txtSecurityCode"
                       name="txtSecurityCode"
                       value=""
                       placeholder=""
                       maxlength="6"
                       autocomplete="off" />
                <i class="validation"></i>
            </div>
            <div class="form-check row">
                <input type="checkbox"
                       class="form-check-input"
                       id="showSecurityCode" />
                <label class="form-check-label" for="showSecurityCode">Show security code</label>
            </div>

            <input type="hidden" id="txtMaxAllowAttempt" value="@SecurityCodeManager.GetMaxAllowAttempt"/>
            <input type="hidden" id="txtIsExternalSite" value="@ViewBag.IsExternalSite.ToString().ToLower()" />
            <input type="hidden" id="txtSecretKey" value="@Encryptor.RandomCaptcha" />

            <label class="form-body" style="margin-bottom: 16px;">
                After Sending SC is successful, you must submit the setting page to complete the update.
            </label>

            <button id="btnSubmitSecurityCode" type="button" class="btn-submit">Submit</button>
        </form>
    </div>
</div>

<div class="securitycode-page-overlay"></div>

@if (ViewBag.IsExternalSite)
{
    <script type="text/javascript">
        function resolveClientUrl(relativeUrl) {
            return '@Url.Content("~/")' + relativeUrl;
        }
    </script>
    <script src="@Url.Content("~/assets/bundles/common.min.js")" type="text/javascript"></script>
}
@StaticResources.RenderScripts("~/assets/bundles/securitycode/index")