@using Fanex.ExternalAccount.Utilities;
@{
    ViewBag.Title = ViewLang.SCPageTile;
    Layout = null;
}

@StaticResources.RenderStyles("~/assets/bundles/securitycode/index")

<div id="securityCodePage" class="sc-page">
    <form id="verySecurityCodeForm">
        <div class="block-login">
            <div class="row">
                <div class="login-logo icon-outline-lock"></div>
            </div>
            <div class="row">
                <h3 class="sc-form-title">@string.Format(ViewLang.SCFormTile, ViewBag.UserName)</h3>
            </div>
            <div class="row">
                <input class="form-control"
                       type="password"
                       name="code"
                       id="code"
                       value=""
                       placeholder="@ViewLang.SCInputPlaceholder"
                       maxlength="6"
                       autocomplete="off" />
                <label id="codeError" class="sc-error-msg hidden">@ViewLang.SCErrorMessage</label>
                <span class="icon-lock"></span>

                <input type="hidden" id="returnUrl" name="return-url" value="@ViewBag.ReturnUrl" />
            </div>

            <div class="row">
                <button id="btnVerify" class="sc-btn-verify">Verify</button>
            </div>
        </div>
    </form>
</div>

<script type="text/javascript">
    function resolveClientUrl(relativeUrl) {
        return '@Url.Content("~/")' + relativeUrl;
    }
</script>

@StaticResources.RenderScripts("~/assets/bundles/securitycode/index")