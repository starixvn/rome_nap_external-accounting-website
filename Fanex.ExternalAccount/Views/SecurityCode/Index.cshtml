@using Fanex.ExternalAccount.Utilities;
@{
    ViewBag.Title = ViewLang.SCPageTile;
    ViewBag.IsExternalSite = ViewBag.ReturnUrl.Contains("/updateCustomerSetting/updateSetting");
    Layout = null;
}

@{
    if (ViewBag.IsExternalSite)
    {
        <link href="@Url.Content("~/assets/bundles/common.min.css")" rel="stylesheet" type="text/css" />
    }
}
@StaticResources.RenderStyles("~/assets/bundles/securitycode/index")

<div id="securityCodePage" class="securitycode-page-overlay">
    <div class="securitycode-form-overlay">
        <form id="verySecurityCodeForm">
            <div class="block-login">
                <div class="row">
                    <div class="login-logo icon-outline-lock"></div>
                </div>
                <div class="row">
                    <h3 class="sc-form-title">@string.Format(ViewLang.SCFormTile, ViewBag.UserName.ToUpper())</h3>
                </div>
                <div class="row">
                    <input class="form-control"
                           type="password"
                           id="code"
                           name="code"
                           value=""
                           placeholder="@ViewLang.SCInputPlaceholder"
                           maxlength="6"
                           autocomplete="off"
                           onkeypress="Fanex.ExtAcc.SecurityCode.OnKeyPress(event)" />
                    <label id="codeError" class="sc-error-msg hidden">@ViewLang.SCErrorMessage</label>
                    <span class="icon-lock"></span>

                    <input type="hidden" id="returnUrl" name="returnUrl" value="@ViewBag.ReturnUrl" />
                </div>

                <div class="row">
                    <button id="btnVerify" type="button" class="sc-btn-verify" onclick="Fanex.ExtAcc.SecurityCode.OnClick()">Verify</button>
                </div>
            </div>
        </form>
    </div>
</div>
@{
    if (ViewBag.IsExternalSite)
    {

        <script type="text/javascript">
            function resolveClientUrl(relativeUrl) {
                return '@Url.Content("~/")' + relativeUrl;
            }
        </script>
        <script src="@Url.Content("~/assets/bundles/common.min.js")" type="text/javascript"></script>
    }
}
@StaticResources.RenderScripts("~/assets/bundles/securitycode/index")