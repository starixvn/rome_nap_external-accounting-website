<configuration>
  <configSections>
    <section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data"/>
    <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging"/>
    <sectionGroup name="CustomerSetting">
      <section name="Security" type="Fanex.CustomerSetting.Security.Configurations.CustomerSettingSection, Fanex.CustomerSetting.Security"/>
      <section name="Keno" type="Fanex.CustomerSetting.Module.Keno.KenoSetting.Configurations.KenoSection, Fanex.CustomerSetting.Module.Keno.KenoSetting, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null" />
      <section name="Casino" type="Fanex.CustomerSetting.Module.Casino.Configurations.CasinoSection, Fanex.CustomerSetting.Module.Casino" />
    </sectionGroup>
    <section name="dotless" type="dotless.Core.configuration.DotlessConfigurationSectionHandler, dotless.Core" />
    <!--Sportsbook-->
    <section name="PTMappingSection" type="Fanex.PTEngine.XmlMapping.PTMappingSection" allowLocation="true" allowDefinition="Everywhere"/>
    <section name="BettingLimitMappingSection" type="Fanex.PTEngine.XmlMapping.BettingLimitMappingSection" allowLocation="true" allowDefinition="Everywhere"/>
    <!--/Sportsbook-->
    <!--CurrentSession-->
    <section name="CurrentSession" type="Fanex.CustomerSetting.Module.Core.Web.CurrentSessionSection, Fanex.CustomerSetting.Module.Core"/>
    <!--/CurrentSession-->
    <!--CurrentContext-->
    <section name="CurrentContext" type="Fanex.CustomerSetting.Module.Core.Web.CurrentContextSection, Fanex.CustomerSetting.Module.Core"/>
    <!--/CurrentSession-->
    <section name="couchbase" type="Couchbase.Configuration.CouchbaseClientSection, Couchbase"/>
    <section name="NoCaptchaSection" type="Fanex.ExternalAccount.Core.Context.NoCaptchaSectionConfiguration, Fanex.ExternalAccount.Core" />
    <section name="StatementSection" type="Fanex.Module.Statement.Configurations.StatementSection, Fanex.Module.Statement, Version=1.0.0.0, Culture=neutral"/>
    <section name="enablestatus" type="Fanex.CustomerSetting.EnableStatus.AllInOne.Mappings.EnableStatusConfiguration, Fanex.CustomerSetting.EnableStatus.AllInOne, Version=1.0.0.0, Culture=neutral" />
    <section name="GoldDeluxeSettings" type="Fanex.GoldDeluxe.CoreSetting.Configuration.GoldDeluxeSettings, Fanex.GoldDeluxe.CoreSetting" />
    <section name="report" type="Fanex.ExternalAccount.Utilities.Reports.WinLossDetail.ProductsConfiguration, Fanex.ExternalAccount.Utilities" />
    <section name="CustomerSettingConfiguration" type="Fanex.CustomerSetting.Client40.Configurations.CustomerSettingConfiguration, Fanex.CustomerSetting.Client40" />
    <section name="ONEbook.UM" type="ONEbook.UM.Configurations.UMClientConfiguration, ONEbook.UM" />
    <section name="ONEbook.NG2.API" type="ONEbook.NG2.API.Configuration.NG2Configuration, ONEbook.NG2.API"/>
    <section name="ONEbook.UM.ThirdParty" type="ONEbook.UM.ThirdParty.Configurations.UMClientConfiguration, ONEbook.UM.ThirdParty" />
    <section name="NumberGame2Section" type="Fanex.HttpModule.NG2.UM.Configurations.NumberGame2Section, Fanex.HttpModule.NG2.UM"/>
    <section name="InternalUrlSection" type="Fanex.ExternalAccount.Core.Configurations.InternalLogin.InternalUrlSection, Fanex.ExternalAccount.Core" />
  </configSections>
  <InternalUrlSection configSource="Configurations\InternalUrlSection.mnl.config" />
  <NumberGame2Section configSource="Areas\NG2\NumberGame2Section.config" />
  <ONEbook.UM.ThirdParty ServiceUris="http://10.40.40.202:8887/api" EnableCheckUM="false" EnableUnscheduledUM="false" UMFrom="03:00" UMTo="04:00" UMPageUrl="~/Areas/NG2/UM.aspx">
    <Products>
      <add Id="23" IsUM="false" UMFrom="00:00" UMTo="23:59" />
      <!--For manual control on site each product -->
    </Products>
  </ONEbook.UM.ThirdParty>
  <ONEbook.NG2.API configSource="Areas\NG2\ONEbook.NG2.API.mnl.config" />
  <CustomerSettingConfiguration System="4" ServiceUris="http://10.40.40.202:7577/api" CdnUris="/dcs-static" ClientLogCategory="DCS-Client" SecretKey="y+TXO6wi3sHIq5AR5CReVmiI0/h4f/TTz+Ky80EY7qY=" AccessDeniedAction="~/Shared/Unauthorized" CustomCssUrl="~/Areas/CustomerSettingRenovation/Content/DCSCustom.css"/>
  <ONEbook.UM ServiceUris="http://10.40.40.202:8889/api" EnableCheckUM="true" EnableUnscheduledUM="false" UMFrom="03:00" UMTo="04:00" SiteId="2000000" UMPageUrl="~/Shared/Offline">
    <AllowedIPs AllowAll="true" />
  </ONEbook.UM>
  <report configSource="Areas\Reports\WinlossDetail\Products.config" />
  <enablestatus configSource="Areas\CustomerSetting\Views\EnableStatus\Templates\Products.config" />
  <GoldDeluxeSettings
    MemberMaxStakeLevels="5"
    UnAuthorizedPath="~/Areas/CustomerSetting/Views/Security/AccessDenied.cshtml"
    AuthorizationServiceType="Fanex.ExternalAccount.Core.Authorization.GoldDeluxe.GoldDeluxeAuthorizationService, Fanex.ExternalAccount.Core"
    LanguageSessionKey="Fanex.GoldDeluxe.CoreSetting.Language"
    SystemId="4"
    SiteNameSessionKey="EASCurrencyGroup"
    SpecialGroupsConfigurationKey="SpecialGroups" />
  <!--CurrentContext-->
  <CurrentSession sessionFactory="Fanex.ExternalAccount.Core.Context.CurrentSession, Fanex.ExternalAccount.Core"/>
  <!--/CurrentContext-->
  <!--CurrentSession-->
  <CurrentContext contextFactory="Fanex.ExternalAccount.Core.Context.CurrentContext, Fanex.ExternalAccount.Core"/>
  <!--/CurrentSession-->
  <!--Security-->
  <CustomerSetting>
    <Security allowDirectDownline="false" allowGroups="1|4|20" authenticateFactory="Fanex.ExternalAccount.Core.Context.ExternalAccountAuthenticateAttribute, Fanex.ExternalAccount.Core"/>
    <Keno enable="true" showsetting="true" exclude="1502,1507,1509" excludesetting="1515,1516" />
    <Casino IsUMTime="false" UMFrom="12:30PM" UMTo="14:00PM" />
  </CustomerSetting>
  <!--/Security-->
  <NoCaptchaSection allowIPs="116.193.67.114" allowAdmins="starix18" />
  <!--Fanex-->
  <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
    <providers>
      <add name="XmlDbSettingProvider" type="Fanex.Data.DbSettingProviderExtension.XmlDbSettingProvider3, Fanex.Data.DbSettingProviderExtension" resourcePath="~/SpNames.CustDB.xml" enableWatching="1"/>
    </providers>
  </Fanex.Data.DbSettingProvider>
  <Fanex.Logging msmqPath="FormatName:DIRECT=TCP:10.2.98.3\private$\entlib" defaultCategory="NAP-External"/>
  <!--/Fanex-->
  <!--Sportsbook-->
  <PTMappingSection configSource="PTEngine\PTMappingSection.config"/>
  <StatementSection configSource="Areas\Statement\StatementSection.config"/>
  <BettingLimitMappingSection configSource="PTEngine\BettingLimitMappingSection.config"/>
  <!--/Sportsbook-->
  <couchbase>
    <servers bucket="Accounting" bucketPassword="">
      <add uri="http://10.2.98.2:8091/pools/default"/>
    </servers>
  </couchbase>
  <connectionStrings configSource="Configurations\connectionStrings.mnl.config"/>
  <appSettings configSource="Configurations\appSettings.mnl.config"/>
  <!--
    For a description of web.config changes see http://go.microsoft.com/fwlink/?LinkId=235367.

    The following attributes can be set on the <httpRuntime> tag.
      <system.Web>
        <httpRuntime targetFramework="4.6.1" />
      </system.Web>
  -->
  <system.web>
    <httpHandlers>
      <add path="*.less" verb="GET" type="dotless.Core.LessCssHttpHandler, dotless.Core" />
    </httpHandlers>
    <customErrors mode="Off"/>
    <httpRuntime enableVersionHeader="false" executionTimeout="600" maxRequestLength="2000000000" maxUrlLength="200" maxQueryStringLength="2097151" requestValidationMode="2.0" requestPathInvalidCharacters=""/>
    <compilation debug="false" targetFramework="4.6.1">
      <assemblies>
        <add assembly="System.Runtime, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a" />
        <add assembly="System.Runtime.Remoting, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089"/>
      </assemblies>
    </compilation>
    <trust level="Full"/>
    <sessionState mode="StateServer" timeout="20" stateConnectionString="tcpip=10.2.98.2:42424" />
    <machineKey validationKey="82DD5F7E8AEE17163191F82D6E74F88716B3A834BD6D1DC5F32CB2F613222E36144B019843C69D711C8EE551F341FDFD60B1AB77F943B02A00467A0D2D632EEB"
         decryptionKey="436E102A02B3582E206F1111DC137F5F2BFC57EBFB8ECD6736596ABDA63B9A65"
         validation="SHA1" decryption="AES" />
    <authentication mode="Forms">
      <forms loginUrl="~/Account/Login/" defaultUrl="~/Home/Index" timeout="20" name=".EXTNAPFORMSAUTH"/>
    </authentication>
    <pages>
      <namespaces>
        <add namespace="System.Web.Helpers"/>
        <add namespace="System.Web.Mvc"/>
        <add namespace="System.Web.Mvc.Ajax"/>
        <add namespace="System.Web.Mvc.Html"/>
        <add namespace="System.Web.Routing"/>
        <add namespace="System.Web.WebPages"/>
        <add namespace="System.Web.Optimization"/>
        <add namespace="Fanex.ExternalAccount.Controllers"/>
        <add namespace="Fanex.ExternalAccount.ViewModel"/>
      </namespaces>
    </pages>
    <profile defaultProvider="DefaultProfileProvider">
      <providers>
        <add name="DefaultProfileProvider" type="System.Web.Providers.DefaultProfileProvider, System.Web.Providers, Version=1.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" connectionStringName="DefaultConnection" applicationName="/"/>
      </providers>
    </profile>
    <globalization uiCulture="en-US" culture="en-US"/>
  </system.web>
  <system.webServer>
    <handlers>
      <add name="dotless" path="*.less" verb="GET" type="dotless.Core.LessCssHttpHandler,dotless.Core" resourceType="File" preCondition="" />
    </handlers>
    <validation validateIntegratedModeConfiguration="false"/>
    <modules runAllManagedModulesForAllRequests="true">
      <remove name="NG2HttpModule" />
      <add name="NG2HttpModule" type="Fanex.HttpModule.NG2.UM.NG2HttpModule" preCondition="integratedMode" />
      <!--<remove name="ExtActivityTrackingHttpModule" />
      <add name="ExtActivityTrackingHttpModule" type="Fanex.ExternalAccount.ActivityTracking.Web.ExtActivityTrackingHttpModule" preCondition="integratedMode" />-->
    </modules>
    <urlCompression doStaticCompression="true" doDynamicCompression="true"/>
    <staticContent>
      <!-- Proper svg serving. Required for svg webfonts on iPad -->
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".svgz" />
      <mimeMap fileExtension=".svgz" mimeType="image/svg+xml" />
      <!-- HTML4 Web font mime types -->
      <!-- Remove default IIS mime type for .eot which is application/octet-stream -->
      <remove fileExtension=".eot" />
      <mimeMap fileExtension=".eot" mimeType="application/vnd.ms-fontobject" />
      <remove fileExtension=".ttf" />
      <mimeMap fileExtension=".ttf" mimeType="application/x-font-ttf" />
      <remove fileExtension=".ttc" />
      <mimeMap fileExtension=".ttc" mimeType="application/x-font-ttf" />
      <remove fileExtension=".otf" />
      <mimeMap fileExtension=".otf" mimeType="font/opentype" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="application/font-woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".less" />
      <mimeMap fileExtension=".less" mimeType="text/css" />
      <clientCache cacheControlMode="DisableCache" cacheControlMaxAge="30.00:00:00" />
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <!--#### SECURITY Related Headers ###
            More information: https://www.owasp.org/index.php/List_of_useful_HTTP_headers
        -->
        <!--
                # Access-Control-Allow-Origin
                The 'Access Control Allow Origin' HTTP header is used to control which
                sites are allowed to bypass same origin policies and send cross-origin requests.
                Secure configuration: Either do not set this header, or return the 'Access-Control-Allow-Origin'
                header restricting it to only a trusted set of sites.
                http://enable-cors.org/
                <remove name="Access-Control-Allow-Origin" /><add name="Access-Control-Allow-Origin" value="*" />-->
        <!--
                # Cache-Control
                The 'Cache-Control' response header controls how pages can be cached
                either by proxies or the users browser.
                This response header can provide enhanced privacy by not caching
                sensitive pages in the users browser cache.
                <remove name="Cache-Control" /><add name="Cache-Control" value="no-store, no-cache"/>-->
        <!--
                # Strict-Transport-Security
                The HTTP Strict Transport Security header is used to control
                if the browser is allowed to only access a site over a secure connection
                and how long to remember the server response for, forcing continued usage.
                Note* Currently a draft standard which only Firefox and Chrome support. But is supported by sites like PayPal.
                <remove name="Strict-Transport-Security" /><add name="Strict-Transport-Security" value="max-age=15768000"/>-->
        <!--
                # X-Frame-Options
                The X-Frame-Options header indicates whether a browser should be allowed
                to render a page within a frame or iframe.
                The valid options are DENY (deny allowing the page to exist in a frame)
                or SAMEORIGIN (allow framing but only from the originating host)
                Without this option set the site is at a higher risk of click-jacking.
                <remove name="X-Frame-Options" /><add name="X-Frame-Options" value="SAMEORIGIN" />-->
        <!--
                # X-XSS-Protection
                The X-XSS-Protection header is used by Internet Explorer version 8+
                The header instructs IE to enable its inbuilt anti-cross-site scripting filter.
                If enabled, without 'mode=block', there is an increased risk that
                otherwise non-exploitable cross-site scripting vulnerabilities may potentially become exploitable
                <remove name="X-XSS-Protection" /><add name="X-XSS-Protection" value="1; mode=block"/>-->
        <!--
                # MIME type sniffing security protection
                Enabled by default as there are very few edge cases where you wouldn't want this enabled.
                Theres additional reading below; but the tldr, it reduces the ability of the browser (mostly IE)
                being tricked into facilitating driveby attacks.
                http://msdn.microsoft.com/en-us/library/ie/gg622941(v=vs.85).aspx
                http://blogs.msdn.com/b/ie/archive/2008/07/02/ie8-security-part-v-comprehensive-protection.aspx
        -->
        <!--<remove name="X-Content-Type-Options"/>
        <add name="X-Content-Type-Options" value="nosniff"/>-->
        <!-- A little extra security (by obscurity), removings fun but adding your own is better -->
        <remove name="X-Powered-By"/>
        <add name="X-Powered-By" value="Custom Powered By"/>
        <!--
                 With Content Security Policy (CSP) enabled (and a browser that supports it (http://caniuse.com/#feat=contentsecuritypolicy),
         you can tell the browser that it can only download content from the domains you explicitly allow
         CSP can be quite difficult to configure, and cause real issues if you get it wrong
         There is website that helps you generate a policy here http://cspisawesome.com/
         <remove name="Content-Security-Policy" /><add name="Content-Security-Policy" value="default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' https://www.google-analytics.com;" />-->
        <!--//#### SECURITY Related Headers ###-->
        <!--
                # E-TAGS
                E-Tags are actually quite useful in cache management especially if you have a front-end caching server
                such as Varnish. http://en.wikipedia.org/wiki/HTTP_ETag / http://developer.yahoo.com/performance/rules.html#etags
                But in load balancing and simply most cases ETags are mishandled in IIS; and it can be advantageous to remove them.
                This is simply done by overriding the default server header with an empty tag.
                See http://bytestopshere.wordpress.com/2009/02/02/disable-remove-etags-on-iis-6-to-improve-performance/
                <remove name="ETAG" /><add name="ETAG" value="" />-->
        <!--
                Allow cookies to be set from iframes (for IE only)
                If needed, uncomment and specify a path or regex in the Location directive
                <remove name="P3P" /><add name="P3P" value="policyref=&quot;/w3c/p3p.xml&quot;, CP=&quot;IDC DSP COR ADM DEVi TAIi PSA PSD IVAi IVDi CONi HIS OUR IND CNT&quot;" />-->
      </customHeaders>
    </httpProtocol>
  </system.webServer>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
